# Copy to .env (gitignored) and fill in real values.
# Values here are read by packaging scripts only; process env always wins.

# -- macOS code signing & notarization (scripts/notarize.js) --
APPLE_ID=your-apple-id@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=XXXXXXXXXX

# -- Windows code signing (scripts/win-sign.cjs) --
# Ask the signing service team for the internal service URL and a CI/app
# credential; do not use a personal account. All four values are required.
# Without them, Windows builds are produced UNSIGNED (dev-only).
# URL is the service root; pasting the full /api/sign endpoint also works.
YD_SIGN_SERVICE_URL=
YD_SIGN_APP_KEY=
YD_SIGN_APP_SECRET=
YD_SIGN_USERNAME=

# -- Optional codown publishing (scripts/release-codown.cjs) --
# Required only when using release:codown / codown:publish. Keep real internal
# URLs and machine paths in .env or CI configuration, never in this template.
# Checkout the product directory first. Each build host uses its own path.
CODOWN_WORKING_COPY=
CODOWN_SVN_URL=
CODOWN_PUBLIC_BASE_URL=
# Printed after SVN submission for MANUAL deployment; never opens a browser
# or creates/submits a ticket. Query parameters (e.g. a process ID) are allowed.
CODOWN_TICKET_URL=
# Prefer the SVN client's OS credential store on local machines. On CI, inject
# a product-scoped service account via Secrets. Password is passed via stdin.
CODOWN_SVN_USERNAME=
CODOWN_SVN_PASSWORD=
