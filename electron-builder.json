{
  "appId": "com.lobsterai.app",
  "productName": "LobsterAI",
  "executableName": "LobsterAI",
  "directories": {
    "output": "release"
  },
  "beforePack": "./scripts/electron-builder-hooks.cjs",
  "afterPack": "./scripts/electron-builder-hooks.cjs",
  "files": [
    "package.json",
    "resources/SYSTEM_PROMPT.md",
    {
      "from": "dist",
      "to": "dist",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "dist-electron",
      "to": "dist-electron",
      "filter": [
        "**/*",
        "!**/*.map",
        "!common/**",
        "!main/**",
        "!renderer/**",
        "!scheduledTask/**",
        "!shared/**"
      ]
    },
    {
      "from": "vendor/dsh-runtime/current",
      "to": "dsh-runtime",
      "filter": [
        "**/*",
        "!**/.bin",
        "!**/.bin/**",
        "!**/*.map",
        "!**/*.d.ts",
        "!**/*.d.cts",
        "!**/*.d.mts",
        "!**/README.md",
        "!**/README",
        "!**/readme.md",
        "!**/CHANGELOG.md",
        "!**/CHANGELOG",
        "!**/HISTORY.md",
        "!**/LICENSE",
        "!**/LICENSE.md",
        "!**/LICENSE.txt",
        "!**/.eslintrc*",
        "!**/.prettierrc*",
        "!**/tsconfig.json",
        "!**/tsconfig.*.json",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/tests/**",
        "!**/test/**",
        "!**/__tests__/**"
      ]
    },
    "!**/*.map",
    "!**/*.d.ts",
    "!**/*.d.cts",
    "!**/*.d.mts",
    "!**/README.md",
    "!**/README",
    "!**/readme.md",
    "!**/CHANGELOG.md",
    "!**/CHANGELOG",
    "!**/HISTORY.md",
    "!**/LICENSE",
    "!**/LICENSE.md",
    "!**/LICENSE.txt",
    "!**/.eslintrc*",
    "!**/.prettierrc*",
    "!**/tsconfig.json",
    "!**/tsconfig.*.json",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/tests/**",
    "!**/test/**",
    "!**/__tests__/**"
  ],
  "extraResources": [
    {
      "from": "resources/word-licenses",
      "to": "licenses/word",
      "filter": ["NOTICE.txt", "manifest.json"]
    },
    {
      "from": "resources/sheet-licenses",
      "to": "licenses/sheet",
      "filter": ["NOTICE.txt", "manifest.json"]
    },
    {
      "from": ".keyfrom-build",
      "to": "keyfrom",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/tray",
      "to": "tray",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "build/icons/png/512x512.png",
      "to": "app-icon/512x512.png"
    },
    {
      "from": "dsh-bundles/lobsterai-host",
      "to": "dsh-bundles/lobsterai-host",
      "filter": [
        "**/*",
        "!**/*.test.*",
        "!**/*.spec.*"
      ]
    },
    {
      "from": "dsh-bundles/lobsterai-channels",
      "to": "dsh-bundles/lobsterai-channels",
      "filter": [
        "**/*",
        "!**/*.test.*",
        "!**/*.spec.*"
      ]
    }
  ],
  "protocols": [
    {
      "name": "LobsterAI",
      "schemes": ["lobsterai"]
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "icon": "build/icons/mac/icon.icns",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "notarize": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "CFBundleIconName": "icon",
      "NSMicrophoneUsageDescription": "LobsterAI 需要访问您的麦克风来录制语音输入并进行语音识别。",
      "NSCalendarsUsageDescription": "LobsterAI 需要访问您的日历来帮助您查看和管理日程安排，例如查找事件、创建会议等。",
      "NSRemindersUsageDescription": "LobsterAI 需要访问您的提醒事项来帮助您管理待办事项。",
      "NSAppleEventsUsageDescription": "LobsterAI 需要使用 Apple Events 来控制 Calendar 应用执行自动化操作。",
      "CFBundleDocumentTypes": [
        {
          "CFBundleTypeName": "Document",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.content", "public.archive"]
        },
        {
          "CFBundleTypeName": "Folder",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.folder"]
        },
        {
          "CFBundleTypeName": "File",
          "CFBundleTypeRole": "Viewer",
          "LSHandlerRank": "Alternate",
          "LSItemContentTypes": ["public.data"]
        }
      ]
    },
    "extraResources": [
      {
        "from": "SKILLs",
        "to": "SKILLs",
        "filter": [
          "**/*",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": "resources/computer-use",
        "to": "computer-use",
        "filter": [
          "*.zip"
        ]
      },
      {
        "from": "resources/skin-pack",
        "to": "skin-pack",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dmg": {
    "sign": false
  },
  "afterSign": "scripts/notarize.js",
  "win": {
    "target": [
      "nsis"
    ],
    "icon": "build/icons/win/icon.ico",
    "requestedExecutionLevel": "asInvoker",
    "electronLanguages": ["en-US", "zh-CN", "zh-TW"],
    "extraResources": [
      {
        "from": "SKILLs",
        "to": "SKILLs",
        "filter": [
          "**/*",
          "!**/.bin",
          "!**/.bin/**",
          "!**/.env",
          "!**/.env.*",
          "!**/.venv",
          "!**/.venv/**",
          "!**/*.map",
          "!**/*.d.ts",
          "!**/*.d.cts",
          "!**/*.d.mts",
          "!**/README.md",
          "!**/README",
          "!**/readme.md",
          "!**/CHANGELOG.md",
          "!**/CHANGELOG",
          "!**/HISTORY.md",
          "!**/LICENSE",
          "!**/LICENSE.md",
          "!**/LICENSE.txt",
          "!**/.eslintrc*",
          "!**/.prettierrc*",
          "!**/tsconfig.json",
          "!**/tsconfig.*.json",
          "!**/*.test.*",
          "!**/*.spec.*",
          "!**/tests/**",
          "!**/test/**",
          "!**/__tests__/**"
        ]
      },
      {
        "from": "resources/python-win",
        "to": "python-win",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/skin-pack",
        "to": "skin-pack",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false,
    "include": "scripts/nsis-installer.nsh"
  },
  "electronVersion": "43.5.0",
  "npmRebuild": false,
  "includeSubNodeModules": true,
  "asarUnpack": [
    "node_modules/@img/**",
    "node_modules/@koromix/**",
    "node_modules/better-sqlite3/**",
    "node_modules/koffi/**",
    "node_modules/npm/**",
    "node_modules/selection-hook/**",
    "vendor/dsh-runtime/current/package-manager/**",
    "vendor/dsh-runtime/current/node_modules/node-pty/**",
    "vendor/dsh-runtime/current/node_modules/@img/**",
    "vendor/dsh-runtime/current/node_modules/@koromix/**",
    "vendor/dsh-runtime/current/node_modules/koffi/**",
    "vendor/dsh-runtime/current/node_modules/@vscode/ripgrep*/**",
    "vendor/dsh-runtime/current/node_modules/@deepseek-ai/node-addon-system*/**",
    "vendor/dsh-runtime/current/node_modules/@deepseek-ai/dsh-sandbox-windows-acl/**",
    "vendor/dsh-runtime/current/node_modules/node-addon-require-builtin*/**",
    "vendor/dsh-runtime/current/**/*.node",
    "vendor/dsh-runtime/current/**/*.dll",
    "vendor/dsh-runtime/current/**/*.dylib",
    "vendor/dsh-runtime/current/**/*.so",
    "vendor/dsh-runtime/current/**/*.exe",
    "vendor/dsh-runtime/current/**/*.cmd",
    "vendor/dsh-runtime/current/**/*.bat",
    "vendor/dsh-runtime/current/**/*.ps1"
  ],
  "asar": true
}
