+// The orphan sweep must delete exactly what the original NOT IN statements deleted.
+import type { DatabaseSync } from "node:sqlite";
+import { describe, expect, it } from "vitest";
+import { requireNodeSqlite } from "../../infra/node-sqlite.js";
+import { deleteOrphanedTranscriptIndexRowsInTransaction } from "./session-transcript-index.js";
+
+const SCHEMA = `
+  CREATE TABLE transcript_events (
+    session_id TEXT NOT NULL, seq INTEGER NOT NULL, event_json TEXT NOT NULL,
+    created_at INTEGER NOT NULL, PRIMARY KEY (session_id, seq)
+  );
+  CREATE TABLE session_transcript_active_events (
+    session_id TEXT NOT NULL, active_position INTEGER NOT NULL, event_seq INTEGER NOT NULL,
+    message_position INTEGER, context_eligible INTEGER, PRIMARY KEY (session_id, active_position)
+  );
+  CREATE TABLE session_transcript_index_state (
+    session_id TEXT NOT NULL PRIMARY KEY, indexed_seq INTEGER NOT NULL, leaf_event_id TEXT,
+    needs_rebuild INTEGER NOT NULL DEFAULT 0, active_event_count INTEGER NOT NULL DEFAULT 0,
+    active_message_count INTEGER NOT NULL DEFAULT 0, updated_at INTEGER NOT NULL
+  );
+  CREATE VIRTUAL TABLE session_transcript_fts USING fts5(
+    text, session_id UNINDEXED, message_id UNINDEXED, role UNINDEXED, timestamp UNINDEXED
+  );
+`;
+
+// The statements this sweep replaced, kept as the oracle.
+const ORIGINAL_SWEEP = `
+  DELETE FROM session_transcript_active_events
+    WHERE session_id NOT IN (SELECT DISTINCT session_id FROM transcript_events);
+  DELETE FROM session_transcript_fts
+    WHERE session_id NOT IN (SELECT DISTINCT session_id FROM transcript_events);
+  DELETE FROM session_transcript_index_state
+    WHERE session_id NOT IN (SELECT DISTINCT session_id FROM transcript_events);
+`;
+
+function seed(seedValue: number): DatabaseSync {
+  const { DatabaseSync } = requireNodeSqlite();
+  const db = new DatabaseSync(":memory:");
+  db.exec(SCHEMA);
+  let state = seedValue;
+  const next = () => {
+    state = (state * 1103515245 + 12345) % 2 ** 31;
+    return state;
+  };
+  const sessions = Array.from({ length: 40 }, (_, index) => `session-${index}`);
+  const insertEvent = db.prepare("INSERT INTO transcript_events VALUES (?, ?, '{}', 0)");
+  const insertActive = db.prepare(
+    "INSERT INTO session_transcript_active_events (session_id, active_position, event_seq) VALUES (?, ?, 0)",
+  );
+  const insertState = db.prepare(
+    "INSERT INTO session_transcript_index_state (session_id, indexed_seq, updated_at) VALUES (?, 0, 0)",
+  );
+  const insertFts = db.prepare(
+    "INSERT INTO session_transcript_fts (text, session_id, message_id, role, timestamp) VALUES (?, ?, 'm', 'user', NULL)",
+  );
+  for (const sessionId of sessions) {
+    // Roughly half the sessions keep transcript rows; the rest left index rows behind.
+    if (next() % 2 === 0) {
+      for (let seq = 0; seq < 1 + (next() % 4); seq += 1) {
+        insertEvent.run(sessionId, seq);
+      }
+    }
+    for (let position = 0; position < next() % 3; position += 1) {
+      insertActive.run(sessionId, position);
+    }
+    if (next() % 3 !== 0) {
+      insertState.run(sessionId);
+    }
+    for (let row = 0; row < next() % 3; row += 1) {
+      insertFts.run(`text ${row}`, sessionId);
+    }
+  }
+  // FTS session_id is nullable; NOT IN never matched these rows.
+  insertFts.run("detached", null);
+  return db;
+}
+
+function snapshot(db: DatabaseSync): Record<string, unknown[]> {
+  return {
+    active: db
+      .prepare(
+        "SELECT session_id, active_position FROM session_transcript_active_events ORDER BY 1, 2",
+      )
+      .all(),
+    fts: db.prepare("SELECT rowid, session_id FROM session_transcript_fts ORDER BY rowid").all(),
+    state: db.prepare("SELECT session_id FROM session_transcript_index_state ORDER BY 1").all(),
+  };
+}
+
+describe("deleteOrphanedTranscriptIndexRowsInTransaction", () => {
+  it.each([1, 7, 42, 1234, 99991])(
+    "deletes the same rows as the original sweep (seed %i)",
+    (value) => {
+      const expected = seed(value);
+      expected.exec(ORIGINAL_SWEEP);
+      const actual = seed(value);
+      deleteOrphanedTranscriptIndexRowsInTransaction(actual);
+
+      expect(snapshot(actual)).toEqual(snapshot(expected));
+      expect(snapshot(actual).fts).toContainEqual(expect.objectContaining({ session_id: null }));
+    },
+  );
+
+  it("probes the transcript key instead of listing every transcript session", () => {
+    const db = seed(3);
+    const plan = db
+      .prepare(
+        "EXPLAIN QUERY PLAN SELECT 1 FROM session_transcript_fts WHERE NOT EXISTS (SELECT 1 FROM transcript_events WHERE transcript_events.session_id = session_transcript_fts.session_id)",
+      )
+      .all()
+      .map((row) => String((row as { detail?: unknown }).detail));
+    expect(
+      plan.some((detail) => /SEARCH transcript_events USING .*\(session_id=\?\)/.test(detail)),
+    ).toBe(true);
+  });
+});
