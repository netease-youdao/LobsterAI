+// The worktree workspace backfill records completion so later starts skip its full scan.
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, expect, it } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { requireNodeSqlite } from "../../infra/node-sqlite.js";
+import { closeOpenClawAgentDatabasesForTest } from "../../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../../state/openclaw-state-db.js";
+import type { OpenClawConfig } from "../types.openclaw.js";
+import { loadSessionEntry, replaceSessionEntry } from "./session-accessor.js";
+import { resolveSqliteTargetFromSessionStorePath } from "./session-sqlite-target.js";
+import { migrateManagedWorktreeCanonicalWorkspaces } from "./worktree-workspace-migration.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+});
+
+function setup() {
+  const root = tempDirs.make("openclaw-worktree-migration-marker-");
+  const stateDir = path.join(root, "state");
+  const agentWorkspace = path.join(root, "workspace");
+  fs.mkdirSync(agentWorkspace, { recursive: true });
+  const env = { ...process.env, OPENCLAW_STATE_DIR: stateDir };
+  const storePath = path.join(stateDir, "agents", "main", "sessions", "sessions.json");
+  const cfg: OpenClawConfig = {
+    agents: { list: [{ id: "main", default: true, workspace: agentWorkspace }] },
+    session: { store: storePath },
+  };
+  const scope = (sessionKey: string) => ({ agentId: "main", env, sessionKey, storePath });
+  // Resolvable: a legacy worktree rooted at the agent workspace.
+  const writeLegacy = async (sessionKey: string, repoRoot = agentWorkspace) =>
+    await replaceSessionEntry(scope(sessionKey), {
+      sessionId: `${sessionKey}-session`,
+      // Recent, or session maintenance prunes the row before the next pass sees it.
+      updatedAt: Date.now(),
+      worktree: { id: sessionKey, branch: `openclaw/${sessionKey}`, repoRoot },
+    });
+  const run = async () =>
+    await migrateManagedWorktreeCanonicalWorkspaces({ agentId: "main", cfg, env, storePath });
+  const marker = () => {
+    const databasePath = resolveSqliteTargetFromSessionStorePath(storePath, {
+      agentId: "main",
+      env,
+    }).path;
+    if (!fs.existsSync(databasePath)) {
+      return "no-database";
+    }
+    const { DatabaseSync } = requireNodeSqlite();
+    const db = new DatabaseSync(databasePath, { readOnly: true });
+    try {
+      const row = db
+        .prepare("SELECT app_version FROM schema_meta WHERE meta_key = ?")
+        .get("managed-worktree-canonical-workspace-v1") as { app_version?: unknown } | undefined;
+      return row?.app_version ?? null;
+    } finally {
+      db.close();
+    }
+  };
+  const canonical = (sessionKey: string) =>
+    loadSessionEntry(scope(sessionKey))?.worktree?.canonicalWorkspaceDir;
+  return { agentWorkspace, canonical, marker, root, run, writeLegacy };
+}
+
+it("records completion once no legacy row is left and skips the scan afterwards", async () => {
+  const t = setup();
+  await t.writeLegacy("agent:main:legacy-a");
+
+  expect(await t.run()).toBe(1);
+  expect(t.canonical("agent:main:legacy-a")).toBe(t.agentWorkspace);
+  expect(t.marker()).toBe("complete");
+
+  // Current writers never produce this shape; a row forced in afterwards is left alone,
+  // which is what proves the completed database is no longer scanned.
+  await t.writeLegacy("agent:main:legacy-b");
+  expect(await t.run()).toBe(0);
+  expect(t.canonical("agent:main:legacy-b")).toBeUndefined();
+});
+
+it("keeps scanning while an unresolvable legacy row remains", async () => {
+  const t = setup();
+  await t.writeLegacy("agent:main:orphan", path.join(t.root, "unrelated-repo"));
+
+  expect(await t.run()).toBe(0);
+  expect(t.marker()).toBeNull();
+
+  await t.writeLegacy("agent:main:legacy-later");
+  expect(await t.run()).toBe(1);
+  expect(t.canonical("agent:main:legacy-later")).toBe(t.agentWorkspace);
+  // The orphan is still unresolved, so the database is still not marked complete.
+  expect(t.marker()).toBeNull();
+});
+
+it("does not create a database just to record completion", async () => {
+  const t = setup();
+  expect(await t.run()).toBe(0);
+  expect(t.marker()).toBe("no-database");
+});
