+// UIA text rectangles at least this tall, in 96 DPI pixels, are taken for provider output
+// that is not a text line (an element's bounds, for example).
+constexpr double kMaxTextRectLogicalHeight = 100.0;
+
+/**
+ * Effective DPI scale of the monitor nearest a screen point, as the calling process sees it.
+ *
+ * UIA reports rectangles in the same coordinate space GetDpiForMonitor describes for the
+ * caller: physical pixels and the monitor's DPI for a per-monitor aware host such as
+ * Electron, 96 DPI values for an unaware one. Size limits meant in 96 DPI pixels are
+ * multiplied by this. At 200% scaling a 66 CSS px heading line is about 170 physical
+ * pixels tall, which a fixed 100 px limit rejected.
+ *
+ * @param[in] x Screen x coordinate of the point.
+ * @param[in] y Screen y coordinate of the point.
+ * @return The scale, 1.0 for 96 DPI; 1.0 when it cannot be read (GetDpiForMonitor needs
+ *         Windows 8.1, and shcore.dll is loaded from System32 only).
+ */
+double MonitorScaleAt(LONG x, LONG y)
+{
+    // MONITOR_DPI_TYPE MDT_EFFECTIVE_DPI from ShellScalingApi.h; resolved at run time so the
+    // module keeps loading on Windows 7.
+    constexpr int effectiveDpi = 0;
+    using GetDpiForMonitorFn = HRESULT(WINAPI *)(HMONITOR, int, UINT *, UINT *);
+    static const GetDpiForMonitorFn getDpiForMonitor = []() -> GetDpiForMonitorFn {
+        HMODULE shcore = LoadLibraryExW(L"shcore.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+        return shcore ? reinterpret_cast<GetDpiForMonitorFn>(GetProcAddress(shcore, "GetDpiForMonitor")) : nullptr;
+    }();
+    if (!getDpiForMonitor)
+        return 1.0;
+
+    const POINT point = {x, y};
+    HMONITOR monitor = MonitorFromPoint(point, MONITOR_DEFAULTTONEAREST);
+    UINT dpiX = 0;
+    UINT dpiY = 0;
+    if (!monitor || FAILED(getDpiForMonitor(monitor, effectiveDpi, &dpiX, &dpiY)) || dpiY == 0)
+        return 1.0;
+    return dpiY / 96.0;
+}
