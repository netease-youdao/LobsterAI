+
+# Acquire the web payload BEFORE anything destructive runs. Inserted at the
+# top of the install section, ahead of CHECK_APP_RUNNING and
+# uninstallOldVersion: a failed or cancelled download leaves the previous
+# installation fully intact. (Previously the old app was already uninstalled
+# by the time the download started, so a download failure stranded the user
+# with no usable app at all.)
+# Resolution order: explicit --package-file, sibling package next to the
+# installer, cached payload from a previous install, network download.
+!macro acquireWebPackage
+  Var /GLOBAL packageFile
+  Var /GLOBAL isPackageFileExplicitlySpecified
+  Var /GLOBAL webPackageExpectedHash
+
+  !ifmacrodef customWebPackageAcquireStart
+    !insertmacro customWebPackageAcquireStart
+  !endif
+
+  # we do not check file hash if specified explicitly using --package-file because it is clear that user definitely want to use this file and it is user responsibility to check
+  # 1. auto-updater uses --package-file and validates checksum
+  # 2. user can use another package file (use case - one installer suitable for any app version (use latest version))
+  ${StdUtils.GetParameter} $packageFile "package-file" ""
+  ${if} $packageFile == ""
+    !ifdef APP_64_NAME
+      !ifdef APP_32_NAME
+        !ifdef APP_ARM64_NAME
+          ${if} ${IsNativeARM64}
+            StrCpy $packageFile "${APP_ARM64_NAME}"
+            StrCpy $webPackageExpectedHash "${APP_ARM64_HASH}"
+          ${elseif} ${IsNativeAMD64}
+            StrCpy $packageFile "${APP_64_NAME}"
+            StrCpy $webPackageExpectedHash "${APP_64_HASH}"
+          ${else}
+            StrCpy $packageFile "${APP_32_NAME}"
+            StrCpy $webPackageExpectedHash "${APP_32_HASH}"
+          ${endif}
+        !else
+          ${if} ${RunningX64}
+            StrCpy $packageFile "${APP_64_NAME}"
+            StrCpy $webPackageExpectedHash "${APP_64_HASH}"
+          ${else}
+            StrCpy $packageFile "${APP_32_NAME}"
+            StrCpy $webPackageExpectedHash "${APP_32_HASH}"
+          ${endif}
+        !endif
+      !else
+        StrCpy $packageFile "${APP_64_NAME}"
+        StrCpy $webPackageExpectedHash "${APP_64_HASH}"
+      !endif
+    !else
+      StrCpy $packageFile "${APP_32_NAME}"
+      StrCpy $webPackageExpectedHash "${APP_32_HASH}"
+    !endif
+    StrCpy $4 "$packageFile"
+    StrCpy $packageFile "$EXEDIR/$packageFile"
+    StrCpy $isPackageFileExplicitlySpecified "false"
+  ${else}
+    StrCpy $isPackageFileExplicitlySpecified "true"
+    StrCpy $webPackageExpectedHash ""
+  ${endIf}
+
+  ${if} $isPackageFileExplicitlySpecified == "true"
+    ${if} ${FileExists} "$packageFile"
+      !ifmacrodef customWebPackageAcquireEnd
+        !insertmacro customWebPackageAcquireEnd "explicit"
+      !endif
+      Goto LobsterWebPackageReady
+    ${endif}
+  ${else}
+    # sibling package next to the installer (channel co-download layout)
+    ${if} ${FileExists} "$packageFile"
+      ${StdUtils.HashFile} $3 "SHA2-512" "$packageFile"
+      ${if} $3 == $webPackageExpectedHash
+        !ifmacrodef customWebPackageAcquireEnd
+          !insertmacro customWebPackageAcquireEnd "sibling"
+        !endif
+        Goto LobsterWebPackageReady
+      ${else}
+        # /SD keeps a stale sibling package from blocking silent installs
+        MessageBox MB_OK "Package file $4 found locally, but checksum doesn't match ${U+2014} expected $webPackageExpectedHash, actual $3.$\r$\nLocal file is ignored and package will be downloaded from Internet." /SD IDOK
+      ${endIf}
+    ${endIf}
+
+    # cached payload from a previous install or attempt: the hash acts as the
+    # version gate (the store file name is version-less), and a match makes a
+    # channel retry install with zero download
+    ${if} $webPackageExpectedHash != ""
+      ${if} $installMode == "all"
+        SetShellVarContext current
+      ${endif}
+      ${if} ${FileExists} "$LOCALAPPDATA\${APP_PACKAGE_STORE_FILE}"
+        ${StdUtils.HashFile} $3 "SHA2-512" "$LOCALAPPDATA\${APP_PACKAGE_STORE_FILE}"
+        ${if} $3 == $webPackageExpectedHash
+          StrCpy $packageFile "$LOCALAPPDATA\${APP_PACKAGE_STORE_FILE}"
+          ${if} $installMode == "all"
+            SetShellVarContext all
+          ${endif}
+          !ifmacrodef customWebPackageAcquireEnd
+            !insertmacro customWebPackageAcquireEnd "cache"
+          !endif
+          Goto LobsterWebPackageReady
+        ${endif}
+      ${endif}
+      ${if} $installMode == "all"
+        SetShellVarContext all
+      ${endif}
+    ${endif}
+  ${endIf}
+
+  !insertmacro downloadApplicationFiles
+  !ifmacrodef customWebPackageAcquireEnd
+    !insertmacro customWebPackageAcquireEnd "download"
+  !endif
+
+  LobsterWebPackageReady:
+!macroend
