+  pathExt?: string;
+  missing: Set<string>;
+};
+const binaryLookupBatch = new AsyncLocalStorage<BinaryLookupBatch>();
+
+/** Reuse missing-binary probes within one publication, never across installs/refreshes. */
+export async function withBinaryLookupBatch<T>(run: () => Promise<T>): Promise<T> {
+  const batch: BinaryLookupBatch = { active: true, missing: new Set() };
+  return await binaryLookupBatch.run(batch, async () => {
+    try {
+      return await run();
+    } finally {
+      // Detached descendants can inherit the context; retire their cache too.
+      batch.active = false;
+      batch.missing.clear();
+    }
+  });
