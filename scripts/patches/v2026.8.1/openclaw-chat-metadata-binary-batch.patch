diff --git a/src/shared/config-eval-batch.test.ts b/src/shared/config-eval-batch.test.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/config-eval-batch.test.ts
@@ -0,0 +1,128 @@
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, expect, test, vi } from "vitest";
+import { mockProcessPlatform } from "../test-utils/vitest-spies.js";
+import { hasBinary, withBinaryLookupBatch } from "./config-eval.js";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllEnvs();
+});
+
+test("scoped misses invalidate on PATH and PATHEXT changes", async () => {
+  mockProcessPlatform("win32");
+  vi.stubEnv("PATH", path.join(path.sep, "batch-first"));
+  vi.stubEnv("PATHEXT", ".EXE");
+  const access = vi.spyOn(fs, "accessSync").mockImplementation(() => {
+    throw new Error("missing");
+  });
+  await withBinaryLookupBatch(async () => {
+    expect(hasBinary("batch-path-fixture")).toBe(false);
+    expect(hasBinary("batch-path-fixture")).toBe(false);
+    expect(access).toHaveBeenCalledTimes(2);
+    vi.stubEnv("PATH", path.join(path.sep, "batch-second"));
+    expect(hasBinary("batch-path-fixture")).toBe(false);
+    expect(access).toHaveBeenCalledTimes(4);
+    vi.stubEnv("PATHEXT", ".CMD");
+    expect(hasBinary("batch-path-fixture")).toBe(false);
+    expect(access).toHaveBeenCalledTimes(6);
+  });
+});
+
+test("a nested publication owns a fresh probe batch", async () => {
+  mockProcessPlatform("linux");
+  vi.stubEnv("PATH", path.join(path.sep, "batch-nested"));
+  let installed = false;
+  vi.spyOn(fs, "accessSync").mockImplementation(() => {
+    if (!installed) {
+      throw new Error("missing");
+    }
+  });
+  await withBinaryLookupBatch(async () => {
+    expect(hasBinary("batch-nested-fixture")).toBe(false);
+    installed = true;
+    await withBinaryLookupBatch(async () => {
+      expect(hasBinary("batch-nested-fixture")).toBe(true);
+    });
+  });
+});
+
+test.each([false, true])(
+  "detached work cannot retain misses after batch settlement (failure: %s)",
+  async (fail) => {
+    mockProcessPlatform("linux");
+    vi.stubEnv("PATH", path.join(path.sep, `batch-retired-${fail}`));
+    let installed = false;
+    vi.spyOn(fs, "accessSync").mockImplementation(() => {
+      if (!installed) {
+        throw new Error("missing");
+      }
+    });
+    let release!: () => void;
+    const gate = new Promise<void>((resolve) => {
+      release = resolve;
+    });
+    let descendant!: Promise<boolean>;
+    const run = withBinaryLookupBatch(async () => {
+      expect(hasBinary(`batch-retired-${fail}`)).toBe(false);
+      descendant = gate.then(() => hasBinary(`batch-retired-${fail}`));
+      if (fail) {
+        throw new Error("publication failed");
+      }
+    });
+    if (fail) {
+      await expect(run).rejects.toThrow("publication failed");
+    } else {
+      await run;
+    }
+    installed = true;
+    release();
+    expect(await descendant).toBe(true);
+  },
+);
+
+test("concurrent batches do not share missing results", async () => {
+  mockProcessPlatform("linux");
+  vi.stubEnv("PATH", path.join(path.sep, "batch-concurrent"));
+  let installed = false;
+  vi.spyOn(fs, "accessSync").mockImplementation(() => {
+    if (!installed) {
+      throw new Error("missing");
+    }
+  });
+  let release!: () => void;
+  const gate = new Promise<void>((resolve) => {
+    release = resolve;
+  });
+  const first = withBinaryLookupBatch(async () => {
+    expect(hasBinary("batch-concurrent-fixture")).toBe(false);
+    await gate;
+  });
+  installed = true;
+  await withBinaryLookupBatch(async () => {
+    expect(hasBinary("batch-concurrent-fixture")).toBe(true);
+  });
+  release();
+  await first;
+});
+
+test.each([false, true])(
+  "distinguishes unset and empty PATHEXT in a batch (empty first: %s)",
+  async (emptyFirst) => {
+    mockProcessPlatform("win32");
+    const binDir = path.join(path.sep, `batch-extensions-${emptyFirst}`);
+    const bin = `batch-extensions-${emptyFirst}`;
+    vi.stubEnv("PATH", binDir);
+    vi.spyOn(fs, "accessSync").mockImplementation((candidate) => {
+      if (String(candidate) !== path.join(binDir, `${bin}.CMD`)) {
+        throw new Error("missing");
+      }
+    });
+    await withBinaryLookupBatch(async () => {
+      vi.stubEnv("PATHEXT", emptyFirst ? "" : undefined);
+      expect(hasBinary(bin)).toBe(!emptyFirst);
+      vi.stubEnv("PATHEXT", emptyFirst ? undefined : "");
+      expect(hasBinary(bin)).toBe(emptyFirst);
+    });
+  },
+);
diff --git a/src/gateway/server-methods/chat-metadata-binary-batch.test.ts b/src/gateway/server-methods/chat-metadata-binary-batch.test.ts
new file mode 100644
--- /dev/null
+++ b/src/gateway/server-methods/chat-metadata-binary-batch.test.ts
@@ -0,0 +1,45 @@
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, expect, test, vi } from "vitest";
+import { hasBinary } from "../../shared/config-eval.js";
+import { mockProcessPlatform } from "../../test-utils/vitest-spies.js";
+import { createChatMetadataHarness } from "./chat-metadata-runtime.test-support.js";
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllEnvs();
+});
+
+test("one metadata publication probes a missing dependency once for all agents, then sees an install", async () => {
+  mockProcessPlatform("win32");
+  const binDir = path.join(path.sep, "metadata-batch-tools");
+  vi.stubEnv("PATH", binDir);
+  vi.stubEnv("PATHEXT", ".EXE;.CMD");
+  let installed = false;
+  const access = vi.spyOn(fs, "accessSync").mockImplementation((candidate) => {
+    if (installed && String(candidate) === path.join(binDir, "metadata-fixture.CMD")) {
+      return;
+    }
+    throw new Error("missing executable");
+  });
+  const harness = createChatMetadataHarness({
+    agents: { list: [{ id: "main", default: true }, { id: "reviewer" }, { id: "writer" }] },
+  });
+  harness.buildCommands.mockImplementation(async () => {
+    await Promise.resolve();
+    return { commands: hasBinary("metadata-fixture") ? [{ name: "installed" }] : [] };
+  });
+  await harness.runtime.refresh();
+  expect(harness.buildCommands).toHaveBeenCalledTimes(3);
+  expect(access).toHaveBeenCalledTimes(3);
+  expect((await harness.runtime.read({ agentId: "main" })).commands).toEqual([]);
+
+  installed = true;
+  harness.setSkillsVersion(2);
+  harness.runtime.invalidate();
+  await harness.runtime.refresh();
+  expect((await harness.runtime.read({ agentId: "reviewer" })).commands).toEqual([
+    { name: "installed" },
+  ]);
+  expect(access).toHaveBeenCalledTimes(6);
+});
