+import fs from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { openNodeSqliteDatabase } from "../infra/node-sqlite.js";
+import { withTempDir } from "../test-utils/temp-dir.js";
+import { listAgentDeletionIds } from "./agent-deletion-journal.js";
+import { resolveOpenClawStateSqlitePath } from "./openclaw-state-db.paths.js";
+
+describe("read-only deletion discovery", () => {
+  it("does not create state when the caller's state directory is absent", async () => {
+    await withTempDir("openclaw-deletion-discovery-", async (root) => {
+      const stateDir = path.join(root, "absent");
+      expect(listAgentDeletionIds({ env: { OPENCLAW_STATE_DIR: stateDir } })).toEqual(new Set());
+      expect(fs.existsSync(stateDir)).toBe(false);
+    });
+  });
+
+  it("does not migrate an existing database without a deletion journal", async () => {
+    await withTempDir("openclaw-deletion-discovery-", async (stateDir) => {
+      const env = { OPENCLAW_STATE_DIR: stateDir };
+      const databasePath = resolveOpenClawStateSqlitePath(env);
+      fs.mkdirSync(path.dirname(databasePath), { recursive: true });
+      const db = openNodeSqliteDatabase(databasePath);
+      db.exec("CREATE TABLE preserved (value TEXT)");
+      db.close();
+      const original = fs.readFileSync(databasePath);
+
+      expect(listAgentDeletionIds({ env })).toEqual(new Set());
+      expect(fs.readFileSync(databasePath)).toEqual(original);
+    });
+  });
+
+  it.each([
+    "CREATE VIEW agent_deletion_journal AS SELECT 'deleted' AS agent_id",
+    "CREATE TABLE agent_deletion_journal (invalid_column TEXT)",
+  ])("propagates invalid journal errors instead of enabling maintenance: %s", async (ddl) => {
+    await withTempDir("openclaw-deletion-discovery-", async (stateDir) => {
+      const env = { OPENCLAW_STATE_DIR: stateDir };
+      const databasePath = resolveOpenClawStateSqlitePath(env);
+      fs.mkdirSync(path.dirname(databasePath), { recursive: true });
+      const db = openNodeSqliteDatabase(databasePath);
+      db.exec(ddl);
+      db.close();
+      const original = fs.readFileSync(databasePath);
+
+      expect(() => listAgentDeletionIds({ env })).toThrow();
+      expect(fs.readFileSync(databasePath)).toEqual(original);
+    });
+  });
+});
