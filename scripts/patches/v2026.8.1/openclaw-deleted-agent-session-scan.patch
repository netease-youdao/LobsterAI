+/** Both pending and completed deletions fence maintenance until identity recreation. */
+export function listAgentDeletionIds(
+  options: OpenClawStateDatabaseOptions = {},
+): ReadonlySet<string> {
+  const ids = withExistingOpenClawStateDatabaseReadOnly(({ db: database, path: pathname }) => {
+    const journal = database
+      .prepare("SELECT type FROM sqlite_master WHERE name = 'agent_deletion_journal'")
+      .get() as { type?: unknown } | undefined;
+    if (!journal) {
+      return [];
+    }
+    if (journal.type !== "table") {
+      throw new Error(`OpenClaw state database ${pathname} has an invalid agent deletion journal.`);
+    }
+    const db = getNodeSqliteKysely<AgentDeletionDatabase>(database);
+    return executeSqliteQuerySync(
+      database,
+      db.selectFrom("agent_deletion_journal").select("agent_id"),
+    ).rows.map((row) => normalizeAgentId(row.agent_id));
+  }, options);
+  return new Set(ids ?? []);
+}
 
