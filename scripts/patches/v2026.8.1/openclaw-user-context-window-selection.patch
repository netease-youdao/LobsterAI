+const LOBSTERAI_PROVIDER = "lobsterai-server";
+export const LOBSTERAI_USER_CONTEXT_WINDOW_PREFIX = "user-context:";
+const LOBSTERAI_PRESET_CONTEXT_WINDOWS = new Set([
+  "yd-fast",
+  "yd-ultra",
+  "model-preset:balanced",
+  "model-preset:ultimate",
+]);
+
+/** Declared managed presets own their current mode budget, independently of the
+ * direct model's scalar. User windows additionally require an explicit selection. */
+export function resolveLobsterAIContextTokens(params: {
+  provider?: string;
+  selected?: string;
+  contextWindow?: string;
+  contextTokens?: number;
+}): number | undefined {
+  const selected = params.selected?.trim();
+  const tokens = params.contextTokens;
+  if (
+    params.provider !== LOBSTERAI_PROVIDER ||
+    typeof tokens !== "number" ||
+    !Number.isFinite(tokens) ||
+    tokens <= 0
+  ) {
+    return undefined;
+  }
+  return LOBSTERAI_PRESET_CONTEXT_WINDOWS.has(params.contextWindow ?? "") ||
+    (selected?.startsWith(LOBSTERAI_USER_CONTEXT_WINDOW_PREFIX) &&
+      params.contextWindow === selected &&
+      Number.isInteger(tokens) &&
+      tokens >= 400_000 &&
+      tokens <= 1_000_000)
+    ? tokens
+    : undefined;
+}
