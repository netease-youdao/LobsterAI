+import { describe, expect, it } from "vitest";
+import type { ModelCatalogEntry } from "../agents/model-catalog.types.js";
+import type { SessionEntry } from "../config/sessions.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { buildGatewaySessionRow } from "./session-utils-row.js";
+
+describe("LobsterAI explicit user context projection", () => {
+  const modelId = "context-window-test-model";
+  const selectedWindow = "user-context:1000000";
+  function row(
+    provider: string,
+    contextWindow?: string,
+    defaultWindow = 400_000,
+    persistedContextTokens = 400_000,
+    locked = false,
+    presetWindow = 400_000,
+    presetId = "yd-fast",
+    withdrawnUserWindow = false,
+  ) {
+    const model: ModelCatalogEntry = {
+      provider,
+      id: modelId,
+      name: modelId,
+      contextWindow: defaultWindow,
+      contextWindows: [
+        { id: "model-default", label: "Default", contextWindow: defaultWindow },
+        { id: presetId, label: "Preset", contextWindow: presetWindow },
+        ...(withdrawnUserWindow
+          ? []
+          : [
+              { id: selectedWindow, label: "1M", contextWindow: 1_000_000 },
+              {
+                id: `user-context:${presetId}:1000000`,
+                label: "Preset 1M",
+                contextWindow: 1_000_000,
+              },
+            ]),
+      ],
+      contextWindowDefault: "model-default",
+    };
+    const cfg = {
+      agents: { defaults: { model: { primary: `${provider}/${modelId}` } } },
+      models: { providers: { [provider]: { baseUrl: "http://127.0.0.1:9/v1", models: [model] } } },
+    } as OpenClawConfig;
+    const entry: SessionEntry = {
+      sessionId: "context-test",
+      updatedAt: 1,
+      contextWindow,
+      modelProvider: provider,
+      model: modelId,
+      contextTokens: persistedContextTokens,
+      contextTokensSource: "runtime",
+      agentHarnessId: "openclaw",
+      modelSelectionLocked: locked,
+    };
+    return buildGatewaySessionRow({
+      cfg,
+      storePath: "",
+      store: {},
+      key: "agent:main:main",
+      entry,
+      modelCatalog: [model],
+      lightweightListRow: true,
+    });
+  }
+
+  it("projects 400K -> explicit 1M -> default 400K despite older 400K telemetry", () => {
+    expect(row("lobsterai-server").contextTokens).toBe(400_000);
+    expect(row("lobsterai-server", selectedWindow)).toMatchObject({
+      contextWindow: selectedWindow,
+      contextTokens: 1_000_000,
+    });
+    expect(row("lobsterai-server").contextTokens).toBe(400_000);
+  });
+
+  it("keeps unknown selections and other providers on the existing cap", () => {
+    expect(row("lobsterai-server", "user-context:900000").contextTokens).toBe(400_000);
+    expect(row("custom-provider", selectedWindow).contextTokens).toBe(400_000);
+  });
+
+  it("immediately clears old 1M telemetry when returning to a managed default", () => {
+    for (const locked of [false, true]) {
+      expect(
+        row("lobsterai-server", selectedWindow, 400_000, 1_000_000, locked).contextTokens,
+      ).toBe(1_000_000);
+      expect(row("lobsterai-server", undefined, 400_000, 1_000_000, locked).contextTokens).toBe(
+        400_000,
+      );
+      expect(row("lobsterai-server", "yd-fast", 1_000_000, 1_000_000, locked).contextTokens).toBe(
+        400_000,
+      );
+    }
+  });
+
+  it("uses a changed managed default for existing sessions while preserving explicit 1M", () => {
+    for (const persistedContextTokens of [400_000, 1_000_000]) {
+      for (const locked of [false, true]) {
+        expect(
+          row("lobsterai-server", undefined, 500_000, persistedContextTokens, locked).contextTokens,
+        ).toBe(500_000);
+        expect(
+          row("lobsterai-server", selectedWindow, 500_000, persistedContextTokens, locked)
+            .contextTokens,
+        ).toBe(1_000_000);
+      }
+    }
+    expect(row("custom-provider", undefined, 500_000, 400_000, true).contextTokens).toBe(400_000);
+  });
+
+  it.each(["yd-fast", "yd-ultra", "model-preset:balanced", "model-preset:ultimate"])(
+    "projects the current declared preset %s independently of the 400K scalar",
+    (presetId) => {
+      for (const locked of [false, true]) {
+        for (const persistedContextTokens of [400_000, 1_000_000]) {
+          const project = (selected: string | undefined, presetWindow: number, withdrawn = false) =>
+            row(
+              "lobsterai-server",
+              selected,
+              400_000,
+              persistedContextTokens,
+              locked,
+              presetWindow,
+              presetId,
+              withdrawn,
+            ).contextTokens;
+          expect(project(presetId, 400_000)).toBe(400_000);
+          expect(project(presetId, 500_000)).toBe(500_000);
+          expect(project(undefined, 500_000)).toBe(400_000);
+          const userPreset = `user-context:${presetId}:1000000`;
+          expect(project(userPreset, 500_000)).toBe(1_000_000);
+          expect(project(presetId, 500_000)).toBe(500_000);
+          // The gateway cannot infer the current mode from a withdrawn ID.
+          // Main must patch back to presetId before its 500K default applies.
+          expect(project(userPreset, 500_000, true)).toBe(400_000);
+          expect(project(presetId, 500_000, true)).toBe(500_000);
+        }
+      }
+      expect(
+        row("custom-provider", presetId, 400_000, 400_000, true, 500_000, presetId).contextTokens,
+      ).toBe(400_000);
+    },
+  );
+});
