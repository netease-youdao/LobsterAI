+import { afterEach, expect, test } from "vitest";
+import { getRuntimeConfig } from "../config/io.js";
+import type { ModelDefinitionConfig } from "../config/types.models.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import { agentDiscoveryMock, testState, writeSessionStore } from "./test-helpers.js";
+import {
+  createCheckpointFixture,
+  directSessionReq,
+  sessionStoreEntry,
+  setupGatewaySessionsHandlerTestHarness,
+} from "./test/server-sessions.test-helpers.js";
+
+const { createSessionStoreDir } = setupGatewaySessionsHandlerTestHarness();
+// The handler-only fixture has no server.close to release SQLite before its
+// tracked session-store directories are removed on Windows.
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+});
+const userWindow = "user-context:1000000";
+const cases: Array<{
+  name: string;
+  provider: string;
+  selected?: string;
+  parentWindow?: string;
+  inherited?: boolean;
+  fork?: boolean;
+  expected: boolean;
+  expectedWindow?: string;
+  presetId?: string;
+  presetWindow?: number;
+  parentTokens?: number;
+  expectedTokens?: number;
+}> = [
+  {
+    name: "explicit 1M",
+    provider: "lobsterai-server",
+    selected: userWindow,
+    expected: true,
+    expectedWindow: userWindow,
+  },
+  {
+    name: "inherited explicit 1M",
+    provider: "lobsterai-server",
+    selected: userWindow,
+    inherited: true,
+    expected: true,
+    expectedWindow: userWindow,
+  },
+  { name: "unselected default", provider: "lobsterai-server", expected: false },
+  { name: "ordinary preset", provider: "lobsterai-server", selected: "yd-fast", expected: false },
+  {
+    name: "unrelated provider",
+    provider: "custom-provider",
+    selected: userWindow,
+    expected: false,
+  },
+  {
+    name: "automatic child",
+    provider: "lobsterai-server",
+    parentWindow: userWindow,
+    fork: false,
+    expected: true,
+  },
+  {
+    name: "explicit child 1M",
+    provider: "lobsterai-server",
+    parentWindow: userWindow,
+    selected: userWindow,
+    fork: false,
+    expected: true,
+    expectedWindow: userWindow,
+  },
+  {
+    name: "explicit child 400K",
+    provider: "lobsterai-server",
+    parentWindow: userWindow,
+    selected: "user-context:400000",
+    fork: false,
+    expected: true,
+    expectedWindow: "user-context:400000",
+  },
+  {
+    name: "legacy child preset",
+    provider: "lobsterai-server",
+    parentWindow: "yd-fast",
+    fork: false,
+    expected: true,
+    expectedWindow: "yd-fast",
+  },
+  ...["yd-fast", "yd-ultra", "model-preset:balanced", "model-preset:ultimate"].map((presetId) => ({
+    name: `declared 500K preset ${presetId}`,
+    provider: "lobsterai-server",
+    selected: presetId,
+    parentWindow: `user-context:${presetId}:1000000`,
+    presetId,
+    presetWindow: 500_000,
+    parentTokens: 450_000,
+    expected: true,
+    expectedWindow: presetId,
+    expectedTokens: 500_000,
+  })),
+  {
+    name: "explicit mode 1M with current mode default 500K",
+    provider: "lobsterai-server",
+    selected: "user-context:yd-fast:1000000",
+    presetWindow: 500_000,
+    expected: true,
+    expectedWindow: "user-context:yd-fast:1000000",
+    expectedTokens: 1_000_000,
+  },
+  {
+    name: "foreign declared 500K preset stays capped",
+    provider: "custom-provider",
+    selected: "yd-fast",
+    presetWindow: 500_000,
+    parentTokens: 450_000,
+    expected: false,
+  },
+];
+
+test.each(cases)(
+  "LobsterAI explicit fork budget: $name",
+  async ({
+    provider,
+    selected,
+    inherited,
+    parentWindow,
+    fork = true,
+    expected,
+    expectedWindow,
+    presetId = "yd-fast",
+    presetWindow = 400_000,
+    parentTokens = 600_000,
+    expectedTokens = expectedWindow === userWindow ? 1_000_000 : 400_000,
+  }) => {
+    const { dir } = await createSessionStoreDir();
+    const modelId = "context-window-test-model";
+    const model: ModelDefinitionConfig & { provider: string } = {
+      id: modelId,
+      name: "Context test",
+      provider,
+      api: "openai-completions",
+      reasoning: false,
+      input: ["text"],
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+      maxTokens: 32_768,
+      contextWindow: 400_000,
+      contextWindows: [
+        { id: "model-default", label: "Default", contextWindow: 400_000 },
+        { id: presetId, label: "Preset", contextWindow: presetWindow },
+        { id: "user-context:400000", label: "400K", contextWindow: 400_000 },
+        { id: userWindow, label: "1M", contextWindow: 1_000_000 },
+        { id: `user-context:${presetId}:1000000`, label: "Preset 1M", contextWindow: 1_000_000 },
+      ],
+      contextWindowDefault: "model-default",
+    };
+    testState.sessionConfig = { scope: "per-sender" };
+    agentDiscoveryMock.models = [model];
+    try {
+      const parent = await createCheckpointFixture(dir);
+      const inheritedWindow = inherited ? selected : parentWindow;
+      await writeSessionStore({
+        entries: {
+          main: sessionStoreEntry(parent.sessionId, {
+            sessionFile: parent.sessionFile,
+            providerOverride: provider,
+            modelOverride: modelId,
+            ...(inheritedWindow ? { contextWindow: inheritedWindow } : {}),
+            totalTokens: parentTokens,
+            totalTokensFresh: true,
+            totalTokensVersion: 1,
+          }),
+        },
+      });
+      const cfg = getRuntimeConfig();
+      const selection = { primary: `${provider}/${modelId}` };
+      const created = await directSessionReq<{ key: string; entry?: { contextWindow?: string } }>(
+        "sessions.create",
+        {
+          agentId: "main",
+          parentSessionKey: "main",
+          fork,
+          ...(!inherited && selected ? { contextWindow: selected } : {}),
+        },
+        {
+          context: {
+            getRuntimeConfig: () => ({
+              ...cfg,
+              agents: {
+                ...cfg.agents,
+                defaults: { ...cfg.agents?.defaults, model: selection },
+                entries: {
+                  ...cfg.agents?.entries,
+                  main: { ...cfg.agents?.entries?.main, model: selection },
+                },
+              },
+              models: {
+                providers: { [provider]: { baseUrl: "http://127.0.0.1:9/v1", models: [model] } },
+              },
+            }),
+          },
+        },
+      );
+      expect(created.ok, JSON.stringify(created.error)).toBe(expected);
+      if (!expected) expect(created.error?.message).toContain(`${parentTokens}/400000 tokens`);
+      else {
+        expect(created.payload?.entry?.contextWindow).toBe(expectedWindow);
+        const listed = await directSessionReq<{
+          sessions: Array<{ key: string; contextTokens?: number }>;
+        }>("sessions.list", {});
+        expect(
+          listed.payload?.sessions.find((row) => row.key === created.payload?.key)?.contextTokens,
+        ).toBe(expectedTokens);
+      }
+    } finally {
+      agentDiscoveryMock.models = [];
+      testState.sessionConfig = undefined;
+    }
+  },
+);
