+import { describe, expect, it } from "vitest";
+import { resolveMemoryFlushContextWindowTokens } from "../auto-reply/reply/memory-flush.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import type { ProviderRuntimeModel } from "../plugins/provider-runtime-model.types.js";
+import { resolveEmbeddedRuntimeModelPolicy } from "./embedded-agent-runner/run/setup.js";
+
+const modelId = "context-window-test-model";
+const selectedWindow = "user-context:1000000";
+
+function fixture(provider = "lobsterai-server", defaultWindow = 400_000) {
+  const runtimeModel: ProviderRuntimeModel = {
+    provider,
+    id: modelId,
+    name: modelId,
+    baseUrl: "http://127.0.0.1:9/v1",
+    api: "openai-completions",
+    reasoning: false,
+    input: ["text"],
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    contextWindow: defaultWindow,
+    maxTokens: 32_768,
+    contextWindows: [
+      { id: "model-default", label: "Default", contextWindow: defaultWindow },
+      { id: "yd-fast", label: "Fast", contextWindow: 400_000 },
+      { id: selectedWindow, label: "1M", contextWindow: 1_000_000 },
+      { id: "user-context:yd-fast:1000000", label: "Fast 1M", contextWindow: 1_000_000 },
+    ],
+    contextWindowDefault: "model-default",
+  };
+  const cfg: OpenClawConfig = {
+    models: {
+      providers: { [provider]: { baseUrl: runtimeModel.baseUrl, models: [runtimeModel] } },
+    },
+  };
+  return { provider, runtimeModel, cfg };
+}
+
+describe("LobsterAI explicit user context budgets", () => {
+  it("keeps run and preflight at 400K, then 1M, then the current default without changing output limits", () => {
+    const { provider, runtimeModel, cfg } = fixture();
+    for (const [contextWindow, expected] of [
+      [undefined, 400_000],
+      [selectedWindow, 1_000_000],
+      [undefined, 400_000],
+    ] as const) {
+      const run = resolveEmbeddedRuntimeModelPolicy({
+        cfg,
+        provider,
+        modelId,
+        runtimeModel,
+        nativeModelOwned: false,
+        contextWindow,
+      });
+      expect(run.contextTokenBudget).toBe(expected);
+      expect(run.effectiveModel.contextWindow).toBe(expected);
+      expect(run.effectiveModel.maxTokens).toBe(32_768);
+      expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow })).toBe(
+        expected,
+      );
+    }
+    expect(runtimeModel.contextWindow).toBe(400_000);
+  });
+
+  it("uses the same explicit budget for a selected preset", () => {
+    const { provider, runtimeModel, cfg } = fixture();
+    const contextWindow = "user-context:yd-fast:1000000";
+    expect(
+      resolveEmbeddedRuntimeModelPolicy({
+        cfg,
+        provider,
+        modelId,
+        runtimeModel,
+        nativeModelOwned: false,
+        contextWindow,
+      }).contextTokenBudget,
+    ).toBe(1_000_000);
+    expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow })).toBe(
+      1_000_000,
+    );
+    expect(
+      resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow: "yd-fast" }),
+    ).toBe(400_000);
+  });
+
+  it.each(["user-context:900000", "retired-option"])(
+    "does not raise a window for undeclared selection %s",
+    (contextWindow) => {
+      const { provider, runtimeModel, cfg } = fixture();
+      expect(
+        resolveEmbeddedRuntimeModelPolicy({
+          cfg,
+          provider,
+          modelId,
+          runtimeModel,
+          nativeModelOwned: false,
+          contextWindow,
+        }).contextTokenBudget,
+      ).toBe(400_000);
+      expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow })).toBe(
+        400_000,
+      );
+    },
+  );
+
+  it("leaves other providers capped even when they declare the same option id", () => {
+    const { provider, runtimeModel, cfg } = fixture("custom-provider");
+    expect(
+      resolveEmbeddedRuntimeModelPolicy({
+        cfg,
+        provider,
+        modelId,
+        runtimeModel,
+        nativeModelOwned: false,
+        contextWindow: selectedWindow,
+      }).contextTokenBudget,
+    ).toBe(400_000);
+    expect(
+      resolveMemoryFlushContextWindowTokens({
+        cfg,
+        provider,
+        modelId,
+        contextWindow: selectedWindow,
+      }),
+    ).toBe(400_000);
+  });
+
+  it("follows a changed default only when there is no explicit selection", () => {
+    const { provider, runtimeModel, cfg } = fixture("lobsterai-server", 500_000);
+    expect(
+      resolveEmbeddedRuntimeModelPolicy({
+        cfg,
+        provider,
+        modelId,
+        runtimeModel,
+        nativeModelOwned: false,
+      }).contextTokenBudget,
+    ).toBe(500_000);
+    expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId })).toBe(500_000);
+    expect(
+      resolveEmbeddedRuntimeModelPolicy({
+        cfg,
+        provider,
+        modelId,
+        runtimeModel,
+        nativeModelOwned: false,
+        contextWindow: selectedWindow,
+      }).contextTokenBudget,
+    ).toBe(1_000_000);
+  });
+
+  it.each(["yd-fast", "yd-ultra", "model-preset:balanced", "model-preset:ultimate"])(
+    "follows declared preset %s from 400K to 500K and resets explicit 1M to 500K",
+    (presetId) => {
+      const { provider, runtimeModel, cfg } = fixture();
+      const preset = runtimeModel.contextWindows!.find((option) => option.id === "yd-fast")!;
+      preset.id = presetId;
+      const userPreset = `user-context:${presetId}:1000000`;
+      runtimeModel.contextWindows!.push({
+        id: userPreset,
+        label: "Preset 1M",
+        contextWindow: 1_000_000,
+      });
+      const expectBudget = (contextWindow: string | undefined, expected: number) => {
+        const run = resolveEmbeddedRuntimeModelPolicy({
+          cfg,
+          provider,
+          modelId,
+          runtimeModel,
+          nativeModelOwned: false,
+          contextWindow,
+        });
+        expect(run.contextTokenBudget).toBe(expected);
+        expect(run.effectiveModel.contextWindow).toBe(expected);
+        expect(run.effectiveModel.maxTokens).toBe(32_768);
+        expect(
+          resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow }),
+        ).toBe(expected);
+      };
+      expectBudget(presetId, 400_000);
+      preset.contextWindow = 500_000;
+      expectBudget(presetId, 500_000);
+      expectBudget(undefined, 400_000);
+      expectBudget(userPreset, 1_000_000);
+      expectBudget(presetId, 500_000);
+      runtimeModel.contextWindows = runtimeModel.contextWindows!.filter(
+        (option) => option.id !== userPreset,
+      );
+      expectBudget(userPreset, 400_000);
+      expectBudget(presetId, 500_000);
+      expect(runtimeModel.contextWindow).toBe(400_000);
+      expect(runtimeModel.contextWindowDefault).toBe("model-default");
+    },
+  );
+
+  it("does not raise foreign-provider budgets for declared modern or legacy presets", () => {
+    for (const presetId of [
+      "yd-fast",
+      "yd-ultra",
+      "model-preset:balanced",
+      "model-preset:ultimate",
+    ]) {
+      const { provider, runtimeModel, cfg } = fixture("custom-provider");
+      runtimeModel.contextWindows![1] = { id: presetId, label: "Preset", contextWindow: 500_000 };
+      for (const contextWindow of [undefined, presetId]) {
+        expect(
+          resolveEmbeddedRuntimeModelPolicy({
+            cfg,
+            provider,
+            modelId,
+            runtimeModel,
+            nativeModelOwned: false,
+            contextWindow,
+          }).contextTokenBudget,
+        ).toBe(400_000);
+        expect(
+          resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow }),
+        ).toBe(400_000);
+      }
+    }
+  });
+});
