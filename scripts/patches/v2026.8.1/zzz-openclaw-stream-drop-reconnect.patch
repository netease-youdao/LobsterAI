diff --git a/src/agents/embedded-agent-runner/run.transport-drop-continuation.integration.test.ts b/src/agents/embedded-agent-runner/run.transport-drop-continuation.integration.test.ts
new file mode 100644
index 0000000..0de28f1
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run.transport-drop-continuation.integration.test.ts
@@ -0,0 +1,202 @@
+// Full-entry coverage for resuming a turn after the provider stream dropped mid-reply.
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { buildEmbeddedRunnerAssistant } from "../test-helpers/embedded-agent-runner-e2e-fixtures.js";
+import { makeAttemptResult } from "./run.overflow-compaction.fixture.js";
+import {
+  mockedRunEmbeddedAttempt,
+  resetSharedRunIntegrationHarnessMocks,
+} from "./run.overflow-compaction.harness.js";
+import {
+  createSharedRunIntegrationSession,
+  loadSharedRunIntegrationHarness,
+} from "./run.shared-integration-harness.test-support.js";
+
+vi.mock("../../utils/sleep.js", () => ({ sleep: vi.fn(async () => undefined) }));
+
+let session: Awaited<ReturnType<typeof createSharedRunIntegrationSession>>;
+let runEmbeddedAgent: Awaited<ReturnType<typeof loadSharedRunIntegrationHarness>>;
+
+// Live shape: the local token proxy aborted a mid-stream SSE body, so undici
+// reported "terminated" after the model had only streamed reasoning.
+const droppedAssistant = buildEmbeddedRunnerAssistant({
+  api: "openai-completions",
+  stopReason: "error",
+  errorMessage: "terminated",
+  content: [{ type: "thinking", thinking: "Check the remaining config files." }],
+  diagnostics: [
+    {
+      type: "provider_transport_failure",
+      timestamp: 1,
+      details: { transportErrorCode: "UND_ERR_SOCKET" },
+    },
+  ],
+});
+
+const userMessage = { role: "user", content: "fix the build" };
+const writeAssistant = buildEmbeddedRunnerAssistant({
+  stopReason: "toolUse",
+  content: [{ type: "toolCall", id: "call-write", name: "write", arguments: {} }],
+});
+
+// A write committed a side effect, then the next model call dropped.
+function makeDropAfterToolBatchAttempt() {
+  return makeAttemptResult({
+    assistantTexts: [],
+    lastAssistant: droppedAssistant,
+    currentAttemptAssistant: droppedAssistant,
+    messagesSnapshot: [
+      userMessage,
+      writeAssistant,
+      { role: "toolResult", toolCallId: "call-write", toolName: "write" },
+      droppedAssistant,
+    ] as never,
+    toolMetas: [{ toolName: "write", toolCallId: "call-write", replaySafe: false }],
+    itemLifecycle: { startedCount: 1, completedCount: 1, activeCount: 0 },
+    replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+    currentAttemptReplayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+  });
+}
+
+// The first model call of the turn dropped; nothing ran yet.
+function makeDropBeforeToolsAttempt() {
+  return makeAttemptResult({
+    assistantTexts: [],
+    lastAssistant: droppedAssistant,
+    currentAttemptAssistant: droppedAssistant,
+    messagesSnapshot: [userMessage, droppedAssistant] as never,
+  });
+}
+
+type AttemptCallParams = {
+  prompt?: string;
+  sessionId?: string;
+  suppressNextUserMessagePersistence?: boolean;
+  onUserMessagePersisted?: (message: unknown) => void;
+};
+
+function requireAttemptCall(index: number): AttemptCallParams {
+  const call = mockedRunEmbeddedAttempt.mock.calls[index];
+  if (!call) {
+    throw new Error(`expected embedded attempt call ${index}`);
+  }
+  return call[0] as AttemptCallParams;
+}
+
+// The real attempt persists the user turn before its first model call.
+function persistUserTurnThen(result: ReturnType<typeof makeAttemptResult>) {
+  return async (params: unknown) => {
+    (params as AttemptCallParams).onUserMessagePersisted?.(userMessage);
+    return result;
+  };
+}
+
+describe("runEmbeddedAgent transport-drop continuation", () => {
+  beforeAll(async () => {
+    runEmbeddedAgent = await loadSharedRunIntegrationHarness();
+  });
+
+  beforeEach(async () => {
+    resetSharedRunIntegrationHarnessMocks();
+    session = await createSharedRunIntegrationSession();
+  });
+
+  afterEach(async () => {
+    await session?.cleanup();
+  });
+
+  it("resumes from the transcript after a drop that followed a tool batch", async () => {
+    mockedRunEmbeddedAttempt
+      .mockImplementationOnce(persistUserTurnThen(makeDropAfterToolBatchAttempt()))
+      .mockResolvedValueOnce(makeAttemptResult());
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-transport-drop-after-tools",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(2);
+    const initial = requireAttemptCall(0);
+    const retry = requireAttemptCall(1);
+    expect(retry.prompt).toContain("cut off by a network error");
+    expect(retry.prompt).not.toBe(session.runParams.prompt);
+    // The continuation is model-only context, never a persisted user turn.
+    expect(retry.suppressNextUserMessagePersistence).toBe(true);
+    expect(retry.sessionId).toBe(initial.sessionId);
+    expect(result.meta.error).toBeUndefined();
+  });
+
+  it("resumes from the transcript after the first model call of the turn dropped", async () => {
+    mockedRunEmbeddedAttempt
+      .mockImplementationOnce(persistUserTurnThen(makeDropBeforeToolsAttempt()))
+      .mockResolvedValueOnce(makeAttemptResult());
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-transport-drop-before-tools",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(2);
+    const retry = requireAttemptCall(1);
+    expect(retry.prompt).toContain("cut off by a network error");
+    expect(retry.suppressNextUserMessagePersistence).toBe(true);
+    expect(result.meta.error).toBeUndefined();
+  });
+
+  it("keeps backing off when the network is still settling on the resumed call", async () => {
+    const proxyFailure = buildEmbeddedRunnerAssistant({
+      api: "openai-completions",
+      stopReason: "error",
+      errorMessage: "502 LobsterAI proxy upstream request failed: net::ERR_NETWORK_CHANGED",
+      content: [],
+    });
+    mockedRunEmbeddedAttempt
+      .mockImplementationOnce(persistUserTurnThen(makeDropAfterToolBatchAttempt()))
+      .mockResolvedValueOnce(
+        makeAttemptResult({
+          assistantTexts: [],
+          lastAssistant: proxyFailure,
+          currentAttemptAssistant: proxyFailure,
+          messagesSnapshot: [userMessage, proxyFailure] as never,
+          replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+        }),
+      )
+      .mockResolvedValueOnce(makeAttemptResult());
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-transport-drop-network-settling",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(3);
+    expect(requireAttemptCall(2).prompt).toContain("cut off by a network error");
+    expect(result.meta.error).toBeUndefined();
+  });
+
+  it("keeps resuming consecutive drops and surfaces the error once the budget is spent", async () => {
+    mockedRunEmbeddedAttempt.mockImplementationOnce(
+      persistUserTurnThen(makeDropAfterToolBatchAttempt()),
+    );
+    for (let index = 0; index < 5; index += 1) {
+      mockedRunEmbeddedAttempt.mockResolvedValueOnce(
+        makeAttemptResult({
+          assistantTexts: [],
+          lastAssistant: droppedAssistant,
+          currentAttemptAssistant: droppedAssistant,
+          messagesSnapshot: [userMessage, droppedAssistant] as never,
+          replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+        }),
+      );
+    }
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-transport-drop-exhausted",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(6);
+    expect(result.meta.error?.kind).toBe("incomplete_turn");
+    expect(result.payloads?.[0]?.text).toContain(
+      "some tool actions may have already been executed",
+    );
+  });
+});
