index 0000000..efe9fc9
--- /dev/null
+++ b/packages/ai/src/transports/transport-drop-evidence.ts
@@ -0,0 +1,117 @@
+/**
+ * LobsterAI: records silent transport drops so the embedded runner can resume
+ * the turn from its transcript instead of ending it.
+ *
+ * A stream that dies after it already delivered visible text or a tool call is
+ * not silent: resuming would duplicate or replace that output. Reasoning that
+ * streamed before the drop does not count, because errored assistant turns are
+ * dropped from replay.
+ */
+import type { AssistantMessage } from "@openclaw/llm-core";
+import {
+  appendAssistantMessageDiagnostic,
+  createAssistantMessageDiagnostic,
+} from "../utils/diagnostics.js";
+import type { ProviderErrorProjection } from "../utils/provider-error.js";
+
+export const PROVIDER_TRANSPORT_FAILURE_DIAGNOSTIC = "provider_transport_failure";
+
+// undici reports a body cut off mid-stream as TypeError("terminated") whose cause
+// is the socket error, e.g. SocketError("other side closed", UND_ERR_SOCKET).
+const UNDICI_TERMINATED_MESSAGE = "terminated";
+const UNDICI_TERMINATED_CODE = "UND_ERR_TERMINATED";
+const MAX_CAUSE_DEPTH = 6;
+
+const TRANSIENT_TRANSPORT_CODES = new Set([
+  "ECONNRESET",
+  "ECONNREFUSED",
+  "ECONNABORTED",
+  "EPIPE",
+  "ETIMEDOUT",
+  "ENETDOWN",
+  "ENETUNREACH",
+  "EHOSTUNREACH",
+  "EAI_AGAIN",
+  "UND_ERR_SOCKET",
+  "UND_ERR_BODY_TIMEOUT",
+  "UND_ERR_HEADERS_TIMEOUT",
+  "UND_ERR_CONNECT",
+  "UND_ERR_CONNECT_TIMEOUT",
+  "ERR_HTTP2_INVALID_SESSION",
+  "ERR_HTTP2_STREAM_ERROR",
+  "ERR_HTTP2_SESSION_ERROR",
+]);
+
+const TRANSIENT_TRANSPORT_MESSAGES = ["other side closed", "socket hang up"];
+
+function readString(value: unknown): string | undefined {
+  return typeof value === "string" && value.trim() ? value.trim() : undefined;
+}
+
+/** Returns the transient transport code found on the error or its causes, if any. */
+export function readTransientTransportErrorCode(error: unknown): string | undefined {
+  const seen = new Set<unknown>();
+  let terminated = false;
+  let current: unknown = error;
+  for (let depth = 0; depth < MAX_CAUSE_DEPTH; depth += 1) {
+    if (!current || typeof current !== "object" || seen.has(current)) {
+      break;
+    }
+    seen.add(current);
+    const record = current as { code?: unknown; message?: unknown; name?: unknown; cause?: unknown };
+    const code = readString(record.code)?.toUpperCase();
+    if (code && TRANSIENT_TRANSPORT_CODES.has(code)) {
+      return code;
+    }
+    const message = readString(record.message)?.toLowerCase();
+    if (message === UNDICI_TERMINATED_MESSAGE && record.name === "TypeError") {
+      terminated = true;
+    } else if (message && TRANSIENT_TRANSPORT_MESSAGES.some((snippet) => message.includes(snippet))) {
+      return "UND_ERR_SOCKET";
+    }
+    current = record.cause;
+  }
+  return terminated ? UNDICI_TERMINATED_CODE : undefined;
+}
+
+/** True when the assistant already delivered text, a tool call, or other non-reasoning content. */
+function hasDeliveredContent(output: AssistantMessage): boolean {
+  const content = Array.isArray(output.content) ? output.content : [];
+  return content.some((block) => {
+    const record = block as { type?: unknown; text?: unknown };
+    if (record.type === "thinking" || record.type === "redacted_thinking") {
+      return false;
+    }
+    return !(record.type === "text" && typeof record.text === "string" && !record.text.trim());
+  });
+}
+
+/** Appends a transport-failure diagnostic when a transient drop left no delivered output. */
+export function recordSilentTransportDrop(
+  output: AssistantMessage,
+  error: unknown,
+  projection: ProviderErrorProjection,
+): void {
+  if (
+    projection.stopReason !== "error" ||
+    hasDeliveredContent(output) ||
+    output.diagnostics?.some((diagnostic) => diagnostic.type === PROVIDER_TRANSPORT_FAILURE_DIAGNOSTIC)
+  ) {
+    return;
+  }
+  const transportErrorCode = readTransientTransportErrorCode(error);
+  if (!transportErrorCode) {
+    return;
+  }
+  const eventsEmitted = Array.isArray(output.content) && output.content.length > 0;
+  // Reuse the bounded, redacted terminal message so the diagnostic cannot expose
+  // the original throw (stack, headers, request body).
+  appendAssistantMessageDiagnostic(
+    output,
+    createAssistantMessageDiagnostic(PROVIDER_TRANSPORT_FAILURE_DIAGNOSTIC, projection.errorMessage, {
+      eventsEmitted,
+      phase: eventsEmitted ? "after_message_stream_start" : "before_message_stream_start",
+      transportErrorCode,
+    }),
+  );
+}
diff --git a/packages/ai/src/transports/transport-drop-evidence.test.ts b/packages/ai/src/transports/transport-drop-evidence.test.ts
new file mode 100644
index 0000000..86d7b5b
--- /dev/null
+++ b/packages/ai/src/transports/transport-drop-evidence.test.ts
@@ -0,0 +1,145 @@
+import type { AssistantMessage } from "@openclaw/llm-core";
+import { describe, expect, it } from "vitest";
+import {
+  PROVIDER_TRANSPORT_FAILURE_DIAGNOSTIC,
+  readTransientTransportErrorCode,
+} from "./transport-drop-evidence.js";
+import { assignTransportErrorDetails } from "./transport-stream-shared.js";
+
+// undici shape when the peer closes the socket mid-body.
+function undiciTerminatedError(): Error {
+  const socketError = Object.assign(new Error("other side closed"), {
+    name: "SocketError",
+    code: "UND_ERR_SOCKET",
+  });
+  return new TypeError("terminated", { cause: socketError });
+}
+
+function makeOutput(content: AssistantMessage["content"]): AssistantMessage {
+  return {
+    role: "assistant",
+    api: "openai-completions",
+    provider: "lobsterai-server",
+    model: "deepseek-flash",
+    content,
+    usage: {
+      input: 0,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 0,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: "error",
+    timestamp: 1,
+  } as AssistantMessage;
+}
+
+function transportDiagnostics(output: AssistantMessage) {
+  return (output.diagnostics ?? []).filter(
+    (diagnostic) => diagnostic.type === PROVIDER_TRANSPORT_FAILURE_DIAGNOSTIC,
+  );
+}
+
+describe("readTransientTransportErrorCode", () => {
+  it("prefers the socket code under an undici terminated error", () => {
+    expect(readTransientTransportErrorCode(undiciTerminatedError())).toBe("UND_ERR_SOCKET");
+  });
+
+  it("recognizes a bare undici terminated error", () => {
+    expect(readTransientTransportErrorCode(new TypeError("terminated"))).toBe("UND_ERR_TERMINATED");
+  });
+
+  it("recognizes reset codes on the error itself", () => {
+    expect(
+      readTransientTransportErrorCode(Object.assign(new Error("read"), { code: "ECONNRESET" })),
+    ).toBe("ECONNRESET");
+  });
+
+  it.each([
+    ["an HTTP error", Object.assign(new Error("400 bad request"), { status: 400 })],
+    ["an abort", Object.assign(new Error("Request was aborted"), { name: "AbortError" })],
+    ["a plain terminated message", new Error("terminated")],
+    ["a non-error value", "terminated"],
+  ])("ignores %s", (_label, error) => {
+    expect(readTransientTransportErrorCode(error)).toBeUndefined();
+  });
+
+  it("stops on cyclic causes", () => {
+    const error = new Error("loop") as Error & { cause?: unknown };
+    error.cause = error;
+    expect(readTransientTransportErrorCode(error)).toBeUndefined();
+  });
+});
+
+describe("assignTransportErrorDetails transport drops", () => {
+  it("records a drop that only streamed reasoning", () => {
+    const output = makeOutput([
+      { type: "thinking", thinking: "check the config", thinkingSignature: "reasoning_content" },
+    ]);
+
+    assignTransportErrorDetails(output, undiciTerminatedError());
+
+    expect(output.errorMessage).toBe("terminated");
+    expect(transportDiagnostics(output)).toEqual([
+      expect.objectContaining({
+        error: expect.objectContaining({ message: "terminated" }),
+        details: {
+          eventsEmitted: true,
+          phase: "after_message_stream_start",
+          transportErrorCode: "UND_ERR_SOCKET",
+        },
+      }),
+    ]);
+  });
+
+  it("records a drop before any content", () => {
+    const output = makeOutput([]);
+
+    assignTransportErrorDetails(output, undiciTerminatedError());
+
+    expect(transportDiagnostics(output)[0]?.details).toMatchObject({
+      eventsEmitted: false,
+      phase: "before_message_stream_start",
+    });
+  });
+
+  it.each([
+    ["visible text", [{ type: "text", text: "Partial answer" }]],
+    ["a tool call", [{ type: "toolCall", id: "call_1", name: "read", arguments: {} }]],
+  ] as const)("does not record a drop after %s", (_label, content) => {
+    const output = makeOutput([...content] as AssistantMessage["content"]);
+
+    assignTransportErrorDetails(output, undiciTerminatedError());
+
+    expect(transportDiagnostics(output)).toEqual([]);
+  });
+
+  it("does not record non-transient failures", () => {
+    const output = makeOutput([]);
+
+    assignTransportErrorDetails(output, new Error("500 internal error"));
+
+    expect(transportDiagnostics(output)).toEqual([]);
+  });
+
+  it("does not record an aborted request", () => {
+    const controller = new AbortController();
+    controller.abort();
+    const output = makeOutput([]);
+
+    assignTransportErrorDetails(output, undiciTerminatedError(), controller.signal);
+
+    expect(output.stopReason).toBe("aborted");
+    expect(transportDiagnostics(output)).toEqual([]);
+  });
+
+  it("records the drop once", () => {
+    const output = makeOutput([]);
+
+    assignTransportErrorDetails(output, undiciTerminatedError());
+    assignTransportErrorDetails(output, undiciTerminatedError());
+
+    expect(transportDiagnostics(output)).toHaveLength(1);
+  });
+});
