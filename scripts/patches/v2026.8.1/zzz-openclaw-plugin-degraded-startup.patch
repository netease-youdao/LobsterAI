+import { formatErrorMessage } from "../infra/errors.js";
+import { describePluginAvailabilityFailure } from "../plugins/runtime-degraded-state.js";
+import { HealthCheckRegistrationError } from "./health-check-registry.js";
+import type { HealthCheck, HealthFinding } from "./health-checks.js";
+
+const PLUGIN_AVAILABILITY_CHECK_ID = "core/doctor/plugin-availability";
+
+/** Registration failures are availability findings; registered checks still own data errors. */
+export function collectPluginHealthAvailability(
+  findings: HealthFinding[],
+  pluginId: string,
+  register: () => void,
+): void {
+  try {
+    register();
+  } catch (error) {
+    if (error instanceof HealthCheckRegistrationError) {
+      throw error;
+    }
+    findings.push({
+      checkId: PLUGIN_AVAILABILITY_CHECK_ID,
+      ...describePluginAvailabilityFailure(pluginId, formatErrorMessage(error)),
+    });
+  }
+}
+
+export function pluginAvailabilityHealthChecks(findings: readonly HealthFinding[]): HealthCheck[] {
+  return findings.length === 0
+    ? []
+    : [
+        {
+          id: PLUGIN_AVAILABILITY_CHECK_ID,
+          kind: "core",
+          source: "doctor",
+          description: "Configured plugin Doctor APIs are available.",
+          detect: async () => findings,
+        },
+      ];
+}
