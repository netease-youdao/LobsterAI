+import { cloneConfigWithResolutionFacts } from "../config/resolution-facts.js";
+import type { OpenClawConfig } from "../config/types.js";
+import { formatErrorMessage } from "../infra/errors.js";
+import { createSubsystemLogger } from "../logging/subsystem.js";
+import type { PluginDoctorCompatibilityNormalizer } from "./doctor-contract-module.js";
+
+const log = createSubsystemLogger("plugins/doctor-contracts");
+
+/** Pure config hooks own a private candidate; state-writing migration refusals stay separate. */
+export function applyPluginDoctorCompatibilityMigration(params: {
+  pluginId: string;
+  config: OpenClawConfig;
+  normalize: PluginDoctorCompatibilityNormalizer;
+}): { config: OpenClawConfig; changes: string[]; warnings?: string[] } {
+  const candidate = cloneConfigWithResolutionFacts(params.config);
+  try {
+    const mutation = params.normalize({ cfg: candidate });
+    return mutation?.changes.length ? mutation : { config: params.config, changes: [] };
+  } catch (error) {
+    const warning = `Plugin "${params.pluginId}" config repair failed: ${formatErrorMessage(error)}. Its config was preserved; run \`openclaw doctor --fix\` after repairing the plugin.`;
+    // v8.1 legacy preview callers do not all carry a warnings collection.
+    log.warn(warning);
+    return { config: params.config, changes: [], warnings: [warning] };
+  }
+}
