+
+// Predefined HKEYs are sign-extended 32-bit handles, so pass them as intptr_t.
+const NATIVE_REGISTRY_ROOTS: Readonly<Record<string, number>> = {
+  HKLM: 0x8000_0002 | 0,
+  HKEY_LOCAL_MACHINE: 0x8000_0002 | 0,
+  HKCU: 0x8000_0001 | 0,
+  HKEY_CURRENT_USER: 0x8000_0001 | 0,
+};
