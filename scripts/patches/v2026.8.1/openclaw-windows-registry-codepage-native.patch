+const RRF_RT_REG_SZ = 0x2;
+const RRF_RT_REG_EXPAND_SZ = 0x4;
+const RRF_RT_REG_DWORD = 0x10;
+const RRF_SUBKEY_WOW6464KEY = 0x1_0000;
+const RRF_NOEXPAND = 0x1000_0000;
+const ERROR_FILE_NOT_FOUND = 2;
+const ERROR_MORE_DATA = 234;
+
