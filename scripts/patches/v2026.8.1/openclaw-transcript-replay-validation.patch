@@ -0,0 +1,183 @@
+import type { Message } from "./types.js";
+
+export const ReplayField = {
+  Content: "content",
+  Block: "block",
+  Text: "text",
+  Thinking: "thinking",
+  Id: "id",
+  ToolCallId: "toolCallId",
+} as const;
+
+export type ReplayValidationIssue = {
+  messageIndex: number;
+  blockIndex?: number;
+  timestamp?: number;
+  field: (typeof ReplayField)[keyof typeof ReplayField];
+  action: "drop-block" | "drop-content" | "drop-message" | "drop-owned-result";
+};
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function isNonBlankString(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function invalidBlockField(
+  block: unknown,
+  assistant: boolean,
+): ReplayValidationIssue["field"] | undefined {
+  if (!isRecord(block)) {
+    return ReplayField.Block;
+  }
+  if (block.type === "text" && typeof block.text !== "string") {
+    return ReplayField.Text;
+  }
+  if (assistant && block.type === "thinking" && typeof block.thinking !== "string") {
+    return ReplayField.Thinking;
+  }
+  if (assistant && block.type === "toolCall" && !isNonBlankString(block.id)) {
+    return ReplayField.Id;
+  }
+  // Opaque provider blocks are not tool calls. Leave their interpretation to the transport.
+  return undefined;
+}
+
+/** Validate persisted replay data without mutating the transcript or inventing tool identities. */
+export function sanitizeReplayMessages(
+  messages: Message[],
+  reportIssue: (issue: ReplayValidationIssue) => void,
+  options?: { preserveLegacyToolResults?: boolean },
+): Message[] {
+  const result: Message[] = [];
+  let rejectedCallIds = new Set<string>();
+  let malformedFrame = false;
+  for (const [messageIndex, message] of messages.entries()) {
+    const report = (
+      field: ReplayValidationIssue["field"],
+      action: ReplayValidationIssue["action"],
+      blockIndex?: number,
+    ) =>
+      reportIssue({
+        messageIndex,
+        ...(blockIndex === undefined ? {} : { blockIndex }),
+        ...(typeof message.timestamp === "number" && Number.isFinite(message.timestamp)
+          ? { timestamp: message.timestamp }
+          : {}),
+        field,
+        action,
+      });
+    if (message.role === "toolResult") {
+      const validId = isNonBlankString(message.toolCallId);
+      if (!validId && !options?.preserveLegacyToolResults) {
+        report(ReplayField.ToolCallId, "drop-message");
+        continue;
+      }
+      if (validId && rejectedCallIds.has(message.toolCallId.trim())) {
+        if (malformedFrame) {
+          report(ReplayField.ToolCallId, "drop-owned-result");
+        }
+        continue;
+      }
+    } else {
+      // IDs may be reused in a later turn. Rejection is local to the adjacent result frame.
+      rejectedCallIds = new Set();
+      malformedFrame = false;
+    }
+    if (message.role !== "assistant" && message.role !== "toolResult") {
+      result.push(message);
+      continue;
+    }
+    const assistant = message.role === "assistant";
+    const source: unknown = message.content;
+    const blocks: unknown[] = Array.isArray(source)
+      ? source
+      : typeof source === "string"
+        ? [{ type: "text", text: source }]
+        : isRecord(source)
+          ? [source]
+          : [];
+    if (
+      source != null &&
+      typeof source !== "string" &&
+      !Array.isArray(source) &&
+      !isRecord(source)
+    ) {
+      report(ReplayField.Content, "drop-content");
+    }
+    const content = blocks.filter((block, blockIndex) => {
+      const field = invalidBlockField(block, assistant);
+      if (!field) {
+        return true;
+      }
+      report(field, "drop-block", blockIndex);
+      malformedFrame = true;
+      return false;
+    });
+    if (assistant) {
+      const signed = blocks.some(
+        (block) =>
+          isRecord(block) &&
+          ((block.type === "thinking" && (block.thinkingSignature || block.redacted)) ||
+            (block.type === "toolCall" && block.thoughtSignature)),
+      );
+      const unsafeSignedTurn = signed && content.length !== blocks.length;
+      const failed =
+        unsafeSignedTurn || message.stopReason === "error" || message.stopReason === "aborted";
+      for (const block of failed ? blocks : content) {
+        if (isRecord(block) && block.type === "toolCall" && isNonBlankString(block.id)) {
+          if (failed) {
+            rejectedCallIds.add(block.id.trim());
+          } else {
+            rejectedCallIds.delete(block.id.trim());
+          }
+        }
+      }
+      if (unsafeSignedTurn) {
+        report(ReplayField.Content, "drop-message");
+        // Keep a failed frame for pairing ownership, but never replay an edited signed span.
+        result.push({
+          ...message,
+          content: content as typeof message.content,
+          stopReason: "error",
+        });
+        continue;
+      }
+    }
+    if (source === blocks && content.length === blocks.length) {
+      result.push(message);
+    } else if (message.role === "assistant") {
+      result.push({ ...message, content: content as typeof message.content });
+    } else {
+      result.push({ ...message, content: content as typeof message.content });
+    }
+  }
+  return result;
+}
+
+/** Log only bounded structural locations, never content, tool arguments, or signatures. */
+export function prepareReplayMessages(
+  messages: Message[],
+  options?: { preserveLegacyToolResults?: boolean },
+): Message[] {
+  const locations: ReplayValidationIssue[] = [];
+  let issueCount = 0;
+  const result = sanitizeReplayMessages(
+    messages,
+    (issue) => {
+      issueCount += 1;
+      if (locations.length < 8) {
+        locations.push(issue);
+      }
+    },
+    options,
+  );
+  if (issueCount > 0) {
+    console.warn(
+      `[transcript-replay] Invalid historical fields omitted: ${JSON.stringify({ issueCount, locations })}`,
+    );
+  }
+  return result;
+}
