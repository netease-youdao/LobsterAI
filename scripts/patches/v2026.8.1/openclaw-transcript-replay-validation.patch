+import { describe, expect, it } from "vitest";
+import type { Api, Context, Model } from "../llm/types.js";
+import { transformTransportMessages } from "./transport-message-transform.js";
+
+function makeModel(api: Api, provider: string, id: string): Model {
+  return {
+    api,
+    provider,
+    id,
+    name: id,
+    baseUrl: "https://example.invalid/v1",
+    input: ["text"],
+    reasoning: false,
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    contextWindow: 128000,
+    maxTokens: 4096,
+  };
+}
+
+describe("configured transport replay validation", () => {
+  it.each(["openai-completions", "openai-responses", "anthropic-messages"] as const)(
+    "validates historical blocks before %s field conversion",
+    (api) => {
+      const model = makeModel(api, "custom", "replay-test");
+      const messages = [
+        {
+          role: "assistant",
+          api,
+          provider: "custom",
+          model: model.id,
+          stopReason: "toolUse",
+          timestamp: 42,
+          content: [
+            null,
+            { type: "text" },
+            { type: "thinking", thinking: 7 },
+            { type: "toolCall", name: "read", arguments: {} },
+            { type: "text", text: "retained" },
+            { type: "toolCall", id: "good", name: "read", arguments: { path: "test.txt" } },
+          ],
+        },
+        {
+          role: "toolResult",
+          toolCallId: "good",
+          toolName: "read",
+          timestamp: 43,
+          content: [{ type: "text", text: "real result" }],
+          isError: false,
+        },
+      ] as Context["messages"];
+      const snapshot = structuredClone(messages);
+      const output = transformTransportMessages(messages, model, (id) => id.trim());
+      expect(output).toHaveLength(2);
+      expect(output[0].content).toEqual([
+        { type: "text", text: "retained" },
+        { type: "toolCall", id: "good", name: "read", arguments: { path: "test.txt" } },
+      ]);
+      expect(output[1]).toEqual(messages[1]);
+      expect(messages).toEqual(snapshot);
+      expect(transformTransportMessages(output, model)).toEqual(output);
+    },
+  );
+
+  it("keeps failed frames from stealing a reused tool id", () => {
+    const model = makeModel("openai-responses", "custom", "replay-test");
+    const assistant = (stopReason: string, malformed = false) => ({
+      role: "assistant",
+      api: model.api,
+      provider: model.provider,
+      model: model.id,
+      stopReason,
+      timestamp: 42,
+      content: [
+        ...(malformed ? [{ type: "thinking", thinking: 7 }] : []),
+        { type: "toolCall", id: "reused", name: "read", arguments: {} },
+      ],
+    });
+    const result = {
+      role: "toolResult",
+      toolCallId: "reused",
+      toolName: "read",
+      timestamp: 43,
+      content: [{ type: "text", text: "failed turn output" }],
+      isError: false,
+    };
+    const input = [
+      assistant("toolUse"),
+      assistant("error", true),
+      result,
+      { role: "user", content: "continue", timestamp: 44 },
+      assistant("toolUse"),
+      { ...result, content: [{ type: "text", text: "last result" }] },
+    ];
+    const output = transformTransportMessages(input as Context["messages"], model);
+    expect(
+      output.filter((message) => message.role === "toolResult").map((message) => message.content),
+    ).toEqual([[{ type: "text", text: "aborted" }], [{ type: "text", text: "last result" }]]);
+  });
+
+  it("preserves a displaced result owned by an earlier successful frame", () => {
+    const model = makeModel("openai-responses", "custom", "replay-test");
+    const assistant = (id: string, stopReason: string) => ({
+      role: "assistant",
+      api: model.api,
+      provider: model.provider,
+      model: model.id,
+      stopReason,
+      timestamp: 42,
+      content: [{ type: "toolCall", id, name: "read", arguments: {} }],
+    });
+    const result = (toolCallId: string) => ({
+      role: "toolResult",
+      toolCallId,
+      toolName: "read",
+      timestamp: 43,
+      content: [{ type: "text", text: "real result" }],
+      isError: false,
+    });
+    const output = transformTransportMessages(
+      [
+        assistant("early", "toolUse"),
+        assistant("failed", "error"),
+        result("early"),
+        result("failed"),
+      ] as Context["messages"],
+      model,
+    );
+    expect(output).toEqual([assistant("early", "toolUse"), result("early")]);
+  });
