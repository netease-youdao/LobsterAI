+import path from "node:path";
+import type { Context, Model } from "openclaw/plugin-sdk/llm";
+import { afterEach, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import { upsertSessionEntryCore } from "../../config/sessions/session-accessor.js";
+import { buildLobsterAiSessionSnapshotMessage } from "../lobsterai-session-snapshot.js";
+import { guardSessionManager } from "../session-tool-result-guard-wrapper.js";
+import {
+  createAssistant,
+  createAssistantResultStream,
+  createTestSession,
+  registerAgentSessionLoopTestLifecycle,
+  streamMocks,
+} from "./agent-session-loop-correctness.test-support.js";
+import { SessionManager } from "./session-manager.js";
+
+registerAgentSessionLoopTestLifecycle();
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+const canonical = {
+  role: "user" as const,
+  content: "original request with frozen local time",
+  idempotencyKey: "retry:user",
+  timestamp: 1,
+};
+const snapshot = buildLobsterAiSessionSnapshotMessage({
+  sessionKey: "agent:main:lobsterai:retry",
+  sessionId: "retry",
+})!;
+
+it.each(["steer", "followUp"] as const)(
+  "persists %s after retry without duplicating or rewriting the original user or snapshot",
+  async (queueMethod) => {
+    const dir = tempDirs.make("lobster-cache-retry-");
+    const scope = {
+      agentId: "main",
+      sessionId: "retry",
+      sessionKey: "agent:main:lobsterai:retry",
+      storePath: path.join(dir, "sessions.json"),
+    };
+    await upsertSessionEntryCore(scope, { sessionId: scope.sessionId, updatedAt: 1 });
+    const manager = SessionManager.open(scope, dir);
+    manager.appendMessage(canonical);
+    manager.appendCustomMessageEntry(snapshot.customType, snapshot.content, snapshot.display);
+    const originalEntries = structuredClone(manager.getEntries());
+    const preparing = vi.fn();
+    const suppressed = vi.fn();
+    const guarded = guardSessionManager(manager, {
+      preparedUserTurnMessage: canonical,
+      suppressNextUserMessagePersistence: true,
+      onUserMessagePreparingForPersistence: preparing,
+      onUserMessagePersistenceSuppressed: suppressed,
+    });
+    const { session } = await createTestSession({ sessionManager: manager });
+    let calls = 0;
+    let queued: Promise<void> | undefined;
+    const contexts: Context[] = [];
+    streamMocks.streamSimple.mockImplementation((model: Model, context: Context) => {
+      contexts.push(structuredClone(context));
+      if (++calls === 1) {
+        queued = session[queueMethod]("new correction after retry");
+      }
+      return createAssistantResultStream(createAssistant(model, [{ type: "text", text: "ok" }]));
+    });
+    await session.prompt(canonical.content, {
+      persistedUserIdempotencyKey: canonical.idempotencyKey,
+      persistentRuntimeContext: snapshot,
+      acknowledgePersistedUserReplay: guarded.acknowledgeReplayedUserMessage,
+    });
+    await queued;
+    expect(calls).toBe(2);
+    expect(suppressed).toHaveBeenCalledExactlyOnceWith(
+      expect.objectContaining(canonical),
+      expect.objectContaining(canonical),
+    );
+    expect(preparing).toHaveBeenCalled();
+    const restored = SessionManager.open(scope, dir);
+    const entries = restored.getEntries();
+    for (const old of originalEntries) {
+      expect(entries.find((entry) => entry.id === old.id)).toEqual(old);
+    }
+    const users = entries.flatMap((entry) =>
+      entry.type === "message" && entry.message.role === "user" ? [entry.message] : [],
+    );
+    expect(users).toHaveLength(2);
+    expect(users[0]).toEqual(canonical);
+    expect(JSON.stringify(users[1].content)).toContain("new correction after retry");
+    expect(users[1]).not.toHaveProperty("idempotencyKey", canonical.idempotencyKey);
+    expect(
+      entries.filter(
+        (entry) => entry.type === "custom_message" && entry.customType === snapshot.customType,
+      ),
+    ).toHaveLength(1);
+    const first = contexts[0].messages.filter((message) => message.role === "user");
+    expect(JSON.stringify(first).split(canonical.content)).toHaveLength(2);
+    expect(JSON.stringify(contexts[1])).toContain("new correction after retry");
+    // A subsequent ordinary turn also persists; the pending prepared user was consumed.
+    await session.prompt("ordinary next turn", { persistentRuntimeContext: snapshot });
+    const after = SessionManager.open(scope, dir).buildSessionContext().messages;
+    expect(after.filter((message) => message.role === "user")).toHaveLength(3);
+    for (const old of originalEntries) {
+      expect(manager.getEntries().find((entry) => entry.id === old.id)).toEqual(old);
+    }
+  },
+);
+
+it("only acknowledges the exact pending user once without modifying history", async () => {
+  const manager = SessionManager.inMemory();
+  manager.appendMessage(canonical);
+  const old = structuredClone(manager.getEntries());
+  const suppressed = vi.fn();
+  const guarded = guardSessionManager(manager, {
+    preparedUserTurnMessage: canonical,
+    suppressNextUserMessagePersistence: true,
+    onUserMessagePersistenceSuppressed: suppressed,
