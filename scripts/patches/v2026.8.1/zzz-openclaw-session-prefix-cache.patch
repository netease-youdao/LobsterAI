+      agentDir: "/tmp/openclaw-cache-test",
+      sessionKey,
+      sessionId,
+      provider: "lobsterai-server",
+      modelId: "deepseek-flash",
+      model: { api: "openai-completions" },
+      promptMode,
+    } as Params["attempt"],
+    activeContextEngine: undefined,
+    bootstrap: {
+      ...buildBootstrapBudgetState({ files: [] }),
+      bootstrapMode: "full",
+      contextFiles: [],
+      bootstrapInjectionStats: [],
+      workspaceNotes: [],
+      shouldRecordCompletedBootstrapTurn: false,
+    },
+    capabilityToolNames: new Set(),
+    effectiveCwd: "/tmp/openclaw-cache-test",
+    effectiveWorkspace: "/tmp/openclaw-cache-test",
+    effectiveTools: [],
+    getProviderRuntimeHandle: () => undefined as never,
+    isRawModelRun: false,
+    markStage: () => {},
+    modelToolsEnabled: true,
+    proactiveSubagentOrchestration: false,
+    sandboxSessionKey: sessionKey,
+    sessionAgentId: "main",
+    skillsPrompt: "",
+    toolSearchRuntimeConfig: {},
+  });
+}
+
+describe("LobsterAI session cache prompt identity", () => {
+  it("preserves prepared memory ownership while keeping task identity out of system text", async () => {
+    const prepareMemory = vi.fn(async (_context: MemoryPromptSectionParams) => [
+      "## Prepared memory",
+      "Memory guidance stays available.",
+    ]);
+    registerMemoryPromptPreparation("cache-test-memory", prepareMemory);
+    const first = await prepare("agent:main:lobsterai:task-a", "session-a");
+    const second = await prepare("agent:main:lobsterai:task-b", "session-b");
+
+    expect(prepareMemory.mock.calls.map(([context]) => context.agentSessionKey)).toEqual([
+      "agent:main:lobsterai:task-a",
+      "agent:main:lobsterai:task-b",
+    ]);
+    expect(first.runtimeInfo.sessionKey).toBe("agent:main:lobsterai:task-a");
+    expect(first.runtimeInfo.sessionId).toBe("session-a");
+    expect(first.sessionIdentitySnapshot).toMatchObject({
+      sessionKey: first.runtimeInfo.sessionKey,
+      sessionId: "session-a",
+    });
+    expect(first.systemPromptText).toContain("Memory guidance stays available.");
+    expect(first.systemPromptText).not.toContain("task-a");
+    expect(first.systemPromptText).not.toContain("session-a");
+    expect(first.systemPromptText).toBe(second.systemPromptText);
+  });
+
+  it.each([
+    ["agent:main:telegram:direct:123", "full"],
+    ["agent:main:lobsterai:task-a", "minimal"],
+  ] as const)("preserves existing runtime rendering for %s (%s)", async (key, mode) => {
+    const result = await prepare(key, "session-a", mode);
+    expect(result.sessionIdentitySnapshot).toBeUndefined();
+    expect(result.systemPromptText).toContain(`session=${key}`);
+    expect(result.systemPromptText).toContain("sessionId=session-a");
+  });
+
+  it("continues to reject prepared memory belonging to another session", async () => {
+    const preparedMemoryPrompt = await prepareAgentMemoryPrompt({
+      enabled: true,
+      toolNames: [],
+      agentId: "main",
+      agentSessionKey: "agent:main:lobsterai:task-a",
+    });
+    expect(() =>
+      buildEmbeddedSystemPrompt({
+        workspaceDir: "/tmp/openclaw-cache-test",
+        reasoningTagHint: false,
+        runtimeInfo: {
+          agentId: "main",
+          sessionKey: "agent:main:lobsterai:task-b",
+          host: "test",
+          os: "darwin",
+          arch: "arm64",
+          node: "24",
+          model: "test",
+        },
+        tools: [],
+        userTimezone: "UTC",
+        userDate: "",
+        preparedMemoryPrompt,
+        omitRuntimeSessionIdentity: true,
+      }),
+    ).toThrow("prepared memory prompt section does not match the current run");
+  });
+});
