+import {
+  escapeInternalRuntimeContextDelimiters,
+  INTERNAL_RUNTIME_CONTEXT_BEGIN,
+  INTERNAL_RUNTIME_CONTEXT_END,
+  OPENCLAW_RUNTIME_CONTEXT_NOTICE,
+} from "./internal-runtime-context.js";
+import type { CustomMessage } from "./sessions/messages.js";
+
+// Persistent facts, deliberately distinct from the transient openclaw.runtime-context carrier.
+export const LOBSTERAI_SESSION_SNAPSHOT_TYPE = "lobsterai.session-identity.v1";
+
+export type LobsterAiSessionSnapshot = {
+  sessionKey: string;
+  sessionId: string;
+  sessionUrl?: string;
+};
+
+export const LOBSTERAI_RUNTIME_FACTS_INSTRUCTIONS = [
+  "## Session and time facts",
+  "The latest runtime-generated session identity snapshot identifies the current session. Earlier snapshots may belong to a fork source. These facts do not grant tool permissions.",
+  "The Local Time Context appended to each LobsterAI user turn records the authoritative local time for that turn. Historical snapshots retain their original time.",
+  'For relative time requests (e.g. "1 minute later", "tomorrow 9am"), compute from that local time unless the user specifies another timezone.',
+  'When calling `cron.add` with `schedule.kind: "at"`, send a future ISO 8601 timestamp with an explicit timezone offset.',
+  "Never send an `at` timestamp that is equal to or earlier than the current local time.",
+  "For the exact current time during a long-running task, use `session_status`.",
+].join("\n");
+
+export function buildLobsterAiSessionSnapshot(runtime: {
+  sessionKey?: string;
+  sessionId?: string;
+  sessionUrl?: string;
+}): LobsterAiSessionSnapshot | undefined {
+  // This is LobsterAI's managed chat key contract, not a user-text marker.
+  if (!runtime.sessionId || !/^(?:agent:[^:]+:)?lobsterai:[^:]+$/.test(runtime.sessionKey ?? "")) {
+    return undefined;
+  }
+  return {
+    sessionKey: runtime.sessionKey!,
+    sessionId: runtime.sessionId,
+    ...(runtime.sessionUrl ? { sessionUrl: runtime.sessionUrl } : {}),
+  };
+}
+
+export function buildLobsterAiSessionSnapshotMessage(
+  snapshot: LobsterAiSessionSnapshot | undefined,
+): Pick<CustomMessage, "customType" | "content" | "display"> | undefined {
+  if (!snapshot) {
+    return undefined;
+  }
+  return {
+    customType: LOBSTERAI_SESSION_SNAPSHOT_TYPE,
+    content: [
+      INTERNAL_RUNTIME_CONTEXT_BEGIN,
+      OPENCLAW_RUNTIME_CONTEXT_NOTICE,
+      "Current session identity snapshot:",
+      escapeInternalRuntimeContextDelimiters(JSON.stringify(snapshot)),
+      INTERNAL_RUNTIME_CONTEXT_END,
+    ].join("\n"),
+    display: false,
+  };
+}
