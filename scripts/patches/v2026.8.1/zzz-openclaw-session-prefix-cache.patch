+afterEach(() => clearMemoryPluginState());
+
+function prepare(sessionKey: string, sessionId: string, promptMode: "full" | "minimal" = "full") {
+  type Params = Parameters<typeof prepareEmbeddedAttemptSystemPrompt>[0];
+  return prepareEmbeddedAttemptSystemPrompt({
+    attempt: {
