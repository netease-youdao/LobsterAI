@@ -0,0 +1,206 @@
+// Reads the Windows process table through kernel32 so Chrome MCP ownership checks need no PowerShell.
+import { createRequire } from "node:module";
+import type { ChromeMcpProcessSnapshot } from "./chrome-mcp-contracts.js";
+
+const require = createRequire(import.meta.url);
+
+/** One Toolhelp row plus the birth identity its process handle reported, when it could be opened. */
+export type ChromeMcpWindowsProcessEntry = {
+  pid: number;
+  ppid: number;
+  /** FILETIME ticks; absent when the process could not be opened or has already exited. */
+  createdTicks?: bigint;
+  imagePath?: string;
+};
+
+export type ChromeMcpWindowsProcessTableReader = () => ChromeMcpWindowsProcessEntry[];
+
+const TH32CS_SNAPPROCESS = 0x2;
+const INVALID_HANDLE_VALUE = -1;
+const ERROR_NO_MORE_FILES = 18;
+const PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
+const MAX_PATH = 260;
+const IMAGE_PATH_MAX_CHARS = 32_768;
+
+let nativeReader: ChromeMcpWindowsProcessTableReader | null | undefined;
+let nativeReaderProven = false;
+
+function loadNativeProcessTableReader(): ChromeMcpWindowsProcessTableReader | null {
+  if (process.platform !== "win32") {
+    return null;
+  }
+  try {
+    const koffi: typeof import("koffi").default = require("koffi");
+    const kernel32 = koffi.load("kernel32.dll");
+    const processEntry = koffi.struct({
+      dwSize: "uint32_t",
+      cntUsage: "uint32_t",
+      th32ProcessID: "uint32_t",
+      th32DefaultHeapID: "uintptr_t",
+      th32ModuleID: "uint32_t",
+      cntThreads: "uint32_t",
+      th32ParentProcessID: "uint32_t",
+      pcPriClassBase: "int32_t",
+      dwFlags: "uint32_t",
+      szExeFile: koffi.array("uint16_t", MAX_PATH),
+    });
+    const entrySize = koffi.sizeof(processEntry);
+    const fileTime = koffi.struct({ low: "uint32_t", high: "uint32_t" });
+    const getLastError = kernel32.func("uint32_t __stdcall GetLastError()");
+    const createSnapshot = kernel32.func(
+      "intptr_t __stdcall CreateToolhelp32Snapshot(uint32_t flags, uint32_t processId)",
+    );
+    const firstProcess = kernel32.func("__stdcall", "Process32FirstW", "int32_t", [
+      "intptr_t",
+      koffi.inout(koffi.pointer(processEntry)),
+    ]);
+    const nextProcess = kernel32.func("__stdcall", "Process32NextW", "int32_t", [
+      "intptr_t",
+      koffi.inout(koffi.pointer(processEntry)),
+    ]);
+    const openProcess = kernel32.func(
+      "intptr_t __stdcall OpenProcess(uint32_t access, int32_t inheritHandle, uint32_t processId)",
+    );
+    const closeHandle = kernel32.func("int32_t __stdcall CloseHandle(intptr_t handle)");
+    const getProcessTimes = kernel32.func("__stdcall", "GetProcessTimes", "int32_t", [
+      "intptr_t",
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+    ]);
+    const queryImageName = kernel32.func(
+      "int32_t __stdcall QueryFullProcessImageNameW(intptr_t process, uint32_t flags, _Out_ void *exeName, _Inout_ uint32_t *size)",
+    );
+    const ticks = (value: { low: number; high: number }) =>
+      (BigInt(value.high) << 32n) | BigInt(value.low);
+
+    const readBirthIdentity = (
+      pid: number,
+      imageBuffer: Buffer,
+    ): Pick<ChromeMcpWindowsProcessEntry, "createdTicks" | "imagePath"> => {
+      const handle = openProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid);
+      if (!handle) {
+        return {};
+      }
+      try {
+        const creation = { low: 0, high: 0 };
+        const exit = { low: 0, high: 0 };
+        // A handle can outlive its process; a set exit time means the pid is gone.
+        if (
+          !getProcessTimes(handle, creation, exit, { low: 0, high: 0 }, { low: 0, high: 0 }) ||
+          ticks(exit) !== 0n
+        ) {
+          return {};
+        }
+        const size: [number] = [IMAGE_PATH_MAX_CHARS];
+        if (!queryImageName(handle, 0, imageBuffer, size)) {
+          return {};
+        }
+        return {
+          createdTicks: ticks(creation),
+          imagePath: imageBuffer.toString("utf16le", 0, size[0] * 2),
+        };
+      } finally {
+        closeHandle(handle);
+      }
+    };
+
+    return () => {
+      const snapshot = createSnapshot(TH32CS_SNAPPROCESS, 0);
+      if (snapshot === INVALID_HANDLE_VALUE) {
+        throw new Error(`CreateToolhelp32Snapshot failed with error ${getLastError()}.`);
+      }
+      const rows: ChromeMcpWindowsProcessEntry[] = [];
+      try {
+        // koffi zero-fills the remaining fields and writes every field back after each call.
+        const entry: { dwSize: number; th32ProcessID: number; th32ParentProcessID: number } = {
+          dwSize: entrySize,
+          th32ProcessID: 0,
+          th32ParentProcessID: 0,
+        };
+        if (!firstProcess(snapshot, entry)) {
+          throw new Error(`Process32FirstW failed with error ${getLastError()}.`);
+        }
+        do {
+          rows.push({ pid: entry.th32ProcessID, ppid: entry.th32ParentProcessID });
+          entry.dwSize = entrySize;
+        } while (nextProcess(snapshot, entry));
+        const lastError = getLastError();
+        // Any other stop reason is a truncated table, which could hide a live owned process.
+        if (lastError !== ERROR_NO_MORE_FILES) {
+          throw new Error(`Process32NextW failed with error ${lastError}.`);
+        }
+      } finally {
+        closeHandle(snapshot);
+      }
+      const imageBuffer = Buffer.alloc(IMAGE_PATH_MAX_CHARS * 2);
+      for (const row of rows) {
+        Object.assign(row, readBirthIdentity(row.pid, imageBuffer));
+      }
+      return rows;
+    };
+  } catch {
+    return null;
+  }
+}
+
+/** Joins Toolhelp ancestry with birth identities, dropping rows that cannot prove one. */
+export function buildChromeMcpWindowsProcessSnapshots(
+  entries: ChromeMcpWindowsProcessEntry[],
+): ChromeMcpProcessSnapshot[] {
+  const createdByPid = new Map<number, bigint>();
+  for (const entry of entries) {
+    if (entry.createdTicks !== undefined) {
+      createdByPid.set(entry.pid, entry.createdTicks);
+    }
+  }
+  return entries.flatMap((entry) => {
+    if (entry.createdTicks === undefined || !entry.imagePath) {
+      return [];
+    }
+    // Toolhelp keeps an exited parent's pid. A process born after this child that
+    // now owns that pid is not its parent, so the child must not join its tree.
+    const parentCreated = createdByPid.get(entry.ppid);
+    const ppid = parentCreated !== undefined && parentCreated > entry.createdTicks ? 0 : entry.ppid;
+    return [{ pid: entry.pid, ppid, identity: `win32:${entry.createdTicks}|${entry.imagePath}` }];
+  });
+}
+
+/**
+ * Lists Windows processes without starting PowerShell. Returns `undefined` when
+ * the native reader is unavailable and the caller should use its fallback.
+ *
+ * The source is fixed once native rows have been returned: identities from the
+ * fallback use a different format, and mixing them would make a live owned
+ * process look exited (skipping its cleanup) or a tracked root look replaced.
+ */
+export function listChromeMcpWindowsProcessesNative(): ChromeMcpProcessSnapshot[] | undefined {
+  if (nativeReader === undefined) {
+    nativeReader = loadNativeProcessTableReader();
+  }
+  if (!nativeReader) {
+    return undefined;
+  }
+  let entries: ChromeMcpWindowsProcessEntry[];
+  try {
+    entries = nativeReader();
+  } catch (err) {
+    if (nativeReaderProven) {
+      throw err;
+    }
+    // No identity has been issued from native rows yet, so the fallback can own all of them.
+    nativeReader = null;
+    return undefined;
+  }
+  nativeReaderProven = true;
+  return buildChromeMcpWindowsProcessSnapshots(entries);
+}
+
+/** Replace the native reader; `null` disables it, `undefined` restores loading. */
+export function setChromeMcpWindowsProcessTableReaderForTest(
+  reader: ChromeMcpWindowsProcessTableReader | null | undefined,
+): void {
+  nativeReader = reader;
+  nativeReaderProven = false;
+}
