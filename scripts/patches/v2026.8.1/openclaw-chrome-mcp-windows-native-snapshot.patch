diff --git a/extensions/browser/src/browser/chrome-mcp-windows-processes.e2e.test.ts b/extensions/browser/src/browser/chrome-mcp-windows-processes.e2e.test.ts
new file mode 100644
index 0000000..09dca4b
--- /dev/null
+++ b/extensions/browser/src/browser/chrome-mcp-windows-processes.e2e.test.ts
@@ -0,0 +1,213 @@
+// End-to-end coverage: real Chrome MCP attach and Windows subprocess-tree cleanup without PowerShell.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import {
+  closeChromeMcpSession,
+  listChromeMcpTabs,
+  resetChromeMcpSessionsForTest,
+} from "./chrome-mcp.js";
+import { getChromeMcpPid } from "./chrome-mcp-tabs.js";
+import { setChromeMcpWindowsProcessTableReaderForTest } from "./chrome-mcp-windows-processes.js";
+
+type ExecCall = { command: string; args: string[]; timeoutMs?: number; elapsedMs: number };
+
+const execState = vi.hoisted(() => ({
+  calls: [] as ExecCall[],
+  // Extra latency injected into the PowerShell process list, as seen on slow hosts.
+  powershellDelayMs: 0,
+}));
+
+vi.mock("openclaw/plugin-sdk/process-runtime", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("openclaw/plugin-sdk/process-runtime")>();
+  return {
+    ...actual,
+    runExec: async (...params: Parameters<typeof actual.runExec>) => {
+      const [command, args, opts] = params;
+      const delayedArgs =
+        command === "powershell.exe" && execState.powershellDelayMs > 0
+          ? args.map((arg) =>
+              arg.startsWith("Get-CimInstance")
+                ? `Start-Sleep -Milliseconds ${execState.powershellDelayMs}; ${arg}`
+                : arg,
+            )
+          : args;
+      const started = Date.now();
+      try {
+        return await actual.runExec(command, delayedArgs, opts);
+      } finally {
+        execState.calls.push({
+          command,
+          args,
+          timeoutMs: typeof opts === "number" ? opts : opts?.timeoutMs,
+          elapsedMs: Date.now() - started,
+        });
+      }
+    },
+  };
+});
+
+// A dependency-free stdio MCP server that, like Chrome MCP, owns a long-lived
+// grandchild. It reports both pids so the test can prove the whole tree is gone.
+const FAKE_SERVER_SOURCE = `
+import { spawn } from "node:child_process";
+import fs from "node:fs";
+import readline from "node:readline";
+
+const reportPath = process.argv.find((arg) => arg.startsWith("--report="))?.slice("--report=".length);
+const grandchild = spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], {
+  stdio: "ignore",
+  windowsHide: true,
+});
+fs.writeFileSync(reportPath, JSON.stringify({ server: process.pid, grandchild: grandchild.pid }));
+
+const send = (message) => process.stdout.write(JSON.stringify({ jsonrpc: "2.0", ...message }) + "\\n");
+readline.createInterface({ input: process.stdin }).on("line", (line) => {
+  const message = JSON.parse(line);
+  if (message.id === undefined) {
+    return;
+  }
+  if (message.method === "initialize") {
+    send({
+      id: message.id,
+      result: {
+        protocolVersion: message.params.protocolVersion,
+        capabilities: { tools: {} },
+        serverInfo: { name: "fake-chrome-mcp", version: "1.0.0" },
+      },
+    });
+  } else if (message.method === "tools/list") {
+    send({ id: message.id, result: { tools: [{ name: "list_pages", inputSchema: { type: "object" } }] } });
+  } else if (message.method === "tools/call") {
+    send({
+      id: message.id,
+      result: {
+        content: [{ type: "text", text: "1: about:blank [selected]" }],
+        structuredContent: { pages: [{ id: 1, url: "about:blank", selected: true }] },
+      },
+    });
+  } else {
+    send({ id: message.id, error: { code: -32601, message: "Method not found" } });
+  }
+});
+`;
+
+let fixtureDir = "";
+let launcherPath = "";
+
+function isAlive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+function readReport(reportPath: string): { server: number; grandchild: number } {
+  return JSON.parse(fs.readFileSync(reportPath, "utf8"));
+}
+
+async function attachListAndClose(profileName: string) {
+  const reportPath = path.join(fixtureDir, `${profileName}.json`);
+  const profileOptions = { mcpCommand: launcherPath, mcpArgs: [`--report=${reportPath}`] };
+
+  const attachStarted = Date.now();
+  const tabs = await listChromeMcpTabs(profileName, profileOptions);
+  const attachMs = Date.now() - attachStarted;
+  expect(tabs).toHaveLength(1);
+
+  const rootPid = getChromeMcpPid(profileName);
+  const { server, grandchild } = readReport(reportPath);
+  expect(rootPid).toBeTypeOf("number");
+  for (const pid of [rootPid ?? 0, server, grandchild]) {
+    expect(isAlive(pid)).toBe(true);
+  }
+
+  const closeStarted = Date.now();
+  await expect(closeChromeMcpSession(profileName)).resolves.toBe(true);
+  const closeMs = Date.now() - closeStarted;
+  await vi.waitFor(
+    () => {
+      for (const pid of [rootPid ?? 0, server, grandchild]) {
+        expect(isAlive(pid)).toBe(false);
+      }
+    },
+    { timeout: 5_000, interval: 50 },
+  );
+  return { attachMs, closeMs, rootPid, server, grandchild };
+}
+
+describe.runIf(process.platform === "win32")("chrome MCP Windows subprocess tree (e2e)", () => {
+  beforeAll(() => {
+    fixtureDir = fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-chrome-mcp-e2e-"));
+    fs.writeFileSync(path.join(fixtureDir, "fake-chrome-mcp.mjs"), FAKE_SERVER_SOURCE);
+    // Mirrors LobsterAI's production launcher: cmd.exe owns the Node server.
+    launcherPath = path.join(fixtureDir, "fake-chrome-mcp.cmd");
+    fs.writeFileSync(
+      launcherPath,
+      [
+        "@echo off",
+        "chcp 65001 >nul 2>&1",
+        `"${process.execPath}" "%~dp0fake-chrome-mcp.mjs" %*`,
+        "",
+      ].join("\r\n"),
+    );
+  });
+
+  afterAll(() => {
+    fs.rmSync(fixtureDir, { recursive: true, force: true });
+  });
+
+  afterEach(async () => {
+    await resetChromeMcpSessionsForTest();
+    setChromeMcpWindowsProcessTableReaderForTest(undefined);
+    execState.calls.length = 0;
+    execState.powershellDelayMs = 0;
+  });
+
+  it("attaches, lists pages, and reaps the launcher tree repeatedly without PowerShell", async () => {
+    // Slow PowerShell must not matter: the native path never starts it.
+    execState.powershellDelayMs = 2_500;
+    const rounds = [];
+    for (let round = 0; round < 5; round += 1) {
+      rounds.push(await attachListAndClose(`native-${round}`));
+    }
+    console.log(
+      `[chrome-mcp-e2e] native rounds: ${rounds
+        .map(({ attachMs, closeMs }) => `attach=${attachMs}ms close=${closeMs}ms`)
+        .join("; ")}`,
+    );
+
+    expect(execState.calls.filter(({ command }) => command === "powershell.exe")).toEqual([]);
+    const taskkills = execState.calls.filter(({ command }) => command === "taskkill");
+    expect(taskkills.map(({ args }) => Number(args[1]))).toEqual(
+      rounds.map(({ rootPid }) => rootPid),
+    );
+    for (const { attachMs } of rounds) {
+      expect(attachMs).toBeLessThan(5_000);
+    }
+  }, 120_000);
+
+  it("survives a PowerShell list slower than the old 2 s limit when koffi is unavailable", async () => {
+    setChromeMcpWindowsProcessTableReaderForTest(null);
+    execState.powershellDelayMs = 2_500;
+
+    const result = await attachListAndClose("powershell-fallback");
+    const lists = execState.calls.filter(({ command }) => command === "powershell.exe");
+    console.log(
+      `[chrome-mcp-e2e] fallback attach=${result.attachMs}ms close=${result.closeMs}ms lists=${lists
+        .map(({ elapsedMs }) => `${elapsedMs}ms`)
+        .join(",")}`,
+    );
+
+    // Attach lists twice and close at least three times; every one would have
+    // exceeded the former 2 s timeout, and each fits the 10 s fallback budget.
+    expect(lists.length).toBeGreaterThanOrEqual(5);
+    for (const { timeoutMs, elapsedMs } of lists) {
+      expect(timeoutMs).toBe(10_000);
+      expect(elapsedMs).toBeGreaterThan(2_000);
+    }
+  }, 180_000);
+});
