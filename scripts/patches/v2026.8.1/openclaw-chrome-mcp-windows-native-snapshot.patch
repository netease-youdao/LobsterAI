@@ -0,0 +1,210 @@
+// Browser tests cover native Windows process snapshots for Chrome MCP subprocess cleanup.
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import fs from "node:fs";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { ChromeMcpSession } from "./chrome-mcp-contracts.js";
+import {
+  ensureChromeMcpAvailable,
+  resetChromeMcpSessionsForTest,
+  setChromeMcpProcessCleanupDepsForTest,
+  setChromeMcpSessionFactoryForTest,
+} from "./chrome-mcp.js";
+import {
+  buildChromeMcpWindowsProcessSnapshots,
+  listChromeMcpWindowsProcessesNative,
+  setChromeMcpWindowsProcessTableReaderForTest,
+  type ChromeMcpWindowsProcessEntry,
+} from "./chrome-mcp-windows-processes.js";
+
+const runExec = vi.hoisted(() => vi.fn());
+
+vi.mock("openclaw/plugin-sdk/process-runtime", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("openclaw/plugin-sdk/process-runtime")>()),
+  runExec,
+}));
+
+function createCleanupSession(): ChromeMcpSession {
+  return {
+    client: {
+      callTool: vi.fn(),
+      listTools: vi.fn().mockResolvedValue({ tools: [{ name: "list_pages" }] }),
+      close: vi.fn().mockResolvedValue(undefined),
+      connect: vi.fn().mockResolvedValue(undefined),
+    },
+    transport: { pid: 123 },
+    ready: Promise.resolve(),
+    processCleanup: { status: "open" },
+  } as unknown as ChromeMcpSession;
+}
+
+function imagePathOf(identity: string | undefined): string {
+  return identity?.slice(identity.indexOf("|") + 1) ?? "";
+}
+
+describe("chrome MCP native Windows process snapshots", () => {
+  beforeEach(async () => {
+    await resetChromeMcpSessionsForTest();
+    runExec.mockReset();
+  });
+
+  afterEach(async () => {
+    await resetChromeMcpSessionsForTest();
+    setChromeMcpWindowsProcessTableReaderForTest(undefined);
+  });
+
+  it("binds ancestry, creation time, and image path in one snapshot row", () => {
+    expect(
+      buildChromeMcpWindowsProcessSnapshots([
+        { pid: 100, ppid: 4, createdTicks: 10n, imagePath: "C:\\App\\app.exe" },
+        { pid: 123, ppid: 100, createdTicks: 20n, imagePath: "C:\\Node\\node.exe" },
+      ]),
+    ).toEqual([
+      { pid: 100, ppid: 4, identity: "win32:10|C:\\App\\app.exe" },
+      { pid: 123, ppid: 100, identity: "win32:20|C:\\Node\\node.exe" },
+    ]);
+  });
+
+  it("drops processes that cannot prove a live birth identity", () => {
+    expect(
+      buildChromeMcpWindowsProcessSnapshots([
+        { pid: 4, ppid: 0 },
+        { pid: 200, ppid: 100, createdTicks: 30n },
+        { pid: 300, ppid: 4, createdTicks: 40n, imagePath: "C:\\Tools\\tool.exe" },
+      ]),
+    ).toEqual([{ pid: 300, ppid: 4, identity: "win32:40|C:\\Tools\\tool.exe" }]);
+  });
+
+  it("detaches a child whose parent pid now belongs to a younger process", () => {
+    const snapshots = buildChromeMcpWindowsProcessSnapshots([
+      { pid: 100, ppid: 4, createdTicks: 50n, imagePath: "C:\\Reused\\reused.exe" },
+      { pid: 123, ppid: 100, createdTicks: 20n, imagePath: "C:\\Orphan\\orphan.exe" },
+    ]);
+
+    expect(snapshots.find((snapshot) => snapshot.pid === 123)?.ppid).toBe(0);
+  });
+
+  it("falls back before any native identity is issued and stays on the fallback", () => {
+    const reader = vi.fn((): ChromeMcpWindowsProcessEntry[] => {
+      throw new Error("Process32FirstW failed with error 24.");
+    });
+    setChromeMcpWindowsProcessTableReaderForTest(reader);
+
+    expect(listChromeMcpWindowsProcessesNative()).toBeUndefined();
+    expect(listChromeMcpWindowsProcessesNative()).toBeUndefined();
+    expect(reader).toHaveBeenCalledOnce();
+  });
+
+  it("fails closed instead of switching identity formats after native rows were issued", () => {
+    let fail = false;
+    setChromeMcpWindowsProcessTableReaderForTest(() => {
+      if (fail) {
+        throw new Error("Process32NextW failed with error 5.");
+      }
+      return [{ pid: 123, ppid: 1, createdTicks: 20n, imagePath: "C:\\Node\\node.exe" }];
+    });
+
+    expect(listChromeMcpWindowsProcessesNative()).toEqual([
+      { pid: 123, ppid: 1, identity: "win32:20|C:\\Node\\node.exe" },
+    ]);
+    fail = true;
+    expect(() => listChromeMcpWindowsProcessesNative()).toThrow(
+      "Process32NextW failed with error 5.",
+    );
+  });
+
+  it("cleans up a Windows subprocess tree from the native table without PowerShell", async () => {
+    let alive = true;
+    const reader = vi.fn((): ChromeMcpWindowsProcessEntry[] => [
+      { pid: 1, ppid: 0, createdTicks: 1n, imagePath: "C:\\App\\gateway.exe" },
+      ...(alive
+        ? [
+            { pid: 123, ppid: 1, createdTicks: 20n, imagePath: "C:\\Node\\node.exe" },
+            { pid: 124, ppid: 123, createdTicks: 30n, imagePath: "C:\\Node\\worker.exe" },
+          ]
+        : []),
+    ]);
+    setChromeMcpWindowsProcessTableReaderForTest(reader);
+    const taskkillProcessTree = vi.fn(async () => {
+      alive = false;
+    });
+    setChromeMcpProcessCleanupDepsForTest({
+      platform: "win32",
+      taskkillProcessTree,
+      sleep: vi.fn().mockResolvedValue(undefined),
+    });
+    setChromeMcpSessionFactoryForTest(async () => createCleanupSession());
+
+    await ensureChromeMcpAvailable("chrome-live", undefined, { ephemeral: true });
+
+    expect(taskkillProcessTree).toHaveBeenCalledExactlyOnceWith(123);
+    expect(reader).toHaveBeenCalledTimes(3);
+    expect(runExec).not.toHaveBeenCalled();
+  });
+
+  it("gives the PowerShell fallback a startup-tolerant timeout when koffi is unavailable", async () => {
+    setChromeMcpWindowsProcessTableReaderForTest(null);
+    let alive = true;
+    runExec.mockImplementation(async () => ({
+      stdout: alive ? "123\t1\t2026-11-07T01:00:00.0000000+08:00\tC:\\Node\\node.exe\r\n" : "",
+      stderr: "",
+    }));
+    const taskkillProcessTree = vi.fn(async () => {
+      alive = false;
+    });
+    setChromeMcpProcessCleanupDepsForTest({
+      platform: "win32",
+      taskkillProcessTree,
+      sleep: vi.fn().mockResolvedValue(undefined),
+    });
+    setChromeMcpSessionFactoryForTest(async () => createCleanupSession());
+
+    await ensureChromeMcpAvailable("chrome-live", undefined, { ephemeral: true });
+
+    expect(taskkillProcessTree).toHaveBeenCalledExactlyOnceWith(123);
+    expect(runExec).toHaveBeenCalledWith(
+      "powershell.exe",
+      expect.arrayContaining(["-NoProfile", "-NonInteractive"]),
+      expect.objectContaining({ timeoutMs: 10_000 }),
+    );
+  });
+
+  it.runIf(process.platform === "win32")(
+    "reads this process, a live child, and the child's exit through kernel32",
+    async () => {
+      const self = listChromeMcpWindowsProcessesNative()?.find(
+        (snapshot) => snapshot.pid === process.pid,
+      );
+      expect(self?.ppid).toBe(process.ppid);
+      expect(self?.identity).toMatch(/^win32:\d+\|/);
+      expect(fs.realpathSync.native(imagePathOf(self?.identity)).toLowerCase()).toBe(
+        fs.realpathSync.native(process.execPath).toLowerCase(),
+      );
+
+      const child = spawn(process.execPath, ["-e", "setInterval(() => {}, 1000)"], {
+        stdio: "ignore",
+        windowsHide: true,
+      });
+      const exited = once(child, "exit");
+      let childIdentity: string | undefined;
+      try {
+        await once(child, "spawn");
+        const childRow = listChromeMcpWindowsProcessesNative()?.find(
+          (snapshot) => snapshot.pid === child.pid,
+        );
+        expect(childRow?.ppid).toBe(process.pid);
+        childIdentity = childRow?.identity;
+        expect(childIdentity).toMatch(/^win32:\d+\|/);
+      } finally {
+        child.kill();
+        await exited;
+      }
+
+      expect(
+        listChromeMcpWindowsProcessesNative()?.some(
+          (snapshot) => snapshot.pid === child.pid && snapshot.identity === childIdentity,
+        ),
+      ).toBe(false);
+    },
+  );
+});
