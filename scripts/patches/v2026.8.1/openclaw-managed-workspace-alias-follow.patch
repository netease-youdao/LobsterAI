@@ -0,0 +1,87 @@
+// A LobsterAI-managed workspace replaced by a link to a synced folder must keep
+// serving messages instead of failing closed on the stale path alias.
+import fs from "node:fs/promises";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import {
+  createOpenClawTestState,
+  type OpenClawTestState,
+} from "../test-utils/openclaw-test-state.js";
+import { resetLegacyWorkspaceStateCheckForTest } from "./workspace-legacy-state.test-support.js";
+import { resolveWorkspaceStateIdentity } from "./workspace-state-identity.js";
+import { readWorkspaceStateSnapshot } from "./workspace-state-store.js";
+import {
+  DEFAULT_AGENTS_FILENAME,
+  DEFAULT_BOOTSTRAP_FILENAME,
+  DEFAULT_IDENTITY_FILENAME,
+  DEFAULT_SOUL_FILENAME,
+  DEFAULT_USER_FILENAME,
+  ensureAgentWorkspace,
+} from "./workspace.js";
+
+const MANAGED_ROOT_ENV = "LOBSTERAI_MANAGED_WORKSPACE_ROOT";
+
+let testState: OpenClawTestState | undefined;
+
+beforeEach(async () => {
+  resetLegacyWorkspaceStateCheckForTest();
+  testState = await createOpenClawTestState({
+    layout: "state-only",
+    prefix: "openclaw-workspace-managed-relink-",
+  });
+});
+
+afterEach(async () => {
+  delete process.env[MANAGED_ROOT_ENV];
+  closeOpenClawStateDatabaseForTest();
+  resetLegacyWorkspaceStateCheckForTest();
+  await testState?.cleanup();
+  testState = undefined;
+});
+
+async function createSyncedWorkspace(): Promise<string> {
+  const dir = testState!.path("onedrive", "workspace");
+  await fs.mkdir(path.join(dir, "memory"), { recursive: true });
+  await fs.writeFile(path.join(dir, DEFAULT_AGENTS_FILENAME), "# Synced agent rules\n");
+  await fs.writeFile(path.join(dir, DEFAULT_SOUL_FILENAME), "# Synced soul\n");
+  await fs.writeFile(path.join(dir, DEFAULT_IDENTITY_FILENAME), "- Name: Synced Assistant\n");
+  await fs.writeFile(path.join(dir, DEFAULT_USER_FILENAME), "- Name: Synced User\n");
+  await fs.writeFile(path.join(dir, "memory", "2026-10-17.md"), "Moved to a new machine.\n");
+  return dir;
+}
+
+async function seedAndRelinkManagedWorkspace(): Promise<{ managed: string; synced: string }> {
+  const managed = testState!.path("lobsterai-state", "workspace-main");
+  await ensureAgentWorkspace({ dir: managed, ensureBootstrapFiles: true });
+  const synced = await createSyncedWorkspace();
+  await fs.rename(managed, `${managed}.template`);
+  await fs.symlink(synced, managed, process.platform === "win32" ? "junction" : "dir");
+  return { managed, synced };
+}
+
+describe("managed workspace relinked to a synced folder", () => {
+  it("serves the synced workspace without reseeding bootstrap", async () => {
+    process.env[MANAGED_ROOT_ENV] = testState!.path("lobsterai-state");
+    const { managed, synced } = await seedAndRelinkManagedWorkspace();
+
+    const result = await ensureAgentWorkspace({ dir: managed, ensureBootstrapFiles: true });
+
+    expect(result.bootstrapPending).toBe(false);
+    await expect(fs.access(path.join(synced, DEFAULT_BOOTSTRAP_FILENAME))).rejects.toThrow();
+    const snapshot = readWorkspaceStateSnapshot(managed);
+    expect(snapshot.identity).toStrictEqual(resolveWorkspaceStateIdentity(synced));
+    expect(snapshot.setup.setupCompletedAt).toEqual(expect.any(String));
+    await expect(
+      fs.readFile(path.join(synced, DEFAULT_IDENTITY_FILENAME), "utf8"),
+    ).resolves.toBe("- Name: Synced Assistant\n");
+  });
+
+  it("keeps failing closed when LobsterAI has not claimed the workspace root", async () => {
+    const { managed } = await seedAndRelinkManagedWorkspace();
+
+    await expect(ensureAgentWorkspace({ dir: managed, ensureBootstrapFiles: true })).rejects.toThrow(
+      /different current target/u,
+    );
+  });
+});
