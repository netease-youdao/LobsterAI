+
+describe("workspace state store under a LobsterAI managed root", () => {
+  const managedRootEnv = "LOBSTERAI_MANAGED_WORKSPACE_ROOT";
+  const linkType = process.platform === "win32" ? "junction" : "dir";
+
+  beforeEach(() => {
+    process.env[managedRootEnv] = testState!.path("managed");
+  });
+
+  afterEach(() => {
+    delete process.env[managedRootEnv];
+  });
+
+  function managedWorkspace(): string {
+    const dir = testState!.path("managed", "workspace-main");
+    fs.mkdirSync(dir, { recursive: true });
+    return dir;
+  }
+
+  function syncedWorkspace(): string {
+    const dir = testState!.path("synced", "workspace");
+    fs.mkdirSync(dir, { recursive: true });
+    return dir;
+  }
+
+  // Mirrors a user replacing the managed folder with a link to a synced copy.
+  function relink(managed: string, target: string): void {
+    fs.renameSync(managed, testState!.path("managed", "workspace-main.template"));
+    fs.symlinkSync(target, managed, linkType);
+  }
+
+  function storedAliasTarget(aliasPath: string): string | undefined {
+    const row = openOpenClawStateDatabase()
+      .db.prepare("SELECT workspace_path FROM workspace_path_aliases WHERE alias_path = ?")
+      .get(aliasPath) as { workspace_path: string } | undefined;
+    return row?.workspace_path;
+  }
+
+  it("follows a relinked managed workspace to its current target", () => {
+    const managed = managedWorkspace();
+    const synced = syncedWorkspace();
+    const original = resolveWorkspaceStateIdentity(managed);
+    mergeWorkspaceSetupState(managed, { bootstrapSeededAt: "2026-07-16T01:00:00.000Z" }, 1_000);
+    relink(managed, synced);
+
+    const snapshot = readWorkspaceStateSnapshot(managed);
+    expect(snapshot.identity).toStrictEqual(resolveWorkspaceStateIdentity(synced));
+    expect(snapshot.setupExists).toBe(false);
+
+    mergeWorkspaceSetupState(managed, { setupCompletedAt: "2026-07-16T02:00:00.000Z" }, 2_000);
+    expect(storedAliasTarget(managed)).toBe(resolveWorkspaceStateIdentity(synced).workspacePath);
+    expect(readWorkspaceStateSnapshot(managed).setup.setupCompletedAt).toBe(
+      "2026-07-16T02:00:00.000Z",
+    );
+    const previousRecord = openOpenClawStateDatabase()
+      .db.prepare("SELECT bootstrap_seeded_at FROM workspace_setup_state WHERE workspace_key = ?")
+      .get(original.workspaceKey);
+    expect(previousRecord).toMatchObject({ bootstrap_seeded_at: "2026-07-16T01:00:00.000Z" });
+  });
+
+  it("uses the current target's own records after a relink", () => {
+    const managed = managedWorkspace();
+    const synced = syncedWorkspace();
+    mergeWorkspaceSetupState(managed, { bootstrapSeededAt: "2026-07-16T01:00:00.000Z" }, 1_000);
+    mergeWorkspaceSetupState(synced, { setupCompletedAt: "2026-07-16T02:00:00.000Z" }, 2_000);
+    relink(managed, synced);
+
+    expect(readWorkspaceStateSnapshot(managed).setup).toStrictEqual({
+      version: 1,
+      setupCompletedAt: "2026-07-16T02:00:00.000Z",
+    });
+    expect(storedAliasTarget(managed)).toBe(resolveWorkspaceStateIdentity(synced).workspacePath);
+  });
+
+  it("accepts an attestation refresh after a relink", () => {
+    const managed = managedWorkspace();
+    const synced = syncedWorkspace();
+    replaceWorkspaceAttestation({
+      workspaceDir: managed,
+      attestedAtMs: 1_000,
+      generatedHashes: new Map(),
+      nowMs: 1_000,
+    });
+    relink(managed, synced);
+
+    replaceWorkspaceAttestation({
+      workspaceDir: managed,
+      attestedAtMs: 2_000,
+      generatedHashes: new Map(),
+      nowMs: 2_000,
+    });
+    expect(readWorkspaceStateSnapshot(managed).attestation?.attestedAtMs).toBe(2_000);
+    expect(storedAliasTarget(managed)).toBe(resolveWorkspaceStateIdentity(synced).workspacePath);
+  });
+
+  it("keeps the stored owner while a managed path is missing", () => {
+    const managed = managedWorkspace();
+    const synced = syncedWorkspace();
+    fs.rmSync(managed, { recursive: true });
+    fs.symlinkSync(synced, managed, linkType);
+    mergeWorkspaceSetupState(managed, { bootstrapSeededAt: "2026-07-16T01:00:00.000Z" }, 1_000);
+    fs.unlinkSync(managed);
+
+    expect(readWorkspaceStateSnapshot(managed).identity).toStrictEqual(
+      resolveWorkspaceStateIdentity(synced),
+    );
+    expect(clearExpiredWorkspaceStateForVanishedWorkspace(managed, 2_000)).toBe(false);
+  });
+
+  it("still fails closed for a relinked workspace outside the managed root", () => {
+    process.env[managedRootEnv] = testState!.path("other-root");
+    const managed = managedWorkspace();
+    const synced = syncedWorkspace();
+    mergeWorkspaceSetupState(managed, { bootstrapSeededAt: "2026-07-16T01:00:00.000Z" }, 1_000);
+    relink(managed, synced);
+
+    expect(() => readWorkspaceStateSnapshot(managed)).toThrow(/different current target/u);
+    expect(() =>
+      mergeWorkspaceSetupState(managed, { setupCompletedAt: "2026-07-16T02:00:00.000Z" }, 2_000),
+    ).toThrow(/different current target/u);
+  });
+
+  it("does not treat the managed root itself as a managed workspace", () => {
+    const root = testState!.path("managed");
+    const synced = syncedWorkspace();
+    fs.mkdirSync(root, { recursive: true });
+    mergeWorkspaceSetupState(root, { bootstrapSeededAt: "2026-07-16T01:00:00.000Z" }, 1_000);
+    fs.renameSync(root, testState!.path("managed.template"));
+    fs.symlinkSync(synced, root, linkType);
+
+    expect(() => readWorkspaceStateSnapshot(root)).toThrow(/different current target/u);
+  });
+});
