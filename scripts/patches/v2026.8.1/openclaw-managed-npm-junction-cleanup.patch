@@ -0,0 +1,131 @@
+// Retires managed npm payloads without traversing their host-runtime junctions.
+import fs from "node:fs";
+import path from "node:path";
+import { hasErrnoCode } from "../infra/errno.js";
+
+type ManagedNpmPackage = {
+  npmRoot: string;
+  packageName: string;
+  packageDir: string;
+};
+
+function removePathNoFollowSync(target: string): void {
+  const stat = fs.lstatSync(target, { throwIfNoEntry: false });
+  if (!stat) {
+    return;
+  }
+  // Electron's recursive rmSync can descend into Windows junctions. Unlink
+  // aliases explicitly and use only non-recursive removal for real directories.
+  if (stat.isSymbolicLink() || !stat.isDirectory()) {
+    fs.unlinkSync(target);
+    return;
+  }
+  for (const name of fs.readdirSync(target)) {
+    removePathNoFollowSync(path.join(target, name));
+  }
+  fs.rmdirSync(target);
+}
+
+function cleanupQuarantines(quarantines: Iterable<string>): void {
+  for (const quarantine of quarantines) {
+    try {
+      removePathNoFollowSync(quarantine);
+    } catch (error) {
+      console.warn(
+        `[Plugin registry] Could not finish managed npm cleanup; retained files at ${quarantine}`,
+        error,
+      );
+    }
+  }
+}
+
+/** Stage the complete batch before metadata changes; delete payloads only after those writes succeed. */
+export function removeManagedNpmPackages(
+  packages: readonly ManagedNpmPackage[],
+  updateMetadata: (entry: ManagedNpmPackage) => void,
+): void {
+  const quarantines = new Map<string, string>();
+  const snapshots: Array<{ filePath: string; backupPath: string }> = [];
+  const staged: Array<{ packageDir: string; stagedDir: string }> = [];
+  let metadataStarted = false;
+  try {
+    for (const { npmRoot } of packages) {
+      if (quarantines.has(npmRoot)) {
+        continue;
+      }
+      // Keep quarantines outside node_modules: host-link repair scans scoped
+      // package directories even when their names start with a dot.
+      const quarantine = fs.mkdtempSync(path.join(npmRoot, ".openclaw-npm-cleanup-"));
+      quarantines.set(npmRoot, quarantine);
+      for (const name of ["package.json", "package-lock.json"]) {
+        const filePath = path.join(npmRoot, name);
+        const backupPath = path.join(quarantine, name);
+        try {
+          fs.copyFileSync(filePath, backupPath);
+          snapshots.push({ filePath, backupPath });
+        } catch (error) {
+          if (name !== "package-lock.json" || !hasErrnoCode(error, "ENOENT")) {
+            throw error;
+          }
+        }
+      }
+    }
+    for (const entry of packages) {
+      const quarantine = quarantines.get(entry.npmRoot);
+      if (!quarantine) {
+        throw new Error(`Missing managed npm cleanup snapshot for ${entry.npmRoot}`);
+      }
+      const stagedDir = path.join(quarantine, "node_modules", ...entry.packageName.split("/"));
+      fs.mkdirSync(path.dirname(stagedDir), { recursive: true });
+      fs.renameSync(entry.packageDir, stagedDir);
+      staged.push({ packageDir: entry.packageDir, stagedDir });
+    }
+    metadataStarted = true;
+    for (const entry of packages) {
+      updateMetadata(entry);
+    }
+  } catch (error) {
+    const rollbackErrors: unknown[] = [];
+    if (metadataStarted) {
+      // A failed Windows JSON replacement may already have removed the original.
+      // Restore raw bytes for every root, including packages finalized earlier.
+      for (const { filePath, backupPath } of snapshots) {
+        try {
+          fs.copyFileSync(backupPath, filePath);
+        } catch (rollbackError) {
+          rollbackErrors.push(rollbackError);
+        }
+      }
+    }
+    for (const { packageDir, stagedDir } of staged.toReversed()) {
+      try {
+        fs.renameSync(stagedDir, packageDir);
+      } catch (rollbackError) {
+        rollbackErrors.push(rollbackError);
+      }
+    }
+    if (rollbackErrors.length > 0) {
+      // Keep both payloads and original metadata available if recovery itself fails.
+      throw new AggregateError(
+        [error, ...rollbackErrors],
+        `Managed npm cleanup rollback failed; recovery files retained at ${[...quarantines.values()].join(", ")}`,
+        { cause: error },
+      );
+    }
+    cleanupQuarantines(quarantines.values());
+    throw error;
+  }
+
+  // Retirement is committed. Locked debris must not prevent callers from
+  // persisting the pruned install records and starting with the bundled plugins.
+  cleanupQuarantines(quarantines.values());
+  for (const scopeDir of new Set(packages.map((entry) => path.dirname(entry.packageDir)))) {
+    if (path.basename(path.dirname(scopeDir)) === "node_modules") {
+      try {
+        fs.rmdirSync(scopeDir);
+      } catch {
+        // Other packages can still live under the scope directory.
+      }
+    }
+  }
+}
