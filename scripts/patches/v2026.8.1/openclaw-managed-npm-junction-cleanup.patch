+// Exercises managed npm retirement through the public registry repair boundary.
+import fs from "node:fs";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createTempDirTracker } from "../../test/helpers/temp-dir.js";
+import type { PluginInstallRecord } from "../config/types.plugins.js";
+import * as jsonFile from "../infra/json-file.js";
+import type { PluginCandidate } from "../plugins/discovery.js";
+import { resolvePluginNpmProjectDir } from "../plugins/install-paths.js";
+import { writePersistedInstalledPluginIndex } from "../plugins/installed-plugin-index-store-write.js";
+import { readPersistedInstalledPluginIndex } from "../plugins/installed-plugin-index-store.js";
+import type { InstalledPluginIndex } from "../plugins/installed-plugin-index.js";
+import { writeManagedNpmPlugin } from "../plugins/test-helpers/managed-npm-plugin.js";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import { maybeRepairPluginRegistryState } from "./doctor-plugin-registry.js";
+
+vi.mock("../../packages/terminal-core/src/note.js", () => ({ note: vi.fn() }));
+
+const tempDirs = createTempDirTracker();
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  closeOpenClawStateDatabaseForTest();
+  tempDirs.cleanup();
+});
+
+async function readRequiredPersistedInstalledPluginIndex(stateDir: string) {
+  const persisted = await readPersistedInstalledPluginIndex({ stateDir });
+  if (!persisted) {
+    throw new Error("Expected persisted installed plugin index");
+  }
+  return persisted;
+}
+
+async function createNpmCleanupScenario(
+  ids = ["cleanup-first", "cleanup-second"],
+  layout: "project" | "legacy" = "project",
+) {
+  const stateDir = tempDirs.make("openclaw-doctor-npm-cleanup-");
+  const packages = ids.map((id) => {
+    const packageName = `@openclaw/${id}`;
+    const npmRoot =
+      layout === "legacy"
+        ? path.join(stateDir, "npm")
+        : resolvePluginNpmProjectDir({
+            npmDir: path.join(stateDir, "npm"),
+            packageName,
+          });
+    const packageDir = writeManagedNpmPlugin({
+      stateDir,
+      packageName,
+      pluginId: id,
+      version: "2026.5.2",
+      layout,
+    });
+    return { id, packageName, npmRoot, packageDir };
+  });
+  for (const npmRoot of new Set(packages.map((entry) => entry.npmRoot))) {
+    const entries = packages.filter((entry) => entry.npmRoot === npmRoot);
+    const dependencies = Object.fromEntries(
+      entries.map(({ packageName }) => [packageName, "2026.5.2"]),
+    );
+    fs.writeFileSync(
+      path.join(npmRoot, "package-lock.json"),
+      JSON.stringify({
+        lockfileVersion: 3,
+        packages: {
+          "": { dependencies },
+          ...Object.fromEntries(
+            entries.map(({ packageName }) => [
+              `node_modules/${packageName}`,
+              { version: "2026.5.2" },
+            ]),
+          ),
+        },
+        dependencies: Object.fromEntries(
+          entries.map(({ packageName }) => [packageName, { version: "2026.5.2" }]),
+        ),
+      }),
+    );
+  }
+  const candidates: PluginCandidate[] = packages.map(({ id, packageName }) => {
+    const rootDir = path.join(stateDir, "bundled", id);
+    fs.mkdirSync(rootDir, { recursive: true });
+    fs.writeFileSync(
+      path.join(rootDir, "package.json"),
+      JSON.stringify({ name: packageName, version: "2026.5.3" }),
+    );
+    fs.writeFileSync(
+      path.join(rootDir, "openclaw.plugin.json"),
+      JSON.stringify({ id, name: id, configSchema: { type: "object" }, providers: [id] }),
+    );
+    const source = path.join(rootDir, "index.ts");
+    fs.writeFileSync(source, "throw new Error('runtime entry should not load');\n");
+    return {
+      idHint: id,
+      source,
+      rootDir,
+      origin: "bundled",
+      packageName,
+      packageVersion: "2026.5.3",
+    };
+  });
+  const index: InstalledPluginIndex = {
+    version: 1,
+    hostContractVersion: "2026.4.25",
+    compatRegistryVersion: "compat-v1",
+    migrationVersion: 1,
+    policyHash: "policy-v1",
+    generatedAtMs: 1777118400000,
+    installRecords: Object.fromEntries(
+      packages.map(({ id, packageName, packageDir }): [string, PluginInstallRecord] => [
+        id,
+        {
+          source: "npm",
+          spec: `${packageName}@2026.5.2`,
+          installPath: packageDir,
+          version: "2026.5.2",
+          resolvedName: packageName,
+          resolvedVersion: "2026.5.2",
+          resolvedSpec: `${packageName}@2026.5.2`,
+        },
+      ]),
+    ),
+    plugins: [],
+    diagnostics: [],
+  };
+  await writePersistedInstalledPluginIndex(index, { stateDir });
+  const metadata = packages.flatMap(({ npmRoot }) =>
+    ["package.json", "package-lock.json"].map((name) => {
+      const filePath = path.join(npmRoot, name);
+      return { filePath, contents: fs.readFileSync(filePath) };
+    }),
+  );
+  const repair = () =>
+    maybeRepairPluginRegistryState({
+      stateDir,
+      candidates,
+      env: {
+        OPENCLAW_BUNDLED_PLUGINS_DIR: undefined,
+        OPENCLAW_VERSION: "2026.4.25",
+        VITEST: "true",
+      },
+      config: { plugins: { allow: ids } },
+      prompter: { shouldRepair: true },
+    });
+  return { stateDir, packages, index, metadata, repair };
+}
+
+describe("managed npm cleanup during registry repair", () => {
+  it("retains original metadata and reports recovery paths when restoring a snapshot fails", async () => {
+    const scenario = await createNpmCleanupScenario();
+    const managed = scenario.packages[1];
+    const failurePath = path.join(managed.npmRoot, "package.json");
+    const originalMetadata = fs.readFileSync(failurePath);
+    const writeJsonTarget = jsonFile.writeJsonTarget;
+    vi.spyOn(jsonFile, "writeJsonTarget").mockImplementation((filePath, data) => {
+      if (filePath === failurePath) {
+        fs.unlinkSync(filePath);
+        throw new Error("injected metadata publication failure");
+      }
+      writeJsonTarget(filePath, data);
+    });
+    const copyFileSync = fs.copyFileSync;
+    vi.spyOn(fs, "copyFileSync").mockImplementation((source, target, mode) => {
+      if (target === failurePath) {
+        throw new Error("injected snapshot restore failure");
+      }
+      copyFileSync(source, target, mode);
+    });
+
+    const failure = await scenario.repair().then(
+      () => {
+        throw new Error("Expected registry repair to fail");
+      },
+      (error: unknown) => error,
+    );
+    expect(failure).toBeInstanceOf(AggregateError);
+    const retained = fs
+      .readdirSync(managed.npmRoot)
+      .filter((name) => name.startsWith(".openclaw-npm-cleanup-"));
+    expect(retained).toHaveLength(1);
+    const quarantinePath = path.join(managed.npmRoot, retained[0]);
+    expect(String(failure)).toContain("recovery files retained at");
+    expect(String(failure)).toContain(quarantinePath);
+    expect(fs.readFileSync(path.join(quarantinePath, "package.json"))).toEqual(originalMetadata);
+    expect(fs.existsSync(failurePath)).toBe(false);
+    for (const { id, packageDir } of scenario.packages) {
+      expect(
+        JSON.parse(fs.readFileSync(path.join(packageDir, "openclaw.plugin.json"), "utf8")).id,
+      ).toBe(id);
+    }
+    expect(
+      (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+    ).toEqual(scenario.index.installRecords);
+  });
+
+  it("removes stale packages without deleting nested junction targets", async () => {
+    const scenario = await createNpmCleanupScenario(["cleanup-junction"]);
+    const managed = scenario.packages[0];
+    const runtimeDir = path.join(scenario.stateDir, "host-runtime");
+    const workerPath = path.join(runtimeDir, "dist", "workers", "agent.js");
+    fs.mkdirSync(path.dirname(workerPath), { recursive: true });
+    fs.writeFileSync(workerPath, "host worker remains intact");
+    const nodeModulesDir = path.join(managed.packageDir, "node_modules");
+    fs.mkdirSync(nodeModulesDir);
+    fs.symlinkSync(runtimeDir, path.join(nodeModulesDir, "openclaw"), "junction");
+    fs.symlinkSync(
+      path.join(scenario.stateDir, "missing-host"),
+      path.join(nodeModulesDir, "missing-host"),
+      "junction",
+    );
+
+    await scenario.repair();
+
+    expect(fs.readFileSync(workerPath, "utf8")).toBe("host worker remains intact");
+    expect(fs.existsSync(managed.packageDir)).toBe(false);
+    expect(
+      Object.keys(
+        (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+      ),
+    ).toEqual([]);
+  });
+
+  it.each([
+    { layout: "project", name: "package.json" },
+    { layout: "project", name: "package-lock.json" },
+    { layout: "legacy", name: "package.json" },
+    { layout: "legacy", name: "package-lock.json" },
+  ] as const)(
+    "restores the $layout batch after a destructive $name write failure",
+    async ({ layout, name }) => {
+      const scenario = await createNpmCleanupScenario(undefined, layout);
+      const failurePath = path.join(scenario.packages[1].npmRoot, name);
+      const writeJsonTarget = jsonFile.writeJsonTarget;
+      let failed = false;
+      const writeSpy = vi
+        .spyOn(jsonFile, "writeJsonTarget")
+        .mockImplementation((filePath, data) => {
+          if (filePath === failurePath && !failed) {
+            failed = true;
+            // The Windows JSON writer can unlink the old file before its replacement rename fails.
+            fs.unlinkSync(filePath);
+            throw new Error("injected metadata publication failure");
+          }
+          writeJsonTarget(filePath, data);
+        });
+      try {
+        await expect(scenario.repair()).rejects.toThrow("injected metadata publication failure");
+        for (const { filePath, contents } of scenario.metadata) {
+          expect(fs.readFileSync(filePath)).toEqual(contents);
+        }
+        for (const { id, packageDir } of scenario.packages) {
+          expect(
+            JSON.parse(fs.readFileSync(path.join(packageDir, "openclaw.plugin.json"), "utf8")).id,
+          ).toBe(id);
+        }
+        expect(
+          (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+        ).toEqual(scenario.index.installRecords);
+      } finally {
+        writeSpy.mockRestore();
+      }
+
+      await scenario.repair();
+      expect(
+        Object.keys(
+          (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+        ),
+      ).toEqual([]);
+      expect(scenario.packages.every(({ packageDir }) => !fs.existsSync(packageDir))).toBe(true);
+    },
+  );
+
+  it("rolls back an earlier staged package when a later package cannot be renamed", async () => {
+    const scenario = await createNpmCleanupScenario();
+    const renameSync = fs.renameSync;
+    const renameSpy = vi.spyOn(fs, "renameSync").mockImplementation((source, target) => {
+      if (source === scenario.packages[1].packageDir) {
+        throw new Error("injected package rename failure");
+      }
+      renameSync(source, target);
+    });
+    try {
+      await expect(scenario.repair()).rejects.toThrow("injected package rename failure");
+      expect(scenario.packages.every(({ packageDir }) => fs.existsSync(packageDir))).toBe(true);
+      for (const { filePath, contents } of scenario.metadata) {
+        expect(fs.readFileSync(filePath)).toEqual(contents);
+      }
+      expect(
+        (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+      ).toEqual(scenario.index.installRecords);
+    } finally {
+      renameSpy.mockRestore();
+    }
+    await scenario.repair();
+    expect(scenario.packages.every(({ packageDir }) => !fs.existsSync(packageDir))).toBe(true);
+  });
+
+  it("persists all retirements and reports retained quarantine when payload cleanup fails", async () => {
+    const scenario = await createNpmCleanupScenario();
+    const managed = scenario.packages[1];
+    fs.writeFileSync(path.join(managed.packageDir, "locked-payload.bin"), "locked payload");
+    const unlinkSync = fs.unlinkSync;
+    const unlinkSpy = vi.spyOn(fs, "unlinkSync").mockImplementation((filePath) => {
+      if (path.basename(String(filePath)) === "locked-payload.bin") {
+        throw new Error("injected payload cleanup failure");
+      }
+      unlinkSync(filePath);
+    });
+    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => undefined);
+    try {
+      await scenario.repair();
+      expect(scenario.packages.every(({ packageDir }) => !fs.existsSync(packageDir))).toBe(true);
+      expect(
+        Object.keys(
+          (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+        ),
+      ).toEqual([]);
+      const retained = fs
+        .readdirSync(managed.npmRoot)
+        .filter((name) => name.startsWith(".openclaw-npm-cleanup-"));
+      expect(retained).toHaveLength(1);
+      const quarantinePath = path.join(managed.npmRoot, retained[0]);
+      expect(
+        fs
+          .readdirSync(quarantinePath, { recursive: true })
+          .some((name) => String(name).endsWith("locked-payload.bin")),
+      ).toBe(true);
+      expect(warnSpy.mock.calls.flat().join("\n")).toContain(quarantinePath);
+      expect(warnSpy.mock.calls.flat().join("\n")).toContain("injected payload cleanup failure");
+      await scenario.repair();
+      expect(
+        Object.keys(
+          (await readRequiredPersistedInstalledPluginIndex(scenario.stateDir)).installRecords,
+        ),
+      ).toEqual([]);
+    } finally {
+      unlinkSpy.mockRestore();
+      warnSpy.mockRestore();
+    }
+  });
+});
