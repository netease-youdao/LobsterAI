+// Some Windows hosts cannot run the PowerShell/Add-Type helper at all: security
+// software blocks powershell.exe, Constrained Language Mode rejects Add-Type, or
+// no C# compiler is available. Disposable staging directories then fall back to
+// a plain child directory, which inherits the ACL of its (user-owned) parent.
+// A genuine "already exists" keeps its meaning, and persistent directories made
+// through createPrivateSqliteDirectory stay fail-closed.
+let privateStagingFallbackWarned = false;
+
+function isDirectoryExistsError(error: unknown): boolean {
+  return (error as NodeJS.ErrnoException | undefined)?.code === "EEXIST";
+}
+
+function warnPrivateStagingFallback(directoryPath: string, error: unknown): void {
+  if (privateStagingFallbackWarned) {
+    return;
+  }
+  privateStagingFallbackWarned = true;
+  const cause = error instanceof Error ? error.cause : undefined;
+  const detail =
+    cause instanceof Error ? cause.message : error instanceof Error ? error.message : String(error);
+  console.warn(
+    `[sqlite] private Windows staging directory creation failed; falling back to a plain directory that inherits its parent ACL (${directoryPath}): ${detail}`,
+  );
+}
+
+async function createStagingDirectoryWithFallback(directoryPath: string): Promise<void> {
+  try {
+    await createPrivateSqliteDirectory(directoryPath);
+  } catch (error) {
+    if (isDirectoryExistsError(error)) {
+      throw error;
+    }
+    warnPrivateStagingFallback(directoryPath, error);
+    try {
+      await fs.mkdir(directoryPath, { mode: SQLITE_DIRECTORY_MODE });
+    } catch (fallbackError) {
+      // Keep the PowerShell diagnostics unless the fallback reports a collision.
+      throw isDirectoryExistsError(fallbackError) ? fallbackError : error;
+    }
+  }
+}
+
+function createStagingDirectoryWithFallbackSync(directoryPath: string): void {
+  try {
+    createPrivateSqliteDirectorySync(directoryPath);
+  } catch (error) {
+    if (isDirectoryExistsError(error)) {
+      throw error;
+    }
+    warnPrivateStagingFallback(directoryPath, error);
+    try {
+      fsSync.mkdirSync(directoryPath, { mode: SQLITE_DIRECTORY_MODE });
+    } catch (fallbackError) {
+      throw isDirectoryExistsError(fallbackError) ? fallbackError : error;
+    }
+  }
+}
+
