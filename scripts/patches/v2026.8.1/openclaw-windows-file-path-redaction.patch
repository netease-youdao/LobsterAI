@@ -0,0 +1,67 @@
+const FILE_PATH_CONTEXT_LIMIT = 4096;
+const FILE_PATH_ROOT =
+  /^(?:file:\/\/\/(?:[A-Za-z]:\/)?|[A-Za-z]:[\\/]|\\\\|\/(?!\/)|~\/|\$(?:HOME|\{HOME\})\/|\.{1,2}\/)/;
+const PATH_ARGUMENT_DELIMITERS = /[\s"'`()[\]{}<>;|&=]/;
+
+/** Exempt only a fragment of a rooted filename, never an ambiguous complete AWS token. */
+export function isAwsSecretFilePathMatch(input: string, offset: number, token: string): boolean {
+  if (offset < 0) {
+    return false;
+  }
+  const tokenEnd = offset + token.length;
+  const hasFilenameContinuation =
+    /^[.-][A-Za-z0-9_]|^\\/.test(input.slice(tokenEnd, tokenEnd + 2)) ||
+    /[A-Za-z0-9_][.-]$|\\$/.test(input.slice(Math.max(0, offset - 2), offset));
+  if (!hasFilenameContinuation) {
+    return false;
+  }
+  const floor = Math.max(0, offset - FILE_PATH_CONTEXT_LIMIT);
+  const ceiling = Math.min(input.length, tokenEnd + FILE_PATH_CONTEXT_LIMIT);
+  const context = input.slice(floor, ceiling);
+  const tokenStart = offset - floor;
+  const end = tokenEnd - floor;
+  const isPath = (start: number, stop: number): boolean => {
+    if (
+      start < 0 ||
+      start >= tokenStart ||
+      stop < end ||
+      stop > context.length ||
+      (start === 0 && floor > 0) ||
+      (stop === context.length && ceiling < input.length)
+    ) {
+      return false;
+    }
+    const candidate = context.slice(start, stop);
+    const root = candidate.match(FILE_PATH_ROOT);
+    // Do not span commands, fields, prose quotes, or URL credentials/query parameters.
+    return root !== null && !/[\r\n"'`<>;|&=?:]/.test(candidate.slice(root[0].length));
+  };
+
+  // Spaces belong to a path only inside its own enclosing argument; nearby prose is not a path.
+  for (const [open, close] of [
+    ['"', '"'],
+    ["'", "'"],
+    ["`", "`"],
+    ["(", ")"],
+    ["<", ">"],
+  ] as const) {
+    const start = context.lastIndexOf(open, tokenStart - 1);
+    if (start < 0) {
+      continue;
+    }
+    const stop = context.indexOf(close, start + 1);
+    if (isPath(start + 1, stop)) {
+      return true;
+    }
+  }
+  let start = tokenStart;
+  let stop = end;
+  while (start > 0 && !PATH_ARGUMENT_DELIMITERS.test(context.charAt(start - 1))) {
+    start -= 1;
+  }
+  while (stop < context.length && !PATH_ARGUMENT_DELIMITERS.test(context.charAt(stop))) {
+    stop += 1;
+  }
+  // A truncated scan cannot establish an argument boundary.
+  return isPath(start, stop);
+}
