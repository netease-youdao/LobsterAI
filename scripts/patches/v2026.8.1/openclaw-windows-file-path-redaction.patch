diff --git a/src/logging/redact-file-path.test.ts b/src/logging/redact-file-path.test.ts
new file mode 100644
--- /dev/null
+++ b/src/logging/redact-file-path.test.ts
@@ -0,0 +1,106 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { AWS_SECRET_ACCESS_KEY_VALUE_REDACT_PATTERN } from "./redact-patterns.js";
+import {
+  computeSensitiveRedactionBitmap,
+  getDefaultRedactPatterns,
+  redactSensitiveText,
+  redactToolPayloadTextWithConfig,
+  resolveRedactOptions,
+} from "./redact.js";
+import { registerSecretValueForRedaction } from "./secret-redaction-registry.js";
+import { resetSecretRedactionRegistryForTest } from "./secret-redaction-registry.test-support.js";
+
+const macPath = "/Users/tester/Library/Application Support/LobsterAI/openclaw/state/gateway-token";
+const linuxPath = "/home/tester/Application-Support/LobsterAI/openclaw/state/gateway-token";
+const windowsPath = "C:/Users/tester/lobsterai/project/chinajoy-ppt/deck.pptx";
+const pathFragment = "Support/LobsterAI/openclaw/state/gateway";
+const secret = "Wj7/".repeat(10);
+const fileComponent = "Gx9Q".repeat(10);
+
+afterEach(resetSecretRedactionRegistryForTest);
+
+describe("file paths in credential redaction", () => {
+  it.each([
+    `cat "${macPath}"`,
+    `The file is \`${macPath}\`.`,
+    `[token file](file://${macPath})`,
+    JSON.stringify({ text: macPath }),
+    JSON.stringify({ command: `cat "${macPath}"` }),
+    linuxPath,
+    `cat '${linuxPath}'`,
+    windowsPath,
+    `[deck](file:///${windowsPath})`,
+    `cat "C:${macPath}"`,
+    String.raw`C:\Users\tester\${fileComponent}.json`,
+    String.raw`C:\Users\tester\${fileComponent}\next.txt`,
+    `/tmp/report-${fileComponent}.txt`,
+    `before\n${"x".repeat(32_760)} cat "${macPath}"\nafter`,
+  ])("preserves the complete path in case %#", (input) => {
+    expect(redactSensitiveText(input, { mode: "tools" })).toBe(input);
+    expect(redactToolPayloadTextWithConfig(input)).toBe(input);
+    const explicitDefaults = { mode: "tools" as const, patterns: getDefaultRedactPatterns() };
+    expect(redactSensitiveText(input, explicitDefaults)).toBe(input);
+    expect(
+      computeSensitiveRedactionBitmap(input, resolveRedactOptions(explicitDefaults)),
+    ).not.toContain(true);
+    expect(
+      computeSensitiveRedactionBitmap(input, resolveRedactOptions({ mode: "tools" })),
+    ).not.toContain(true);
+  });
+
+  it.each([
+    `bare ${secret}`,
+    `bare ${secret}.`,
+    `x:${secret}`,
+    `bare ${"/Ab7".repeat(10)}`,
+    `bare ${"/Ab7".repeat(10)}-suffix`,
+    `bare ${"/Ab7".repeat(10)}.txt`,
+    `bare ${pathFragment}`,
+    `AWS_SECRET_ACCESS_KEY="${secret}"`,
+    JSON.stringify({ SecretAccessKey: secret }),
+    `tool --aws-secret-access-key '${secret}'`,
+    `cat "${macPath}"; printf '${secret}'`,
+    `/tmp/notes ${secret}`,
+    `Read /tmp/notes first; the key is ${secret}`,
+    `path=/tmp/a plus ${secret}-suffix`,
+    `/tmp/a plus ${secret}-suffix`,
+    `/tmp/a ${secret}.json`,
+    `"/tmp/a" ${secret}-suffix`,
+    `echo "/tmp/a" "${secret}"`,
+  ])("still masks credentials in case %#", (input) => {
+    const credential = input.includes(secret)
+      ? secret
+      : input.includes(pathFragment)
+        ? pathFragment
+        : "/Ab7".repeat(10);
+    expect(redactSensitiveText(input, { mode: "tools" })).not.toContain(credential);
+    expect(redactToolPayloadTextWithConfig(input)).not.toContain(credential);
+    expect(
+      computeSensitiveRedactionBitmap(input, resolveRedactOptions({ mode: "tools" })),
+    ).toContain(true);
+  });
+
+  it("keeps custom and registered secret rules authoritative inside paths", () => {
+    const input = `cat "${macPath}"`;
+    expect(redactToolPayloadTextWithConfig(input, { redactPatterns: ["unrelated-marker"] })).toBe(
+      input,
+    );
+    expect(
+      redactToolPayloadTextWithConfig(input, {
+        redactPatterns: [AWS_SECRET_ACCESS_KEY_VALUE_REDACT_PATTERN],
+      }),
+    ).not.toContain(pathFragment);
+    expect(
+      redactToolPayloadTextWithConfig(input, { redactPatterns: [pathFragment] }),
+    ).not.toContain(pathFragment);
+    registerSecretValueForRedaction(pathFragment);
+    expect(redactSensitiveText(input, { mode: "tools" })).not.toContain(pathFragment);
+    expect(redactToolPayloadTextWithConfig(input)).not.toContain(pathFragment);
+  });
+
+  it("still masks explicitly labeled path-shaped credentials", () => {
+    const input = JSON.stringify({ SecretAccessKey: macPath });
+    expect(redactSensitiveText(input, { mode: "tools" })).not.toContain(macPath);
+    expect(redactToolPayloadTextWithConfig(input)).not.toContain(macPath);
+  });
+});
