+export async function runCronIsolatedAgentTurn(
+  params: Parameters<typeof runCronIsolatedAgentTurnInTrace>[0],
+): Promise<RunCronAgentTurnResult> {
+  // A timer can inherit the async trace of the request or prior run that armed it.
+  // Every cron execution owns a fresh root; model retries within it share that root.
+  return runWithDiagnosticTraceContext(createDiagnosticTraceContext(), () =>
+    runCronIsolatedAgentTurnInTrace(params),
+  );
+}
