diff --git a/src/agents/tools/progress-card-tool.visibility.test.ts b/src/agents/tools/progress-card-tool.visibility.test.ts
new file mode 100644
index 00000000..d7acf2e1
--- /dev/null
+++ b/src/agents/tools/progress-card-tool.visibility.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import { finalizeAgentTools } from "../agent-tools.finalize.js";
+import { applyCodeModeCatalog, createCodeModeTools } from "../code-mode.js";
+import { filterToolsByPolicy } from "../tool-policy-match.js";
+import {
+  applyToolSchemaDirectoryCatalog,
+  applyToolSearchCatalog,
+  createToolSearchCatalogRef,
+  createToolSearchTools,
+} from "../tool-search.js";
+import type { AnyAgentTool } from "./common.js";
+import { createProgressCardTool } from "./progress-card-tool.js";
+
+const modes = ["tools", "directory", "code", "code-mode"] as const;
+type Mode = (typeof modes)[number];
+
+function compact(mode: Mode, authorizedTools: AnyAgentTool[]) {
+  const config = {
+    tools: { toolSearch: { enabled: true, mode: mode === "code-mode" ? ("code" as const) : mode } },
+  };
+  const catalogRef = createToolSearchCatalogRef();
+  const controls =
+    mode === "code-mode"
+      ? createCodeModeTools({ config, catalogRef })
+      : createToolSearchTools({ config, catalogRef });
+  const params = { config, catalogRef, tools: [...controls, ...authorizedTools] };
+  const result =
+    mode === "code-mode"
+      ? applyCodeModeCatalog(params)
+      : mode === "directory"
+        ? applyToolSchemaDirectoryCatalog(params)
+        : applyToolSearchCatalog(params);
+  return { ...result, entries: catalogRef.current?.entries ?? [] };
+}
+
+describe("progress_card visibility after tool surface compaction", () => {
+  for (const wrapped of [false, true]) {
+    it.each(modes)(`keeps progress_card directly callable in %s (wrapped=${wrapped})`, (mode) => {
+      const progress = createProgressCardTool({ agentSessionKey: "agent:main:progress" });
+      const tools = wrapped
+        ? finalizeAgentTools({
+            tools: [progress],
+            hookContext: {},
+            abortSignal: new AbortController().signal,
+          })
+        : [progress];
+      const result = compact(mode, tools);
+      expect(result.catalogRegistered).toBe(true);
+      expect(result.tools.map((tool) => tool.name)).toContain("progress_card");
+      expect(result.tools.find((tool) => tool.name === "progress_card")?.execute).toBeTypeOf(
+        "function",
+      );
+      expect(result.entries.map((entry) => entry.name)).not.toContain("progress_card");
+    });
+  }
+
+  it.each(modes)("preserves explicit policy denial in %s", (mode) => {
+    const tools = filterToolsByPolicy(
+      [createProgressCardTool({ agentSessionKey: "agent:main:progress" })],
+      { deny: ["progress_card"] },
+    );
+    const result = compact(mode, tools);
+    expect(result.catalogRegistered).toBe(true);
+    expect(result.tools.map((tool) => tool.name)).not.toContain("progress_card");
+    expect(result.entries.map((entry) => entry.name)).not.toContain("progress_card");
+  });
+});
