+function createDeps(overrides: Partial<ProfileScopedDirectoryDeps> = {}) {
+  const mkdirSync = vi.fn<(target: string) => void>();
+  const rmSync = vi.fn<(target: string) => void>();
+  const warn = vi.fn<(message: string) => void>();
+  const lstatSync = vi.fn(() => ({ isDirectory: () => true, isSymbolicLink: () => false }));
+  const realpathSync = (target: string): string => {
+    const resolved = realPaths.get(target.toLowerCase());
+    if (!resolved) {
+      throw Object.assign(new Error(`ENOENT: ${target}`), { code: "ENOENT" });
+    }
+    return resolved;
+  };
+  const deps: ProfileScopedDirectoryDeps = {
+    env: { USERPROFILE: profile },
+    realpathSync,
+    mkdirSync,
+    lstatSync,
+    rmSync,
+    warn,
+    ...overrides,
+  };
+  return { deps, mkdirSync, rmSync, warn, lstatSync };
+}
+
