+type PrivateDirectoryModule = typeof import("./windows-private-directory.js");
+
+async function loadFreshModule(): Promise<PrivateDirectoryModule> {
+  vi.resetModules();
+  return await import("./windows-private-directory.js");
+}
+
+const profile = "C:\\Users\\Alice";
+const realPaths = new Map<string, string>([
+  ["c:\\users\\alice", profile],
+  ["c:\\users\\alice~1", profile],
+  ["c:\\users\\alice~1\\appdata\\local\\temp", "C:\\Users\\Alice\\AppData\\Local\\Temp"],
+  ["c:\\users\\alice\\appdata\\local\\openclaw", "C:\\Users\\Alice\\AppData\\Local\\openclaw"],
+  ["d:\\shared\\temp", "D:\\Shared\\Temp"],
+]);
+const nativeFailure = new Error("koffi is not available in this build");
