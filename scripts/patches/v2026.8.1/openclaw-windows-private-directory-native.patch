+    expect(
+      isWindowsPathInsideUserProfile(
+        "C:\\Users\\ALICE~1\\AppData\\Local\\Temp\\openclaw-session-import-1",
+        deps,
+      ),
+    ).toBe(true);
+    expect(
+      isWindowsPathInsideUserProfile("C:\\Users\\Alice\\AppData\\Local\\openclaw\\stage-1", deps),
+    ).toBe(true);
+    expect(isWindowsPathInsideUserProfile("C:\\Users\\Alice\\direct-child", deps)).toBe(true);
+    expect(isWindowsPathInsideUserProfile("D:\\Shared\\Temp\\openclaw-x", deps)).toBe(false);
+    expect(isWindowsPathInsideUserProfile("C:\\Users\\AliceOther\\x", deps)).toBe(false);
+    expect(
+      isWindowsPathInsideUserProfile("C:\\Users\\Alice\\x", { ...deps, env: {} }),
+    ).toBe(false);
+    expect(
+      isWindowsPathInsideUserProfile("C:\\Users\\Alice\\x", {
+        ...deps,
+        env: { USERPROFILE: "Users\\Alice" },
+      }),
+    ).toBe(false);
+  });
+
+  it("creates the directory exclusively under the inherited profile ACL", async () => {
+    const { createProfileScopedWindowsDirectory } = await loadFreshModule();
+    const { deps, mkdirSync, lstatSync, rmSync, warn } = createDeps();
+    const directory = "C:\\Users\\ALICE~1\\AppData\\Local\\Temp\\openclaw-session-import-1";
+    createProfileScopedWindowsDirectory(directory, nativeFailure, deps);
+    expect(mkdirSync).toHaveBeenCalledExactlyOnceWith(directory);
+    expect(lstatSync).toHaveBeenCalledExactlyOnceWith(directory);
+    expect(rmSync).not.toHaveBeenCalled();
+    expect(warn).toHaveBeenCalledOnce();
+    expect(warn.mock.calls[0]?.[0]).toContain(nativeFailure.message);
+    expect(warn.mock.calls[0]?.[0]).toContain("C:\\Users\\ALICE~1\\AppData\\Local\\Temp");
+  });
+
+  it("warns once per process across fallback creations", async () => {
+    const { createProfileScopedWindowsDirectory } = await loadFreshModule();
+    const { deps, warn } = createDeps();
+    createProfileScopedWindowsDirectory("C:\\Users\\Alice\\AppData\\Local\\openclaw\\a", nativeFailure, deps);
+    createProfileScopedWindowsDirectory("C:\\Users\\Alice\\AppData\\Local\\openclaw\\b", nativeFailure, deps);
+    expect(warn).toHaveBeenCalledOnce();
+  });
+
+  it("stays fail-closed outside the user profile", async () => {
+    const { createProfileScopedWindowsDirectory } = await loadFreshModule();
+    const { deps, mkdirSync, warn } = createDeps();
+    let error: unknown;
+    try {
+      createProfileScopedWindowsDirectory("D:\\Shared\\Temp\\openclaw-x", nativeFailure, deps);
+    } catch (caught) {
+      error = caught;
+    }
+    expect(error).toBeInstanceOf(Error);
+    expect((error as Error).message).toContain("outside the user profile");
+    expect((error as Error).message).toContain("D:\\Shared\\Temp\\openclaw-x");
+    expect((error as Error & { cause?: unknown }).cause).toBe(nativeFailure);
+    expect(mkdirSync).not.toHaveBeenCalled();
+    expect(warn).not.toHaveBeenCalled();
+  });
+
+  it("propagates exclusive creation failures such as EEXIST", async () => {
+    const { createProfileScopedWindowsDirectory } = await loadFreshModule();
+    const exists = Object.assign(new Error("EEXIST: file already exists"), { code: "EEXIST" });
+    const { deps, rmSync } = createDeps({
+      mkdirSync: () => {
+        throw exists;
+      },
+    });
+    expect(() =>
+      createProfileScopedWindowsDirectory("C:\\Users\\Alice\\AppData\\Local\\openclaw\\a", nativeFailure, deps),
+    ).toThrow(exists);
+    expect(rmSync).not.toHaveBeenCalled();
+  });
+
+  it("removes and rejects a created path that is no longer a plain directory", async () => {
+    const { createProfileScopedWindowsDirectory } = await loadFreshModule();
+    const { deps, rmSync } = createDeps({
+      lstatSync: () => ({ isDirectory: () => true, isSymbolicLink: () => true }),
+    });
+    const directory = "C:\\Users\\Alice\\AppData\\Local\\openclaw\\linked";
+    expect(() => createProfileScopedWindowsDirectory(directory, nativeFailure, deps)).toThrow(
+      /changed after creation/u,
+    );
+    expect(rmSync).toHaveBeenCalledExactlyOnceWith(directory);
+  });
+
+  it("routes a native helper load failure to the profile fallback exactly once", async () => {
+    const { createPrivateWindowsDirectory } = await loadFreshModule();
+    const previousProfile = process.env.USERPROFILE;
+    delete process.env.USERPROFILE;
+    try {
+      for (let attempt = 0; attempt < 2; attempt += 1) {
+        let error: unknown;
+        try {
+          createPrivateWindowsDirectory("D:\\Shared\\Temp\\openclaw-x");
+        } catch (caught) {
+          error = caught;
+        }
+        expect((error as Error).message).toContain("outside the user profile");
+        expect((error as Error & { cause?: Error }).cause?.message).toBe(
+          "Cannot find module 'koffi'",
+        );
+      }
+      expect(loader.calls).toBe(1);
+    } finally {
+      if (previousProfile === undefined) {
+        delete process.env.USERPROFILE;
+      } else {
+        process.env.USERPROFILE = previousProfile;
+      }
+    }
+  });
+});
