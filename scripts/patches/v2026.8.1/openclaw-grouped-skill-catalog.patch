index 00000000000..25ee896f7ff
--- /dev/null
+++ b/src/skills/loading/grouped-skill-catalog.ts
@@ -0,0 +1,155 @@
+import { sliceUtf16Safe } from "@openclaw/normalization-core/utf16-slice";
+import { truncateSkillDescription, type Skill } from "./skill-contract.js";
+
+const CATALOG_HEADER = "<available_skills>\nRoots: ";
+const CATALOG_END = "\n</available_skills>";
+const INSTRUCTIONS =
+  "Skill rows are JSON [name, location, description?, loading note?]. For <location>, a number means Roots[location] + name + the root's separator + SKILL.md. A string is the exact location. Resolve relative references from the skill file's directory.";
+
+function catalogJson(value: unknown): string {
+  // Keep even multiline descriptions and literal closing tags inside their own row.
+  return JSON.stringify(value).replaceAll("<", "\\u003c");
+}
+
+// The longest shared prefix of a string is always with one of its sorted neighbors.
+// Deduplicate identical descriptions first: they have no distinguishing text to show.
+function compactDescriptions(skills: Skill[], maxChars: number): string[] {
+  if (maxChars === 0) {
+    return [];
+  }
+  const descriptions = skills.map(({ description }) => description.replace(/\s+/gu, " ").trim());
+  const sorted = [...new Set(descriptions)].toSorted();
+  const sharedPrefixes = new Map<string, number>();
+  let previous = "";
+  for (const current of sorted) {
+    let shared = 0;
+    while (shared < previous.length && previous[shared] === current[shared]) {
+      shared++;
+    }
+    if (shared > 0) {
+      sharedPrefixes.set(previous, Math.max(sharedPrefixes.get(previous) ?? 0, shared));
+      sharedPrefixes.set(current, shared);
+    }
+    previous = current;
+  }
+
+  return descriptions.map((description) => {
+    const shared = sharedPrefixes.get(description) ?? 0;
+    // The native prefix preview reserves three characters for "...".
+    if (description.length <= maxChars || maxChars < 4 || !shared || shared < maxChars - 3) {
+      return truncateSkillDescription(description, maxChars);
+    }
+    // Keep the opening and a contiguous excerpt around the first difference.
+    // A little preceding context retains qualifiers such as "only for".
+    const context = Math.floor((maxChars - 2) / 4);
+    const head = sliceUtf16Safe(description, 0, context).trimEnd();
+    const split = sliceUtf16Safe(description, 0, shared).length;
+    const detail = sliceUtf16Safe(description, split - context).trimStart();
+    const remaining = maxChars - head.length - 1;
+    const excerpt =
+      detail.length <= remaining
+        ? detail
+        : sliceUtf16Safe(detail, 0, remaining - 1).trimEnd() + "…";
+    return head + "…" + excerpt;
+  });
+}
+
+export function formatGroupedSkillCatalog(skills: Skill[], descriptionMaxChars?: number): string {
+  if (skills.length === 0) {
+    return "";
+  }
+  const roots = new Map<string, number>();
+  const descriptions =
+    descriptionMaxChars === undefined
+      ? undefined
+      : compactDescriptions(skills, descriptionMaxChars);
+  const rows = skills.map((skill, index) => {
+    let location: string | number = skill.filePath;
+    const parts = /^(.*[\\/])([^\\/]+)([\\/])SKILL\.md$/u.exec(skill.filePath);
+    const [, root, directory, separator] = parts ?? [];
+    if (
+      root &&
+      separator &&
+      directory === skill.name &&
+      root.endsWith(separator) &&
+      !skill.filePath.includes("://")
+    ) {
+      location = roots.get(root) ?? roots.size;
+      roots.set(root, location);
+    }
+    const description = descriptions ? (descriptions[index] ?? "") : skill.description;
+    const row: Array<string | number> = [skill.name, location];
+    if (description || skill.locationNote) {
+      row.push(description);
+    }
+    if (skill.locationNote) {
+      row.push(skill.locationNote);
+    }
+    return catalogJson(row);
+  });
+  return (
+    INSTRUCTIONS +
+    "\n" +
+    CATALOG_HEADER +
+    catalogJson([...roots.keys()]) +
+    "\n" +
+    rows.join("\n") +
+    CATALOG_END
+  );
+}
+
+// Undefined denotes the native XML format. Malformed grouped catalogs yield no entries.
+export function parseGroupedSkillCatalog(
+  prompt: string,
+): Array<{ name: string; location: string; blockChars: number }> | undefined {
+  const start = prompt.indexOf(CATALOG_HEADER);
+  if (start === -1) {
+    return undefined;
+  }
+  const end = prompt.indexOf(CATALOG_END, start + CATALOG_HEADER.length);
+  if (end === -1) {
+    return [];
+  }
+  const [header, ...rows] = prompt.slice(start + CATALOG_HEADER.length, end).split("\n");
+  try {
+    const roots: unknown = JSON.parse(header ?? "");
+    if (
+      !Array.isArray(roots) ||
+      !roots.every((root) => typeof root === "string" && /[\\/]$/u.test(root))
+    ) {
+      return [];
+    }
+    const entries = [];
+    for (const row of rows) {
+      const fields: unknown = JSON.parse(row);
+      if (
+        !Array.isArray(fields) ||
+        fields.length < 2 ||
+        fields.length > 4 ||
+        typeof fields[0] !== "string" ||
+        !fields[0] ||
+        !fields.slice(2).every((field) => typeof field === "string")
+      ) {
+        return [];
+      }
+      const [name, reference] = fields;
+      let location = reference;
+      if (
+        typeof reference === "number" &&
+        Number.isInteger(reference) &&
+        reference >= 0 &&
+        reference < roots.length
+      ) {
+        const root = roots[reference] as string;
+        location = root + name + root.slice(-1) + "SKILL.md";
+      }
+      if (typeof location !== "string" || !location) {
+        return [];
+      }
+      entries.push({ name, location, blockChars: row.length });
+    }
+    return entries;
+  } catch {
+    return [];
+  }
+}
