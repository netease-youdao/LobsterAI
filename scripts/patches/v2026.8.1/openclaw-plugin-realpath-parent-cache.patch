diff --git a/src/plugins/realpath-through-parent.test.ts b/src/plugins/realpath-through-parent.test.ts
new file mode 100644
index 0000000..855cde8
--- /dev/null
+++ b/src/plugins/realpath-through-parent.test.ts
@@ -0,0 +1,62 @@
+/** Tests realpath resolution through cached parent directories. */
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { safeRealpathWithParentsSync } from "./realpath-through-parent.js";
+
+let tempRoot: string;
+
+beforeEach(() => {
+  tempRoot = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-realpath-parent-")));
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  fs.rmSync(tempRoot, { recursive: true, force: true });
+});
+
+function writeFile(relativePath: string): string {
+  const filePath = path.join(tempRoot, relativePath);
+  fs.mkdirSync(path.dirname(filePath), { recursive: true });
+  fs.writeFileSync(filePath, "");
+  return filePath;
+}
+
+function linkDirectory(target: string, link: string): void {
+  fs.symlinkSync(target, link, process.platform === "win32" ? "junction" : "dir");
+}
+
+describe("safeRealpathWithParentsSync", () => {
+  it("returns what fs.realpathSync returns, through linked directories", () => {
+    const cache = new Map<string, string>();
+    const file = writeFile(path.join("plugin", "dist", "index.js"));
+    linkDirectory(path.join(tempRoot, "plugin"), path.join(tempRoot, "linked"));
+    const viaLink = path.join(tempRoot, "linked", "dist", "index.js");
+
+    expect(safeRealpathWithParentsSync(file, cache)).toBe(fs.realpathSync(file));
+    expect(safeRealpathWithParentsSync(viaLink, cache)).toBe(fs.realpathSync(viaLink));
+    expect(safeRealpathWithParentsSync(viaLink, cache)).toBe(file);
+  });
+
+  it("reuses cached parents so sibling paths cost one lstat", () => {
+    const cache = new Map<string, string>();
+    const manifest = writeFile(path.join("a", "b", "plugin", "openclaw.plugin.json"));
+    const packageJson = writeFile(path.join("a", "b", "plugin", "package.json"));
+    safeRealpathWithParentsSync(manifest, cache);
+
+    const lstat = vi.spyOn(fs, "lstatSync");
+    expect(safeRealpathWithParentsSync(packageJson, cache)).toBe(packageJson);
+    expect(lstat).toHaveBeenCalledTimes(1);
+  });
+
+  it("returns null for missing paths without caching them", () => {
+    const cache = new Map<string, string>();
+    const missing = path.join(tempRoot, "plugin", "index.js");
+
+    expect(safeRealpathWithParentsSync(missing, cache)).toBeNull();
+    expect(cache.has(missing)).toBe(false);
+    writeFile(path.join("plugin", "index.js"));
+    expect(safeRealpathWithParentsSync(missing, cache)).toBe(missing);
+  });
+});
diff --git a/src/plugins/realpath-through-parent.ts b/src/plugins/realpath-through-parent.ts
new file mode 100644
index 0000000..2abb474
--- /dev/null
+++ b/src/plugins/realpath-through-parent.ts
@@ -0,0 +1,49 @@
+/**
+ * Realpaths plugin paths through their already-resolved parent directory.
+ *
+ * fs.realpathSync lstat's every path component on each call. Plugin discovery
+ * and index checks realpath thousands of files under a few directories, and on
+ * Windows hosts where security software makes each metadata call under
+ * %APPDATA%/%LOCALAPPDATA% cost about 1ms those repeated walks dominated
+ * startup. Reusing the parent's realpath from the caller's cache costs one
+ * lstat per new path and returns what fs.realpathSync returns.
+ */
+import fs from "node:fs";
+import path from "node:path";
+
+/** Throws like fs.realpathSync when the path is missing; links fall back to it. */
+export function realpathThroughParentSync(
+  targetPath: string,
+  realpathParent: (parentPath: string) => string | null,
+): string {
+  const absolute = path.resolve(targetPath);
+  const parent = path.dirname(absolute);
+  if (parent === absolute || fs.lstatSync(absolute).isSymbolicLink()) {
+    return fs.realpathSync(absolute);
+  }
+  const realParent = realpathParent(parent);
+  return realParent === null
+    ? fs.realpathSync(absolute)
+    : path.join(realParent, path.basename(absolute));
+}
+
+/** safeRealpathSync that also keeps each resolved parent directory in `cache`. */
+export function safeRealpathWithParentsSync(
+  targetPath: string,
+  cache: Map<string, string>,
+): string | null {
+  const cached = cache.get(targetPath);
+  if (cached) {
+    return cached;
+  }
+  try {
+    const resolved = realpathThroughParentSync(targetPath, (parentPath) =>
+      safeRealpathWithParentsSync(parentPath, cache),
+    );
+    cache.set(targetPath, resolved);
+    cache.set(resolved, resolved);
+    return resolved;
+  } catch {
+    return null;
+  }
+}
