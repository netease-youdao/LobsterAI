@@ -0,0 +1,101 @@
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { cleanupTempDirs, makeTempDir } from "../../../test/helpers/temp-dir.js";
+import * as agentDatabase from "../../state/openclaw-agent-db.js";
+import {
+  applySessionEntryLifecycleMutation,
+  loadTranscriptEvents,
+  resetSessionEntryLifecycle,
+  upsertSessionEntryCore,
+} from "./session-accessor.js";
+import { appendTranscriptMessageSync } from "./session-accessor.sqlite-transcript-write.js";
+import { CURRENT_SESSION_VERSION } from "./version.js";
+
+type Scope = { sessionId: string; sessionKey: string; storePath: string };
+
+function eventTypes(events: readonly unknown[]): unknown[] {
+  return events.map((event) => (event as { type?: unknown }).type);
+}
+
+describe("reset boundary on an empty transcript", () => {
+  const tempDirs: string[] = [];
+  let storePath: string;
+
+  beforeEach(() => {
+    storePath = path.join(
+      makeTempDir(tempDirs, "openclaw-reset-empty-transcript-"),
+      "sessions.json",
+    );
+  });
+
+  afterEach(() => {
+    agentDatabase.closeOpenClawAgentDatabasesForTest();
+    cleanupTempDirs(tempDirs);
+  });
+
+  const resets = [
+    {
+      name: "single reset",
+      reset: async (scope: Scope) =>
+        resetSessionEntryLifecycle({
+          buildNextEntry: () => ({ sessionId: scope.sessionId, updatedAt: 20 }),
+          resetBoundary: { context: "clear", reason: "new" },
+          storePath: scope.storePath,
+          target: { canonicalKey: scope.sessionKey, storeKeys: [scope.sessionKey] },
+        }),
+    },
+    {
+      name: "bulk lifecycle reset",
+      reset: async (scope: Scope) =>
+        applySessionEntryLifecycleMutation({
+          skipMaintenance: true,
+          storePath: scope.storePath,
+          upserts: [
+            {
+              entry: { sessionId: scope.sessionId, updatedAt: 20 },
+              resetBoundary: { context: "clear", reason: "new" },
+              sessionKey: scope.sessionKey,
+            },
+          ],
+        }),
+    },
+  ];
+
+  it.each(resets)(
+    "keeps the session header first after a $name of a new session",
+    async ({ reset }) => {
+      // A channel "/new" can reach a session whose entry exists but whose
+      // transcript has no rows yet.
+      const scope = { sessionId: "fresh-session", sessionKey: "agent:main:empty-reset", storePath };
+      await upsertSessionEntryCore(scope, { sessionId: scope.sessionId, updatedAt: 10 });
+
+      await reset(scope);
+      expect(await loadTranscriptEvents(scope)).toEqual([]);
+
+      appendTranscriptMessageSync(scope, {
+        eventId: "first",
+        message: { role: "user", content: "first message" },
+        parentId: null,
+      });
+      const events = await loadTranscriptEvents(scope);
+      expect(eventTypes(events)).toEqual(["session", "message"]);
+      expect(events[0]).toMatchObject({ type: "session", version: CURRENT_SESSION_VERSION });
+    },
+  );
+
+  it.each(resets)("still bounds a transcript that has history ($name)", async ({ reset }) => {
+    const scope = { sessionId: "used-session", sessionKey: "agent:main:used-reset", storePath };
+    await upsertSessionEntryCore(scope, { sessionId: scope.sessionId, updatedAt: 10 });
+    appendTranscriptMessageSync(scope, {
+      eventId: "earlier",
+      message: { role: "user", content: "earlier" },
+      parentId: null,
+    });
+
+    await reset(scope);
+
+    const events = await loadTranscriptEvents(scope);
+    expect(eventTypes(events)).toEqual(["session", "message", "reset"]);
+    expect(events[2]).toMatchObject({ parentId: "earlier", reason: "new" });
+  });
+});
