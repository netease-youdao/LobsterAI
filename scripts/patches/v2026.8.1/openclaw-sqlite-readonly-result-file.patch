--- /dev/null
+++ b/src/infra/sqlite-readonly-result-file.ts
@@ -0,0 +1,127 @@
+// Keep worker protocol data separate from stdout, which native process hooks can write to.
+import fs from "node:fs";
+import path from "node:path";
+import { sameFileIdentity } from "./fs-safe-advanced.js";
+import {
+  createPrivateSqliteTempDirectory,
+  createPrivateSqliteTempDirectorySync,
+  resolvePrivateSqliteSnapshotStagingRoot,
+} from "./sqlite-private-directory.js";
+
+export const SQLITE_READONLY_RESULT_FILE_ARG = "--openclaw-sqlite-readonly-result-file";
+const RESULT_DIRECTORY_PREFIX = `openclaw-sqlite-result-${process.pid}-`;
+const MAX_RESULT_BYTES = 64 * 1024;
+const SQLITE_READONLY_STDERR_TAIL_CHARS = 4_000;
+
+export type SqliteReadOnlyWorkerResult =
+  | { ok: true; location: string }
+  | { ok: false; message: string };
+
+export async function createSqliteReadOnlyResultFile(): Promise<string> {
+  const directory = await createPrivateSqliteTempDirectory(
+    resolvePrivateSqliteSnapshotStagingRoot(),
+    RESULT_DIRECTORY_PREFIX,
+  );
+  return path.join(directory, "result.json");
+}
+
+export function createSqliteReadOnlyResultFileSync(): string {
+  const directory = createPrivateSqliteTempDirectorySync(
+    resolvePrivateSqliteSnapshotStagingRoot(),
+    RESULT_DIRECTORY_PREFIX,
+  );
+  return path.join(directory, "result.json");
+}
+
+function readSqliteReadOnlyResultText(resultPath: string): string {
+  // The parent owns this private directory and reads only after the child exits.
+  const identity = fs.lstatSync(resultPath, { bigint: true });
+  if (!identity.isFile() || identity.nlink !== 1n || identity.size > BigInt(MAX_RESULT_BYTES)) {
+    throw new Error("SQLite read-only worker returned an invalid result file");
+  }
+  const descriptor = fs.openSync(
+    resultPath,
+    fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0),
+  );
+  try {
+    const opened = fs.fstatSync(descriptor, { bigint: true });
+    if (!sameFileIdentity(identity, opened) || !opened.isFile() || opened.nlink !== 1n) {
+      throw new Error("SQLite read-only worker result file changed while opening");
+    }
+    const buffer = Buffer.alloc(MAX_RESULT_BYTES + 1);
+    let length = 0;
+    while (length < buffer.length) {
+      const count = fs.readSync(descriptor, buffer, length, buffer.length - length, null);
+      if (count === 0) {
+        break;
+      }
+      length += count;
+    }
+    if (length > MAX_RESULT_BYTES) {
+      throw new Error("SQLite read-only worker returned an oversized result file");
+    }
+    return buffer.subarray(0, length).toString("utf8");
+  } finally {
+    fs.closeSync(descriptor);
+  }
+}
+
+export function writeSqliteReadOnlyResultFile(
+  resultPath: string,
+  result: SqliteReadOnlyWorkerResult,
+): void {
+  // Exclusive creation rejects stale files; the containing directory supplies the Windows DACL.
+  fs.writeFileSync(resultPath, JSON.stringify(result), {
+    encoding: "utf8",
+    flag: "wx",
+    mode: 0o600,
+  });
+}
+
+function isSqliteReadOnlyWorkerResult(value: unknown): value is SqliteReadOnlyWorkerResult {
+  if (!value || typeof value !== "object" || Array.isArray(value)) {
+    return false;
+  }
+  if (Object.keys(value).length !== 2 || !("ok" in value)) {
+    return false;
+  }
+  return (
+    (value.ok === true && "location" in value && typeof value.location === "string") ||
+    (value.ok === false && "message" in value && typeof value.message === "string")
+  );
+}
+
+export function createSqliteReadOnlyWorkerError(message: string, stderr: string): Error {
+  const stderrTail = stderr.trim().slice(-SQLITE_READONLY_STDERR_TAIL_CHARS);
+  return new Error(
+    `SQLite read-only worker ${message}${stderrTail ? `\nstderr (tail): ${stderrTail}` : ""}`,
+  );
+}
+
+export function readSqliteReadOnlyWorkerResult(
+  resultPath: string,
+  stderr: string,
+): SqliteReadOnlyWorkerResult {
+  let json: string;
+  try {
+    json = readSqliteReadOnlyResultText(resultPath);
+  } catch (error) {
+    throw createSqliteReadOnlyWorkerError(
+      `result could not be read: ${error instanceof Error ? error.message : String(error)}`,
+      stderr,
+    );
+  }
+  if (!json.trim()) {
+    throw createSqliteReadOnlyWorkerError("returned no JSON result", stderr);
+  }
+  let message: unknown;
+  try {
+    message = JSON.parse(json);
+  } catch {
+    throw createSqliteReadOnlyWorkerError("returned invalid JSON", stderr);
+  }
+  if (!isSqliteReadOnlyWorkerResult(message)) {
+    throw createSqliteReadOnlyWorkerError("returned an invalid result", stderr);
+  }
+  return message;
+}
