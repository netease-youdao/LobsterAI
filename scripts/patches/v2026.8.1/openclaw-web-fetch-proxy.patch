new file mode 100644
--- /dev/null
+++ b/src/agents/tools/web-fetch.proxy.integration.test.ts
@@ -0,0 +1,199 @@
+import { createServer, type Server } from "node:http";
+import { connect } from "node:net";
+import type { Duplex } from "node:stream";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { LookupFn, SsrFPolicy } from "../../infra/net/ssrf.js";
+import { createWebFetchTool } from "./web-fetch.js";
+
+const PUBLIC_HOST = "public.example.test";
+const PUBLIC_ADDRESS = "93.184.216.34";
+const BYPASS_HOST = "localhost";
+const PRIVATE_HOST = "private.example.test";
+
+async function listen(server: Server): Promise<number> {
+  await new Promise<void>((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", () => {
+      server.off("error", reject);
+      resolve();
+    });
+  });
+  const address = server.address();
+  if (!address || typeof address === "string") {
+    throw new Error("Expected TCP listener");
+  }
+  return address.port;
+}
+
+describe("web_fetch environment proxy boundary", () => {
+  let origin: Server;
+  let proxy: Server;
+  let originPort: number;
+  const sockets = new Set<Duplex>();
+  const connects: string[] = [];
+  const hosts: string[] = [];
+  const lookup = vi.fn<LookupFn>();
+
+  function ownSocket(socket: Duplex): void {
+    sockets.add(socket);
+    socket.once("close", () => sockets.delete(socket));
+    socket.on("error", () => socket.destroy());
+  }
+
+  function fetchPage(
+    path: string,
+    options?: {
+      hostname?: string;
+      useProxy?: boolean;
+      ssrfPolicy?: SsrFPolicy;
+    },
+  ) {
+    const tool = createWebFetchTool({
+      config: {
+        tools: {
+          web: {
+            fetch: {
+              useTrustedEnvProxy: options?.useProxy ?? true,
+              ssrfPolicy: options?.ssrfPolicy,
+              cacheTtlMinutes: 0,
+              timeoutSeconds: 5,
+            },
+          },
+        },
+      },
+      lookupFn: lookup,
+    });
+    if (!tool) {
+      throw new Error("Expected enabled web_fetch tool");
+    }
+    return tool.execute("proxy-boundary", {
+      url: `http://${options?.hostname ?? PUBLIC_HOST}:${originPort}${path}`,
+    });
+  }
+
+  beforeEach(async () => {
+    connects.length = 0;
+    hosts.length = 0;
+    lookup.mockReset();
+    lookup.mockImplementation(async (hostname) => [
+      {
+        address:
+          hostname === PRIVATE_HOST || hostname === BYPASS_HOST ? "127.0.0.1" : PUBLIC_ADDRESS,
+        family: 4,
+      },
+    ]);
+    origin = createServer((req, res) => {
+      hosts.push(req.headers.host ?? "");
+      if (req.url === "/redirect-private" || req.url === "/redirect-bypass") {
+        const hostname = req.url === "/redirect-private" ? PRIVATE_HOST : BYPASS_HOST;
+        res.writeHead(302, { location: `http://${hostname}:${originPort}/done` });
+        res.end();
+      } else {
+        res.writeHead(200, { "content-type": "text/plain" });
+        res.end("proxy boundary fixture");
+      }
+    });
+    origin.on("connection", ownSocket);
+    originPort = await listen(origin);
+    proxy = createServer((_req, res) => {
+      res.writeHead(405);
+      res.end();
+    });
+    proxy.on("connection", ownSocket);
+    proxy.on("connect", (req, socket, head) => {
+      connects.push(req.url ?? "");
+      // This fixture routes only to its own origin; no request leaves loopback.
+      const upstream = connect(originPort, "127.0.0.1", () => {
+        socket.write("HTTP/1.1 200 Connection Established\r\n\r\n");
+        if (head.length > 0) {
+          upstream.write(head);
+        }
+        socket.pipe(upstream);
+        upstream.pipe(socket);
+      });
+      ownSocket(upstream);
+    });
+    const proxyPort = await listen(proxy);
+    for (const key of ["HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy"]) {
+      vi.stubEnv(key, `http://127.0.0.1:${proxyPort}`);
+    }
+    for (const key of ["NO_PROXY", "no_proxy", "OPENCLAW_PROXY_ACTIVE"]) {
+      vi.stubEnv(key, "");
+    }
+  });
+
+  afterEach(async () => {
+    for (const socket of sockets) {
+      socket.destroy();
+    }
+    await Promise.all(
+      [origin, proxy].map(
+        (server) =>
+          new Promise<void>((resolve, reject) => {
+            server.close((error) => (error ? reject(error) : resolve()));
+          }),
+      ),
+    );
+    vi.unstubAllEnvs();
+  });
+
+  it("pins the proxy CONNECT to validated DNS while preserving the destination Host", async () => {
+    const result = await fetchPage("/public");
+    expect(result.details).toMatchObject({ status: 200 });
+    expect(connects).toEqual([`${PUBLIC_ADDRESS}:${originPort}`]);
+    expect(hosts).toEqual([`${PUBLIC_HOST}:${originPort}`]);
+    expect(lookup).toHaveBeenCalledWith(PUBLIC_HOST, { all: true });
+  });
+
+  it("blocks private DNS answers before connecting to the proxy", async () => {
+    await expect(fetchPage("/private", { hostname: PRIVATE_HOST })).rejects.toThrow(
+      /private|internal|blocked/i,
+    );
+    expect(connects).toEqual([]);
+    expect(hosts).toEqual([]);
+  });
+
+  it("rejects mixed public and private DNS answers before connecting", async () => {
+    lookup.mockResolvedValue([
+      { address: PUBLIC_ADDRESS, family: 4 },
+      { address: "127.0.0.1", family: 4 },
+    ]);
+    await expect(fetchPage("/mixed-dns")).rejects.toThrow(/private|internal|blocked/i);
+    expect(connects).toEqual([]);
+  });
+
+  it("revalidates a redirect before it can reach private DNS through the proxy", async () => {
+    await expect(fetchPage("/redirect-private")).rejects.toThrow(/private|internal|blocked/i);
+    expect(connects).toEqual([`${PUBLIC_ADDRESS}:${originPort}`]);
+    expect(hosts).toEqual([`${PUBLIC_HOST}:${originPort}`]);
+  });
+
+  it("honors NO_PROXY after a redirect while preserving explicit host policy", async () => {
+    vi.stubEnv("no_proxy", BYPASS_HOST);
+    const result = await fetchPage("/redirect-bypass", {
+      ssrfPolicy: { allowedHostnames: [BYPASS_HOST] },
+    });
+    expect(result.details).toMatchObject({ status: 200 });
+    expect(connects).toEqual([`${PUBLIC_ADDRESS}:${originPort}`]);
+    expect(hosts).toEqual([`${PUBLIC_HOST}:${originPort}`, `${BYPASS_HOST}:${originPort}`]);
+  });
+
+  it("keeps the private DNS policy for NO_PROXY targets", async () => {
+    vi.stubEnv("no_proxy", PRIVATE_HOST);
+    await expect(fetchPage("/private-bypass", { hostname: PRIVATE_HOST })).rejects.toThrow(
+      /private|internal|blocked/i,
+    );
+    expect(connects).toEqual([]);
+  });
+
+  it("ignores inherited proxy settings when the fetch preference is disabled", async () => {
+    const result = await fetchPage("/direct", {
+      hostname: BYPASS_HOST,
+      useProxy: false,
+      ssrfPolicy: { allowedHostnames: [BYPASS_HOST] },
+    });
+    expect(result.details).toMatchObject({ status: 200 });
+    expect(connects).toEqual([]);
+    expect(hosts).toEqual([`${BYPASS_HOST}:${originPort}`]);
+  });
+});
