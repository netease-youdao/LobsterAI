+// Image- and tool-heavy history can reach the embedded runner's model-context byte bound
+// while prompt tokens stay below the compaction threshold. The bounded load then drops the
+// oldest history unsummarized and rewrites the cached prefix (openclaw/openclaw#159799), so
+// compact before the bound instead. A boundary whose retained tail alone is this large cannot
+// shrink further; new history must first grow by one step, and so must a retry after a miss.
+const MODEL_CONTEXT_BYTES_COMPACTION_RATIO = 0.8;
+const MODEL_CONTEXT_BYTES_STEP_DIVISOR = 4;
+const MAX_MODEL_CONTEXT_BYTES_RETRY_SESSIONS = 256;
+const modelContextBytesCompactionRetryFloor = new Map<string, number>();
+
+function shouldCompactByModelContextBytes(params: {
+  retryKey: string;
+  activeTranscriptBytes: number | undefined;
+  contextHydrationMaxBytes: number;
+  readRetainedPrefixBytes: () => number;
+}): boolean {
+  const { activeTranscriptBytes, contextHydrationMaxBytes } = params;
+  if (
+    typeof activeTranscriptBytes !== "number" ||
+    activeTranscriptBytes < contextHydrationMaxBytes * MODEL_CONTEXT_BYTES_COMPACTION_RATIO
+  ) {
+    return false;
+  }
+  const step = contextHydrationMaxBytes / MODEL_CONTEXT_BYTES_STEP_DIVISOR;
+  const retryFloor = modelContextBytesCompactionRetryFloor.get(params.retryKey);
+  if (retryFloor !== undefined && activeTranscriptBytes < retryFloor + step) {
+    return false;
+  }
+  try {
+    return activeTranscriptBytes - params.readRetainedPrefixBytes() >= step;
+  } catch {
+    return false;
+  }
+}
+
+function recordModelContextBytesCompactionMiss(retryKey: string, bytes: number | undefined): void {
+  if (typeof bytes !== "number") {
+    return;
+  }
+  modelContextBytesCompactionRetryFloor.delete(retryKey);
+  modelContextBytesCompactionRetryFloor.set(retryKey, bytes);
+  if (modelContextBytesCompactionRetryFloor.size > MAX_MODEL_CONTEXT_BYTES_RETRY_SESSIONS) {
+    const oldest = modelContextBytesCompactionRetryFloor.keys().next().value;
+    if (oldest !== undefined) {
+      modelContextBytesCompactionRetryFloor.delete(oldest);
+    }
+  }
+}
