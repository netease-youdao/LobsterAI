diff --git a/src/agents/embedded-agent-runner/run/session-context-limits.ts b/src/agents/embedded-agent-runner/run/session-context-limits.ts
new file mode 100644
index 00000000000..65e873db375
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/session-context-limits.ts
@@ -0,0 +1,14 @@
+/**
+ * Byte and event limits for hydrating one embedded attempt's model-context history.
+ * Preflight compaction measures against the same byte limit, so history is summarized
+ * before the bounded load would silently omit it (openclaw/openclaw#159799).
+ */
+export function resolveEmbeddedSessionContextLimits(contextTokenBudget: number | undefined): {
+  maxBytes: number;
+  maxEvents: number;
+} {
+  return {
+    maxBytes: Math.min(64 * 1024 * 1024, Math.max(1024, (contextTokenBudget ?? 128_000) * 8)),
+    maxEvents: 10_000,
+  };
+}
