       Math.min(maxSearchLimit, readInteger(raw.searchDefaultLimit, DEFAULT_SEARCH_LIMIT)),
     ),
     maxSearchLimit,
+    ...readDirectToolNames(raw.direct),
   };
 }
 
+function readDirectToolNames(value: unknown): { directToolNames?: readonly string[] } {
+  if (!Array.isArray(value)) {
+    return {};
+  }
+  const names = [
+    ...new Set(
+      value
+        .filter((entry): entry is string => typeof entry === "string")
+        .map((entry) => entry.trim())
+        .filter(Boolean),
+    ),
+  ];
+  return names.length > 0 ? { directToolNames: names } : {};
+}
