+/**
+ * Operator-pinned names from tools.toolSearch.direct: exact names, or a
+ * trailing `*` prefix such as `lobster-word__*` for one MCP server. Unlike the
+ * implicit required names above, an explicit pin may name an MCP tool, but only
+ * when that name is unique in the run so a lookalike cannot take its place.
+ */
+export function createOperatorPinnedToolMatcher(
+  names: Iterable<string> | undefined,
+): ((tool: AnyAgentTool, uniqueNames: ReadonlySet<string>) => boolean) | undefined {
+  const exact = new Set<string>();
+  const prefixes: string[] = [];
+  for (const raw of names ?? []) {
+    const name = raw.trim();
+    if (!name) {
+      continue;
+    }
+    if (name.endsWith("*")) {
+      const prefix = name.slice(0, -1);
+      if (prefix) {
+        prefixes.push(prefix);
+      }
+    } else {
+      exact.add(name);
+    }
+  }
+  if (exact.size === 0 && prefixes.length === 0) {
+    return undefined;
+  }
+  return (tool, uniqueNames) =>
+    uniqueNames.has(tool.name) &&
+    (exact.has(tool.name) || prefixes.some((prefix) => tool.name.startsWith(prefix)));
+}
