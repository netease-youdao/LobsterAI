index 00000000000..994032d9448
--- /dev/null
+++ b/src/agents/embedded-agent-runner/run/malformed-tool-call-recovery.ts
@@ -0,0 +1,141 @@
+/**
+ * Continues a turn whose final provider tool call was rejected before it ran.
+ *
+ * Transports reject incomplete or malformed tool-call arguments at the terminal boundary,
+ * so the call never executes. Continuing after the committed transcript therefore cannot
+ * replay a side effect, which lets this recovery run after earlier tools committed work,
+ * unlike the non-visible-answer retries that resubmit a replay-safe turn.
+ */
+import { sanitizeForLog } from "../../../../packages/terminal-core/src/ansi.js";
+import { projectAgentRunAttemptTerminal } from "../../agent-run-terminal-outcome.js";
+import { log } from "../logger.js";
+import type { IncompleteTurnAttempt } from "./incomplete-turn-classification.js";
+import {
+  isEmbeddedRunTerminalAbort,
+  isEmbeddedRunTerminalInterrupted,
+  isEmbeddedRunTerminalTimeout,
+  type EmbeddedRunTerminalState,
+} from "./terminal-outcome.js";
+import type { EmbeddedRunTerminalRetryState } from "./terminal-retry-state.js";
+
+export const MALFORMED_TOOL_CALL_RETRY_LIMIT = 2;
+const MALFORMED_TOOL_CALL_RETRY_INSTRUCTION =
+  "Your previous tool call was rejected before it ran because its arguments were not complete, valid JSON, so it had no effect. Continue from the current transcript and issue that tool call again with valid JSON arguments (escape quotes, backslashes, and line breaks inside strings). If the arguments are large, split the work into several smaller tool calls. Do not repeat tool calls that already completed.";
+/** Transport fact recorded when a provider tool call is rejected at the terminal boundary. */
+const MALFORMED_TOOL_CALL_DIAGNOSTIC_TYPE = "malformed_tool_call_arguments";
+// Terminal rejections from transports that surface the failed argument parse as text only.
+const MALFORMED_TOOL_CALL_ERROR_MESSAGES = new Set([
+  "Provider returned an incomplete or malformed tool call",
+  "Provider completed tool call with malformed JSON arguments",
+]);
+const MALFORMED_TOOL_CALL_LOG_FIELDS = [
+  "reason",
+  "providerStopReason",
+  "toolCallCount",
+  "argumentChars",
+  "parseError",
+  "parseErrorPosition",
+  "repairAttempted",
+] as const;
+
+type TerminalAssistant = IncompleteTurnAttempt["lastAssistant"] | null;
+
+/** True when the provider's final tool call was rejected at the terminal boundary and never ran. */
+export function isMalformedToolCallAssistantTurn(assistant: TerminalAssistant): boolean {
+  if (!assistant || assistant.stopReason !== "error") {
+    return false;
+  }
+  if (
+    assistant.diagnostics?.some(
+      (diagnostic) => diagnostic.type === MALFORMED_TOOL_CALL_DIAGNOSTIC_TYPE,
+    )
+  ) {
+    return true;
+  }
+  const errorMessage = assistant.errorMessage?.trim();
+  return errorMessage !== undefined && MALFORMED_TOOL_CALL_ERROR_MESSAGES.has(errorMessage);
+}
+
+/** Content-free summary of the rejected call's transport diagnostic for runner logs. */
+export function describeMalformedToolCallDiagnostic(assistant: TerminalAssistant): string {
+  const details = assistant?.diagnostics?.findLast(
+    (diagnostic) => diagnostic.type === MALFORMED_TOOL_CALL_DIAGNOSTIC_TYPE,
+  )?.details;
+  if (!details) {
+    return "diagnostic=none";
+  }
+  return MALFORMED_TOOL_CALL_LOG_FIELDS.flatMap((field) => {
+    const value = details[field];
+    return typeof value === "string" || typeof value === "number" || typeof value === "boolean"
+      ? [`${field}=${sanitizeForLog(String(value)).slice(0, 64)}`]
+      : [];
+  }).join(" ");
+}
+
+/** Builds the continuation instruction when the attempt ended on a rejected tool call. */
+export function resolveMalformedToolCallRetryInstruction(params: {
+  aborted: boolean;
+  timedOut: boolean;
+  attempt: IncompleteTurnAttempt;
+}): string | null {
+  if (
+    params.aborted ||
+    params.timedOut ||
+    params.attempt.terminal.kind === "failed" ||
+    params.attempt.clientToolCalls ||
+    params.attempt.yieldDetected ||
+    params.attempt.didSendDeterministicApprovalPrompt
+  ) {
+    return null;
+  }
+  const assistant = params.attempt.currentAttemptAssistant ?? params.attempt.lastAssistant ?? null;
+  return isMalformedToolCallAssistantTurn(assistant) ? MALFORMED_TOOL_CALL_RETRY_INSTRUCTION : null;
+}
+
+/**
+ * Arms one bounded continuation for a rejected tool call and reports whether the run should
+ * retry. Exhausted continuations fall through to the ordinary incomplete-turn resolution.
+ */
+export function continueAfterMalformedToolCall(input: {
+  runParams: { runId: string; sessionId: string };
+  attempt: IncompleteTurnAttempt;
+  retryState: EmbeddedRunTerminalRetryState;
+  terminalState: EmbeddedRunTerminalState;
+  activeErrorContext: { provider: string; model: string };
+  activateInternalPrompt: (prompt: string) => void;
+}): boolean {
+  const { outcome } = input.terminalState;
+  const { promptError } = projectAgentRunAttemptTerminal(input.attempt.terminal);
+  const instruction =
+    isEmbeddedRunTerminalInterrupted(outcome) || promptError
+      ? null
+      : resolveMalformedToolCallRetryInstruction({
+          aborted: isEmbeddedRunTerminalAbort(outcome),
+          timedOut: isEmbeddedRunTerminalTimeout(outcome),
+          attempt: input.attempt,
+        });
+  if (!instruction) {
+    return false;
+  }
+  const { retryState } = input;
+  const context =
+    `runId=${input.runParams.runId} sessionId=${input.runParams.sessionId} ` +
+    `provider=${input.activeErrorContext.provider}/${input.activeErrorContext.model} ` +
+    describeMalformedToolCallDiagnostic(
+      input.attempt.currentAttemptAssistant ?? input.attempt.lastAssistant ?? null,
+    );
+  if (retryState.malformedToolCallAttempts >= MALFORMED_TOOL_CALL_RETRY_LIMIT) {
+    log.warn(
+      `malformed tool call continuations exhausted: ${context} ` +
+        `attempts=${retryState.malformedToolCallAttempts}/${MALFORMED_TOOL_CALL_RETRY_LIMIT} — surfacing incomplete-turn error`,
+    );
+    return false;
+  }
+  retryState.malformedToolCallAttempts += 1;
+  input.activateInternalPrompt(instruction);
+  log.warn(
+    `malformed tool call rejected before execution: ${context} — retrying ` +
+      `${retryState.malformedToolCallAttempts}/${MALFORMED_TOOL_CALL_RETRY_LIMIT} with tool-call continuation`,
+  );
+  return true;
+}
