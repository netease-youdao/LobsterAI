+
+describe("terminal resolution for a rejected provider tool call", () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  it("continues a side-effecting turn after the provider's tool call is rejected", async () => {
+    const input = makeTerminalInput(malformedToolCallAssistant());
+
+    await expect(resolveEmbeddedRunTerminal(input)).resolves.toEqual({ action: "retry" });
+    expect(input.activateInternalPrompt).toHaveBeenCalledWith(
+      expect.stringContaining("rejected before it ran"),
+    );
+    expect(input.retryState.malformedToolCallAttempts).toBe(1);
+    expect(input.setSuppressNextUserMessagePersistence).not.toHaveBeenCalled();
+  });
+
+  it("continues when the transport surfaced the rejection as text only", async () => {
+    const input = makeTerminalInput(
+      malformedToolCallAssistant({
+        diagnostics: undefined,
+        errorMessage: "Provider completed tool call with malformed JSON arguments",
+      }),
+    );
+
+    await expect(resolveEmbeddedRunTerminal(input)).resolves.toEqual({ action: "retry" });
+    expect(input.retryState.malformedToolCallAttempts).toBe(1);
+  });
+
+  it("surfaces the incomplete-turn error once continuations are exhausted", async () => {
+    const retryState = createEmbeddedRunTerminalRetryState();
+    retryState.malformedToolCallAttempts = 2;
+    const input = makeTerminalInput(malformedToolCallAssistant(), { retryState });
+
+    const resolved = await resolveEmbeddedRunTerminal(input);
+
+    expect(resolved.action).toBe("complete");
+    if (resolved.action !== "complete") {
+      return;
+    }
+    expect(resolved.result.payloads?.[0]?.text).toContain(
+      "some tool actions may have already been executed",
+    );
+    expect(resolved.result.meta.error?.kind).toBe("incomplete_turn");
+    expect(input.activateInternalPrompt).not.toHaveBeenCalled();
+    expect(retryState.malformedToolCallAttempts).toBe(2);
+  });
+
+  it("does not continue after isolated finalization was attempted", async () => {
+    const input = makeTerminalInput(malformedToolCallAssistant(), {
+      settledTurnFinalizationOutcome: "failed",
+    });
+
+    const resolved = await resolveEmbeddedRunTerminal(input);
+
+    expect(resolved.action).toBe("complete");
+    expect(input.activateInternalPrompt).not.toHaveBeenCalled();
+  });
+
+  it("keeps other provider errors on the incomplete-turn path", async () => {
+    const input = makeTerminalInput(
+      malformedToolCallAssistant({
+        diagnostics: undefined,
+        errorMessage: "500 Internal Server Error",
+      }),
+    );
+
+    const resolved = await resolveEmbeddedRunTerminal(input);
+
+    expect(resolved.action).toBe("complete");
+    expect(input.activateInternalPrompt).not.toHaveBeenCalled();
+    expect(input.retryState.malformedToolCallAttempts).toBe(0);
+  });
+
+  it("does not request isolated finalization for a rejected tool call", () => {
+    const toolUseAssistant = buildEmbeddedRunnerAssistant({
+      stopReason: "toolUse",
+      content: [{ type: "toolCall", id: "tool-1", name: "write", arguments: {} }],
+    });
+    const request = (assistant: Assistant) => {
+      const attempt = makeEmbeddedRunnerAttempt({
+        assistantTexts: [],
+        lastAssistant: assistant,
+        currentAttemptAssistant: assistant,
+        messagesSnapshot: [
+          { role: "user", content: "Update the report", timestamp: 1 },
+          toolUseAssistant,
+          {
+            role: "toolResult",
+            toolCallId: "tool-1",
+            toolName: "write",
+            content: [{ type: "text", text: "Wrote note.txt" }],
+            isError: false,
+            timestamp: 2,
+          },
+          assistant,
+        ],
+        toolMetas: [{ toolName: "write", toolCallId: "tool-1", replaySafe: false }],
+        itemLifecycle: { startedCount: 1, completedCount: 1, activeCount: 0 },
+        replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+        currentAttemptReplayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+      });
+      return resolveSettledTurnFinalizationRequest({
+        runParams: { sessionId: "session:malformed", runId: "run:malformed" } as never,
+        attempt,
+        activeErrorContext: { provider: "openai", model: "gpt-5.6-luna" },
+        modelApi: "openai-responses",
+        executionContract: undefined,
+        payloadsWithToolMedia: [],
+        hasTerminalToolPresentation: false,
+        terminalState: resolveEmbeddedRunAttemptTerminalState({ attempt, assistant }),
+        settledTurnFinalizationAvailable: true,
+      });
+    };
+
+    // A final-answer pass would drop the action the model was still taking; the
+    // rejected call resumes through the malformed-call continuation instead.
+    expect(request(malformedToolCallAssistant())).toBeNull();
+    expect(
+      request(
+        buildEmbeddedRunnerAssistant({ stopReason: "stop", content: [{ type: "text", text: "" }] }),
+      ),
+    ).toBe(SETTLED_TOOL_TERMINAL_CONTINUATION_INSTRUCTION);
+  });
+});
