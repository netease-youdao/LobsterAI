+import { describe, expect, it, vi } from "vitest";
+import {
+  buildEmbeddedRunnerAssistant,
+  makeEmbeddedRunnerAttempt,
+} from "../../test-helpers/embedded-agent-runner-e2e-fixtures.js";
+import {
+  continueAfterMalformedToolCall,
+  describeMalformedToolCallDiagnostic,
+  isMalformedToolCallAssistantTurn,
+  MALFORMED_TOOL_CALL_RETRY_LIMIT,
+  resolveMalformedToolCallRetryInstruction,
+} from "./malformed-tool-call-recovery.js";
+import { resolveEmbeddedRunAttemptTerminalState } from "./terminal-outcome.js";
+import { createEmbeddedRunTerminalRetryState } from "./terminal-retry-state.js";
+
+function malformedToolCallAssistant(
+  overrides: Parameters<typeof buildEmbeddedRunnerAssistant>[0] = {},
+) {
+  return buildEmbeddedRunnerAssistant({
+    api: "openai-completions",
+    stopReason: "error",
+    errorMessage: "Provider returned an incomplete or malformed tool call",
+    content: [{ type: "thinking", thinking: "Update the report section next." }],
+    diagnostics: [
+      {
+        type: "malformed_tool_call_arguments",
+        timestamp: 1,
+        details: {
+          toolCallCount: 1,
+          providerStopReason: "toolUse",
+          reason: "invalid_arguments",
+          argumentChars: 812,
+          argumentHash: "abc123",
+          repairAttempted: true,
+          parseError: "unexpected_token",
+          parseErrorPosition: 401,
+        },
+      },
+    ],
+    ...overrides,
+  });
+}
+
+function sideEffectingAttempt(
+  assistant: ReturnType<typeof buildEmbeddedRunnerAssistant>,
+  overrides: Parameters<typeof makeEmbeddedRunnerAttempt>[0] = {},
+) {
+  return makeEmbeddedRunnerAttempt({
+    assistantTexts: [],
+    lastAssistant: assistant,
+    currentAttemptAssistant: assistant,
+    toolMetas: [
+      { toolName: "write", replaySafe: false },
+      { toolName: "exec", replaySafe: false },
+    ],
+    replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+    currentAttemptReplayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+    ...overrides,
+  });
+}
+
+function continuationInput(attempt: ReturnType<typeof makeEmbeddedRunnerAttempt>) {
+  return {
+    runParams: { runId: "run:malformed", sessionId: "session:malformed" },
+    attempt,
+    retryState: createEmbeddedRunTerminalRetryState(),
+    terminalState: resolveEmbeddedRunAttemptTerminalState({
+      attempt,
+      assistant: attempt.currentAttemptAssistant ?? attempt.lastAssistant,
+    }),
+    activeErrorContext: { provider: "lobsterai-server", model: "deepseek-flash" },
+    activateInternalPrompt: vi.fn(),
+  };
+}
+
+describe("isMalformedToolCallAssistantTurn", () => {
+  it.each([
+    { name: "transport diagnostic", assistant: malformedToolCallAssistant() },
+    {
+      name: "completions rejection text",
+      assistant: malformedToolCallAssistant({ diagnostics: undefined }),
+    },
+    {
+      name: "terminal argument parse text",
+      assistant: malformedToolCallAssistant({
+        diagnostics: undefined,
+        errorMessage: "Provider completed tool call with malformed JSON arguments",
+      }),
+    },
+  ])("recognizes a rejected tool call from its $name", ({ assistant }) => {
+    expect(isMalformedToolCallAssistantTurn(assistant)).toBe(true);
+  });
+
+  it.each([
+    { name: "missing assistant", assistant: null },
+    {
+      name: "non-error stop",
+      assistant: malformedToolCallAssistant({ stopReason: "toolUse" }),
+    },
+    {
+      name: "unrelated provider error",
+      assistant: malformedToolCallAssistant({
+        diagnostics: undefined,
+        errorMessage: "500 Internal Server Error",
+      }),
+    },
+    {
+      name: "unrelated diagnostic",
+      assistant: malformedToolCallAssistant({
+        errorMessage: "Provider finish_reason: content_filter",
+        diagnostics: [{ type: "provider_refusal", timestamp: 1 }],
+      }),
+    },
+  ])("ignores a $name", ({ assistant }) => {
+    expect(isMalformedToolCallAssistantTurn(assistant)).toBe(false);
+  });
+});
+
+describe("describeMalformedToolCallDiagnostic", () => {
+  it("summarizes only whitelisted, content-free diagnostic fields", () => {
+    expect(describeMalformedToolCallDiagnostic(malformedToolCallAssistant())).toBe(
+      "reason=invalid_arguments providerStopReason=toolUse toolCallCount=1 argumentChars=812 " +
+        "parseError=unexpected_token parseErrorPosition=401 repairAttempted=true",
+    );
+    expect(
+      describeMalformedToolCallDiagnostic(malformedToolCallAssistant({ diagnostics: undefined })),
+    ).toBe("diagnostic=none");
+  });
+});
+
+describe("resolveMalformedToolCallRetryInstruction", () => {
+  it("continues after committed tool side effects", () => {
+    const instruction = resolveMalformedToolCallRetryInstruction({
+      aborted: false,
+      timedOut: false,
+      attempt: sideEffectingAttempt(malformedToolCallAssistant()),
+    });
+    expect(instruction).toContain("rejected before it ran");
+    expect(instruction).toContain("Do not repeat tool calls that already completed.");
+  });
+
+  it.each([
+    { name: "caller abort", aborted: true, timedOut: false, overrides: {} },
+    { name: "timeout", aborted: false, timedOut: true, overrides: {} },
+    {
+      name: "failed prompt",
+      aborted: false,
+      timedOut: false,
+      overrides: { terminal: { kind: "failed", source: "prompt", error: new Error("boom") } },
+    },
+    {
+      name: "pending client tool",
+      aborted: false,
+      timedOut: false,
+      overrides: { clientToolCalls: [{ name: "pending", params: {} }] },
+    },
+    { name: "yield", aborted: false, timedOut: false, overrides: { yieldDetected: true } },
+    {
+      name: "approval prompt",
+      aborted: false,
+      timedOut: false,
+      overrides: { didSendDeterministicApprovalPrompt: true },
+    },
+  ] as const)("does not continue after a $name", ({ aborted, timedOut, overrides }) => {
+    expect(
+      resolveMalformedToolCallRetryInstruction({
+        aborted,
+        timedOut,
+        attempt: sideEffectingAttempt(malformedToolCallAssistant(), overrides),
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("continueAfterMalformedToolCall", () => {
+  it("arms bounded internal continuations and then yields to incomplete-turn resolution", () => {
+    const input = continuationInput(sideEffectingAttempt(malformedToolCallAssistant()));
+
+    for (let attempt = 1; attempt <= MALFORMED_TOOL_CALL_RETRY_LIMIT; attempt += 1) {
+      expect(continueAfterMalformedToolCall(input)).toBe(true);
+      expect(input.retryState.malformedToolCallAttempts).toBe(attempt);
+    }
+    expect(continueAfterMalformedToolCall(input)).toBe(false);
+    expect(input.retryState.malformedToolCallAttempts).toBe(MALFORMED_TOOL_CALL_RETRY_LIMIT);
+    expect(input.activateInternalPrompt).toHaveBeenCalledTimes(MALFORMED_TOOL_CALL_RETRY_LIMIT);
+    expect(input.activateInternalPrompt).toHaveBeenCalledWith(
+      expect.stringContaining("rejected before it ran"),
+    );
+  });
+
+  it.each([
+    {
+      name: "external abort",
+      overrides: { terminal: { kind: "aborted", source: "external" } },
+    },
+    {
+      name: "failed prompt",
+      overrides: { terminal: { kind: "failed", source: "prompt", error: new Error("boom") } },
+    },
+  ] as const)("does not arm a continuation after an $name", ({ overrides }) => {
+    const input = continuationInput(sideEffectingAttempt(malformedToolCallAssistant(), overrides));
+
+    expect(continueAfterMalformedToolCall(input)).toBe(false);
+    expect(input.retryState.malformedToolCallAttempts).toBe(0);
+    expect(input.activateInternalPrompt).not.toHaveBeenCalled();
+  });
+
+  it("leaves other provider errors to the ordinary terminal path", () => {
+    const input = continuationInput(
+      sideEffectingAttempt(
+        malformedToolCallAssistant({
+          diagnostics: undefined,
+          errorMessage: "500 Internal Server Error",
+        }),
+      ),
+    );
+
+    expect(continueAfterMalformedToolCall(input)).toBe(false);
+    expect(input.activateInternalPrompt).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/agents/embedded-agent-runner/run/malformed-tool-call-recovery.ts b/src/agents/embedded-agent-runner/run/malformed-tool-call-recovery.ts
