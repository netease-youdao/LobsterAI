+// Full-entry coverage for continuing a turn after the provider's tool call was rejected.
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import { buildEmbeddedRunnerAssistant } from "../test-helpers/embedded-agent-runner-e2e-fixtures.js";
+import { makeAttemptResult } from "./run.overflow-compaction.fixture.js";
+import {
+  mockedRunEmbeddedAttempt,
+  resetSharedRunIntegrationHarnessMocks,
+} from "./run.overflow-compaction.harness.js";
+import {
+  createSharedRunIntegrationSession,
+  loadSharedRunIntegrationHarness,
+} from "./run.shared-integration-harness.test-support.js";
+
+let session: Awaited<ReturnType<typeof createSharedRunIntegrationSession>>;
+let runEmbeddedAgent: Awaited<ReturnType<typeof loadSharedRunIntegrationHarness>>;
+
+const rejectedEditAssistant = buildEmbeddedRunnerAssistant({
+  api: "openai-completions",
+  stopReason: "error",
+  errorMessage: "Provider returned an incomplete or malformed tool call",
+  content: [{ type: "thinking", thinking: "Update the report section next." }],
+  diagnostics: [
+    {
+      type: "malformed_tool_call_arguments",
+      timestamp: 1,
+      details: { toolCallCount: 1, reason: "invalid_arguments", parseError: "unexpected_token" },
+    },
+  ],
+});
+
+// An earlier write committed a side effect, then the model's next call was rejected.
+function makeRejectedToolCallAttempt() {
+  return makeAttemptResult({
+    assistantTexts: [],
+    lastAssistant: rejectedEditAssistant,
+    currentAttemptAssistant: rejectedEditAssistant,
+    toolMetas: [{ toolName: "write", toolCallId: "call-write", replaySafe: false }],
+    replayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+    currentAttemptReplayMetadata: { hadPotentialSideEffects: true, replaySafe: false },
+  });
+}
+
+function requireAttemptCall(index: number): {
+  prompt?: string;
+  sessionId?: string;
+  suppressNextUserMessagePersistence?: boolean;
+} {
+  const call = mockedRunEmbeddedAttempt.mock.calls[index];
+  if (!call) {
+    throw new Error(`expected embedded attempt call ${index}`);
+  }
+  return call[0] as {
+    prompt?: string;
+    sessionId?: string;
+    suppressNextUserMessagePersistence?: boolean;
+  };
+}
+
+describe("runEmbeddedAgent malformed tool-call continuation", () => {
+  beforeAll(async () => {
+    runEmbeddedAgent = await loadSharedRunIntegrationHarness();
+  });
+
+  beforeEach(async () => {
+    resetSharedRunIntegrationHarnessMocks();
+    session = await createSharedRunIntegrationSession();
+  });
+
+  afterEach(async () => {
+    await session?.cleanup();
+  });
+
+  it("continues from the transcript after the provider rejects a tool call", async () => {
+    mockedRunEmbeddedAttempt
+      .mockResolvedValueOnce(makeRejectedToolCallAttempt())
+      .mockResolvedValueOnce(makeAttemptResult());
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-malformed-tool-call-continuation",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(2);
+    const initial = requireAttemptCall(0);
+    const retry = requireAttemptCall(1);
+    expect(retry.prompt).toContain("rejected before it ran");
+    expect(retry.prompt).not.toBe(session.runParams.prompt);
+    // The continuation is model-only context, never a persisted user turn.
+    expect(retry.suppressNextUserMessagePersistence).toBe(true);
+    expect(retry.sessionId).toBe(initial.sessionId);
+    expect(result.meta.error).toBeUndefined();
+  });
+
+  it("surfaces the incomplete-turn error after the bounded continuations", async () => {
+    mockedRunEmbeddedAttempt
+      .mockResolvedValueOnce(makeRejectedToolCallAttempt())
+      .mockResolvedValueOnce(makeRejectedToolCallAttempt())
+      .mockResolvedValueOnce(makeRejectedToolCallAttempt());
+
+    const result = await runEmbeddedAgent({
+      ...session.runParams,
+      runId: "run-malformed-tool-call-exhausted",
+    });
+
+    expect(mockedRunEmbeddedAttempt).toHaveBeenCalledTimes(3);
+    expect(result.meta.error?.kind).toBe("incomplete_turn");
+    expect(result.payloads?.[0]?.text).toContain(
+      "some tool actions may have already been executed",
+    );
+  });
+});
