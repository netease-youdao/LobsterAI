+function fastForwardMissedRecurringJobs(
+  state: CronServiceState,
+  nowMs: number,
+  opts?: { skipJobIds?: ReadonlySet<string> },
+): ReadonlySet<string> {
+  const missedJobIds = new Set(
+    collectRunnableJobs(state, nowMs, {
+      skipJobIds: opts?.skipJobIds,
+      skipAtIfAlreadyRan: true,
+      allowCronMissedRunByLastRun: true,
+    })
+      .filter((job) => job.schedule.kind !== "at")
+      .map((job) => job.id),
+  );
+  if (missedJobIds.size === 0) {
+    return missedJobIds;
+  }
+
+  const notifications: DeferredCronNotifications = [];
+  const result = commitCronRuntimeRows({
+    state,
+    jobIds: missedJobIds,
+    operationLabel: "cron.skip-missed-jobs",
+    mutate: ({ jobs }) => {
+      const committed: CronJob[] = [];
+      const skippedJobs: Array<{
+        jobId: string;
+        name: string;
+        previousNextRunAtMs: number | undefined;
+        nextRunAtMs: number | undefined;
+      }> = [];
+      for (const jobId of missedJobIds) {
+        const job = jobs.get(jobId);
+        if (!job || !isJobEnabled(job) || job.schedule.kind === "at") {
+          continue;
+        }
+        const previousNextRunAtMs = job.state.nextRunAtMs;
+        recomputeJobNextRunAtMs({ state, job, nowMs, deferredNotifications: notifications });
+        committed.push(job);
+        skippedJobs.push({
+          jobId: job.id,
+          name: job.name,
+          previousNextRunAtMs,
+          nextRunAtMs: job.state.nextRunAtMs,
+        });
+      }
+      return {
+        upsertJobIds: committed.map((job) => job.id),
+        value: { committed, skippedJobs },
+      };
+    },
+  });
+  applyCronRuntimeRowsToState(state, result.committed);
+  runPostPersistCronNotifications(state, notifications);
+  state.deps.log.info(
+    {
+      skipMissedJobs: true,
+      skippedCount: result.skippedJobs.length,
+      skippedJobs: result.skippedJobs,
+    },
+    "cron: skipping missed jobs after restart",
+  );
+  return new Set(result.skippedJobs.map((entry) => entry.jobId));
+}
