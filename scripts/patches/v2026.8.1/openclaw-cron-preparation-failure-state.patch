+      return null;
+    });
+
+    try {
+      const failure = await run(state, job.id, "force").catch((error: unknown) => error);
+      expect(failure).toBeInstanceOf(AggregateError);
+      expect((failure as AggregateError).message).toContain("without process start identity");
