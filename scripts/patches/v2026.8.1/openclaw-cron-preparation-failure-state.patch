+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createDueIsolatedJob,
+  noopLogger,
+  setupCronRegressionFixtures,
+} from "../../../test/helpers/cron/service-regression-fixtures.js";
+import * as pidAlive from "../../shared/pid-alive.js";
+import {
+  openOpenClawStateDatabase,
+  runOpenClawStateWriteTransaction,
+} from "../../state/openclaw-state-db.js";
+import { loadCronStore, saveCronStore } from "../store.js";
+import { cronStoreKey } from "../store/key.js";
+import {
+  claimCronRunReceiptInDatabase,
+  finishCronRunReceipt,
+  inspectActiveCronRunReceipt,
+  prepareCronRunReceiptClaim,
+} from "../store/run-receipt-store.js";
+import { readCronTaskRunHistoryPage } from "../task-run-history.js";
+import type { CronJob } from "../types.js";
+import { stop } from "./ops-lifecycle.js";
+import { list } from "./ops-read.js";
+import { enqueueRun, run } from "./ops-run.js";
+import { persistQueuedCronRunReservations } from "./run-admission.js";
+import { commitCronRuntimeRows } from "./runtime-store.js";
+import { createCronServiceState, type CronEvent, type CronServiceState } from "./state.js";
+import { runMissedJobs } from "./timer-catchup.js";
+import { onTimer } from "./timer.test-support.js";
+
+const fixtures = setupCronRegressionFixtures({ prefix: "cron-preparation-failure-" });
+const now = Date.parse("2026-02-06T10:05:00.000Z");
+const states: CronServiceState[] = [];
+
+afterEach(() => {
+  for (const state of states.splice(0)) {
+    stop(state);
+  }
+});
+
+function makeState(storePath: string, onEvent = vi.fn<(event: CronEvent) => void>()) {
+  const runIsolatedAgentJob = vi.fn(async () => ({ status: "ok" as const }));
+  const state = createCronServiceState({
+    cronEnabled: true,
+    storePath,
+    log: noopLogger,
+    nowMs: () => now,
+    enqueueSystemEvent: vi.fn(),
+    requestHeartbeat: vi.fn(),
+    runIsolatedAgentJob,
+    onEvent,
+  });
+  states.push(state);
+  return { state, onEvent, runIsolatedAgentJob };
+}
+
+function makeJob(id: string, nextRunAtMs = now): CronJob {
+  return createDueIsolatedJob({ id, nowMs: now, nextRunAtMs });
+}
+
+function history(storePath: string, jobId: string) {
+  return readCronTaskRunHistoryPage({ storeKey: cronStoreKey(storePath), jobId }).entries;
+}
+
+describe("cron preparation failure settlement", () => {
+  it.each([undefined, "ok"] as const)(
+    "persists an enqueued failure over prior %s status before its single finished event",
+    async (priorStatus) => {
+      const { storePath } = fixtures.makeStorePath();
+      const job = makeJob(`enqueued-${priorStatus ?? "never"}`, now + 60_000);
+      if (priorStatus) {
+        job.state.lastRunAtMs = now - 60_000;
+        job.state.lastRunStatus = priorStatus;
+        job.state.lastStatus = priorStatus;
+      }
+      await saveCronStore(storePath, { version: 1, jobs: [job] });
+      const stateAtEvent: unknown[] = [];
+      const onEvent = vi.fn((event: CronEvent) => {
+        if (event.action === "finished") {
+          const row = openOpenClawStateDatabase()
+            .db.prepare("SELECT state_json FROM cron_jobs WHERE store_key = ? AND job_id = ?")
+            .get(cronStoreKey(storePath), job.id) as { state_json: string };
+          stateAtEvent.push(JSON.parse(row.state_json));
+        }
+      });
+      const { state, runIsolatedAgentJob } = makeState(storePath, onEvent);
+      vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockReturnValue(null);
+
+      const ack = await enqueueRun(state, job.id, "force");
+      await vi.waitFor(() =>
+        expect(onEvent).toHaveBeenCalledWith(
+          expect.objectContaining({ action: "finished", status: "error" }),
+        ),
+      );
+
+      const finished = onEvent.mock.calls
+        .map(([event]) => event)
+        .filter((event) => event.action === "finished");
+      expect(finished).toHaveLength(1);
+      expect(stateAtEvent).toEqual([
+        expect.objectContaining({ lastRunStatus: "error", lastRunAtMs: now }),
+      ]);
+      expect(runIsolatedAgentJob).not.toHaveBeenCalled();
+      expect(inspectActiveCronRunReceipt({ storePath, jobId: job.id })).toBeUndefined();
+      const reloaded = await list(makeState(storePath).state, { includeDisabled: true });
+      expect(reloaded[0]?.state).toMatchObject({
+        lastRunStatus: "error",
+        lastStatus: "error",
+        lastDurationMs: 0,
+      });
+      expect(reloaded[0]?.state.runningAtMs).toBeUndefined();
+      expect(reloaded[0]?.state.queuedAtMs).toBeUndefined();
+      expect(history(storePath, job.id)).toEqual([
+        expect.objectContaining({
+          status: "error",
+          runId: "runId" in ack ? ack.runId : undefined,
+          durationMs: 0,
+        }),
+      ]);
+    },
+  );
+
+  it.each(["at", "every"] as const)(
+    "preserves the future %s schedule for failed force runs",
+    async (kind) => {
+      const { storePath } = fixtures.makeStorePath();
+      const job = makeJob(`forced-${kind}`, now + 60_000);
+      if (kind === "every") {
+        job.schedule = { kind, everyMs: 60_000, anchorMs: now };
+      }
+      await saveCronStore(storePath, { version: 1, jobs: [job] });
+      const { state, onEvent } = makeState(storePath);
+      vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockReturnValue(null);
+
+      await expect(run(state, job.id, "force")).rejects.toThrow("without process start identity");
+
+      expect((await loadCronStore(storePath)).jobs[0]).toMatchObject({
+        enabled: true,
+        state: { lastRunStatus: "error", nextRunAtMs: now + 60_000, consecutiveErrors: 1 },
+      });
+      expect(onEvent.mock.calls.filter(([event]) => event.action === "finished")).toHaveLength(1);
+    },
+  );
+
+  it.each(["timer", "catchup"] as const)(
+    "records a failed %s attempt and schedules recurring backoff",
+    async (entry) => {
+      const { storePath } = fixtures.makeStorePath();
+      const job = makeJob(`scheduled-${entry}`);
+      job.schedule = { kind: "every", everyMs: 10_000, anchorMs: now - 10_000 };
+      await saveCronStore(storePath, { version: 1, jobs: [job] });
+      const { state, runIsolatedAgentJob } = makeState(storePath);
+      vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockReturnValue(null);
+
+      await (entry === "timer" ? onTimer(state) : runMissedJobs(state));
+
+      const persisted = (await loadCronStore(storePath)).jobs[0];
+      expect(persisted?.state).toMatchObject({ lastRunStatus: "error", consecutiveErrors: 1 });
+      expect(persisted?.state.nextRunAtMs).toBeGreaterThan(now);
+      expect(state.runAdmission.active).toBe(0);
+      expect(state.queuedRunReservationsByJobId.size).toBe(0);
+      expect(runIsolatedAgentJob).not.toHaveBeenCalled();
+      expect(history(storePath, job.id)).toHaveLength(1);
+    },
+  );
+
+  it("does not strand another due job when only one preparation fails", async () => {
+    const { storePath } = fixtures.makeStorePath();
+    const failed = makeJob("failed-first");
+    const sibling = makeJob("successful-sibling");
+    await saveCronStore(storePath, { version: 1, jobs: [failed, sibling] });
+    const { state, runIsolatedAgentJob } = makeState(storePath);
+    vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockReturnValueOnce(null);
+
+    await onTimer(state);
+
+    expect(runIsolatedAgentJob).toHaveBeenCalledOnce();
+    expect(history(storePath, failed.id)[0]?.status).toBe("error");
+    expect(history(storePath, sibling.id)[0]?.status).toBe("ok");
+    expect(state.runAdmission.active).toBe(0);
+  });
+
+  it.each([
+    "edited",
+    "deleted",
+    "finalized",
+    "queued",
+    "running",
+    "reactivated",
+    "replaced-source",
+  ] as const)(
+    "does not overwrite concurrent %s state with a stale preparation failure",
+    async (change) => {
+      const { storePath } = fixtures.makeStorePath();
+      const job = makeJob(`stale-${change}`);
+      await saveCronStore(storePath, { version: 1, jobs: [job] });
+      const { state, onEvent } = makeState(storePath);
+      await list(state);
+      vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockImplementationOnce(() => {
+        commitCronRuntimeRows({
+          state,
+          jobIds: [job.id],
+          operationLabel: "test.concurrent-job-change",
+          mutate: ({ jobs }) => {
+            const current = jobs.get(job.id)!;
+            if (change === "deleted") {
+              return { value: undefined, deleteJobIds: [job.id] };
+            }
+            if (change === "edited") {
+              current.name = "new owner definition";
+            }
+            if (change === "finalized") {
+              current.state.lastRunAtMs = now + 1;
+              current.state.lastRunStatus = "ok";
+            }
+            if (change === "queued") {
+              current.state.queuedAtMs = now + 1;
+            }
+            if (change === "running") {
+              current.state.runningAtMs = now + 1;
+            }
+            if (change === "reactivated") {
+              current.state.scheduleActivatedAtMs = now + 1;
+            }
+            if (change === "replaced-source") {
+              current.state.streamSourceIdentity = "successor-source";
+            }
+            return { value: undefined, upsertJobIds: [job.id] };
+          },
+        });
+        return null;
+      });
+
+      await expect(
+        persistQueuedCronRunReservations({ state, candidates: [job], reservedAtMs: now }),
+      ).resolves.toEqual([]);
+
+      const persisted = (await loadCronStore(storePath)).jobs[0];
+      if (change === "deleted") {
+        expect(persisted).toBeUndefined();
+      }
+      if (change === "edited") {
+        expect(persisted?.name).toBe("new owner definition");
+      }
+      if (change === "finalized") {
+        expect(persisted?.state.lastRunStatus).toBe("ok");
+      }
+      if (change === "queued") {
+        expect(persisted?.state.queuedAtMs).toBe(now + 1);
+      }
+      if (change === "running") {
+        expect(persisted?.state.runningAtMs).toBe(now + 1);
+      }
+      if (change === "reactivated") {
+        expect(persisted?.state.scheduleActivatedAtMs).toBe(now + 1);
+      }
+      if (change === "replaced-source") {
+        expect(persisted?.state.streamSourceIdentity).toBe("successor-source");
+      }
+      expect(persisted?.state.lastError).toBeUndefined();
+      expect(onEvent).not.toHaveBeenCalled();
+      expect(history(storePath, job.id)).toEqual([]);
+    },
+  );
+
+  it("preserves an active durable receipt even when its job has no runtime marker", async () => {
+    const { storePath } = fixtures.makeStorePath();
+    const job = makeJob("receipt-without-marker");
+    await saveCronStore(storePath, { version: 1, jobs: [job] });
+    const { state, onEvent } = makeState(storePath);
+    await list(state);
+    const prepared = prepareCronRunReceiptClaim({
+      storePath,
+      job,
+      agentId: "main",
+      startedAtMs: now,
+    });
+    const receipt = runOpenClawStateWriteTransaction(({ db }) =>
+      claimCronRunReceiptInDatabase({
+        database: db,
+        prepared,
+        resolveAgentId: () => "main",
+      }),
+    );
+    vi.spyOn(pidAlive, "getFileLockProcessStartTime").mockReturnValue(null);
+
+    try {
+      await expect(
+        persistQueuedCronRunReservations({ state, candidates: [job], reservedAtMs: now }),
+      ).resolves.toEqual([]);
+      expect(inspectActiveCronRunReceipt({ storePath, jobId: job.id })?.receiptId).toBe(
+        receipt.receiptId,
+      );
+      expect((await loadCronStore(storePath)).jobs[0]?.state.lastRunStatus).toBeUndefined();
+      expect(onEvent).not.toHaveBeenCalled();
+    } finally {
+      finishCronRunReceipt({ handle: receipt, status: "skipped", finishedAtMs: now + 1 });
+    }
+  });
+
+  it.each(["edited", "deleted"] as const)(
