+import { resolveCronJobConfigRevision } from "../config-revision.js";
+import { createCronRunDiagnosticsFromError } from "../run-diagnostics.js";
+import { findActiveCronRunReceiptInDatabase } from "../store/run-receipt-store.js";
+import type { CronJob } from "../types.js";
+import { normalizeCronRunErrorText } from "./execution-errors.js";
+import { failureNotificationDeliveryFromJobState } from "./failure-alerts.js";
+import { applyCronRuntimeRowsToState, commitCronRuntimeRows } from "./runtime-store.js";
+import {
+  emit,
+  type CronEvent,
+  type CronServiceState,
+  type DeferredCronNotifications,
+} from "./state.js";
+import { runPostPersistCronNotifications } from "./store.js";
+import { tryFinishCronTaskRun } from "./task-runs.js";
+import { applyJobResult } from "./timer-outcomes.js";
+
+export type CronPreparationFailureHandler = (
+  event: CronEvent & { action: "finished" },
+  error: unknown,
+) => void;
+
+/** A preparation failure owns no receipt; it may settle only an unchanged, unclaimed job. */
+export function finishCronRunPreparationFailure(params: {
+  state: CronServiceState;
+  job: CronJob;
+  error: unknown;
+  lifecycleGeneration: number;
+  scheduleMode: "advance" | "preserve";
+  scheduleOwnershipAtMs: number;
+  onFailure?: CronPreparationFailureHandler;
+}): void {
+  const { state, job } = params;
+  const finishedAt = state.deps.nowMs();
+  const errorText = normalizeCronRunErrorText(params.error);
+  const result = {
+    status: "error" as const,
+    completionStatus: "failed" as const,
+    error: errorText,
+    diagnostics: createCronRunDiagnosticsFromError("cron-preflight", errorText, {
+      nowMs: state.deps.nowMs,
+    }),
+    executionStarted: false,
+    deliveryAttempted: false,
+    startedAt: finishedAt,
+    endedAt: finishedAt,
+  };
+  const notifications: DeferredCronNotifications = [];
+  let committed: CronJob | undefined;
+  try {
+    committed = commitCronRuntimeRows({
+      state,
+      jobIds: [job.id],
+      operationLabel: "cron.preparation-failure",
+      mutate: ({ database, jobs }) => {
+        const current = jobs.get(job.id);
+        if (
+          !current ||
+          state.stopped ||
+          state.lifecycleGeneration !== params.lifecycleGeneration ||
+          state.queuedRunReservationsByJobId.has(job.id) ||
+          current.state.queuedAtMs !== undefined ||
+          current.state.runningAtMs !== undefined ||
+          current.updatedAtMs !== job.updatedAtMs ||
+          current.state.nextRunAtMs !== job.state.nextRunAtMs ||
+          current.state.scheduleActivatedAtMs !== job.state.scheduleActivatedAtMs ||
+          current.state.streamSourceIdentity !== job.state.streamSourceIdentity ||
+          current.state.lastRunAtMs !== job.state.lastRunAtMs ||
+          current.state.lastRunStatus !== job.state.lastRunStatus ||
+          current.state.lastStatus !== job.state.lastStatus ||
+          resolveCronJobConfigRevision(current) !== resolveCronJobConfigRevision(job) ||
+          findActiveCronRunReceiptInDatabase({
+            database,
+            storePath: state.deps.storePath,
+            jobId: job.id,
+          })
+        ) {
+          return { value: undefined };
+        }
+        applyJobResult(state, current, result, {
+          scheduleMode: params.scheduleMode,
+          scheduleOwnershipAtMs: params.scheduleOwnershipAtMs,
+          deferredNotifications: notifications,
+        });
+        return { value: current, upsertJobIds: [current.id] };
+      },
+    });
+  } catch (persistError) {
+    throw new AggregateError(
+      [params.error, persistError],
+      `${errorText}; failed to persist cron preparation failure: ${normalizeCronRunErrorText(persistError)}`,
+      { cause: persistError },
+    );
+  }
+  if (committed) {
+    applyCronRuntimeRowsToState(state, [committed]);
+    runPostPersistCronNotifications(state, notifications);
+  } else if (!params.onFailure) {
+    // A newer owner controls automatic scheduling. Manual callers still owe
+    // their accepted request a terminal event, without rewriting that owner's row.
+    return;
+  }
+  const event: CronEvent & { action: "finished" } = {
+    jobId: job.id,
+    action: "finished",
+    job: committed ?? job,
+    status: result.status,
+    completionStatus: result.completionStatus,
+    error: errorText,
+    diagnostics: result.diagnostics,
+    runAtMs: finishedAt,
+    durationMs: 0,
+    nextRunAtMs: committed?.state.nextRunAtMs,
+    deliveryStatus: committed?.state.lastDeliveryStatus,
+    deliveryError: committed?.state.lastDeliveryError,
+    failureNotificationDelivery: committed
+      ? failureNotificationDeliveryFromJobState(committed)
+      : undefined,
+  };
+  if (params.onFailure) {
+    params.onFailure(event, params.error);
+  } else {
+    tryFinishCronTaskRun(state, { job: committed, event });
+    emit(state, event);
+  }
+}
