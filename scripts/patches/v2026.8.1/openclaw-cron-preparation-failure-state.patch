+              ...(change === "deleted" ? { deleteJobIds: [job.id] } : { upsertJobIds: [job.id] }),
+            };
+          },
+        });
+        return null;
+      });
+
+      const ack = await enqueueRun(state, job.id, "force");
+      await vi.waitFor(() =>
+        expect(onEvent).toHaveBeenCalledWith(
