+/**
+ * Native lookup result: a creation time in epoch ms, `null` when the process
+ * does not exist or has exited, or `undefined` when the native lookup could
+ * not decide (helper unavailable, access denied) and the PowerShell/WMIC
+ * chain should answer instead.
+ */
+type NativeStartTimeReader = (pid: number) => number | null | undefined;
+
+// 100 ns FILETIME ticks between 1601-01-01 and 1970-01-01.
+const FILETIME_UNIX_EPOCH_TICKS = 116_444_736_000_000_000n;
+const FILETIME_TICKS_PER_MS = 10_000n;
+const PROCESS_QUERY_LIMITED_INFORMATION = 0x1000;
+const ERROR_INVALID_PARAMETER = 87;
+
+let nativeReader: NativeStartTimeReader | null | undefined;
+let ownStartTime: number | undefined;
+
+function loadNativeStartTimeReader(): NativeStartTimeReader | null {
+  if (process.platform !== "win32") {
+    return null;
+  }
+  try {
+    const koffi: typeof import("koffi").default = require("koffi");
+    const kernel32 = koffi.load("kernel32.dll");
+    const fileTime = koffi.struct({ low: "uint32_t", high: "uint32_t" });
+    const getLastError = kernel32.func("uint32_t __stdcall GetLastError()");
+    const getCurrentProcess = kernel32.func("void * __stdcall GetCurrentProcess()");
+    const openProcess = kernel32.func(
+      "void * __stdcall OpenProcess(uint32_t access, int32_t inheritHandle, uint32_t processId)",
+    );
+    const closeHandle = kernel32.func("int32_t __stdcall CloseHandle(void *handle)");
+    const getProcessTimes = kernel32.func("__stdcall", "GetProcessTimes", "int32_t", [
+      "void *",
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+      koffi.out(koffi.pointer(fileTime)),
+    ]);
+    const ticks = (value: { low: number; high: number }) =>
+      (BigInt(value.high) << 32n) | BigInt(value.low);
+
+    return (pid) => {
+      const self = pid === process.pid;
+      // The pseudo handle needs no access check and no CloseHandle.
+      const handle = self
+        ? getCurrentProcess()
+        : openProcess(PROCESS_QUERY_LIMITED_INFORMATION, 0, pid);
+      if (!handle) {
+        return getLastError() === ERROR_INVALID_PARAMETER ? null : undefined;
+      }
+      try {
+        const creation = { low: 0, high: 0 };
+        const exit = { low: 0, high: 0 };
+        if (!getProcessTimes(handle, creation, exit, { low: 0, high: 0 }, { low: 0, high: 0 })) {
+          return undefined;
+        }
+        // A handle can outlive the process; GetProcessById and WMIC report it gone.
+        if (ticks(exit) !== 0n) {
+          return null;
+        }
+        // Same instant .NET Process.StartTime reads, truncated to ms the way
+        // Date.parse truncates PowerShell's 7-digit fraction.
+        return Number((ticks(creation) - FILETIME_UNIX_EPOCH_TICKS) / FILETIME_TICKS_PER_MS);
+      } finally {
+        if (!self) {
+          closeHandle(handle);
+        }
+      }
+    };
+  } catch {
+    return null;
+  }
+}
+
+function readNativeStartTime(pid: number): number | null | undefined {
+  if (pid === process.pid && ownStartTime !== undefined) {
+    return ownStartTime;
+  }
+  // `null` records that the helper is unavailable; only `undefined` loads it.
+  if (nativeReader === undefined) {
+    nativeReader = loadNativeStartTimeReader();
+  }
+  if (!nativeReader) {
+    return undefined;
+  }
+  let startTime: number | null | undefined;
+  try {
+    startTime = nativeReader(pid);
+  } catch {
+    return undefined;
+  }
+  if (pid === process.pid && typeof startTime === "number") {
+    ownStartTime = startTime;
+  }
+  return startTime;
+}
+
+/** Replace the native reader; `null` disables it, `undefined` restores loading. */
+export function setWindowsProcessStartNativeReaderForTests(
+  reader: NativeStartTimeReader | null | undefined,
+): void {
+  nativeReader = reader;
+  ownStartTime = undefined;
+}
