+/** Match catalog aliases before applying the host's restrictive install policy. */
+function resolveInstallPolicyPluginId(pluginId: string): string {
+  const normalized = normalizePluginId(pluginId);
+  const official = getOfficialExternalPluginCatalogEntry(normalized);
+  return official
+    ? normalizePluginId(resolveOfficialExternalPluginId(official) ?? normalized)
+    : normalized;
