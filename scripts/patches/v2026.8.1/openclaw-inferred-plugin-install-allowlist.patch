+  // Config/environment discovery is not permission to install a plugin outside
+  // an explicit allowlist. Keep the candidate's actual id for installation; only
+  // policy comparison resolves catalog aliases (for example qqbot/openclaw-qqbot).
+  const allow = new Set(
+    normalizePluginsConfig(params.cfg.plugins).allow.map(resolveInstallPolicyPluginId),
   );
+  return [...candidates.values()]
+    .filter(
+      (candidate) =>
+        allow.size === 0 || allow.has(resolveInstallPolicyPluginId(candidate.pluginId)),
+    )
+    .toSorted((left, right) => left.pluginId.localeCompare(right.pluginId));
 }
 
