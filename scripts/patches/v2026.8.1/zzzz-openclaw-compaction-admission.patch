index 00000000..d0fb9305
--- /dev/null
+++ b/src/state/openclaw-agent-db-identity.ts
@@ -0,0 +1,48 @@
+import { statSync } from "node:fs";
+import type { DatabaseSync } from "node:sqlite";
+import { resolveGlobalSingleton } from "../shared/global-singleton.js";
+
+export type OpenClawAgentDatabaseIdentity = string | symbol;
+const identities = resolveGlobalSingleton(
+  Symbol.for("openclaw.agentDatabaseIdentities"),
+  () =>
+    new WeakMap<
+      DatabaseSync,
+      { identity: OpenClawAgentDatabaseIdentity; filename: string; birthtime?: bigint }
+    >(),
+);
+
+/** Capture the physical file at open, never by resolving a predecessor's path later. */
+export function registerOpenClawAgentDatabaseIdentity(db: DatabaseSync): void {
+  const filename = db.location() ?? "";
+  const file = filename ? statSync(filename, { bigint: true }) : undefined;
+  identities.set(db, {
+    identity: file ? `${file.dev}:${file.ino}` : Symbol("incognito-agent-database"),
+    filename,
+    birthtime: file?.birthtimeNs,
+  });
+}
+
+/** A cached connection cannot prove continuity after its pathname has been replaced. */
+export function readOpenClawAgentDatabaseIdentity(database: {
+  db: DatabaseSync;
+  path: string;
+}): OpenClawAgentDatabaseIdentity {
+  const captured = identities.get(database.db);
+  if (!captured || !database.db.isOpen) {
+    throw new Error("Session database identity is unavailable");
+  }
+  if (typeof captured.identity === "symbol") {
+    return captured.identity;
+  }
+  const current = statSync(database.path, { bigint: true, throwIfNoEntry: false });
+  if (
+    !current ||
+    database.db.location() !== captured.filename ||
+    `${current.dev}:${current.ino}` !== captured.identity ||
+    current.birthtimeNs !== captured.birthtime
+  ) {
+    throw new Error("Session database changed while starting work. Retry.");
+  }
+  return captured.identity;
+}
