diff --git a/src/auto-reply/reply/reply-turn-compaction-handoff.test.ts b/src/auto-reply/reply/reply-turn-compaction-handoff.test.ts
new file mode 100644
index 00000000..bff882f5
--- /dev/null
+++ b/src/auto-reply/reply/reply-turn-compaction-handoff.test.ts
@@ -0,0 +1,171 @@
+import { copyFileSync, renameSync } from "node:fs";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { createDeferred } from "../../../test/helpers/promise.js";
+import { useAutoCleanupTempDirTracker } from "../../../test/helpers/temp-dir.js";
+import {
+  replaceSessionEntrySync,
+  replaceSessionEntry,
+} from "../../config/sessions/session-accessor.js";
+import type { ReplyOperation } from "./reply-run-registry.js";
+import { testing } from "./reply-run-registry.test-support.js";
+import { admitReplyTurn } from "./reply-turn-admission.js";
+
+const dirs = useAutoCleanupTempDirTracker(afterEach);
+afterEach(() => testing.resetReplyRunRegistry());
+const sessionKey = "agent:main:compaction-handoff";
+function store(sessionId: string) {
+  const storePath = path.join(dirs.make("compaction-handoff-"), "sessions.sqlite");
+  replaceSessionEntrySync({ storePath, sessionKey }, { sessionId, updatedAt: Date.now() });
+  return storePath;
+}
+async function owner(storePath: string, sessionId: string) {
+  const result = await admitReplyTurn({
+    storePath,
+    sessionKey,
+    sessionId,
+    expectedSessionId: sessionId,
+    kind: "visible",
+    resetTriggered: false,
+  });
+  if (result.status !== "owned") {
+    throw new Error("Expected owned fixture");
+  }
+  return result.operation;
+}
+async function compact(storePath: string, operation: ReplyOperation, sessionId: string) {
+  await replaceSessionEntry({ storePath, sessionKey }, { sessionId, updatedAt: Date.now() });
+  operation.updateSessionId(sessionId);
+}
+async function finish(operation: ReplyOperation) {
+  operation.complete();
+  await operation.ownerSettlement;
+}
+describe("accepted turn compaction lineage", () => {
+  it("continues through two completed owners captured before asynchronous preparation", async () => {
+    const storePath = store("a");
+    const first = await owner(storePath, "a");
+    await compact(storePath, first, "b");
+    await finish(first);
+    const second = await owner(storePath, "b");
+    await compact(storePath, second, "c");
+    await finish(second);
+    const result = await admitReplyTurn({
+      storePath,
+      sessionKey,
+      sessionId: "a",
+      expectedSessionId: "a",
+      expectedActiveOperations: [first, second],
+      kind: "visible",
+      resetTriggered: false,
+    });
+    expect(result.status).toBe("owned");
+    if (result.status === "owned") {
+      expect(result.operation.sessionId).toBe("c");
+      await finish(result.operation);
+    }
+  });
+  it("rejects a completed predecessor from another physical database with identical IDs", async () => {
+    const foreignPath = store("a");
+    const localPath = store("b");
+    const first = await owner(foreignPath, "a");
+    await compact(foreignPath, first, "b");
+    await finish(first);
+    await expect(
+      admitReplyTurn({
+        storePath: localPath,
+        sessionKey,
+        sessionId: "a",
+        expectedSessionId: "a",
+        expectedActiveOperations: [first],
+        kind: "visible",
+        resetTriggered: false,
+      }),
+    ).rejects.toThrow(/changed while starting work/i);
+  });
+  it("rejects physical replacement of a retained connection's pathname", async () => {
+    const storePath = store("a");
+    const replacementPath = store("b");
+    const first = await owner(storePath, "a");
+    await compact(storePath, first, "b");
+    await finish(first);
+    renameSync(storePath, `${storePath}.old`);
+    copyFileSync(replacementPath, storePath);
+    await expect(
+      admitReplyTurn({
+        storePath,
+        sessionKey,
+        sessionId: "a",
+        expectedSessionId: "a",
+        expectedActiveOperations: [first],
+        kind: "visible",
+        resetTriggered: false,
+      }),
+    ).rejects.toThrow(/database changed while starting work/i);
+  });
+  it("retains connected compactions across pending followup barriers", async () => {
+    const storePath = store("a");
+    const first = await owner(storePath, "a");
+    await compact(storePath, first, "b");
+    const firstBarrier = createDeferred();
+    const secondBarrier = createDeferred();
+    first.completeWithAfterClearBarrier(firstBarrier.promise);
+    const second = await owner(storePath, "b");
+    await compact(storePath, second, "c");
+    second.completeWithAfterClearBarrier(secondBarrier.promise);
+    const pending = admitReplyTurn({
+      storePath,
+      sessionKey,
+      sessionId: "a",
+      expectedSessionId: "a",
+      expectedActiveOperations: [first, second],
+      kind: "queued_followup",
+      resetTriggered: false,
+    });
+    firstBarrier.resolve();
+    secondBarrier.resolve();
+    const result = await pending;
+    expect(result.status).toBe("owned");
+    if (result.status === "owned") {
+      expect(result.operation.sessionId).toBe("c");
+      await finish(result.operation);
+    }
+  });
+  it.each(["replacement", "restart", "cancelled"])(
+    "does not execute accepted work after %s",
+    async (scenario) => {
+      const storePath = store("a");
+      const first = await owner(storePath, "a");
+      await replaceSessionEntry(
+        { storePath, sessionKey },
+        { sessionId: "b", updatedAt: Date.now() },
+      );
+      if (scenario !== "replacement") {
+        first.updateSessionId("b");
+      }
+      if (scenario === "restart") {
+        first.abortForRestart();
+      }
+      await finish(first);
+      const controller = new AbortController();
+      if (scenario === "cancelled") {
+        controller.abort();
+      }
+      const pending = admitReplyTurn({
+        storePath,
+        sessionKey,
+        sessionId: "a",
+        expectedSessionId: "a",
+        expectedActiveOperations: [first],
+        kind: "visible",
+        resetTriggered: false,
+        upstreamAbortSignal: controller.signal,
+      });
+      if (scenario === "cancelled") {
+        expect(await pending).toMatchObject({ status: "skipped", reason: "aborted" });
+      } else {
+        await expect(pending).rejects.toThrow(/changed while starting work/i);
+      }
+    },
+  );
+});
