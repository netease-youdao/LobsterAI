+// Tests that low-level channel dispatches release the dispatcher restart reservation.
+import { beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  createHookCtx,
+  emptyConfig,
+  hookMocks,
+} from "./dispatch-from-config.shared.test-harness.js";
+import {
+  describe0BeforeEach0,
+  globalBeforeAll0,
+  setNoAbort,
+} from "./dispatch-from-config.test-harness.js";
+import { getTotalPendingReplies } from "./dispatcher-registry.js";
+import { createReplyDispatcher } from "./reply-dispatcher.js";
+
+beforeAll(globalBeforeAll0);
+
+describe("dispatchLowLevelChannelReplyFromConfig", () => {
+  beforeEach(() => {
+    describe0BeforeEach0();
+    setNoAbort();
+    hookMocks.runner.hasHooks.mockReturnValue(false);
+  });
+
+  it("releases the dispatcher reservation once the channel dispatch settles", async () => {
+    const { dispatchLowLevelChannelReplyFromConfig } = await import("./dispatch-from-config.js");
+    const pendingBefore = getTotalPendingReplies();
+    const deliver = vi.fn(async () => {});
+    const dispatcher = createReplyDispatcher({ deliver });
+    expect(getTotalPendingReplies()).toBe(pendingBefore + 1);
+
+    const result = await dispatchLowLevelChannelReplyFromConfig({
+      ctx: createHookCtx(),
+      cfg: emptyConfig,
+      dispatcher,
+      replyResolver: async () => ({ text: "hi" }),
+    });
+    await dispatcher.waitForIdle();
+
+    expect(result.queuedFinal).toBe(true);
+    expect(deliver).toHaveBeenCalledOnce();
+    await vi.waitFor(() => {
+      expect(getTotalPendingReplies()).toBe(pendingBefore);
+    });
+  });
+});
