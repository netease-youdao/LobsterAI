+describe("resolveMemoryFlushContextWindowTokens session windows", () => {
+  const provider = "lobsterai-server";
+  const modelId = "deepseek-flash-YoudaoInner";
+  function buildConfig(contextWindow: number | undefined): OpenClawConfig {
+    return {
+      models: {
+        providers: {
+          [provider]: {
+            baseUrl: "http://127.0.0.1:9/v1",
+            models: [
+              {
+                id: modelId,
+                name: modelId,
+                api: "openai-completions",
+                reasoning: true,
+                input: ["text"],
+                cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+                ...(contextWindow ? { contextWindow } : {}),
+                maxTokens: 32_768,
+                contextWindows: [
+                  {
+                    id: "model-default",
+                    label: String(contextWindow ?? 200_000),
+                    contextWindow: contextWindow ?? 200_000,
+                  },
+                  { id: "yd-fast", label: "400000", contextWindow: 400_000 },
+                ],
+                contextWindowDefault: "model-default",
+              },
+            ],
+          },
+        },
+      },
+    } as OpenClawConfig;
+  }
+
+  it("budgets preflight against the session-selected window like the embedded run", () => {
+    const cfg = buildConfig(1_000_000);
+    expect(
+      resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow: "yd-fast" }),
+    ).toBe(400_000);
+    expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId })).toBe(1_000_000);
+  });
+
+  it("keeps the model window for unknown selections and never raises it", () => {
+    expect(
+      resolveMemoryFlushContextWindowTokens({
+        cfg: buildConfig(1_000_000),
+        provider,
+        modelId,
+        contextWindow: "retired-option",
+      }),
+    ).toBe(1_000_000);
+    expect(
+      resolveMemoryFlushContextWindowTokens({
+        cfg: buildConfig(262_144),
+        provider,
+        modelId,
+        contextWindow: "yd-fast",
+      }),
+    ).toBe(262_144);
+  });
+
+  it("uses the selected window like the run when the model declares no native window", () => {
+    const cfg = buildConfig(undefined);
+    expect(
+      resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId, contextWindow: "yd-fast" }),
+    ).toBe(400_000);
+    expect(resolveMemoryFlushContextWindowTokens({ cfg, provider, modelId })).toBe(200_000);
+  });
+});
