diff --git a/src/gateway/managed-outgoing-gc-lifecycle.ts b/src/gateway/managed-outgoing-gc-lifecycle.ts
new file mode 100644
--- /dev/null
+++ b/src/gateway/managed-outgoing-gc-lifecycle.ts
@@ -0,0 +1,78 @@
+import { normalizeAgentDirRegistryPath } from "../agents/agent-dir-registry.js";
+import { getRuntimeConfig } from "../config/config.js";
+import { resolveSessionStorePathCore } from "../config/sessions/paths.js";
+import { resolveSqliteTargetFromSessionStorePath } from "../config/sessions/session-sqlite-target.js";
+import {
+  resolvePersistedSessionStoreOwner,
+  resolvePersistedSessionStoreOwnerForKey,
+} from "../config/sessions/session-store-owner.js";
+import {
+  resolveExistingAgentSessionStoreTargetsReadOnlyResult,
+  type SessionStoreTargetsReadCache,
+} from "../config/sessions/targets-read-availability.js";
+import { isPathInside } from "../infra/path-guards.js";
+import { resolveSqliteDatabaseFilePaths } from "../infra/sqlite-files.js";
+import { listAgentDeletionJournalEntriesReadOnly } from "../state/agent-deletion-journal.js";
+import { tryResolveSessionCompatibilityOwnerAgentId } from "./session-request-agent.js";
+
+/** Deletion fences maintenance, including media whose session row was already purged. */
+export function isManagedMediaCleanupBlockedByAgentDeletion(params: {
+  agentId: string | undefined;
+  sessionKey: string;
+  stateDir: string;
+  cache: SessionStoreTargetsReadCache;
+}): boolean {
+  const env = { ...process.env, OPENCLAW_STATE_DIR: params.stateDir };
+  // Refresh at each decision: deletion can begin during an awaited history or queue read.
+  const deletions = listAgentDeletionJournalEntriesReadOnly({ env });
+  if (deletions.length === 0) {
+    return false;
+  }
+  const cfg = getRuntimeConfig();
+  const keyOwner = resolvePersistedSessionStoreOwnerForKey(cfg, params.sessionKey);
+  const agentId =
+    params.agentId ??
+    (keyOwner.kind !== "none"
+      ? keyOwner.agentId
+      : tryResolveSessionCompatibilityOwnerAgentId(cfg, params.sessionKey));
+  if (!agentId) {
+    return false;
+  }
+  if (deletions.some((entry) => entry.agentId === agentId)) {
+    return true;
+  }
+  const discovery = resolveExistingAgentSessionStoreTargetsReadOnlyResult(cfg, agentId, {
+    env,
+    cache: params.cache,
+  });
+  const storePaths = new Set([
+    resolveSessionStorePathCore(cfg.session?.store, { agentId, env }),
+    ...(discovery.available ? discovery.targets.map((target) => target.storePath) : []),
+  ]);
+  const persistedOwner = resolvePersistedSessionStoreOwner(cfg);
+  const defaultAgentId = persistedOwner.kind === "none" ? agentId : persistedOwner.agentId;
+  // Match the writer's physical owner and unfinished path fences without claiming its lease.
+  const pendingFences = deletions
+    .filter((entry) => !entry.cleanupCompleted)
+    .flatMap((entry) =>
+      [entry.agentDir, entry.workspaceDir, entry.sessionsDir].concat(
+        entry.databasePaths,
+        entry.cleanupPaths.map((cleanup) => cleanup.canonicalPath),
+      ),
+    )
+    .map((pathname) => normalizeAgentDirRegistryPath(pathname, env));
+  return [...storePaths].some((storePath) => {
+    const target = resolveSqliteTargetFromSessionStorePath(storePath, {
+      agentId,
+      defaultAgentId,
+      env,
+    });
+    if (deletions.some((entry) => entry.agentId === target.agentId)) {
+      return true;
+    }
+    return resolveSqliteDatabaseFilePaths(target.path).some((pathname) => {
+      const canonical = normalizeAgentDirRegistryPath(pathname, env);
+      return pendingFences.some((fence) => canonical === fence || isPathInside(fence, canonical));
+    });
+  });
+}
