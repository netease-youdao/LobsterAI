+import { describe, expect, it } from "vitest";
+import { resolveRequesterRecoveryDelivery } from "./subagent-announce-completion-delivery.js";
+
+describe("requester recovery completion deduplication", () => {
+  const base = { sessionId: "parent", updatedAt: 1 };
+  it("blocks a second settle turn while the exact recovered input remains claimed", () => {
+    const entry = {
+      ...base,
+      restartRecoveryDeliveryRunId: "successor",
+      restartRecoveryDeliverySourceRunId: "settle",
+    };
+    expect(resolveRequesterRecoveryDelivery(entry, "settle")).toMatchObject({
+      kind: "delivery",
+      delivery: { delivered: false, reason: "requester_turn_pending", disposition: "retryable" },
+    });
+    expect(resolveRequesterRecoveryDelivery(entry, "different-settle")).toBeUndefined();
+  });
+  it("reuses only the exact durable final receipt", () => {
+    const receipt = { runId: "settle", captured: true as const, payloads: [{ visible: true }] };
+    expect(
+      resolveRequesterRecoveryDelivery(
+        { ...base, restartRecoveryTerminalDeliveryEvidence: [receipt] },
+        "settle",
+      ),
+    ).toEqual({ kind: "result", result: receipt });
+    expect(
+      resolveRequesterRecoveryDelivery(
+        { ...base, restartRecoveryTerminalDeliveryEvidence: [receipt] },
+        "different-settle",
+      ),
+    ).toBeUndefined();
+  });
+  it("does not rerun a terminal successor without final evidence", () => {
+    expect(
+      resolveRequesterRecoveryDelivery(
+        { ...base, restartRecoveryTerminalRunIds: ["settle"] },
+        "settle",
+      ),
+    ).toMatchObject({
+      kind: "delivery",
+      delivery: {
+        delivered: false,
+        reason: "visible_reply_missing",
+        disposition: "permanent_failure",
+      },
+    });
+  });
+});
