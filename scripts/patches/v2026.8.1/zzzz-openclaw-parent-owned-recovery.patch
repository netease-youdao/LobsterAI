+      clearConfigCache();
+      clearRuntimeConfigSnapshot();
+      await rm(stateDir, { recursive: true, force: true });
+    } finally {
+      env.restore();
+    }
+  });
+
+  return {
+    get stateDir() {
+      return stateDir;
+    },
+  };
+}
