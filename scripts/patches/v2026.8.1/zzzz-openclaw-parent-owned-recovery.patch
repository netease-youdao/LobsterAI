index 00000000..17b4e106
--- /dev/null
+++ b/src/agents/subagents/registry/subagent-requester-wake-cancellation.ts
@@ -0,0 +1,64 @@
+import { subagentRuns } from "./subagent-registry-memory.js";
+import { listSubagentRunsForRequester } from "./subagent-registry-read.js";
+import { persistSubagentRunsToDiskOrThrow } from "./subagent-registry-state.js";
+
+/** Capture the exact durable continuation before Stop can await descendant cancellation. */
+export function captureRequesterYieldedWakeCancellation(params: {
+  requesterSessionKey: string;
+  requesterAgentId: string;
+}): (() => boolean) | undefined {
+  const captured = listSubagentRunsForRequester(params.requesterSessionKey, {
+    requesterAgentId: params.requesterAgentId,
+  }).flatMap((entry) => {
+    const wake = entry.requesterSettleWake;
+    return !entry.collect &&
+      entry.expectsCompletionMessage === true &&
+      !entry.requesterTurnRunId &&
+      wake?.requesterYieldBatch === true &&
+      wake.rearmGeneration !== undefined &&
+      wake.batchRunIds?.includes(entry.runId)
+      ? [
+          {
+            entry,
+            wake,
+            generation: wake.rearmGeneration,
+            suppressed: entry.suppressCompletionDelivery,
+          },
+        ]
+      : [];
+  });
+  if (!captured.length) {
+    return undefined;
+  }
+  return () => {
+    // Replacements and newly rearmed batches retain their own cancellation boundary.
+    if (
+      captured.some(
+        ({ entry, wake, generation }) =>
+          subagentRuns.get(entry.runId) !== entry ||
+          entry.requesterSettleWake !== wake ||
+          wake.rearmGeneration !== generation ||
+          entry.requesterTurnRunId,
+      )
+    ) {
+      return false;
+    }
+    for (const { entry } of captured) {
+      entry.requesterSettleWake = undefined;
+      entry.suppressCompletionDelivery = true;
+    }
+    try {
+      persistSubagentRunsToDiskOrThrow(
+        subagentRuns,
+        captured.map(({ entry }) => entry.runId),
+      );
+    } catch (error) {
+      for (const { entry, wake, suppressed } of captured) {
+        entry.requesterSettleWake = wake;
+        entry.suppressCompletionDelivery = suppressed;
+      }
+      throw error;
+    }
+    return true;
+  };
+}
