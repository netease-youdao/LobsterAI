diff --git a/packages/agent-core/src/harness/compaction/summary-recovery.ts b/packages/agent-core/src/harness/compaction/summary-recovery.ts
new file mode 100644
--- /dev/null
+++ b/packages/agent-core/src/harness/compaction/summary-recovery.ts
@@ -0,0 +1,141 @@
+import type { AgentMessage } from "../../types.js";
+import {
+  createToolCallOccurrenceQueue,
+  extractToolCallsFromAssistant,
+  extractToolResultId,
+} from "../session/tool-result-pairing.js";
+import {
+  CompactionError,
+  err,
+  IncompleteSummaryError,
+  ok,
+  SummaryContextOverflowError,
+  type Result,
+} from "../types.js";
+
+const MAX_OVERFLOW_SPLITS = 8;
+const MIN_FRAGMENT_CHARS = 1024;
+
+function subdivideSummaryMessages(
+  messages: AgentMessage[],
+  estimateTokens: (message: AgentMessage) => number,
+): AgentMessage[][] {
+  const weightedMessages = messages.map((message) => ({
+    message,
+    weight: estimateTokens(message),
+  }));
+  const half = weightedMessages.reduce((sum, entry) => sum + entry.weight, 0) / 2;
+  const pending = createToolCallOccurrenceQueue<true>();
+  let accumulated = 0;
+  let boundary = 0;
+  let distance = Number.POSITIVE_INFINITY;
+  for (const [index, { message, weight }] of weightedMessages.entries()) {
+    accumulated += weight;
+    if (message.role === "assistant") {
+      // Even an aborted assistant can have a real result later in the transcript.
+      for (const call of extractToolCallsFromAssistant(message)) {
+        pending.add(call.id, true);
+      }
+    } else if (message.role === "toolResult") {
+      const id = extractToolResultId(message);
+      if (id) {
+        pending.claim(id);
+      }
+    }
+    // A user turn displaced into an unfinished tool batch cannot split that batch.
+    const nextDistance = Math.abs(accumulated - half);
+    if (pending.size === 0 && index < messages.length - 1 && nextDistance < distance) {
+      boundary = index + 1;
+      distance = nextDistance;
+    }
+  }
+  if (boundary > 0) {
+    return [messages.slice(0, boundary), messages.slice(boundary)];
+  }
+
+  const message = messages[0];
+  // Only plain user text is split internally, in a temporary summary projection.
+  if (messages.length !== 1 || message?.role !== "user") {
+    return [];
+  }
+  const content = message.content;
+  const text =
+    typeof content === "string"
+      ? content
+      : content.every((part) => part.type === "text")
+        ? content.map((part) => (part.type === "text" ? part.text : "")).join("")
+        : undefined;
+  if (!text || text.length < MIN_FRAGMENT_CHARS * 2) {
+    return [];
+  }
+  let middle = Math.floor(text.length / 2);
+  const paragraphEnd = text.lastIndexOf("\n", middle);
+  if (paragraphEnd >= Math.max(middle / 2, MIN_FRAGMENT_CHARS - 1)) {
+    middle = paragraphEnd + 1;
+  }
+  if (
+    /[\uD800-\uDBFF]/.test(text.charAt(middle - 1)) &&
+    /[\uDC00-\uDFFF]/.test(text.charAt(middle))
+  ) {
+    middle--;
+  }
+  return [text.slice(0, middle), text.slice(middle)].map((fragment) => [
+    {
+      ...message,
+      content: typeof content === "string" ? fragment : [{ type: "text", text: fragment }],
+    },
+  ]);
+}
+
+/** Recover rejected summary inputs without replaying successful fragments or changing history. */
+export async function summarizeWithOverflowRecovery(params: {
+  messages: AgentMessage[];
+  previousSummary?: string;
+  signal?: AbortSignal;
+  estimateTokens: (message: AgentMessage) => number;
+  summarize: (
+    messages: AgentMessage[],
+    previousSummary: string | undefined,
+  ) => Promise<Result<string, CompactionError>>;
+}): Promise<Result<string, CompactionError>> {
+  const chunks = [params.messages];
+  let summary = params.previousSummary ?? "";
+  let splits = 0;
+  for (const [index, chunk] of chunks.entries()) {
+    if (params.signal?.aborted) {
+      return err(new CompactionError("aborted", "Summarization aborted"));
+    }
+    let result: Result<string, CompactionError>;
+    try {
+      result = await params.summarize(chunk, summary || undefined);
+    } catch (error) {
+      if (params.signal?.aborted) {
+        return err(new CompactionError("aborted", "Summarization aborted"));
+      }
+      if (splits > 0) {
+        return err(new IncompleteSummaryError(error));
+      }
+      throw error;
+    }
+    if (params.signal?.aborted) {
+      return err(new CompactionError("aborted", "Summarization aborted"));
+    }
+    if (result.ok) {
+      summary = result.value;
+      continue;
+    }
+    if (result.error instanceof SummaryContextOverflowError) {
+      const smaller =
+        splits < MAX_OVERFLOW_SPLITS ? subdivideSummaryMessages(chunk, params.estimateTokens) : [];
+      if (smaller.length > 1) {
+        splits++;
+        // The worklist iterator visits the smaller chunks immediately after this rejection.
+        chunks.splice(index + 1, 0, ...smaller);
+        continue;
+      }
+      return err(new IncompleteSummaryError(result.error));
+    }
+    return splits > 0 ? err(new IncompleteSummaryError(result.error)) : result;
+  }
+  return ok(summary);
+}
