+++ b/packages/agent-core/src/harness/compaction/compaction.context-overflow.test.ts
@@ -0,0 +1,382 @@
+import { describe, expect, it, vi } from "vitest";
+import { createAssistantMessageEventStream } from "../../llm.js";
+import type { AssistantMessage, Model, StreamFn } from "../../llm.js";
+import type { AgentMessage } from "../../types.js";
+import { compact, generateSummary, type CompactionPreparation } from "./compaction.js";
+import { createFileOps } from "./utils.js";
+
+const model: Model = {
+  id: "summary-model",
+  name: "Summary Model",
+  api: "test-api",
+  provider: "test-provider",
+  baseUrl: "https://example.test",
+  reasoning: false,
+  input: ["text"],
+  cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+  contextWindow: 100_000,
+  maxTokens: 8_000,
+};
+const overflowError =
+  "This model's maximum context length is 1048576 tokens. However, you requested 1202037 tokens (1202037 in the messages, 0 in the completion). Please reduce the length of the messages or completion.";
+
+function user(content: string): AgentMessage {
+  return { role: "user", content, timestamp: 1 };
+}
+
+function assistant(text: string, errorMessage?: string): AssistantMessage {
+  return {
+    role: "assistant",
+    content: [{ type: "text", text }],
+    api: model.api,
+    provider: model.provider,
+    model: model.id,
+    usage: {
+      input: 1,
+      output: 0,
+      cacheRead: 0,
+      cacheWrite: 0,
+      totalTokens: 1,
+      cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+    },
+    stopReason: errorMessage ? "error" : "stop",
+    ...(errorMessage ? { errorMessage } : {}),
+    timestamp: 2,
+  };
+}
+
+function reply(text: string, errorMessage?: string) {
+  const stream = createAssistantMessageEventStream();
+  const message = assistant(text, errorMessage);
+  if (errorMessage) {
+    stream.push({ type: "error", reason: "error", error: message });
+  } else {
+    stream.push({ type: "done", reason: "stop", message });
+  }
+  stream.end();
+  return stream;
+}
+
+function readPrompt(context: Parameters<StreamFn>[1]): string {
+  const message = context.messages[0];
+  if (message?.role !== "user") {
+    throw new Error("expected a user summary prompt");
+  }
+  return typeof message.content === "string"
+    ? message.content
+    : message.content.map((block) => (block.type === "text" ? block.text : "")).join("");
+}
+
+function readConversation(prompt: string): string {
+  const conversation = prompt.match(/<conversation>\n([\s\S]*?)\n<\/conversation>/)?.[1];
+  if (conversation === undefined) {
+    throw new Error("expected the summary prompt to include the conversation");
+  }
+  return conversation;
+}
+
+function readPreviousSummary(prompt: string): string | undefined {
+  return prompt.match(/<previous-summary>\n([\s\S]*?)\n<\/previous-summary>/)?.[1];
+}
+
+function preparation(history: AgentMessage[], prefix: AgentMessage[] = []): CompactionPreparation {
+  return {
+    firstKeptEntryId: "retained-tail",
+    messagesToSummarize: history,
+    turnPrefixMessages: prefix,
+    isSplitTurn: prefix.length > 0,
+    tokensBefore: 1202037,
+    fileOps: createFileOps(),
+    settings: { enabled: true, reserveTokens: 1_000, keepRecentTokens: 100 },
+  };
+}
+
+describe("core compaction context overflow recovery", () => {
+  it.each([
+    { name: "history-only", history: true, prefix: false, textBlocks: false },
+    { name: "prefix-only", history: false, prefix: true, textBlocks: true },
+    { name: "history and prefix", history: true, prefix: true, textBlocks: false },
+  ])("recovers $name without losing or mutating Unicode input", async (scenario) => {
+    const controller = new AbortController();
+    const texts = {
+      history: `HISTORY-BEGIN\n${"龘🙂".repeat(4096)}\nHISTORY-END`,
+      prefix: `PREFIX-BEGIN\n${"龘🚀".repeat(4096)}\nPREFIX-END`,
+    };
+    const prefixMessage: AgentMessage = scenario.textBlocks
+      ? {
+          role: "user",
+          content: [
+            { type: "text", text: "PREFIX-BEGIN\n" },
+            { type: "text", text: `${"龘🚀".repeat(4096)}\nPREFIX-END` },
+          ],
+          timestamp: 1,
+        }
+      : user(texts.prefix);
+    const input = preparation(
+      scenario.history ? [user(texts.history)] : [],
+      scenario.prefix ? [prefixMessage] : [],
+    );
+    input.previousSummary = "earlier decisions";
+    const original = structuredClone(input);
+    const accepted: Record<"history" | "prefix", string[]> = { history: [], prefix: [] };
+    const rejected = { history: 0, prefix: 0 };
+    const summaries: Record<"history" | "prefix", string | undefined> = {
+      history: input.previousSummary,
+      prefix: undefined,
+    };
+    const usageSink = vi.fn();
+    const streamFn = vi.fn<StreamFn>((_model, context, options) => {
+      const prompt = readPrompt(context);
+      const kind = prompt.includes("## Original Request") ? "prefix" : "history";
+      const conversation = readConversation(prompt);
+      expect(conversation.startsWith("[User]: ")).toBe(true);
+      const fragment = conversation.slice("[User]: ".length);
+      expect(fragment).not.toMatch(/[\uD800-\uDBFF](?![\uDC00-\uDFFF])/);
+      expect(fragment).not.toMatch(/(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/);
+      expect(readPreviousSummary(prompt)).toBe(summaries[kind]);
+      expect(prompt).toContain("Preserve the user's unresolved request.");
+      expect(options?.signal).toBe(controller.signal);
+      expect(options?.maxTokens).toBe(kind === "prefix" ? 500 : 800);
+      if (fragment.length > 2200) {
+        rejected[kind]++;
+        return reply("", overflowError);
+      }
+      accepted[kind].push(fragment);
+      summaries[kind] = `${summaries[kind] ?? ""} ${kind}-${accepted[kind].length}`.trim();
+      return reply(summaries[kind]);
+    });
+
+    const result = await compact(
+      input,
+      model,
+      undefined,
+      undefined,
+      "Preserve the user's unresolved request.",
+      controller.signal,
+      undefined,
+      streamFn,
+      { completeSimple: vi.fn(), internalUsageSink: usageSink },
+    );
+
+    expect(result.ok).toBe(true);
+    if (!result.ok) {
+      throw new Error("expected every summary fragment to succeed");
+    }
+    for (const kind of ["history", "prefix"] as const) {
+      if (scenario[kind]) {
+        expect(rejected[kind]).toBeGreaterThan(1);
+        expect(accepted[kind].length).toBeGreaterThanOrEqual(4);
+        expect(accepted[kind].join("")).toBe(texts[kind]);
+        expect(result.value.summary).toContain(summaries[kind]);
+      }
+    }
+    expect(result.value.firstKeptEntryId).toBe(input.firstKeptEntryId);
+    expect(usageSink).toHaveBeenCalledTimes(streamFn.mock.calls.length);
+    expect(input).toEqual(original);
+  });
+
+  it("returns a compaction result only after the final fragment completes", async () => {
+    const finalStream = createAssistantMessageEventStream();
+    let notifyFinalRequest!: () => void;
+    const finalRequested = new Promise<void>((resolve) => {
+      notifyFinalRequest = resolve;
+    });
+    const streamFn = vi.fn<StreamFn>((_model, context) => {
+      const prompt = readPrompt(context);
+      const conversation = readConversation(prompt);
+      if (conversation.length > 5000) {
+        return reply("", overflowError);
+      }
+      if (!readPreviousSummary(prompt)) {
+        return reply("first fragment summary");
+      }
+      expect(readPreviousSummary(prompt)).toBe("first fragment summary");
+      notifyFinalRequest();
+      return finalStream;
+    });
+    let settled = false;
+    const pending = compact(
+      preparation([user(`${"a".repeat(4096)}${"b".repeat(4096)}`)]),
+      model,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      streamFn,
+    ).then((result) => {
+      settled = true;
+      return result;
+    });
+
+    try {
+      const phase = await Promise.race([
+        finalRequested.then(() => "final-request"),
+        pending.then(() => "finished"),
+      ]);
+      expect(phase).toBe("final-request");
+      expect(settled).toBe(false);
+    } finally {
+      finalStream.push({
+        type: "done",
+        reason: "stop",
+        message: assistant("complete summary of both fragments"),
+      });
+      finalStream.end();
+    }
+    const result = await pending;
+    expect(result.ok && result.value.summary).toBe("complete summary of both fragments");
+  });
+
+  it("does not return completed history when a later prefix fragment fails", async () => {
+    const streamFn = vi.fn<StreamFn>((_model, context) => {
+      const prompt = readPrompt(context);
+      if (!prompt.includes("## Original Request")) {
+        return reply("completed history summary");
+      }
+      if (readConversation(prompt).length > 5000) {
+        return reply("", overflowError);
+      }
+      return readPreviousSummary(prompt)
+        ? reply("", "Provider unavailable")
+        : reply("first prefix fragment summary");
+    });
+    const result = await compact(
+      preparation([user("completed history")], [user("x".repeat(8192))]),
+      model,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      streamFn,
+    );
+
+    expect(result.ok).toBe(false);
+    expect(result).not.toHaveProperty("value");
+    expect(streamFn).toHaveBeenCalledTimes(4);
+  });
+
+  it("bounds repeated overflow failures instead of retrying the same input", async () => {
+    const lengths: number[] = [];
+    const streamFn = vi.fn<StreamFn>((_model, context) => {
+      lengths.push(readConversation(readPrompt(context)).length);
+      return reply("", overflowError);
+    });
+    const result = await generateSummary(
+      [user("x".repeat(1_048_576))],
+      model,
+      1_000,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      undefined,
+      streamFn,
+    );
+
+    expect(result.ok).toBe(false);
+    expect(result).not.toHaveProperty("value");
+    expect(lengths.length).toBeGreaterThan(1);
+    expect(lengths.length).toBeLessThanOrEqual(9);
+    expect(lengths).toEqual([...new Set(lengths)].toSorted((left, right) => right - left));
+  });
+
+  it("stops after cancellation even when the in-flight fragment returns text", async () => {
+    const controller = new AbortController();
+    let requests = 0;
+    const streamFn = vi.fn<StreamFn>((_model, _context, options) => {
+      expect(options?.signal).toBe(controller.signal);
+      requests++;
+      if (requests === 1) {
+        return reply("", overflowError);
+      }
+      controller.abort();
+      return reply("late fragment summary");
+    });
+    const result = await generateSummary(
+      [user("x".repeat(8192))],
+      model,
+      1_000,
+      undefined,
+      undefined,
+      controller.signal,
+      undefined,
+      undefined,
+      undefined,
+      streamFn,
+    );
+
+    expect(result.ok).toBe(false);
+    if (result.ok) {
+      throw new Error("expected cancelled compaction to fail");
+    }
+    expect(result.error.code).toBe("aborted");
+    expect(requests).toBe(2);
+  });
