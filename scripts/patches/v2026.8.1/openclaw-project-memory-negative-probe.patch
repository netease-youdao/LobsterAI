@@ -0,0 +1,51 @@
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import type { OpenClawConfig } from "openclaw/plugin-sdk/memory-core-host-runtime-core";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { probeProjectMemoryPresence } from "./project-memory-probe.js";
+
+describe("project memory negative probe", () => {
+  let workspaceDir: string;
+  let cfg: OpenClawConfig;
+
+  beforeEach(async () => {
+    workspaceDir = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-project-memory-probe-"));
+    cfg = {
+      agents: {
+        entries: {
+          main: { workspace: workspaceDir },
+        },
+      },
+    };
+  });
+
+  afterEach(async () => {
+    await fs.rm(workspaceDir, { recursive: true, force: true });
+  });
+
+  it("proves absence when the canonical source does not exist", async () => {
+    await expect(probeProjectMemoryPresence({ cfg, agentId: "main" })).resolves.toBe("none");
+  });
+
+  it("proves absence when the canonical source has no project marker", async () => {
+    await fs.writeFile(path.join(workspaceDir, "MEMORY.md"), "- A global preference.\n");
+
+    await expect(probeProjectMemoryPresence({ cfg, agentId: "main" })).resolves.toBe("none");
+  });
+
+  it("reports possible project memory without duplicating candidate filtering", async () => {
+    await fs.writeFile(
+      path.join(workspaceDir, "MEMORY.md"),
+      "- A repository preference. <!-- project: github.com/openclaw/openclaw -->\n",
+    );
+
+    await expect(probeProjectMemoryPresence({ cfg, agentId: "main" })).resolves.toBe("present");
+  });
+
+  it("fails open when the canonical source cannot be safely inspected", async () => {
+    await fs.mkdir(path.join(workspaceDir, "MEMORY.md"));
+
+    await expect(probeProjectMemoryPresence({ cfg, agentId: "main" })).resolves.toBe("unknown");
+  });
+});
