diff --git a/extensions/memory-core/src/project-memory-probe.ts b/extensions/memory-core/src/project-memory-probe.ts
new file mode 100644
index 00000000000..80012a0bbd8
--- /dev/null
+++ b/extensions/memory-core/src/project-memory-probe.ts
@@ -0,0 +1,40 @@
+import fs from "node:fs";
+import path from "node:path";
+import { resolveAgentWorkspaceDir } from "openclaw/plugin-sdk/agent-scope-runtime";
+import type {
+  MemoryProjectPresence,
+  OpenClawConfig,
+} from "openclaw/plugin-sdk/memory-core-host-runtime-core";
+
+const PROJECT_MEMORY_SOURCE_MAX_BYTES = 4 * 1024 * 1024;
+const PROJECT_ANNOTATION_MARKER_RE = /<!--\s*project\s*:/iu;
+
+function probeProjectMemorySource(filePath: string): MemoryProjectPresence {
+  try {
+    const stats = fs.statSync(filePath);
+    if (!stats.isFile() || stats.size > PROJECT_MEMORY_SOURCE_MAX_BYTES) {
+      return "unknown";
+    }
+    return PROJECT_ANNOTATION_MARKER_RE.test(fs.readFileSync(filePath, "utf8"))
+      ? "present"
+      : "none";
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === "ENOENT" ? "none" : "unknown";
+  }
+}
+
+export async function probeProjectMemoryPresence(params: {
+  cfg: OpenClawConfig;
+  agentId: string;
+}): Promise<MemoryProjectPresence> {
+  try {
+    const workspaceDir = resolveAgentWorkspaceDir(params.cfg, params.agentId);
+    // The bootstrap consumer only admits curated candidates from the canonical
+    // root MEMORY.md. Reading that source is both cheaper and more conservative
+    // than interpreting the memory index: no annotation marker means no valid
+    // indexed project candidate can exist, regardless of schema or index state.
+    return probeProjectMemorySource(path.join(workspaceDir, "MEMORY.md"));
+  } catch {
+    return "unknown";
+  }
+}
