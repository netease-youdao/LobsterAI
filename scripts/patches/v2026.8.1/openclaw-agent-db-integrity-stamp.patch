@@ -0,0 +1,127 @@
+// Agent database opens skip the full integrity rescan only for a file left
+// unchanged since a verified clean close.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { requireNodeSqlite } from "../infra/node-sqlite.js";
+import { resolveSqliteIntegrityStampPath } from "../infra/sqlite-integrity-stamp.js";
+import {
+  closeOpenClawAgentDatabaseByPath,
+  closeOpenClawAgentDatabasesForTest,
+  openOpenClawAgentDatabase,
+  recordOpenClawAgentDatabaseOpenFailure,
+} from "./openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "./openclaw-state-db.js";
+
+let stateDir: string;
+let env: NodeJS.ProcessEnv;
+let integrityChecksByPath: Map<string, number>;
+
+function integrityChecks(pathname: string): number {
+  return integrityChecksByPath.get(pathname) ?? 0;
+}
+
+/** Ends this "process": closes cleanly and forgets all in-process trust, like a restart. */
+function restart(): void {
+  closeOpenClawAgentDatabasesForTest();
+  integrityChecksByPath.clear();
+}
+
+/**
+ * Creates the database, then gives it one fully verified current-version open
+ * and a clean close. A brand-new file is still at schema version 0 when its
+ * first open checks it, which is the always-verify migration path.
+ */
+function createStampedDatabase(): string {
+  const pathname = openOpenClawAgentDatabase({ agentId: "main", env }).path;
+  restart();
+  openOpenClawAgentDatabase({ agentId: "main", env });
+  expect(integrityChecks(pathname)).toBeGreaterThan(0);
+  restart();
+  expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(true);
+  return pathname;
+}
+
+beforeEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  stateDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-agent-db-stamp-")));
+  env = { OPENCLAW_STATE_DIR: stateDir };
+  integrityChecksByPath = new Map();
+  const { DatabaseSync } = requireNodeSqlite();
+  const prepare = DatabaseSync.prototype.prepare;
+  vi.spyOn(DatabaseSync.prototype, "prepare").mockImplementation(function (
+    this: DatabaseSync,
+    sql: string,
+    ...rest: unknown[]
+  ) {
+    if (/^PRAGMA integrity_check/i.test(sql)) {
+      const location = this.location() ?? ":memory:";
+      integrityChecksByPath.set(location, (integrityChecksByPath.get(location) ?? 0) + 1);
+    }
+    return (prepare as (...args: unknown[]) => ReturnType<DatabaseSync["prepare"]>).call(
+      this,
+      sql,
+      ...rest,
+    );
+  });
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+  fs.rmSync(stateDir, { force: true, recursive: true });
+});
+
+describe("agent database integrity stamp", () => {
+  it("does not stamp a database whose only check ran on the migration path", () => {
+    const pathname = openOpenClawAgentDatabase({ agentId: "main", env }).path;
+    expect(integrityChecks(pathname)).toBeGreaterThan(0);
+    restart();
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(false);
+  });
+
+  it("skips the rescan on the start after a verified clean close", () => {
+    const pathname = createStampedDatabase();
+
+    const second = openOpenClawAgentDatabase({ agentId: "main", env });
+    expect(integrityChecks(pathname)).toBe(0);
+    // The stamp is consumed while this process may write the file.
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(false);
+    expect(second.db.prepare("SELECT 1 AS ok").get()).toEqual({ ok: 1 });
+  });
+
+  it("rescans after a write by another connection", () => {
+    const pathname = createStampedDatabase();
+
+    const { DatabaseSync } = requireNodeSqlite();
+    const external = new DatabaseSync(pathname);
+    external.exec("CREATE TABLE IF NOT EXISTS external_probe (id INTEGER PRIMARY KEY)");
+    external.exec("DROP TABLE external_probe");
+    external.close();
+
+    openOpenClawAgentDatabase({ agentId: "main", env });
+    expect(integrityChecks(pathname)).toBeGreaterThan(0);
+  });
+
+  it("leaves no stamp behind while the database is open, so a crash forces a rescan", () => {
+    const pathname = createStampedDatabase();
+    openOpenClawAgentDatabase({ agentId: "main", env });
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(false);
+  });
+
+  it("drops the stamp when this process records damage", () => {
+    const pathname = createStampedDatabase();
+    openOpenClawAgentDatabase({ agentId: "main", env });
+    expect(closeOpenClawAgentDatabaseByPath(pathname)).toBe(true);
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(true);
+
+    const damage = Object.assign(new Error("database disk image is malformed"), {
+      name: "SqliteIntegrityError",
+    });
+    recordOpenClawAgentDatabaseOpenFailure(pathname, damage);
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(pathname))).toBe(false);
+  });
+});
