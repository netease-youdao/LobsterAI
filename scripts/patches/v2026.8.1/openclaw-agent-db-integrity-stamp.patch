+++ b/src/infra/sqlite-integrity-stamp.test.ts
@@ -0,0 +1,139 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { DatabaseSync } from "node:sqlite";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { requireNodeSqlite } from "./node-sqlite.js";
+import {
+  admitSqliteIntegrityStamp,
+  consumeSqliteIntegrityStampAdmission,
+  noteSqliteIntegrityVerified,
+  recordSqliteIntegrityStampAfterClose,
+  resetSqliteIntegrityStampsForTest,
+  resolveSqliteIntegrityStampPath,
+  revokeSqliteIntegrityTrust,
+} from "./sqlite-integrity-stamp.js";
+
+let dir: string;
+let dbPath: string;
+
+function openWal(): DatabaseSync {
+  const { DatabaseSync } = requireNodeSqlite();
+  const db = new DatabaseSync(dbPath);
+  db.exec("PRAGMA journal_mode = WAL;");
+  return db;
+}
+
+function writeRow(value: string): void {
+  const db = openWal();
+  db.prepare("INSERT INTO items (value) VALUES (?)").run(value);
+  db.close();
+}
+
+/** A verified, cleanly closed database with a fresh stamp. */
+function stampFreshDatabase(): void {
+  const db = openWal();
+  db.exec("CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY, value TEXT)");
+  db.close();
+  noteSqliteIntegrityVerified(dbPath);
+  expect(recordSqliteIntegrityStampAfterClose(dbPath)).toBe(true);
+}
+
+beforeEach(() => {
+  resetSqliteIntegrityStampsForTest();
+  dir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-integrity-stamp-")));
+  dbPath = path.join(dir, "agent.sqlite");
+});
+
+afterEach(() => {
+  resetSqliteIntegrityStampsForTest();
+  fs.rmSync(dir, { force: true, recursive: true });
+});
+
+describe("sqlite integrity stamp", () => {
+  it("never stamps a file this process did not verify", () => {
+    const db = openWal();
+    db.exec("CREATE TABLE items (id INTEGER PRIMARY KEY, value TEXT)");
+    db.close();
+
+    expect(recordSqliteIntegrityStampAfterClose(dbPath)).toBe(false);
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(dbPath))).toBe(false);
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+  });
+
+  it("admits an unchanged file once and deletes the stamp", () => {
+    stampFreshDatabase();
+    resetSqliteIntegrityStampsForTest();
+
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(true);
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(dbPath))).toBe(false);
+    expect(consumeSqliteIntegrityStampAdmission(dbPath)).toBe(true);
+    // Single use: the admission and the stamp are both gone.
+    expect(consumeSqliteIntegrityStampAdmission(dbPath)).toBe(false);
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+  });
+
+  it("rejects a file written after the stamp", () => {
+    stampFreshDatabase();
+    writeRow("after stamp");
+
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+  });
+
+  it("rejects a metadata change before admission but tolerates the opener's chmod after it", () => {
+    stampFreshDatabase();
+    fs.chmodSync(dbPath, 0o600);
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+
+    stampFreshDatabase();
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(true);
+    fs.chmodSync(dbPath, 0o600);
+    expect(consumeSqliteIntegrityStampAdmission(dbPath)).toBe(true);
+  });
+
+  it("drops an admission when content changes before the integrity gate", () => {
+    stampFreshDatabase();
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(true);
+    writeRow("between admission and gate");
+
+    expect(consumeSqliteIntegrityStampAdmission(dbPath)).toBe(false);
+  });
+
+  it("does not stamp or admit while a WAL holds committed frames", () => {
+    stampFreshDatabase();
+    const writer = openWal();
+    writer.exec("PRAGMA wal_autocheckpoint = 0;");
+    writer.prepare("INSERT INTO items (value) VALUES (?)").run("in wal");
+
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+    noteSqliteIntegrityVerified(dbPath);
+    expect(recordSqliteIntegrityStampAfterClose(dbPath)).toBe(false);
+    writer.close();
+  });
+
+  it("rejects a byte-identical replacement file", () => {
+    stampFreshDatabase();
+    const copy = `${dbPath}.copy`;
+    fs.copyFileSync(dbPath, copy);
+    const { atime, mtime } = fs.statSync(dbPath);
+    fs.utimesSync(copy, atime, mtime);
+    fs.renameSync(copy, dbPath);
+
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+  });
+
+  it("treats an unreadable stamp as absent and removes it", () => {
+    stampFreshDatabase();
+    fs.writeFileSync(resolveSqliteIntegrityStampPath(dbPath), "{not json");
+
+    expect(admitSqliteIntegrityStamp(dbPath)).toBe(false);
+  });
+
+  it("revokes process trust and the on-disk stamp", () => {
+    stampFreshDatabase();
+    revokeSqliteIntegrityTrust(dbPath);
+
+    expect(fs.existsSync(resolveSqliteIntegrityStampPath(dbPath))).toBe(false);
+    expect(recordSqliteIntegrityStampAfterClose(dbPath)).toBe(false);
+  });
+});
diff --git a/src/infra/sqlite-integrity-stamp.ts b/src/infra/sqlite-integrity-stamp.ts
new file mode 100644
index 00000000000..4eed50ec5c4
--- /dev/null
+++ b/src/infra/sqlite-integrity-stamp.ts
@@ -0,0 +1,193 @@
+/**
+ * Remembers that a SQLite file passed a full integrity check in this process
+ * and was then closed cleanly, so the next process can skip rescanning it
+ * while the file is provably unchanged.
+ *
+ * A full `PRAGMA integrity_check` reads every page. On a large agent database
+ * with a cold page cache (first start after a reboot or a long idle) that is
+ * several seconds of random reads on every gateway start. The stamp binds the
+ * check result to the file's identity (device, inode, birth, change and
+ * modification times, size) as of the clean close. Any later write, chmod,
+ * copy, restore or replacement changes that identity, and a leftover WAL or
+ * hot journal means the main file is not the whole database, so either case
+ * falls back to the full check. The daily background verifier still scans
+ * every database independently of this stamp.
+ */
+import fs from "node:fs";
+import path from "node:path";
+
+const SQLITE_INTEGRITY_STAMP_SUFFIX = ".integrity-stamp.json";
+const SQLITE_INTEGRITY_STAMP_VERSION = 1;
+const SQLITE_INTEGRITY_STAMP_FILE_MODE = 0o600;
+const SQLITE_PENDING_SIDECAR_SUFFIXES = ["-wal", "-journal"] as const;
+
+type SqliteFileStamp = {
+  birthtimeNs: string;
+  ctimeNs: string;
+  dev: string;
+  ino: string;
+  mtimeNs: string;
+  size: string;
+};
+
+const STAMP_KEYS = ["birthtimeNs", "ctimeNs", "dev", "ino", "mtimeNs", "size"] as const;
+// Between admission and the integrity gate the opener tightens file modes,
+// which moves ctime; content changes still move mtime or size.
+const ADMISSION_KEYS = ["birthtimeNs", "dev", "ino", "mtimeNs", "size"] as const;
+
+// Paths whose integrity this process proved (or admitted from a stamp).
+const verifiedPaths = new Set<string>();
+// Single-use admissions taken before the opener touched file metadata.
+const admissions = new Map<string, SqliteFileStamp>();
+
+export function resolveSqliteIntegrityStampPath(pathname: string): string {
+  return `${path.resolve(pathname)}${SQLITE_INTEGRITY_STAMP_SUFFIX}`;
+}
+
+function readSqliteFileStamp(pathname: string): SqliteFileStamp | null {
+  const stat = fs.statSync(pathname, { bigint: true, throwIfNoEntry: false });
+  if (!stat?.isFile()) {
+    return null;
+  }
+  return {
+    birthtimeNs: String(stat.birthtimeNs),
+    ctimeNs: String(stat.ctimeNs),
+    dev: String(stat.dev),
+    ino: String(stat.ino),
+    mtimeNs: String(stat.mtimeNs),
+    size: String(stat.size),
+  };
+}
+
+/** A non-empty WAL or any rollback journal means the main file alone is not the database. */
+function hasPendingSqliteSidecars(pathname: string): boolean {
+  return SQLITE_PENDING_SIDECAR_SUFFIXES.some((suffix) => {
+    const stat = fs.statSync(`${pathname}${suffix}`, { throwIfNoEntry: false });
+    return stat !== undefined && (!stat.isFile() || stat.size > 0);
+  });
+}
+
+function sameStamp(
+  left: SqliteFileStamp,
+  right: Partial<Record<keyof SqliteFileStamp, unknown>>,
+  keys: readonly (keyof SqliteFileStamp)[],
+): boolean {
+  return keys.every((key) => left[key] === right[key]);
+}
+
+function removeStampFile(stampPath: string): void {
+  try {
+    fs.rmSync(stampPath, { force: true });
+  } catch {
+    // An undeletable stamp is still harmless: it only matches an unchanged file.
+  }
+}
+
+/**
+ * Read and consume the stamp for `pathname` before anything (including a
+ * permission chmod) touches the file. Returns whether the file is unchanged
+ * since its last verified clean close. The stamp is deleted either way: from
+ * here on this process may write the file, and only a clean close re-stamps it.
+ */
+export function admitSqliteIntegrityStamp(pathname: string): boolean {
+  const resolvedPath = path.resolve(pathname);
+  const stampPath = resolveSqliteIntegrityStampPath(resolvedPath);
+  admissions.delete(resolvedPath);
+  let recorded: unknown;
+  try {
+    recorded = JSON.parse(fs.readFileSync(stampPath, "utf8"));
+  } catch {
+    return false;
+  }
+  removeStampFile(stampPath);
+  try {
+    const current = readSqliteFileStamp(resolvedPath);
+    if (
+      !current ||
+      hasPendingSqliteSidecars(resolvedPath) ||
+      typeof recorded !== "object" ||
+      recorded === null ||
+      (recorded as { version?: unknown }).version !== SQLITE_INTEGRITY_STAMP_VERSION
+    ) {
+      return false;
+    }
+    const file = (recorded as { file?: unknown }).file;
+    if (typeof file !== "object" || file === null || !sameStamp(current, file, STAMP_KEYS)) {
+      return false;
+    }
+    admissions.set(resolvedPath, current);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/**
+ * Consume this process's admission for the integrity gate about to run.
+ * True only when an admission exists and the file content is unchanged since.
+ */
+export function consumeSqliteIntegrityStampAdmission(pathname: string): boolean {
+  const resolvedPath = path.resolve(pathname);
+  const admission = admissions.get(resolvedPath);
+  admissions.delete(resolvedPath);
+  if (!admission) {
+    return false;
+  }
+  try {
+    const current = readSqliteFileStamp(resolvedPath);
+    return current !== null && sameStamp(admission, current, ADMISSION_KEYS);
+  } catch {
+    return false;
+  }
+}
+
+/** Record that this process proved (or admitted) the file's integrity. */
+export function noteSqliteIntegrityVerified(pathname: string): void {
+  verifiedPaths.add(path.resolve(pathname));
+}
+
+/** Forget any trust in `pathname`, in this process and on disk. */
+export function revokeSqliteIntegrityTrust(pathname: string): void {
+  const resolvedPath = path.resolve(pathname);
+  verifiedPaths.delete(resolvedPath);
+  admissions.delete(resolvedPath);
+  removeStampFile(resolveSqliteIntegrityStampPath(resolvedPath));
+}
+
+/**
+ * Stamp `pathname` after this process closed its connection. Writes nothing
+ * unless this process verified the file and SQLite left no pending WAL or
+ * journal (another connection still open, or a failed checkpoint). Never throws.
+ */
+export function recordSqliteIntegrityStampAfterClose(pathname: string): boolean {
+  const resolvedPath = path.resolve(pathname);
+  if (!verifiedPaths.has(resolvedPath)) {
+    return false;
+  }
+  const stampPath = resolveSqliteIntegrityStampPath(resolvedPath);
+  const tempPath = `${stampPath}.${process.pid}.tmp`;
+  try {
+    if (hasPendingSqliteSidecars(resolvedPath)) {
+      return false;
+    }
+    const file = readSqliteFileStamp(resolvedPath);
+    if (!file) {
+      return false;
+    }
+    fs.writeFileSync(
+      tempPath,
+      `${JSON.stringify({ version: SQLITE_INTEGRITY_STAMP_VERSION, file, stampedAt: new Date().toISOString() })}\n`,
+      { mode: SQLITE_INTEGRITY_STAMP_FILE_MODE },
+    );
+    fs.renameSync(tempPath, stampPath);
+    return true;
+  } catch {
+    removeStampFile(tempPath);
+    return false;
+  }
+}
+
+export function resetSqliteIntegrityStampsForTest(): void {
+  verifiedPaths.clear();
+  admissions.clear();
+}
