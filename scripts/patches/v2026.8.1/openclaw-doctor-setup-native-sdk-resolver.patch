+      path.join(hostRoot, "package.json"),
+      JSON.stringify({
+        name: "openclaw",
+        type: "module",
+        bin: { openclaw: "./openclaw.mjs" },
+        exports: { "./plugin-sdk/channel-outbound": "./dist/plugin-sdk/channel-outbound.js" },
+      }),
+    );
+    fs.writeFileSync(path.join(hostRoot, "openclaw.mjs"), "// fixture host\n");
+    fs.writeFileSync(
+      path.join(sdkDir, "channel-outbound.js"),
+      'export const doctorWarning = "SDK resolved after setup";\n',
+    );
+    const fixture = writeExternalSetupChannelPlugin({ pluginDir });
+    fs.appendFileSync(
+      path.join(pluginDir, "setup-entry.cjs"),
+      '\nmodule.exports.plugin.doctor = { collectPreviewWarnings: async () => (await import("./doctor.mjs")).warnings };\n',
+    );
+    fs.writeFileSync(
+      path.join(pluginDir, "doctor.mjs"),
+      'import { doctorWarning } from "openclaw/plugin-sdk/channel-outbound";\nexport const warnings = [doctorWarning];\n',
+    );
+    const cfg = createExternalChannelTestConfig({ pluginDir });
+    const plugins = listReadOnlyChannelPluginsForConfig(cfg, {
+      env: { ...process.env },
+      includePersistedAuthState: false,
+      includeSetupFallbackPlugins: true,
+    });
+
+    expectExternalChatSetupOnlyPluginLoaded({ plugins, ...fixture });
+    expect(fs.existsSync(path.join(pluginDir, "node_modules", "openclaw"))).toBe(false);
+    const doctor = plugins.find((plugin) => plugin.id === "external-chat")?.doctor;
+    expect(doctor?.collectPreviewWarnings).toBeTypeOf("function");
+    await expect(
+      doctor!.collectPreviewWarnings!({ cfg, doctorFixCommand: "openclaw doctor --fix" }),
+    ).resolves.toEqual(["SDK resolved after setup"]);
+  });
