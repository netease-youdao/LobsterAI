diff --git a/src/agents/embedded-agent-runner/managed-image-replay.ts b/src/agents/embedded-agent-runner/managed-image-replay.ts
new file mode 100644
--- /dev/null
+++ b/src/agents/embedded-agent-runner/managed-image-replay.ts
@@ -0,0 +1,43 @@
+const IMAGE_HISTORY_DIAGNOSTIC =
+  "[session:history] omitted image payload: missing data or mimeType";
+const MANAGED_IMAGE_ARTIFACT_PREFIX = "artifact_managed_image_";
+const MANAGED_IMAGE_URL_PREFIX = "/api/chat/media/outgoing/";
+
+export function isManagedAssistantImageBlock(value: unknown): boolean {
+  if (!value || typeof value !== "object") return false;
+  const block = value as Record<string, unknown>;
+  return block.type === "image"
+    && block.data === undefined
+    && typeof block.artifactId === "string"
+    && block.artifactId.startsWith(MANAGED_IMAGE_ARTIFACT_PREFIX)
+    && typeof block.url === "string"
+    && block.url.startsWith(MANAGED_IMAGE_URL_PREFIX);
+}
+
+/** Old model replies can echo a sentinel generated from these display-only blocks. */
+export function stripAssistantImageDiagnostic(text: string): string {
+  if (!text.includes(IMAGE_HISTORY_DIAGNOSTIC)) return text;
+  let fence: { marker: string; length: number } | undefined;
+  let changed = false;
+  const lines = text.split("\n").filter((line) => {
+    const boundary = /^ {0,3}(`{3,}|~{3,})(.*)$/.exec(line);
+    if (boundary) {
+      if (!fence) {
+        fence = { marker: boundary[1][0], length: boundary[1].length };
+      } else if (
+        boundary[1][0] === fence.marker
+        && boundary[1].length >= fence.length
+        && !boundary[2].trim()
+      ) {
+        fence = undefined;
+      }
+      return true;
+    }
+    if (!fence && line.replace(/\r$/, "") === IMAGE_HISTORY_DIAGNOSTIC) {
+      changed = true;
+      return false;
+    }
+    return true;
+  });
+  return changed ? lines.join("\n").trimEnd() : text;
+}
diff --git a/src/agents/embedded-agent-runner/managed-image-replay.test.ts b/src/agents/embedded-agent-runner/managed-image-replay.test.ts
