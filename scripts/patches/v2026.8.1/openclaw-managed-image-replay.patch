+++ b/src/agents/embedded-agent-runner/managed-image-replay.test.ts
@@ -0,0 +1,74 @@
+import type { AgentMessage } from "openclaw/plugin-sdk/agent-core";
+import { describe, expect, it } from "vitest";
+import { sanitizeSessionMessagesImages } from "../embedded-agent-helpers/images.js";
+import { normalizeAssistantReplayContent } from "./replay-history.js";
+
+const diagnostic = "[session:history] omitted image payload: missing data or mimeType";
+const image = {
+  type: "image",
+  artifactId: "artifact_managed_image_test",
+  url: "/api/chat/media/outgoing/session/test/full",
+  mimeType: "image/png",
+  width: 2048,
+  height: 2048,
+};
+const assistant = (content: unknown): AgentMessage => ({
+  role: "assistant", content, stopReason: "stop",
+  api: "openai-completions", provider: "test", model: "test",
+  usage: { input: 1, output: 1, totalTokens: 2 }, timestamp: 1,
+}) as unknown as AgentMessage;
+
+describe("managed outgoing images in assistant replay", () => {
+  it("avoids image omission diagnostics without changing the persisted image attachment", async () => {
+    const messages = [assistant([{ type: "text", text: "Image ready." }, image])];
+    const saved = structuredClone(messages);
+    const replay = normalizeAssistantReplayContent(messages);
+    expect(replay[0].content).toEqual([{ type: "text", text: "Image ready." }]);
+    expect(await sanitizeSessionMessagesImages(replay, "session:history")).toEqual(replay);
+    expect(messages).toEqual(saved);
+    expect(normalizeAssistantReplayContent(replay)).toBe(replay);
+  });
+
+  it("omits display-only turns but retains tool calls in mixed turns", () => {
+    expect(normalizeAssistantReplayContent([assistant([image])])).toEqual([]);
+    const call = { type: "toolCall", id: "call1", name: "read", arguments: {} };
+    expect(normalizeAssistantReplayContent([assistant([image, call])])[0].content).toEqual([call]);
+  });
+
+  it("keeps actual image inputs and malformed non-managed blocks for normal validation", () => {
+    const content = [
+      { ...image, data: "actual-base64" },
+      { type: "image", mimeType: "image/png" },
+      { ...image, artifactId: "unrecognized" },
+      { ...image, url: "https://example.test/image.png" },
+    ];
+    const messages = [assistant(content)];
+    expect(normalizeAssistantReplayContent(messages)).toBe(messages);
+  });
+
+  it("does not remove user attachments or tool results", () => {
+    const messages = [
+      { role: "user", content: [image], timestamp: 1 },
+      { role: "toolResult", toolCallId: "call1", toolName: "read", content: [image], timestamp: 2 },
+    ] as unknown as AgentMessage[];
+    expect(normalizeAssistantReplayContent(messages)).toBe(messages);
+  });
+
+  it("removes an old echoed sentinel without losing the final answer", () => {
+    for (const content of ["Done.\n" + diagnostic, [{ type: "text", text: "Done.\n" + diagnostic }]]) {
+      expect(normalizeAssistantReplayContent([assistant(content)])[0].content)
+        .toEqual([{ type: "text", text: "Done." }]);
+    }
+  });
+
+  it.each([
+    "Explain " + diagnostic,
+    "> " + diagnostic,
+    "```text\n" + diagnostic + "\n```",
+    "~~~text\n" + diagnostic + "\n~~~",
+    "```svg\n<svg><text>hello</text></svg>\n```",
+  ])("preserves quoted diagnostics and SVG examples", (text) => {
+    const messages = [assistant([{ type: "text", text }])];
+    expect(normalizeAssistantReplayContent(messages)).toBe(messages);
+  });
+});
