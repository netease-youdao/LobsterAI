@@ -0,0 +1,104 @@
+// LobsterAI: an unchanged agent database closed cleanly skips its next whole-file check.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  closeOpenClawAgentDatabaseByPath,
+  closeOpenClawAgentDatabasesForTest,
+  disposeOpenClawAgentDatabaseByPath,
+  openOpenClawAgentDatabase,
+} from "./openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "./openclaw-state-db.js";
+
+const integrityChecks = vi.hoisted(() => ({ count: 0 }));
+
+vi.mock("../infra/sqlite-integrity.js", async (importOriginal) => {
+  const actual = await importOriginal<typeof import("../infra/sqlite-integrity.js")>();
+  return {
+    ...actual,
+    assertSqliteIntegrity: (...args: Parameters<typeof actual.assertSqliteIntegrity>) => {
+      integrityChecks.count += 1;
+      return actual.assertSqliteIntegrity(...args);
+    },
+  };
+});
+
+let stateDir: string | undefined;
+let env: NodeJS.ProcessEnv = {};
+
+function readSealVerifiedAt(databasePath: string): number {
+  const envelope = JSON.parse(fs.readFileSync(`${databasePath}.seal`, "utf8"));
+  return JSON.parse(envelope.payload).verifiedAt;
+}
+
+beforeAll(() => {
+  closeOpenClawAgentDatabasesForTest();
+  stateDir = fs.realpathSync(fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-agent-db-seal-")));
+  env = { OPENCLAW_STATE_DIR: stateDir };
+});
+
+beforeEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  integrityChecks.count = 0;
+});
+
+afterAll(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+  if (stateDir) {
+    fs.rmSync(stateDir, { force: true, recursive: true });
+  }
+});
+
+describe("openclaw agent database clean-close seal", () => {
+  it("skips the whole-file check after a clean close and keeps the original check time", () => {
+    const first = openOpenClawAgentDatabase({ agentId: "seal-reuse", env });
+    expect(integrityChecks.count).toBeGreaterThan(0);
+    closeOpenClawAgentDatabaseByPath(first.path);
+    const verifiedAt = readSealVerifiedAt(first.path);
+
+    integrityChecks.count = 0;
+    const second = openOpenClawAgentDatabase({ agentId: "seal-reuse", env });
+
+    expect(integrityChecks.count).toBe(0);
+    // The open handle owns the file now; no seal may survive while it can change.
+    expect(fs.existsSync(`${second.path}.seal`)).toBe(false);
+    closeOpenClawAgentDatabaseByPath(second.path);
+    expect(readSealVerifiedAt(second.path)).toBe(verifiedAt);
+  });
+
+  it("re-verifies a file that changed after it was sealed", () => {
+    const first = openOpenClawAgentDatabase({ agentId: "seal-changed", env });
+    closeOpenClawAgentDatabaseByPath(first.path);
+    const later = new Date(Date.now() + 60_000);
+    fs.utimesSync(first.path, later, later);
+
+    integrityChecks.count = 0;
+    const second = openOpenClawAgentDatabase({ agentId: "seal-changed", env });
+
+    expect(integrityChecks.count).toBeGreaterThan(0);
+    closeOpenClawAgentDatabaseByPath(second.path);
+    expect(readSealVerifiedAt(second.path)).toBeGreaterThanOrEqual(later.getTime() - 60_000);
+  });
+
+  it("re-verifies after an unclean exit left no seal", () => {
+    const first = openOpenClawAgentDatabase({ agentId: "seal-crash", env });
+    closeOpenClawAgentDatabaseByPath(first.path);
+    // A process killed while the handle was open never republishes the consumed seal.
+    fs.rmSync(`${first.path}.seal`);
+
+    integrityChecks.count = 0;
+    openOpenClawAgentDatabase({ agentId: "seal-crash", env });
+
+    expect(integrityChecks.count).toBeGreaterThan(0);
