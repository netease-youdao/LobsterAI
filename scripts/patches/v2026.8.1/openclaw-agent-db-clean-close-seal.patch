@@ -0,0 +1,103 @@
+// LobsterAI clean-close seal tests: a seal proves only the exact file state it recorded.
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import {
+  invalidateSqliteCleanCloseSeal,
+  readSqliteCleanCloseSeal,
+  SQLITE_CLEAN_CLOSE_FULL_VERIFICATION_INTERVAL_MS,
+  writeSqliteCleanCloseSeal,
+} from "./sqlite-clean-close-seal.js";
+
+const SCHEMA = "agent:19:fixture";
+const tempDirs: string[] = [];
+
+function fixtureDatabase(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "openclaw-clean-close-seal-"));
+  tempDirs.push(dir);
+  const pathname = path.join(dir, "openclaw-agent.sqlite");
+  fs.writeFileSync(pathname, "database bytes");
+  return pathname;
+}
+
+afterEach(() => {
+  for (const dir of tempDirs.splice(0)) {
+    fs.rmSync(dir, { force: true, recursive: true });
+  }
+});
+
+describe("sqlite clean-close seal", () => {
+  it("returns the recorded proof while the file is unchanged", () => {
+    const pathname = fixtureDatabase();
+    const verifiedAt = Date.now() - 1_000;
+
+    expect(writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt })).toBe(true);
+
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toEqual({ verifiedAt });
+  });
+
+  it("rejects a seal after the file changes", () => {
+    const pathname = fixtureDatabase();
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() });
+
+    fs.appendFileSync(pathname, "more");
+
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toBeUndefined();
+  });
+
+  it("rejects a seal from another schema", () => {
+    const pathname = fixtureDatabase();
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() });
+
+    expect(readSqliteCleanCloseSeal(pathname, "agent:20:fixture")).toBeUndefined();
+  });
+
+  it("forces a full check once the last one is older than the interval", () => {
+    const pathname = fixtureDatabase();
+    const verifiedAt = Date.now() - SQLITE_CLEAN_CLOSE_FULL_VERIFICATION_INTERVAL_MS - 1;
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt });
+
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toBeUndefined();
+  });
+
+  it("neither writes nor honors a seal while WAL frames are pending", () => {
+    const pathname = fixtureDatabase();
+    fs.writeFileSync(`${pathname}-wal`, "frames");
+
+    expect(writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() })).toBe(false);
+    expect(fs.existsSync(`${pathname}.seal`)).toBe(false);
+
+    fs.writeFileSync(`${pathname}-wal`, "");
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() });
+    fs.writeFileSync(`${pathname}-wal`, "frames");
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toBeUndefined();
+  });
+
+  it("rejects a torn or tampered seal", () => {
+    const pathname = fixtureDatabase();
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() });
+    const sealPath = `${pathname}.seal`;
+    const envelope = JSON.parse(fs.readFileSync(sealPath, "utf8"));
+    const payload = JSON.parse(envelope.payload);
+    fs.writeFileSync(
+      sealPath,
+      JSON.stringify({ ...envelope, payload: JSON.stringify({ ...payload, verifiedAt: 1 }) }),
+    );
+
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toBeUndefined();
+
+    fs.writeFileSync(sealPath, "{");
+    expect(readSqliteCleanCloseSeal(pathname, SCHEMA)).toBeUndefined();
+  });
+
+  it("invalidates idempotently", () => {
+    const pathname = fixtureDatabase();
+    writeSqliteCleanCloseSeal(pathname, SCHEMA, { verifiedAt: Date.now() });
+
+    invalidateSqliteCleanCloseSeal(pathname);
+    invalidateSqliteCleanCloseSeal(pathname);
+
+    expect(fs.existsSync(`${pathname}.seal`)).toBe(false);
+  });
+});
