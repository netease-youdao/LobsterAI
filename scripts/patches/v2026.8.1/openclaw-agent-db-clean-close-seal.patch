new file mode 100644
index 00000000000..780ff8be662
--- /dev/null
+++ b/src/infra/sqlite-clean-close-seal.ts
@@ -0,0 +1,135 @@
+import { createHash } from "node:crypto";
+import fs, { type BigIntStats } from "node:fs";
+import { hasErrnoCode } from "./errno.js";
+
+// LobsterAI backport of the v2026.10.10 clean-close seal, reduced to agent databases.
+// A database closed after a verified open records its file identity next to it. The
+// next open may skip the full integrity_check only while that identity, size and
+// mtime are unchanged, no journal is pending, and the last full check is under 7 days.
+export const SQLITE_CLEAN_CLOSE_FULL_VERIFICATION_INTERVAL_MS = 7 * 24 * 60 * 60 * 1_000;
+
+const SEAL_VERSION = 1;
+
+export type SqliteCleanCloseProof = { verifiedAt: number };
+
+function sealPathFor(pathname: string): string {
+  return `${pathname}.seal`;
+}
+
+function fileFields(file: BigIntStats) {
+  return {
+    dev: file.dev.toString(),
+    ino: file.ino.toString(),
+    birthtimeNs: file.birthtimeNs.toString(),
+    size: file.size.toString(),
+    mtimeNs: file.mtimeNs.toString(),
+  };
+}
+
+function checksum(payload: string): string {
+  return createHash("sha256").update(payload).digest("hex").slice(0, 16);
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function hasNoJournal(pathname: string): boolean {
+  return ["-wal", "-journal"].every((suffix) => {
+    const file = fs.statSync(`${pathname}${suffix}`, { bigint: true, throwIfNoEntry: false });
+    return file === undefined || (file.isFile() && file.size === 0n);
+  });
+}
+
+/** Return the clean-close proof when the database file is exactly as it was sealed. */
+export function readSqliteCleanCloseSeal(
+  pathname: string,
+  schemaIdentity: string,
+  now = Date.now(),
+): SqliteCleanCloseProof | undefined {
+  try {
+    const sealPath = sealPathFor(pathname);
+    if (!fs.lstatSync(sealPath, { throwIfNoEntry: false })?.isFile()) {
+      return undefined;
+    }
+    const file = fs.statSync(pathname, { bigint: true, throwIfNoEntry: false });
+    if (!file?.isFile()) {
+      return undefined;
+    }
+    const envelope: unknown = JSON.parse(fs.readFileSync(sealPath, "utf8"));
+    if (
+      !isRecord(envelope) ||
+      typeof envelope.payload !== "string" ||
+      envelope.checksum !== checksum(envelope.payload)
+    ) {
+      return undefined;
+    }
+    const payload: unknown = JSON.parse(envelope.payload);
+    if (
+      !isRecord(payload) ||
+      payload.version !== SEAL_VERSION ||
+      payload.schemaIdentity !== schemaIdentity ||
+      typeof payload.verifiedAt !== "number" ||
+      !Number.isSafeInteger(payload.verifiedAt)
+    ) {
+      return undefined;
+    }
+    const age = now - payload.verifiedAt;
+    if (
+      age < 0 ||
+      age > SQLITE_CLEAN_CLOSE_FULL_VERIFICATION_INTERVAL_MS ||
+      !Object.entries(fileFields(file)).every(([key, value]) => payload[key] === value) ||
+      !hasNoJournal(pathname)
+    ) {
+      return undefined;
+    }
+    return { verifiedAt: payload.verifiedAt };
+  } catch {
+    // Torn writes and unreadable seals fall back to the ordinary full validation.
+    return undefined;
+  }
+}
+
+/** Remove any seal; a database that may change must never keep an old proof. */
+export function invalidateSqliteCleanCloseSeal(pathname: string): void {
+  try {
+    fs.unlinkSync(sealPathFor(pathname));
+  } catch (error) {
+    if (!hasErrnoCode(error, "ENOENT")) {
+      throw error;
+    }
+  }
+}
+
+/** Publish a proof after the last handle closed and its WAL was folded into the file. */
+export function writeSqliteCleanCloseSeal(
+  pathname: string,
+  schemaIdentity: string,
+  proof: SqliteCleanCloseProof,
+): boolean {
+  try {
+    const sealPath = sealPathFor(pathname);
+    const existing = fs.lstatSync(sealPath, { throwIfNoEntry: false });
+    const file = fs.statSync(pathname, { bigint: true, throwIfNoEntry: false });
+    if (!file?.isFile() || (existing && !existing.isFile()) || !hasNoJournal(pathname)) {
+      invalidateSqliteCleanCloseSeal(pathname);
+      return false;
+    }
+    const payload = JSON.stringify({
+      version: SEAL_VERSION,
+      schemaIdentity,
+      ...fileFields(file),
+      verifiedAt: proof.verifiedAt,
+    });
+    // No rename/fsync is needed: a partial write cannot pass the checksum and file-state checks.
+    fs.writeFileSync(sealPath, JSON.stringify({ payload, checksum: checksum(payload) }));
+    return true;
+  } catch {
+    try {
+      invalidateSqliteCleanCloseSeal(pathname);
+    } catch {
+      // Publication is best effort; a failed invalidation still cannot authorize a skip.
+    }
+    return false;
+  }
+}
