diff --git a/src/config/zod-schema.model-api-owner.test.ts b/src/config/zod-schema.model-api-owner.test.ts
new file mode 100644
index 00000000..7cbe4795
--- /dev/null
+++ b/src/config/zod-schema.model-api-owner.test.ts
@@ -0,0 +1,51 @@
+import { describe, expect, it } from "vitest";
+import { ModelsConfigSchema } from "./zod-schema.core.js";
+
+describe("ModelsConfigSchema provider API owners", () => {
+  it("accepts the LobsterAI owner while models keep explicit transports", () => {
+    const result = ModelsConfigSchema.safeParse({
+      providers: {
+        custom_0: {
+          baseUrl: "https://gateway.example.com/v1",
+          api: "lobsterai-model-compat",
+          models: [
+            { id: "kimi-k3", name: "Kimi K3", api: "openai-completions" },
+            { id: "plain-model", name: "Plain Model", api: "anthropic-messages" },
+          ],
+        },
+      },
+    });
+
+    expect(result.success).toBe(true);
+  });
+
+  it("rejects arbitrary provider API owner strings", () => {
+    const result = ModelsConfigSchema.safeParse({
+      providers: {
+        custom_0: {
+          baseUrl: "https://gateway.example.com/v1",
+          api: "arbitrary-plugin-owner",
+          models: [{ id: "model", name: "Model", api: "openai-completions" }],
+        },
+      },
+    });
+
+    expect(result.success).toBe(false);
+  });
+
+  it("rejects compatibility ownership at model level", () => {
+    const result = ModelsConfigSchema.safeParse({
+      providers: {
+        custom_0: {
+          baseUrl: "https://gateway.example.com/v1",
+          api: "lobsterai-model-compat",
+          models: [
+            { id: "kimi-k3", name: "Kimi K3", api: "lobsterai-model-compat" },
+          ],
+        },
+      },
+    });
+
+    expect(result.success).toBe(false);
+  });
+});
