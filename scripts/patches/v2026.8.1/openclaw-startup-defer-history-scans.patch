diff --git a/src/gateway/server-startup-deferred-work.test.ts b/src/gateway/server-startup-deferred-work.test.ts
new file mode 100644
index 00000000000..296a0ca7009
--- /dev/null
+++ b/src/gateway/server-startup-deferred-work.test.ts
@@ -0,0 +1,161 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  beginGatewayStartupDeferral,
+  deferUntilGatewayReady,
+  releaseGatewayStartupDeferredWork,
+  resetGatewayStartupDeferralForTest,
+} from "./server-startup-deferred-work.js";
+
+// No grace or quiet window: these cases cover ordering, failures and closing.
+const IMMEDIATE = { graceMs: 0, maxWaitMs: 1_000, pollMs: 1, quietMs: 0 };
+
+afterEach(() => {
+  resetGatewayStartupDeferralForTest();
+});
+
+describe("gateway startup deferred work", () => {
+  it("holds queued work until release, then runs it in order", async () => {
+    const order: string[] = [];
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("first", async () => order.push("first"));
+    deferUntilGatewayReady("second", async () => order.push("second"));
+    await new Promise<void>((resolve) => {
+      setImmediate(resolve);
+    });
+    expect(order).toEqual([]);
+
+    await releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    expect(order).toEqual(["first", "second"]);
+  });
+
+  it("yields to the event loop before each task", async () => {
+    const order: string[] = [];
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("scan", async () => order.push("scan"));
+    const released = releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    order.push("ready");
+    await released;
+    expect(order).toEqual(["ready", "scan"]);
+  });
+
+  it("logs a failed task and keeps going", async () => {
+    const warn = vi.fn();
+    const ran = vi.fn(async () => undefined);
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("broken", async () => {
+      throw new Error("boom");
+    });
+    deferUntilGatewayReady("next", ran);
+    await releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => false,
+      log: { warn },
+    });
+    expect(warn).toHaveBeenCalledWith(
+      expect.stringContaining("deferred startup work failed (broken)"),
+    );
+    expect(ran).toHaveBeenCalledOnce();
+  });
+
+  it("skips remaining work once the gateway is closing", async () => {
+    const ran = vi.fn(async () => undefined);
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("late", ran);
+    await releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => true,
+      log: { warn: vi.fn() },
+    });
+    expect(ran).not.toHaveBeenCalled();
+  });
+
+  it("runs at once outside a deferring startup and after release", async () => {
+    const outside = vi.fn(async () => undefined);
+    deferUntilGatewayReady("outside", outside);
+    expect(outside).toHaveBeenCalledOnce();
+
+    beginGatewayStartupDeferral();
+    await releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    const afterRelease = vi.fn(async () => undefined);
+    deferUntilGatewayReady("after", afterRelease);
+    expect(afterRelease).toHaveBeenCalledOnce();
+  });
+
+  it("drops work left by a startup that never became ready", async () => {
+    const stale = vi.fn(async () => undefined);
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("stale", stale);
+    beginGatewayStartupDeferral();
+    await releaseGatewayStartupDeferredWork({
+      timing: IMMEDIATE,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    expect(stale).not.toHaveBeenCalled();
+  });
+
+  it("waits for in-flight gateway work to settle before each task", async () => {
+    const ran = vi.fn(async () => undefined);
+    let active = 1;
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("scan", ran);
+    const released = releaseGatewayStartupDeferredWork({
+      timing: { graceMs: 0, maxWaitMs: 5_000, pollMs: 2, quietMs: 20 },
+      getActiveWorkCount: () => active,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    await new Promise<void>((resolve) => {
+      setTimeout(resolve, 60);
+    });
+    expect(ran).not.toHaveBeenCalled();
+    active = 0;
+    await released;
+    expect(ran).toHaveBeenCalledOnce();
+  });
+
+  it("runs anyway once the quiet wait reaches its cap", async () => {
+    const ran = vi.fn(async () => undefined);
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("scan", ran);
+    await releaseGatewayStartupDeferredWork({
+      timing: { graceMs: 0, maxWaitMs: 30, pollMs: 2, quietMs: 1_000 },
+      getActiveWorkCount: () => 1,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    expect(ran).toHaveBeenCalledOnce();
+  });
+
+  it("queues work that arrives while the released queue is still waiting", async () => {
+    const order: string[] = [];
+    let active = 1;
+    beginGatewayStartupDeferral();
+    deferUntilGatewayReady("startup", async () => order.push("startup"));
+    const released = releaseGatewayStartupDeferredWork({
+      timing: { graceMs: 0, maxWaitMs: 5_000, pollMs: 2, quietMs: 10 },
+      getActiveWorkCount: () => active,
+      isClosing: () => false,
+      log: { warn: vi.fn() },
+    });
+    // A post-ready service starting now must not run before the gateway is quiet.
+    const late = vi.fn(async () => order.push("late"));
+    deferUntilGatewayReady("late", late);
+    expect(late).not.toHaveBeenCalled();
+    active = 0;
+    await released;
+    expect(order).toEqual(["startup", "late"]);
+  });
+});
