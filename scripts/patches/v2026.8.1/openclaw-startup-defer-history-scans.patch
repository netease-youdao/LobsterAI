@@ -0,0 +1,109 @@
+/** Gateway startup keeps only history-critical session maintenance ahead of readiness. */
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { useAutoCleanupTempDirTracker } from "../../test/helpers/temp-dir.js";
+import { upsertSessionEntryCore } from "../config/sessions/session-accessor.js";
+import type { OpenClawConfig } from "../config/types.openclaw.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import { runStartupSessionMigration } from "./server-startup-session-migration.js";
+
+const tempDirs = useAutoCleanupTempDirTracker(afterEach);
+
+afterEach(() => {
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+});
+
+async function setup() {
+  const stateDir = tempDirs.make("openclaw-session-startup-deferral-");
+  const env = { OPENCLAW_STATE_DIR: stateDir };
+  const cfg: OpenClawConfig = { agents: { ownership: "explicit", entries: { main: {} } } };
+  await upsertSessionEntryCore(
+    {
+      agentId: "main",
+      defaultAgentId: "main",
+      env,
+      sessionKey: "agent:main:startup",
+    },
+    { sessionId: "startup-session", updatedAt: Date.now() },
+  );
+  closeOpenClawAgentDatabasesForTest();
+  const deferred: Array<{ label: string; run: () => Promise<unknown> }> = [];
+  const deferUntilReady = (label: string, run: () => Promise<unknown>) => {
+    deferred.push({ label, run });
+  };
+  const deps = {
+    migrateManagedWorktreeCanonicalWorkspaces: vi.fn(async () => 0),
+    reconcileSessionTranscriptIndexes: vi.fn(async () => ({ reconciledSessions: 0 })),
+  };
+  return { cfg, deferUntilReady, deferred, deps, env };
+}
+
+describe("runStartupSessionMigration with deferral", () => {
+  it("defers the backfill and the index sweep of a healthy store until readiness", async () => {
+    const t = await setup();
+    const transcriptProjectionNeedsRepair = vi.fn(() => false);
+    await runStartupSessionMigration({
+      cfg: t.cfg,
+      env: t.env,
+      log: { info: vi.fn(), warn: vi.fn() },
+      deps: { ...t.deps, transcriptProjectionNeedsRepair },
+      deferUntilReady: t.deferUntilReady,
+    });
+
+    expect(transcriptProjectionNeedsRepair).toHaveBeenCalledOnce();
+    expect(t.deps.migrateManagedWorktreeCanonicalWorkspaces).not.toHaveBeenCalled();
+    expect(t.deps.reconcileSessionTranscriptIndexes).not.toHaveBeenCalled();
+    expect(t.deferred.map((task) => task.label)).toEqual([
+      "session worktree workspace backfill",
+      "session transcript index sweep",
+    ]);
+
+    for (const task of t.deferred) {
+      await task.run();
+    }
+    expect(t.deps.migrateManagedWorktreeCanonicalWorkspaces).toHaveBeenCalledOnce();
+    expect(t.deps.reconcileSessionTranscriptIndexes).toHaveBeenCalledOnce();
+  });
+
+  it("repairs a stale projection before readiness", async () => {
+    const t = await setup();
+    await runStartupSessionMigration({
+      cfg: t.cfg,
+      env: t.env,
+      log: { info: vi.fn(), warn: vi.fn() },
+      deps: { ...t.deps, transcriptProjectionNeedsRepair: () => true },
+      deferUntilReady: t.deferUntilReady,
+    });
+
+    expect(t.deps.reconcileSessionTranscriptIndexes).toHaveBeenCalledOnce();
+    expect(t.deferred.map((task) => task.label)).toEqual(["session worktree workspace backfill"]);
+  });
+
+  it("checks the real projection state of a fresh store without deferring repair", async () => {
+    const t = await setup();
+    await runStartupSessionMigration({
+      cfg: t.cfg,
+      env: t.env,
+      log: { info: vi.fn(), warn: vi.fn() },
+      deps: t.deps,
+      deferUntilReady: t.deferUntilReady,
+    });
+    // The default check reads the store; a session without transcript rows needs no repair.
+    expect(t.deps.reconcileSessionTranscriptIndexes).not.toHaveBeenCalled();
+    expect(t.deferred.map((task) => task.label)).toContain("session transcript index sweep");
+  });
+
+  it("keeps everything inline without a deferral hook", async () => {
+    const t = await setup();
+    await runStartupSessionMigration({
+      cfg: t.cfg,
+      env: t.env,
+      log: { info: vi.fn(), warn: vi.fn() },
+      deps: t.deps,
+    });
+    expect(t.deps.migrateManagedWorktreeCanonicalWorkspaces).toHaveBeenCalledOnce();
+    expect(t.deps.reconcileSessionTranscriptIndexes).toHaveBeenCalledOnce();
+    expect(t.deferred).toEqual([]);
+  });
+});
