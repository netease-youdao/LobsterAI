index 00000000000..c93e8d5292c
--- /dev/null
+++ b/src/gateway/server-startup-deferred-work.ts
@@ -0,0 +1,130 @@
+/**
+ * Startup work that reads the whole session history but is not needed to
+ * serve the first request, queued until the gateway reports ready.
+ *
+ * node:sqlite is synchronous: a full-history scan blocks the event loop even
+ * when its promise is not awaited, so fire-and-forget scans still delay
+ * readiness. On a cold page cache each of them costs seconds, and removing one
+ * only moves the cost to the next reader of the same pages, so they all run
+ * here, one at a time, after readiness.
+ */
+type DeferredStartupTask = {
+  label: string;
+  run: () => Promise<unknown>;
+};
+
+type DeferredWorkLog = { warn: (message: string) => void };
+
+// Readiness alone is not enough: the first scan would block the event loop
+// right away and delay the readiness probe and the client's first requests.
+// Wait out the post-ready burst, then for a quiet gateway before each task.
+const POST_READY_GRACE_MS = 3_000;
+const QUIET_MS = 1_000;
+const QUIET_POLL_MS = 250;
+const MAX_QUIET_WAIT_MS = 60_000;
+
+type QuietWaitOptions = {
+  getActiveWorkCount: () => number;
+  isClosing: () => boolean;
+  maxWaitMs: number;
+  pollMs: number;
+  quietMs: number;
+};
+
+function sleep(ms: number): Promise<void> {
+  return new Promise((resolve) => {
+    // Never keep a closing process alive for deferred maintenance.
+    setTimeout(resolve, ms).unref?.();
+  });
+}
+
+/** Resolves once no root work ran for `quietMs`, the wait cap passed, or the gateway closes. */
+async function waitForQuietGateway(options: QuietWaitOptions): Promise<void> {
+  const startedAt = Date.now();
+  let quietSince = Date.now();
+  while (!options.isClosing() && Date.now() - startedAt < options.maxWaitMs) {
+    if (options.getActiveWorkCount() > 0) {
+      quietSince = Date.now();
+    } else if (Date.now() - quietSince >= options.quietMs) {
+      return;
+    }
+    await sleep(options.pollMs);
+  }
+}
+
+let deferring = false;
+// True while a released queue still waits for quiet or runs; late arrivals join it.
+let draining = false;
+let generation = 0;
+let pending: DeferredStartupTask[] = [];
+
+/** Starts queueing for a gateway startup; drops anything left from an earlier one. */
+export function beginGatewayStartupDeferral(): void {
+  generation += 1;
+  deferring = true;
+  draining = false;
+  pending = [];
+}
+
+/**
+ * Runs `run` once the gateway is ready and quiet: queued during startup or
+ * while the released queue drains (post-ready services start then too), and
+ * run at once otherwise (a settled lifecycle, or a caller outside startup).
+ */
+export function deferUntilGatewayReady(label: string, run: () => Promise<unknown>): void {
+  if (deferring || draining) {
+    pending.push({ label, run });
+    return;
+  }
+  void run().catch(() => undefined);
+}
+
+/** Releases queued work once readiness is published. Never throws. */
+export function releaseGatewayStartupDeferredWork(params: {
+  isClosing: () => boolean;
+  log: DeferredWorkLog;
+  /** Requests and ticks in flight; deferred work waits until this stays at zero. */
+  getActiveWorkCount?: () => number;
+  timing?: Partial<{ graceMs: number; maxWaitMs: number; pollMs: number; quietMs: number }>;
+}): Promise<void> {
+  const releasedGeneration = generation;
+  deferring = false;
+  draining = true;
+  const quiet: QuietWaitOptions = {
+    getActiveWorkCount: params.getActiveWorkCount ?? (() => 0),
+    isClosing: params.isClosing,
+    maxWaitMs: params.timing?.maxWaitMs ?? MAX_QUIET_WAIT_MS,
+    pollMs: params.timing?.pollMs ?? QUIET_POLL_MS,
+    quietMs: params.timing?.quietMs ?? QUIET_MS,
+  };
+  const current = () => generation === releasedGeneration;
+  return (async () => {
+    try {
+      await sleep(params.timing?.graceMs ?? POST_READY_GRACE_MS);
+      while (current() && pending.length > 0) {
+        await waitForQuietGateway(quiet);
+        const task = pending.shift();
+        if (!task || !current() || params.isClosing()) {
+          return;
+        }
+        try {
+          await task.run();
+        } catch (error) {
+          params.log.warn(`deferred startup work failed (${task.label}): ${String(error)}`);
+        }
+      }
+    } finally {
+      if (current()) {
+        draining = false;
+        pending = [];
+      }
+    }
+  })();
+}
+
+export function resetGatewayStartupDeferralForTest(): void {
+  generation += 1;
+  deferring = false;
+  draining = false;
+  pending = [];
+}
