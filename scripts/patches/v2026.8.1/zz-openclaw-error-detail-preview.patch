diff --git a/src/auto-reply/reply/agent-lifecycle-terminal.test.ts b/src/auto-reply/reply/agent-lifecycle-terminal.test.ts
new file mode 100644
index 00000000000..3307f1e7a55
--- /dev/null
+++ b/src/auto-reply/reply/agent-lifecycle-terminal.test.ts
@@ -0,0 +1,68 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { emitAgentEvent } from "../../infra/agent-events.js";
+import { createAgentLifecycleTerminalBackstop } from "./agent-lifecycle-terminal.js";
+
+vi.mock("../../infra/agent-events.js", () => ({ emitAgentEvent: vi.fn() }));
+
+const detail = {
+  provider: "lobsterai-server",
+  model: "deepseek-v4-pro",
+  rawErrorPreview: "Cannot read properties of undefined (reading 'trim')",
+  providerErrorMessagePreview: "Provider diagnostic",
+  httpCode: "500",
+  providerErrorType: "server_error",
+  providerRuntimeFailureKind: "unclassified",
+  failoverReason: "server_error",
+  rawErrorHash: "sha256:fixture",
+};
+
+function createBackstop() {
+  return createAgentLifecycleTerminalBackstop({
+    runId: "run-error-detail",
+    sessionKey: "agent:main:fixture",
+    getLifecycleGeneration: () => "generation-fixture",
+    resolveTerminationFields: () => ({}),
+  });
+}
+
+describe("deferred lifecycle error details", () => {
+  beforeEach(() => vi.clearAllMocks());
+
+  it("preserves safe previews through finishing to the outer terminal event", () => {
+    const backstop = createBackstop();
+    backstop.note({
+      stream: "lifecycle",
+      data: {
+        phase: "finishing",
+        error: "LLM request failed.",
+        ...detail,
+        headers: { authorization: "private" },
+        rawError: "private provider body",
+      },
+    });
+    backstop.emit("error", new Error(backstop.getDeferredError()));
+    expect(emitAgentEvent).toHaveBeenCalledWith(
+      expect.objectContaining({
+        data: expect.objectContaining({ phase: "error", error: "LLM request failed.", ...detail }),
+      }),
+    );
+    const data = vi.mocked(emitAgentEvent).mock.calls[0]?.[0].data;
+    expect(data).not.toHaveProperty("headers");
+    expect(data).not.toHaveProperty("rawError");
+  });
+
+  it.each(["end", "error"] as const)("clears earlier error details on retry before %s", (phase) => {
+    const backstop = createBackstop();
+    backstop.note({
+      stream: "lifecycle",
+      data: { phase: "finishing", error: "old error", ...detail },
+    });
+    backstop.note({ stream: "lifecycle", data: { phase: "start" } });
+    backstop.emit(phase, phase === "error" ? new Error("new error") : {});
+    expect(backstop.getDeferredError()).toBeUndefined();
+    const data = vi.mocked(emitAgentEvent).mock.calls[0]?.[0].data;
+    for (const key of Object.keys(detail)) {
+      expect(data).not.toHaveProperty(key);
+    }
+  });
+});
