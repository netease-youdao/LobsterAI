+import { describe, expect, it } from "vitest";
+import { OpenClawSchema } from "./zod-schema.js";
+
+describe("channel scheduling opt-in", () => {
+  it("defaults off and accepts explicit booleans", () => {
+    expect(OpenClawSchema.parse({ cron: {} }).cron?.allowChannelScheduling).toBeUndefined();
+    for (const enabled of [false, true]) {
+      expect(
+        OpenClawSchema.parse({ cron: { allowChannelScheduling: enabled } }).cron
+          ?.allowChannelScheduling,
+      ).toBe(enabled);
+    }
+  });
+  it("rejects non-boolean settings", () => {
+    expect(OpenClawSchema.safeParse({ cron: { allowChannelScheduling: "true" } }).success).toBe(
+      false,
+    );
+  });
+});
