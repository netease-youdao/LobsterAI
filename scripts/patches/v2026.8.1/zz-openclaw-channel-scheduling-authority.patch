@@ -0,0 +1,86 @@
+import { describe, expect, it, vi } from "vitest";
+import "../../test-helpers/fast-bash-tools.js";
+import "../../test-helpers/fast-coding-tools.js";
+import "../../test-helpers/fast-openclaw-tools.js";
+import {
+  createCronCreatorAuthorityCapability,
+  runWithCronCreatorAuthorityCapability,
+} from "../../cron-creator-authority-context.js";
+import { createOpenClawTools } from "../../openclaw-tools.js";
+import { prepareEmbeddedAttemptToolBase } from "./attempt-tool-prepare.js";
+
+type Preparation = Parameters<typeof prepareEmbeddedAttemptToolBase>[0];
+function prepare(
+  capability?: Preparation["attempt"]["cronCreatorAuthorityCapability"],
+  deny?: string[],
+) {
+  return prepareEmbeddedAttemptToolBase({
+    agentDir: process.cwd(),
+    effectiveCwd: process.cwd(),
+    effectiveWorkspace: process.cwd(),
+    resolvedWorkspace: process.cwd(),
+    sandboxSessionKey: "agent:main:feishu:direct:sender",
+    sessionAgentId: "main",
+    markCoreToolStage: () => {},
+    onYield: () => {},
+    runAbortController: new AbortController(),
+    codeModeSkills: [],
+    skillUsagePaths: [],
+    attempt: {
+      runId: "channel-run",
+      sessionKey: "agent:main:feishu:direct:sender",
+      senderId: "sender",
+      senderIsOwner: false,
+      messageChannel: "feishu",
+      agentAccountId: "bot-account",
+      provider: "openai",
+      modelId: "gpt-4.1",
+      model: { id: "gpt-4.1", provider: "openai", api: "openai-completions", input: ["text"] },
+      config: { tools: { deny } },
+      admittedRunContext: {},
+      cronCreatorAuthorityCapability: capability,
+    },
+  } as Preparation);
+}
+
+describe("built-in attempt channel scheduling authority", () => {
+  it("retains only automations, waits for the final tool capture and expires with the run", async () => {
+    const capability = createCronCreatorAuthorityCapability(
+      "channel-run",
+      { kind: "external", channel: "feishu" },
+      { schedulingOnly: true },
+    )!;
+    let resolver: NonNullable<
+      Parameters<typeof createOpenClawTools>[0]
+    >["resolveCronCreatorToolAuthority"];
+    await runWithCronCreatorAuthorityCapability(capability, async () => {
+      const prepared = prepare(capability);
+      const names = prepared.toolsRaw.map((tool) => tool.name);
+      expect(names).toContain("automations");
+      expect(names).not.toContain("gateway");
+      expect(names).not.toContain("openclaw");
+      resolver = vi.mocked(createOpenClawTools).mock.lastCall?.[0]?.resolveCronCreatorToolAuthority;
+      expect(resolver).toBeTypeOf("function");
+      await expect(resolver!()).rejects.toThrow("complete model-callable tool surface");
+      prepared.cronCreatorToolAllowlist.splice(0, prepared.cronCreatorToolAllowlist.length, "read");
+      prepared.cronCreatorToolAllowlistCaptureRef.value = {
+        version: 1,
+        source: "final-executable-surface",
+      };
+      await expect(resolver!()).resolves.toMatchObject({ tools: ["read"] });
+    });
+    await expect(resolver!()).rejects.toThrow("no longer active");
+  });
+
+  it("does not admit missing or mismatched capabilities and preserves explicit denies", () => {
+    expect(prepare().toolsRaw.map((tool) => tool.name)).not.toContain("automations");
+    const wrongRun = createCronCreatorAuthorityCapability("other-run")!;
+    expect(prepare(wrongRun).toolsRaw.map((tool) => tool.name)).not.toContain("automations");
+    const capability = createCronCreatorAuthorityCapability("channel-run")!;
+    runWithCronCreatorAuthorityCapability(capability, () => {
+      expect(prepare(capability, ["automations"]).toolsRaw.map((tool) => tool.name)).not.toContain(
+        "automations",
+      );
+    });
+  });
+});
