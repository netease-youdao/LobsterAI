@@ -0,0 +1,66 @@
+import { afterEach, expect, test, vi } from "vitest";
+import { ConfigMutationReceipts } from "./config-mutation-receipts.js";
+
+afterEach(() => vi.useRealTimers());
+
+test("persistence remains pending until the application owner confirms the same revision", async () => {
+  const receipts = new ConfigMutationReceipts();
+  const { receipt } = receipts.begin("write-1", "secret fixture config");
+  let settle!: (state: string) => void;
+  receipts.committed(
+    receipt,
+    "revision-1",
+    new Promise((resolve) => {
+      settle = resolve;
+    }),
+  );
+  expect(receipts.get("write-1")).toEqual({
+    mutationId: "write-1",
+    state: "pending",
+    desiredRevision: "revision-1",
+    persistedRevision: "revision-1",
+  });
+  settle("applied");
+  await Promise.resolve();
+  expect(receipts.get("write-1")).toEqual({
+    mutationId: "write-1",
+    state: "applied",
+    desiredRevision: "revision-1",
+    persistedRevision: "revision-1",
+    appliedRevision: "revision-1",
+  });
+  expect(JSON.stringify(receipts.get("write-1"))).not.toContain("secret");
+  expect(receipts.begin("write-1", "secret fixture config").duplicate).toBe(true);
+  expect(() => receipts.begin("write-1", "different config")).toThrow("different config mutation");
+});
+
+test.each([
+  ["unclaimed", "pending"],
+  ["failed", "rejected"],
+  ["superseded", "rejected"],
+  ["restart-pending", "restart-required"],
+  ["applied-restart-required", "restart-required"],
+])(
+  "application %s yields %s without inventing an applied revision",
+  async (application, expected) => {
+    const receipts = new ConfigMutationReceipts();
+    const { receipt } = receipts.begin("write-2", "config");
+    receipts.committed(receipt, "revision-2", Promise.resolve(application));
+    await Promise.resolve();
+    expect(receipts.get("write-2")).toMatchObject({ state: expected });
+    expect(receipts.get("write-2")?.appliedRevision).toBeUndefined();
+  },
+);
+
+test("receipt memory is bounded and expired receipts become unknown", () => {
+  vi.useFakeTimers();
+  const receipts = new ConfigMutationReceipts();
+  for (let index = 0; index < 256; index++) {
+    receipts.begin(String(index), "config");
+  }
+  expect(() => receipts.begin("overflow", "config")).toThrow("capacity");
+  vi.advanceTimersByTime(600_001);
+  receipts.begin("new", "config");
+  expect(receipts.get("0")).toBeNull();
+  expect(receipts.get("new")?.state).toBe("pending");
+});
diff --git a/src/gateway/config-mutation-receipts.ts b/src/gateway/config-mutation-receipts.ts
new file mode 100644
index 00000000..b70e0bcb
--- /dev/null
+++ b/src/gateway/config-mutation-receipts.ts
@@ -0,0 +1,76 @@
+import { createHash } from "node:crypto";
+
+export type ConfigMutationReceipt = {
+  mutationId: string;
+  state: "pending" | "applied" | "rejected" | "restart-required";
+  desiredRevision?: string;
+  persistedRevision?: string;
+  appliedRevision?: string;
+  /** Schema paths only; retained for ACK loss and read-only reconciliation. */
+  restartPaths?: string[];
+};
+
+/** Short-lived, process-owned receipts. They contain no config values or credentials. */
+export class ConfigMutationReceipts {
+  private entries = new Map<
+    string,
+    { digest: string; at: number; receipt: ConfigMutationReceipt }
+  >();
+
+  get(id: string): ConfigMutationReceipt | null {
+    const entry = this.entries.get(id);
+    return entry ? { ...entry.receipt } : null;
+  }
+
+  begin(id: string, payload: string): { receipt: ConfigMutationReceipt; duplicate: boolean } {
+    const digest = createHash("sha256").update(payload).digest("hex");
+    const existing = this.entries.get(id);
+    if (existing) {
+      if (existing.digest !== digest) {
+        throw new Error("mutationId was already used for a different config mutation");
+      }
+      return { receipt: existing.receipt, duplicate: true };
+    }
+    // The desktop reconciles for at most 45 seconds. Keep a ten minute receipt
+    // window; eviction means unknown, never proof that a mutation did not run.
+    const now = Date.now();
+    for (const [key, value] of this.entries) {
+      if (now - value.at > 600_000) {
+        this.entries.delete(key);
+      }
+    }
+    if (this.entries.size >= 256) {
+      throw new Error("config mutation receipt capacity reached");
+    }
+    const receipt: ConfigMutationReceipt = { mutationId: id, state: "pending" };
+    this.entries.set(id, { digest, at: now, receipt });
+    return { receipt, duplicate: false };
+  }
+
+  committed(
+    receipt: ConfigMutationReceipt,
+    revision: string | undefined,
+    application?: Promise<string>,
+  ): void {
+    receipt.desiredRevision = revision;
+    receipt.persistedRevision = revision;
+    if (!application) {
+      return;
+    }
+    void application.then(
+      (status) => {
+        if (status === "applied" && revision) {
+          receipt.appliedRevision = revision;
+          receipt.state = "applied";
+        } else if (status === "restart-pending" || status === "applied-restart-required") {
+          receipt.state = "restart-required";
+        } else if (status !== "unclaimed") {
+          receipt.state = "rejected";
+        }
+      },
+      () => {
+        receipt.state = "rejected";
+      },
+    );
+  }
+}
diff --git a/src/gateway/gateway.config-mutations.e2e.test.ts b/src/gateway/gateway.config-mutations.e2e.test.ts
