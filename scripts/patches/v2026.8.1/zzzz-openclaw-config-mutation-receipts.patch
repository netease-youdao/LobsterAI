+++ b/src/gateway/host-config-restart-lease.ts
@@ -0,0 +1,254 @@
+import { randomUUID } from "node:crypto";
+import type { GatewayActiveWorkSnapshot } from "../infra/gateway-active-work.js";
+import type { GatewayRequestContext } from "./server-methods/types.js";
+
+type RestartLeaseState = "acquired" | "committed" | "released" | "busy" | "unknown" | "expired";
+export type HostConfigRestartLeaseResult = {
+  state: RestartLeaseState;
+  instanceId: string;
+  leaseId?: string;
+  expiresAtMs?: number;
+  targetRevision?: string;
+  reason?: string;
+};
+type HeldLease = {
+  leaseId: string;
+  targetRevision: string;
+  expiresAtMs: number;
+  committed: boolean;
+  timer?: ReturnType<typeof setTimeout>;
+  isReady: () => boolean;
+  inspect: () => GatewayActiveWorkSnapshot;
+  release: () => boolean;
+  commitAdmission: () => void;
+  isDraining: () => boolean;
+};
+
+const INSTANCE_ID = randomUUID();
+const LEASE_TTL_MS = 15_000;
+let current: HeldLease | undefined;
+
+function result(
+  state: RestartLeaseState,
+  held?: HeldLease,
+  reason?: string,
+): HostConfigRestartLeaseResult {
+  return {
+    state,
+    instanceId: INSTANCE_ID,
+    ...(held
+      ? {
+          leaseId: held.leaseId,
+          targetRevision: held.targetRevision,
+          expiresAtMs: held.expiresAtMs,
+        }
+      : {}),
+    ...(reason ? { reason } : {}),
+  };
+}
+
+function releaseHeld(held: HeldLease): boolean {
+  clearTimeout(held.timer);
+  if (current === held) {
+    current = undefined;
+  }
+  return held.release();
+}
+
+function liveLease(): HeldLease | undefined {
+  const held = current;
+  if (!held) {
+    return undefined;
+  }
+  if (held.committed) {
+    // An in-process lifecycle reset retires the old lease too.
+    if (!held.isDraining()) {
+      current = undefined;
+    }
+    return current;
+  }
+  if (Date.now() >= held.expiresAtMs || !held.isReady()) {
+    releaseHeld(held);
+    return undefined;
+  }
+  return held;
+}
+
+function requestRecord(params: unknown): Record<string, unknown> | undefined {
+  if (!params || typeof params !== "object" || Array.isArray(params)) {
+    return undefined;
+  }
+  const record = params as Record<string, unknown>;
+  if (
+    record.raw !== "{}" ||
+    record.mutationId !== undefined ||
+    record.allowRestart !== undefined ||
+    record.baseHash !== undefined
+  ) {
+    return undefined;
+  }
+  return record;
+}
+
+function isHostConfigRestartLeaseAcquire(params: unknown): boolean {
+  return requestRecord(params)?.restartLeaseAction === "acquire";
+}
+
+/** Only the exact held lease may finish through closed admission; config writes stay blocked. */
+function isHostConfigRestartLeaseContinuation(params: unknown): boolean {
+  const request = requestRecord(params);
+  if (
+    !request ||
+    (request.restartLeaseAction !== "commit" && request.restartLeaseAction !== "release")
+  ) {
+    return false;
+  }
+  const held = liveLease();
+  return Boolean(
+    held &&
+    request.restartLeaseId === held.leaseId &&
+    request.restartLeaseInstanceId === INSTANCE_ID,
+  );
+}
+
+export function getHostConfigRestartLeaseRequestKind(
+  method: string,
+  params: unknown,
+): "acquire" | "continuation" | undefined {
+  if (method !== "config.set") {
+    return undefined;
+  }
+  if (isHostConfigRestartLeaseAcquire(params)) {
+    return "acquire";
+  }
+  return isHostConfigRestartLeaseContinuation(params) ? "continuation" : undefined;
+}
+
+/** Acquire through the existing scheduler-aware, process-wide suspension owner. */
+export async function acquireHostConfigRestartLease(
+  context: GatewayRequestContext,
+  targetRevision: string,
+): Promise<HostConfigRestartLeaseResult> {
+  if (
+    !targetRevision?.trim() ||
+    targetRevision.length > 256 ||
+    process.listenerCount("SIGINT") === 0 ||
+    !context.cron?.pauseScheduling ||
+    !context.cron?.resumeScheduling ||
+    !context.chatAbortControllers ||
+    !context.chatQueuedTurns
+  ) {
+    return result("unknown", undefined, "restart-prerequisites-unavailable");
+  }
+  // Keep activity registries off the dispatcher's static startup import path.
+  const [suspension, activity, admission, serverActivity] = await Promise.all([
+    import("../infra/gateway-suspend-coordinator.js"),
+    import("../infra/gateway-active-work.js"),
+    import("../process/gateway-work-admission.js"),
+    import("./server-active-work.js"),
+  ]);
+  const existing = liveLease();
+  if (existing) {
+    return result("busy", undefined, "restart-lease-held");
+  }
+  const inspect = serverActivity.createGatewayServerActiveWorkInspectors(context);
+  const requestId = `host-config-restart:${randomUUID()}`;
+  try {
+    const prepared = suspension.prepareGatewaySuspend({
+      requestId,
+      terminalPolicy: "preserve",
+      pauseScheduling: () => context.cron.pauseScheduling(),
+      resumeScheduling: () => context.cron.resumeScheduling(),
+      inspect,
+      warn: (message) => context.logGateway.warn(message),
+    });
+    if (prepared.status !== "ready") {
+      return result(
+        prepared.status === "busy" || prepared.status === "conflict" ? "busy" : "unknown",
+        undefined,
+        prepared.status === "busy"
+          ? `runtime-not-idle:${prepared.reason}:${prepared.blockers.map(({ kind, count }) => `${kind}=${count}`).join(",")}`
+          : `runtime-not-idle:${prepared.status}`,
+      );
+    }
+    const leaseId = prepared.suspensionId;
+    const lifecycleSignal = admission.getGatewayRestartDrainSignal();
+    const held: HeldLease = {
+      leaseId,
+      targetRevision,
+      expiresAtMs: Date.now() + LEASE_TTL_MS,
+      committed: false,
+      isReady: () => suspension.getGatewaySuspendStatus(leaseId).status === "ready",
+      inspect: () => activity.createGatewayActiveWorkSnapshot(inspect),
+      release: () => suspension.resumeGatewaySuspend(leaseId).ok,
+      commitAdmission: admission.markGatewayRestartDraining,
+      isDraining: () =>
+        admission.getGatewayRestartDrainSignal() === lifecycleSignal &&
+        admission.isGatewayRestartDraining(),
+    };
+    current = held;
+    held.timer = setTimeout(() => {
+      if (current === held && !held.committed) {
+        releaseHeld(held);
+      }
+    }, LEASE_TTL_MS);
+    held.timer.unref?.();
+    return result("acquired", held);
+  } catch {
+    // The suspension owner rolls back scheduler/admission on inspection failure.
+    return result("unknown", undefined, "runtime-inspection-failed");
+  }
+}
+
+/** Commit and close admission in one turn; the host never force-kills this automatic restart. */
+export function commitHostConfigRestartLease(
+  leaseId: string,
+  instanceId: string,
+): HostConfigRestartLeaseResult {
+  const held = liveLease();
+  if (!held || held.leaseId !== leaseId || instanceId !== INSTANCE_ID) {
+    return result("expired");
+  }
+  if (held.committed) {
+    return result("committed", held);
+  }
+  try {
+    if (process.listenerCount("SIGINT") === 0) {
+      releaseHeld(held);
+      return result("unknown", undefined, "shutdown-handler-unavailable");
+    }
+    const snapshot = held.inspect();
+    if (
+      snapshot.idle !== true ||
+      !Number.isFinite(snapshot.counts.totalActive) ||
+      snapshot.counts.totalActive !== 0
+    ) {
+      releaseHeld(held);
+      return result("busy", undefined, "runtime-became-busy");
+    }
+  } catch {
+    releaseHeld(held);
+    return result("unknown", undefined, "runtime-inspection-failed");
+  }
+  // No await separates the final inventory check from the irreversible admission fence.
+  held.commitAdmission();
+  held.committed = true;
+  clearTimeout(held.timer);
+  // Let config.set enqueue the ACK first. Even a lost ACK cannot admit new work.
+  setImmediate(() => process.emit("SIGINT"));
+  return result("committed", held);
+}
+
+export function releaseHostConfigRestartLease(
+  leaseId: string,
+  instanceId: string,
+): HostConfigRestartLeaseResult {
+  const held = liveLease();
+  if (!held || held.leaseId !== leaseId || instanceId !== INSTANCE_ID) {
+    return result("expired");
+  }
+  if (held.committed) {
+    return result("committed", held);
+  }
+  return result(releaseHeld(held) ? "released" : "unknown");
+}
