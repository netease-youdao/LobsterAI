@@ -0,0 +1,429 @@
+import { createHash } from "node:crypto";
+import fs from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, beforeAll, expect, test, vi } from "vitest";
+import { setLoggerOverride } from "../logging.js";
+import { getActiveGatewayRootWorkCount } from "../process/gateway-work-admission.js";
+import { closeOpenClawAgentDatabasesForTest } from "../state/openclaw-agent-db.js";
+import { closeOpenClawStateDatabaseForTest } from "../state/openclaw-state-db.js";
+import { captureEnv } from "../test-utils/env.js";
+import type { ConfigMutationReceipt } from "./config-mutation-receipts.js";
+import { startGatewayServer } from "./server.js";
+import {
+  connectGatewayClient,
+  getGatewayE2ePortBlock,
+  disconnectGatewayClient,
+} from "./test-helpers.e2e.js";
+
+let server: {
+  client: Awaited<ReturnType<typeof connectGatewayClient>>;
+  server: Awaited<ReturnType<typeof startGatewayServer>>;
+};
+const recoveryRestart = vi.fn(() => ({ status: "failed" as const }));
+let tempHome: string;
+let envSnapshot: ReturnType<typeof captureEnv>;
+beforeAll(async () => {
+  const keys = [
+    "HOME",
+    "USERPROFILE",
+    "OPENCLAW_STATE_DIR",
+    "OPENCLAW_CONFIG_PATH",
+    "OPENCLAW_GATEWAY_TOKEN",
+    "OPENCLAW_TEST_MINIMAL_GATEWAY",
+    "OPENCLAW_SKIP_CHANNELS",
+    "OPENCLAW_SKIP_GMAIL_WATCHER",
+    "OPENCLAW_SKIP_CRON",
+    "OPENCLAW_SKIP_CANVAS_HOST",
+    "OPENCLAW_SKIP_BROWSER_CONTROL_SERVER",
+    "OPENCLAW_SKIP_PROVIDERS",
+    "OPENCLAW_BUNDLED_PLUGINS_DIR",
+    "OPENCLAW_DISABLE_BUNDLED_PLUGINS",
+  ];
+  envSnapshot = captureEnv(keys);
+  tempHome = await fs.mkdtemp(path.join(os.tmpdir(), "openclaw-config-receipts-"));
+  const configPath = path.join(tempHome, "state", "openclaw.json");
+  const bundled = path.join(tempHome, "empty-plugins");
+  await fs.mkdir(path.dirname(configPath), { recursive: true });
+  await fs.mkdir(bundled);
+  Object.assign(process.env, {
+    HOME: tempHome,
+    USERPROFILE: tempHome,
+    OPENCLAW_STATE_DIR: path.dirname(configPath),
+    OPENCLAW_GATEWAY_TOKEN: "receipt-fixture-token",
+    OPENCLAW_SKIP_CHANNELS: "1",
+    OPENCLAW_SKIP_GMAIL_WATCHER: "1",
+    OPENCLAW_SKIP_CRON: "1",
+    OPENCLAW_SKIP_CANVAS_HOST: "1",
+    OPENCLAW_SKIP_BROWSER_CONTROL_SERVER: "1",
+    OPENCLAW_SKIP_PROVIDERS: "1",
+    OPENCLAW_BUNDLED_PLUGINS_DIR: bundled,
+    OPENCLAW_DISABLE_BUNDLED_PLUGINS: "1",
+  });
+  delete process.env.OPENCLAW_TEST_MINIMAL_GATEWAY;
+  process.env.OPENCLAW_CONFIG_PATH = configPath;
+  await fs.writeFile(
+    configPath,
+    JSON.stringify({
+      gateway: { mode: "local", auth: { mode: "token", token: "${OPENCLAW_GATEWAY_TOKEN}" } },
+      skills: { entries: {} },
+    }),
+  );
+  const port = await getGatewayE2ePortBlock();
+  const gateway = await startGatewayServer(port, {
+    bind: "loopback",
+    auth: { mode: "token", token: "receipt-fixture-token" },
+    controlUiEnabled: false,
+    hotReloadRecovery: recoveryRestart,
+  });
+  const client = await connectGatewayClient({
+    url: `ws://127.0.0.1:${port}`,
+    token: "receipt-fixture-token",
+    scopes: ["operator.admin"],
+  });
+  server = { server: gateway, client };
+  await server.server.startupSettled;
+}, 90_000);
+afterAll(async () => {
+  if (server) {
+    await disconnectGatewayClient(server.client);
+    await server.server.close();
+  }
+  closeOpenClawAgentDatabasesForTest();
+  closeOpenClawStateDatabaseForTest();
+  if (tempHome) {
+    await fs.rm(tempHome, { recursive: true, force: true, maxRetries: 10, retryDelay: 50 });
+  }
+  setLoggerOverride(null);
+  envSnapshot?.restore();
+});
+
+async function rpcReq<T = Record<string, unknown>>(
+  client: typeof server.client,
+  method: string,
+  params: unknown,
+  timeoutMs = 10_000,
+) {
+  try {
+    return { ok: true, payload: await client.request<T>(method, params, { timeoutMs }) };
+  } catch (error) {
+    return { ok: false, error, payload: undefined };
+  }
+}
+
+type Snapshot = {
+  hash: string;
+  path: string;
+  config: Record<string, unknown>;
+  capabilities: { configMutationReceipts: number };
+};
+async function snapshot() {
+  const response = await rpcReq<Snapshot>(server.client, "config.get", {});
+  expect(response.ok).toBe(true);
+  expect(response.payload?.capabilities.configMutationReceipts).toBe(1);
+  return response.payload!;
+}
+
+test("authored skills and employee updates retain token placeholders without gateway restart", async () => {
+  for (const kind of ["skills", "employee"] as const) {
+    const before = await snapshot();
+    const candidate = JSON.parse(await fs.readFile(before.path, "utf8"));
+    expect(candidate.gateway.auth.token).toBe("${OPENCLAW_GATEWAY_TOKEN}");
+    if (kind === "skills") {
+      candidate.skills.entries["installed-employee-skill"] = { enabled: false };
+    } else {
+      const agents = before.config.agents as { entries?: Record<string, unknown> };
+      candidate.agents = { ...candidate.agents, ownership: "explicit", entries: { ...agents.entries,
+        "installed-employee": { name: "Isolated fixture employee", workspace: path.join(tempHome, "employee-workspace") } } };
+    }
+    const response = await rpcReq<{ mutation: ConfigMutationReceipt }>(server.client, "config.set", {
+      raw: JSON.stringify(candidate), baseHash: before.hash, mutationId: `authored-${kind}`, allowRestart: false,
+    }, 20_000);
+    expect(response.ok, String(response.error)).toBe(true);
+    expect(response.payload?.mutation.state, JSON.stringify(response.payload)).toBe("applied");
+    expect(JSON.parse(await fs.readFile(before.path, "utf8")).gateway.auth.token).toBe("${OPENCLAW_GATEWAY_TOKEN}");
+    await expect(server.client.request("health", {})).resolves.toEqual(expect.any(Object));
+    expect(recoveryRestart).not.toHaveBeenCalled();
+  }
+});
+
+test("a real authentication change still requires restart without touching the live file", async () => {
+  const before = await snapshot();
+  const bytes = await fs.readFile(before.path, "utf8");
+  const candidate = JSON.parse(bytes);
+  candidate.gateway.auth.token = "genuinely-different-token";
+  const response = await rpcReq<{ mutation: ConfigMutationReceipt; restartPaths: string[] }>(server.client, "config.set", {
+    raw: JSON.stringify(candidate), baseHash: before.hash, mutationId: "authored-auth-change", allowRestart: false,
+  });
+  expect(response.payload?.mutation.state).toBe("restart-required");
+  expect(response.payload?.restartPaths).toContain("gateway.auth.token");
+  const reconciled = await rpcReq<{ mutation: ConfigMutationReceipt }>(server.client, "config.get", {
+    mutationId: "authored-auth-change",
+  });
+  expect(reconciled.payload?.mutation.restartPaths).toContain("gateway.auth.token");
+  expect(await fs.readFile(before.path, "utf8")).toBe(bytes);
+  await expect(server.client.request("health", {})).resolves.toEqual(expect.any(Object));
+});
+
+test("restart-required candidates never reach the file watcher and duplicate IDs do not execute again", async () => {
+  const before = await snapshot();
+  const bytes = await fs.readFile(before.path, "utf8");
+  const candidate = structuredClone(before.config);
+  candidate.discovery = { mdns: { mode: "off" } };
+  const params = {
+    raw: JSON.stringify(candidate),
+    baseHash: before.hash,
+    mutationId: "requires-restart",
+    allowRestart: false,
+  };
+  const response = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+    server.client,
+    "config.set",
+    params,
+  );
+  expect(response.ok).toBe(true);
+  expect(response.payload?.mutation.state).toBe("restart-required");
+  expect(await fs.readFile(before.path, "utf8")).toBe(bytes);
+  const duplicate = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+    server.client,
+    "config.set",
+    params,
+  );
+  expect(duplicate.payload?.mutation).toEqual(response.payload?.mutation);
+  const readback = await rpcReq<{ mutation: ConfigMutationReceipt }>(server.client, "config.get", {
+    mutationId: params.mutationId,
+  });
+  expect(readback.payload?.mutation).toEqual(response.payload?.mutation);
+  expect(await fs.readFile(before.path, "utf8")).toBe(bytes);
+});
+
+test("disabled live reloading rejects managed mutations before persistence", async () => {
+  const before = await snapshot();
+  const bytes = await fs.readFile(before.path, "utf8");
+  const candidate = structuredClone(before.config);
+  candidate.gateway = { ...(candidate.gateway as object), reload: { mode: "off" } };
+  candidate.skills = { entries: { "disabled-reload-fixture": { enabled: false } } };
+  const response = await rpcReq<{ mutation: ConfigMutationReceipt }>(server.client, "config.set", {
+    raw: JSON.stringify(candidate),
+    baseHash: before.hash,
+    mutationId: "disabled-reload",
+    allowRestart: false,
+  });
+  expect(response.ok).toBe(true);
+  expect(response.payload?.mutation.state).toBe("restart-required");
+  expect(await fs.readFile(before.path, "utf8")).toBe(bytes);
+});
+
+test("hot config.set settles only after its owner applies the saved revision", async () => {
+  const before = await snapshot();
+  const candidate = structuredClone(before.config);
+  candidate.skills = { entries: { "receipt-fixture": { enabled: false } } };
+  const params = {
+    raw: JSON.stringify(candidate),
+    baseHash: before.hash,
+    mutationId: "hot-write",
+    allowRestart: false,
+  };
+  const response = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+    server.client,
+    "config.set",
+    params,
+    20_000,
+  );
+  expect(response.ok).toBe(true);
+  expect(response.payload?.mutation.state, JSON.stringify(response.payload)).not.toBe(
+    "restart-required",
+  );
+  let last: ConfigMutationReceipt | null | undefined;
+  await expect
+    .poll(
+      async () => {
+        const readback = await rpcReq<{ mutation: ConfigMutationReceipt | null }>(
+          server.client,
+          "config.get",
+          { mutationId: params.mutationId },
+        );
+        last = readback.payload?.mutation;
+        return last?.state;
+      },
+      { timeout: 10_000 },
+    )
+    .toBe("applied");
+  expect(last?.desiredRevision).toBeTruthy();
+  expect(last?.persistedRevision).toBe(last?.desiredRevision);
+  expect(last?.appliedRevision).toBe(last?.desiredRevision);
+  const persisted = await fs.readFile(before.path, "utf8");
+  const duplicate = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+    server.client,
+    "config.set",
+    params,
+  );
+  expect(duplicate.payload?.mutation).toEqual(last);
+  expect(await fs.readFile(before.path, "utf8")).toBe(persisted);
+  await expect(server.client.request("health", {})).resolves.toEqual(expect.any(Object));
+  expect(recoveryRestart).not.toHaveBeenCalled();
+});
+
+test("agents-only config.patch uses the same watcher receipt without a legacy restart", async () => {
+  setLoggerOverride({ level: "debug", file: path.join(tempHome, "config-reload.log") });
+  const before = await snapshot();
+  const params = {
+    raw: JSON.stringify({ agents: { defaults: { maxConcurrent: 3 } } }),
+    baseHash: before.hash,
+    mutationId: "agent-patch",
+    allowRestart: false,
+  };
+  const response = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+    server.client,
+    "config.patch",
+    params,
+  );
+  expect(response.ok).toBe(true);
+  expect(response.payload?.mutation.state, JSON.stringify(response.payload)).not.toBe(
+    "restart-required",
+  );
+  await expect
+    .poll(
+      async () => {
+        const result = await rpcReq<{ mutation: ConfigMutationReceipt }>(
+          server.client,
+          "config.get",
+          { mutationId: params.mutationId },
+        );
+        return result.payload?.mutation.state;
+      },
+      { timeout: 10_000 },
+    )
+    .toBe("applied")
+    .catch(async (error) => {
+      const log = await fs
+        .readFile(path.join(tempHome, "config-reload.log"), "utf8")
+        .catch(() => "");
+      throw new Error(
+        `${String(error)}\n${log
+          .split("\n")
+          .filter((line) => /reload.*failed|Error:/.test(line))
+          .join("\n")}`,
+      );
+    });
+  await expect(server.client.request("health", {})).resolves.toEqual(expect.any(Object));
+  expect(recoveryRestart).not.toHaveBeenCalled();
+});
+
+test("unknown IDs and invalid writes cannot masquerade as applied", async () => {
+  const unknown = await rpcReq<{ mutation: null }>(server.client, "config.get", {
+    mutationId: "not-submitted",
+  });
+  expect(unknown.payload?.mutation).toBeNull();
+  const before = await snapshot();
+  const bytes = await fs.readFile(before.path, "utf8");
+  const invalid = await rpcReq(server.client, "config.set", {
+    raw: "{invalid",
+    baseHash: before.hash,
+    mutationId: "invalid-write",
+    allowRestart: false,
+  });
+  expect(invalid.ok).toBe(false);
+  const readback = await rpcReq<{ mutation: ConfigMutationReceipt }>(server.client, "config.get", {
+    mutationId: "invalid-write",
+  });
+  expect(readback.payload?.mutation.state).toBe("rejected");
+  expect(await fs.readFile(before.path, "utf8")).toBe(bytes);
+});
+
+test("read-only candidate attestation bypasses a cached old snapshot", async () => {
+  const before = await snapshot();
+  const currentRaw = await fs.readFile(before.path, "utf8");
+  const expectedRawHash = createHash("sha256").update(currentRaw).digest("hex");
+  const match = await rpcReq<{
+    persistedCandidateMatches: boolean;
+    configRevisionHash: string;
+    appliedConfigHash: string;
+  }>(server.client, "config.get", { expectedRawHash });
+  expect(match.payload?.persistedCandidateMatches).toBe(true);
+  expect(match.payload?.configRevisionHash).toBe(match.payload?.appliedConfigHash);
+  const wrong = await rpcReq<{ persistedCandidateMatches: boolean }>(server.client, "config.get", {
+    expectedRawHash: "a".repeat(64),
+  });
+  expect(wrong.payload?.persistedCandidateMatches).toBe(false);
+  expect(await fs.readFile(before.path, "utf8")).toBe(currentRaw);
+});
+
+type RestartLease = {
+  state: string;
+  leaseId?: string;
+  instanceId: string;
+  expiresAtMs?: number;
+  reason?: string;
+};
+async function lease(action: "acquire" | "commit" | "release", held?: RestartLease) {
+  if (action === "acquire") {
+    // WebSocket ACKs can precede the previous request envelope releasing its root.
+    await expect.poll(() => getActiveGatewayRootWorkCount(), { timeout: 5_000 }).toBe(0);
+  }
+  const response = await rpcReq<{ restartLease: RestartLease }>(
+    server.client,
+    "config.set",
+    {
+      raw: "{}",
+      restartLeaseAction: action,
+      ...(action === "acquire"
+        ? { restartTargetRevision: "fixture-desired-revision" }
+        : { restartLeaseId: held?.leaseId, restartLeaseInstanceId: held?.instanceId }),
+    },
+    3_000,
+  );
+  expect(response.ok, String(response.error)).toBe(true);
+  return response.payload!.restartLease;
+}
+
+test(
+  "restart leases release or expire without closing the live gateway",
+  { timeout: 25_000 },
+  async () => {
+    const shutdown = vi.fn();
+    process.on("SIGINT", shutdown);
+    try {
+      const before = await snapshot();
+      const raw = await fs.readFile(before.path, "utf8");
+      const first = await lease("acquire");
+      expect(first.state, first.reason).toBe("acquired");
+      expect((await lease("release", first)).state).toBe("released");
+      const expiring = await lease("acquire");
+      expect(expiring.state, expiring.reason).toBe("acquired");
+      await new Promise((resolve) => {
+        setTimeout(resolve, Math.max(0, expiring.expiresAtMs! - Date.now()) + 50);
+      });
+      expect((await lease("commit", expiring)).state).toBe("expired");
+      await expect(server.client.request("health", {})).resolves.toEqual(expect.any(Object));
+      expect(shutdown).not.toHaveBeenCalled();
+      expect(await fs.readFile(before.path, "utf8")).toBe(raw);
+    } finally {
+      process.off("SIGINT", shutdown);
+    }
+  },
+);
+
+test("committed restart lease emits SIGINT with new write admission already fenced", async () => {
+  const shutdown = vi.fn();
+  process.on("SIGINT", shutdown);
+  try {
+    const before = await snapshot();
+    const raw = await fs.readFile(before.path, "utf8");
+    const acquired = await lease("acquire");
+    expect(acquired.state, acquired.reason).toBe("acquired");
+    expect((await lease("commit", acquired)).state).toBe("committed");
+    await expect.poll(() => shutdown.mock.calls.length).toBe(1);
+    const blocked = await rpcReq(server.client, "config.set", {
+      raw,
+      baseHash: before.hash,
+      mutationId: "must-not-write-after-commit",
+      allowRestart: false,
+    });
+    expect(blocked.ok).toBe(false);
+    expect(String(blocked.error)).toMatch(/suspend|drain|restart/i);
+    expect(await fs.readFile(before.path, "utf8")).toBe(raw);
+  } finally {
+    process.off("SIGINT", shutdown);
+  }
+});
