+import { beforeEach, expect, test, vi } from "vitest";
+import { configHandlers } from "./config.js";
+import { createConfigHandlerHarness, createConfigWriteSnapshot } from "./config.test-helpers.js";
+
+const mocks = vi.hoisted(() => ({ read: vi.fn(), commit: vi.fn() }));
+vi.mock("../../config/io.js", async () => ({
+  ...(await vi.importActual<typeof import("../../config/io.js")>("../../config/io.js")),
+  readConfigFileSnapshotForWrite: mocks.read,
+}));
+vi.mock("./config-write-flow.js", async () => ({
+  ...(await vi.importActual<typeof import("./config-write-flow.js")>("./config-write-flow.js")),
+  commitGatewayConfigWrite: mocks.commit,
+}));
+vi.mock("../../config/validation.js", async () => ({
+  ...(await vi.importActual<typeof import("../../config/validation.js")>("../../config/validation.js")),
+  validateConfigObjectRawWithPlugins: (config: unknown) => ({ ok: true, config, warnings: [] }),
+  validateConfigObjectWithPlugins: (config: unknown) => ({ ok: true, config, warnings: [] }),
+}));
+vi.mock("../../config/runtime-schema.js", () => ({
+  loadGatewayRuntimeConfigSchema: () => ({ schema: { type: "object" }, uiHints: {}, version: "fixture" }),
+}));
+vi.mock("../../secrets/runtime.js", async () => ({
+  ...(await vi.importActual<typeof import("../../secrets/runtime.js")>("../../secrets/runtime.js")),
+  prepareSecretsRuntimeSnapshot: async () => ({ degradedOwners: [] }),
+}));
+
+const tokenVariable = "OPENCLAW_ENV_RESTART_FIXTURE_TOKEN";
+const template = `\${${tokenVariable}}`;
+const original = {
+  gateway: { mode: "local" as const, auth: { mode: "token" as const, token: "read-time-token" } },
+  skills: { entries: {} },
+};
+let counter = 0;
+beforeEach(() => {
+  vi.clearAllMocks();
+  const read = createConfigWriteSnapshot(structuredClone(original));
+  read.snapshot.parsed = { ...original, gateway: { ...original.gateway, auth: { ...original.gateway.auth, token: template } } };
+  read.snapshot.raw = JSON.stringify(read.snapshot.parsed);
+  read.writeOptions = { envSnapshotForRestore: { [tokenVariable]: "read-time-token" } } as never;
+  mocks.read.mockResolvedValue(read);
+  mocks.commit.mockImplementation(async ({ nextConfig }) => ({
+    path: "/tmp/fixture-openclaw.json", config: nextConfig, hash: "fixture-next-hash",
+    application: Promise.resolve("applied"), queueFollowUp: vi.fn(),
+  }));
+});
+
+async function apply(method: "config.set" | "config.patch", token: string, extra?: object) {
+  const raw = {
+    gateway: { ...original.gateway, auth: { ...original.gateway.auth, token } },
+    skills: { entries: { "fixture-installed-skill": { enabled: true } } }, ...extra,
+  };
+  const harness = createConfigHandlerHarness({ method, params: {
+    raw: JSON.stringify(raw), baseHash: "base-hash", mutationId: `env-fixture-${++counter}`, allowRestart: false,
+  } });
+  await configHandlers[method]!(harness.options);
+  return harness.respond.mock.calls.at(-1);
+}
+
+test.each(["config.set", "config.patch"] as const)("%s keeps an unchanged authored token placeholder hot", async (method) => {
+  const response = await apply(method, template);
+  expect(response?.[0]).toBe(true);
+  expect(response?.[1]).toMatchObject({ mutation: { state: "applied" } });
+  expect(mocks.commit).toHaveBeenCalledOnce();
+  expect(mocks.commit.mock.calls[0][0].nextConfig.gateway.auth.token).toBe(template);
+});
+
+test.each(["config.set", "config.patch"] as const)("%s still requires restart for a genuinely changed token", async (method) => {
+  const response = await apply(method, "different-token");
+  expect(response?.[1]).toMatchObject({ mutation: { state: "restart-required" }, restartPaths: ["gateway.auth.token"] });
+  expect(mocks.commit).not.toHaveBeenCalled();
+});
+
+test("candidate env changes still require restart without modifying the live process environment", async () => {
+  const previous = process.env[tokenVariable];
+  const response = await apply("config.set", template, { env: { [tokenVariable]: "candidate-new-token" } });
+  expect(response?.[1]).toMatchObject({ mutation: { state: "restart-required" } });
+  expect(response?.[1].restartPaths).toContain("env");
+  expect(process.env[tokenVariable]).toBe(previous);
+  expect(mocks.commit).not.toHaveBeenCalled();
+});
+
+test("changing the token reference to a different environment value requires restart", async () => {
+  const read = await mocks.read();
+  read.writeOptions.envSnapshotForRestore.OPENCLAW_ENV_RESTART_OTHER_FIXTURE = "other-token";
+  const response = await apply("config.set", "${OPENCLAW_ENV_RESTART_OTHER_FIXTURE}");
+  expect(response?.[1]).toMatchObject({ mutation: { state: "restart-required" }, restartPaths: ["gateway.auth.token"] });
+  expect(mocks.commit).not.toHaveBeenCalled();
+});
+
+test.skipIf(process.platform !== "win32")("Windows read-time environment names remain case-insensitive", async () => {
+  const read = await mocks.read();
+  read.writeOptions.envSnapshotForRestore = { [tokenVariable.toLowerCase()]: "read-time-token" };
+  const response = await apply("config.set", template);
+  expect(response?.[1]).toMatchObject({ mutation: { state: "applied" } });
+  expect(mocks.commit.mock.calls[0][0].nextConfig.gateway.auth.token).toBe(template);
+});
+
+test("an unresolved new placeholder is never treated as unchanged gateway authentication", async () => {
+  const response = await apply("config.set", "${OPENCLAW_ENV_RESTART_MISSING_FIXTURE}");
+  expect(response?.[1]).toMatchObject({ mutation: { state: "restart-required" } });
+  expect(mocks.commit).not.toHaveBeenCalled();
+});
