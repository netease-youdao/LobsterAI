+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { resetGatewaySuspendCoordinatorForLifecycleRestart } from "../infra/gateway-suspend-coordinator.js";
+import {
+  isGatewayWorkAdmissionClosed,
+  resetGatewayWorkAdmission,
+  tryBeginGatewayRootWorkAdmission,
+} from "../process/gateway-work-admission.js";
+import {
+  consumeControlPlaneWriteBudget,
+  CONTROL_PLANE_RATE_LIMIT_MAX_REQUESTS,
+} from "./control-plane-rate-limit.js";
+import {
+  acquireHostConfigRestartLease,
+  commitHostConfigRestartLease,
+  releaseHostConfigRestartLease,
+} from "./host-config-restart-lease.js";
+import { createPluginGatewayMethodDescriptor } from "./methods/descriptor.js";
+import { createGatewayMethodRegistry } from "./methods/registry.js";
+import { runWithGatewayRequestEnvelope } from "./server-methods.js";
+import type { GatewayRequestContext } from "./server-methods/types.js";
+
+const shutdown = vi.fn();
+function fixture() {
+  const pauseScheduling = vi.fn();
+  const resumeScheduling = vi.fn();
+  const getSuspensionBlockerCount = vi.fn(() => 0);
+  const context = {
+    cron: { pauseScheduling, resumeScheduling, getSuspensionBlockerCount },
+    chatAbortControllers: new Map(),
+    chatQueuedTurns: new Map(),
+    terminalSessions: { size: 0 },
+    logGateway: { warn: vi.fn() },
+  } as unknown as GatewayRequestContext;
+  return { context, pauseScheduling, resumeScheduling, getSuspensionBlockerCount };
+}
+beforeEach(() => {
+  vi.useFakeTimers();
+  shutdown.mockClear();
+  process.on("SIGINT", shutdown);
+  resetGatewaySuspendCoordinatorForLifecycleRestart();
+  resetGatewayWorkAdmission();
+});
+afterEach(() => {
+  resetGatewaySuspendCoordinatorForLifecycleRestart();
+  resetGatewayWorkAdmission();
+  process.removeListener("SIGINT", shutdown);
+  vi.useRealTimers();
+});
+
+describe("host config restart lease", () => {
+  it("excludes only its own admitted RPC root when acquiring through the real dispatcher", async () => {
+    const { context } = fixture();
+    const handler = async () => acquireHostConfigRestartLease(context, "revision-a");
+    const methodRegistry = createGatewayMethodRegistry([
+      createPluginGatewayMethodDescriptor({ pluginId: "lease-proof", name: "config.set", handler }),
+    ]);
+    const acquired = await runWithGatewayRequestEnvelope("config.set", null, handler, {
+      context,
+      methodRegistry,
+      isWebchatConnect: () => false,
+      requestParams: {
+        raw: "{}",
+        restartLeaseAction: "acquire",
+        restartTargetRevision: "revision-a",
+      },
+      reject: () => {
+        throw new Error("unexpected admission rejection");
+      },
+    });
+    expect(acquired.state, acquired.reason).toBe("acquired");
+    expect(releaseHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "released",
+    );
+  });
+
+  it("fences new work and resumes the scheduler when an uncommitted lease expires", async () => {
+    const { context, pauseScheduling, resumeScheduling } = fixture();
+    const acquired = await acquireHostConfigRestartLease(context, "revision-a");
+    expect(acquired.state).toBe("acquired");
+    expect(pauseScheduling).toHaveBeenCalledOnce();
+    expect(tryBeginGatewayRootWorkAdmission()).toBeNull();
+    await vi.advanceTimersByTimeAsync(15_000);
+    expect(resumeScheduling).toHaveBeenCalledOnce();
+    expect(isGatewayWorkAdmissionClosed()).toBe(false);
+    expect(commitHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "expired",
+    );
+    expect(shutdown).not.toHaveBeenCalled();
+  });
+
+  it("refuses an existing root and rolls back admission without aborting that work", async () => {
+    const { context, resumeScheduling } = fixture();
+    const running = tryBeginGatewayRootWorkAdmission();
+    try {
+      expect((await acquireHostConfigRestartLease(context, "revision-a")).state).toBe("busy");
+      expect(isGatewayWorkAdmissionClosed()).toBe(false);
+      expect(resumeScheduling).toHaveBeenCalledOnce();
+    } finally {
+      running?.release();
+    }
+    expect(shutdown).not.toHaveBeenCalled();
+  });
+
+  it("does not authorize shutdown when inspection fails", async () => {
+    const { context, getSuspensionBlockerCount, resumeScheduling } = fixture();
+    getSuspensionBlockerCount.mockImplementation(() => {
+      throw new Error("inventory unavailable");
+    });
+    expect((await acquireHostConfigRestartLease(context, "revision-a")).state).toBe("unknown");
+    expect(resumeScheduling).toHaveBeenCalledOnce();
+    expect(isGatewayWorkAdmissionClosed()).toBe(false);
+  });
+
+  it("rejects the wrong instance and a retired lifecycle without stopping a replacement", async () => {
+    const { context } = fixture();
+    const acquired = await acquireHostConfigRestartLease(context, "revision-a");
+    expect(commitHostConfigRestartLease(acquired.leaseId!, "another-instance").state).toBe(
+      "expired",
+    );
+    expect(isGatewayWorkAdmissionClosed()).toBe(true);
+    resetGatewaySuspendCoordinatorForLifecycleRestart();
+    resetGatewayWorkAdmission();
+    expect(commitHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "expired",
+    );
+    expect(shutdown).not.toHaveBeenCalled();
+  });
+
+  it("rechecks runtime work before commit and keeps that work alive", async () => {
+    const { context, getSuspensionBlockerCount } = fixture();
+    const acquired = await acquireHostConfigRestartLease(context, "revision-a");
+    getSuspensionBlockerCount.mockReturnValue(1);
+    expect(commitHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe("busy");
+    expect(isGatewayWorkAdmissionClosed()).toBe(false);
+    expect(shutdown).not.toHaveBeenCalled();
+  });
+
+  it("commits the irreversible fence before ACK and emits one shutdown even when retried", async () => {
+    const { context, resumeScheduling } = fixture();
+    const acquired = await acquireHostConfigRestartLease(context, "revision-a");
+    expect(commitHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "committed",
+    );
+    expect(tryBeginGatewayRootWorkAdmission()).toBeNull();
+    expect(shutdown).not.toHaveBeenCalled();
+    expect(commitHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "committed",
+    );
+    expect(releaseHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "committed",
+    );
+    await vi.advanceTimersByTimeAsync(15_001);
+    expect(shutdown).toHaveBeenCalledOnce();
+    expect(resumeScheduling).not.toHaveBeenCalled();
+    expect(isGatewayWorkAdmissionClosed()).toBe(true);
+  });
+
+  it("allows only exact lease completion through the real dispatcher while config writes remain fenced", async () => {
+    const { context } = fixture();
+    const acquired = await acquireHostConfigRestartLease(context, "revision-a");
+    const handler = vi.fn();
+    const reject = vi.fn();
+    const methodRegistry = createGatewayMethodRegistry([
+      {
+        ...createPluginGatewayMethodDescriptor({
+          pluginId: "lease-proof",
+          name: "config.set",
+          scope: "operator.write",
+          handler,
+        }),
+        controlPlaneWrite: true,
+      },
+    ]);
+    const dispatch = (requestParams: unknown) =>
+      runWithGatewayRequestEnvelope("config.set", null, handler, {
+        context,
+        methodRegistry,
+        isWebchatConnect: () => false,
+        requestParams,
+        reject,
+      });
+    await dispatch({ raw: "{}" });
+    await dispatch({
+      raw: "{}",
+      restartLeaseAction: "release",
+      restartLeaseId: acquired.leaseId,
+      restartLeaseInstanceId: "another-instance",
+    });
+    await dispatch({
+      raw: '{"models":{}}',
+      restartLeaseAction: "release",
+      restartLeaseId: acquired.leaseId,
+      restartLeaseInstanceId: acquired.instanceId,
+    });
+    expect(reject).toHaveBeenCalledTimes(3);
+    expect(handler).not.toHaveBeenCalled();
+    for (let i = 0; i < CONTROL_PLANE_RATE_LIMIT_MAX_REQUESTS; i++) {
+      consumeControlPlaneWriteBudget({ client: null, method: "config.set" });
+    }
+    expect(consumeControlPlaneWriteBudget({ client: null, method: "config.set" }).allowed).toBe(
+      false,
+    );
+    await dispatch({
+      raw: "{}",
+      restartLeaseAction: "release",
+      restartLeaseId: acquired.leaseId,
+      restartLeaseInstanceId: acquired.instanceId,
+    });
+    expect(handler).toHaveBeenCalledOnce();
+    expect(releaseHostConfigRestartLease(acquired.leaseId!, acquired.instanceId).state).toBe(
+      "released",
+    );
+  });
+});
