+
+async function appendBoundedTestTurns(
+  scope: Parameters<typeof persistSessionTranscriptTurn>[0],
+  params: { from: number; count: number; parentId: string | null; padding: number },
+): Promise<string | null> {
+  let parentId = params.parentId;
+  for (let turn = params.from; turn < params.from + params.count; turn += 1) {
+    await persistSessionTranscriptTurn(scope, {
+      messages: [
+        {
+          eventId: `turn-${turn}-user`,
+          parentId,
+          message: { role: "user", content: `question ${turn} ${"q".repeat(params.padding)}` },
+        },
+        {
+          eventId: `turn-${turn}-assistant`,
+          parentId: `turn-${turn}-user`,
+          message: { role: "assistant", content: `answer ${turn} ${"a".repeat(params.padding)}` },
+        },
+      ],
+      touchSessionEntry: false,
+    });
+    parentId = `turn-${turn}-assistant`;
+  }
+  return parentId;
+}
+
+function boundedEventIds(context: { events: unknown[] }): string[] {
+  return context.events.slice(1).map((event) => (event as { id: string }).id);
+}
+
+it("keeps a byte-limited tail start fixed until the tail outgrows a quarter-capacity step", async () => {
+  await withBoundedContextScope(async (scope) => {
+    let parentId = await appendBoundedTestTurns(scope, {
+      from: 0,
+      count: 40,
+      parentId: null,
+      padding: 200,
+    });
+    const limits = { maxBytes: 8_000, maxEvents: 10_000 };
+    const starts: string[] = [];
+    for (let turn = 40; turn < 52; turn += 1) {
+      const context = readSessionTranscriptBoundedActiveContextCore(scope, limits);
+      expect(context.truncated).toBe(true);
+      expect(context.serializedBytes).toBeLessThanOrEqual(limits.maxBytes);
+      const [first] = boundedEventIds(context);
+      expect(first).toMatch(/^turn-\d+-user$/);
+      starts.push(first!);
+      parentId = await appendBoundedTestTurns(scope, {
+        from: turn,
+        count: 1,
+        parentId,
+        padding: 200,
+      });
+    }
+    // Each turn is about a quarter of a step, so twelve appends move the start a few times
+    // instead of on every append, and only forward.
+    const distinct = [...new Set(starts)];
+    expect(distinct.length).toBeGreaterThan(1);
+    expect(distinct.length).toBeLessThanOrEqual(5);
+    const turnNumbers = starts.map((id) => Number(id.split("-")[1]));
+    expect(turnNumbers).toEqual(turnNumbers.toSorted((left, right) => left - right));
+  });
+});
+
+it("reserves the latest compaction boundary before sizing a byte-limited tail", async () => {
+  await withBoundedContextScope(async (scope) => {
+    const keptParent = await appendBoundedTestTurns(scope, {
+      from: 0,
+      count: 2,
+      parentId: null,
+      padding: 100,
+    });
+    await appendTranscriptEvent(scope, {
+      type: "compaction",
+      id: "boundary",
+      parentId: keptParent,
+      timestamp: "2026-08-25T00:00:00.000Z",
+      summary: `earlier ${"s".repeat(1_500)}`,
+      firstKeptEntryId: "turn-1-user",
+      tokensBefore: 10_000,
+    });
+    let parentId: string | null = "boundary";
+    let truncatedIds: string[] | undefined;
+    for (let turn = 2; turn < 30; turn += 1) {
+      parentId = await appendBoundedTestTurns(scope, {
+        from: turn,
+        count: 1,
+        parentId,
+        padding: 150,
+      });
+      const context = readSessionTranscriptBoundedActiveContextCore(scope, {
+        maxBytes: 6_000,
+        maxEvents: 10_000,
+      });
+      const ids = boundedEventIds(context);
+      expect(ids).toContain("boundary");
+      expect(context.serializedBytes).toBeLessThanOrEqual(6_000);
+      if (context.truncated) {
+        truncatedIds = ids;
+      }
+    }
+    expect(truncatedIds?.[0]).toBe("boundary");
+    expect(truncatedIds?.[1]).toMatch(/^turn-\d+-user$/);
+  });
+});
+
+it("sizes the byte-limited tail from the retained compaction start, not compacted history", async () => {
+  await withBoundedContextScope(async (scope) => {
+    const compactedParent = await appendBoundedTestTurns(scope, {
+      from: 0,
+      count: 30,
+      parentId: null,
+      padding: 200,
+    });
+    const keptParent = await appendBoundedTestTurns(scope, {
+      from: 30,
+      count: 2,
+      parentId: compactedParent,
+      padding: 200,
+    });
+    await appendTranscriptEvent(scope, {
+      type: "compaction",
+      id: "boundary",
+      parentId: keptParent,
+      timestamp: "2026-08-25T00:00:00.000Z",
+      summary: "earlier work",
+      firstKeptEntryId: "turn-30-user",
+      tokensBefore: 10_000,
+    });
+    await appendBoundedTestTurns(scope, { from: 32, count: 3, parentId: "boundary", padding: 200 });
+
+    const context = readSessionTranscriptBoundedActiveContextCore(scope, {
+      maxBytes: 8_000,
+      maxEvents: 10_000,
+    });
+    const ids = boundedEventIds(context);
+    // The retained tail and everything after the boundary fit, so no step cut applies to them.
+    for (const id of [
+      "turn-30-user",
+      "turn-31-assistant",
+      "boundary",
+      "turn-32-user",
+      "turn-34-assistant",
+    ]) {
+      expect(ids).toContain(id);
+    }
+    expect(ids.indexOf("boundary")).toBeGreaterThan(ids.indexOf("turn-31-assistant"));
+    expect(ids.indexOf("boundary")).toBeLessThan(ids.indexOf("turn-32-user"));
+  });
+});
