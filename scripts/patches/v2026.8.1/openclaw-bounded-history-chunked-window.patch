+// A byte-limited tail advances in quarter-capacity steps (openclaw/openclaw#159799, #168157).
+const BOUNDED_CONTEXT_STEP_DIVISOR = 4;
+
+function isUserMessageEvent(event: TranscriptEvent): boolean {
+  const entry = asOptionalRecord(event);
+  return entry?.type === "message" && asOptionalRecord(entry.message)?.role === "user";
+}
+
+/** First active position the latest boundary keeps visible to the model. */
+function resolveBoundedContextStart(
+  projection: CurrentTranscriptProjection,
+  boundary: { event_json: string; active_position: number } | undefined,
+): number | undefined {
+  if (!boundary) {
+    return undefined;
+  }
+  const firstKeptEntryId = asOptionalRecord(JSON.parse(boundary.event_json))?.firstKeptEntryId;
+  if (typeof firstKeptEntryId === "string") {
+    const firstKept = executeSqliteQueryTakeFirstSync(
+      projection.database.db,
+      getActiveTranscriptKysely(projection.database)
+        .selectFrom("transcript_event_identities as identity")
+        .innerJoin("session_transcript_active_events as active", (join) =>
+          join
+            .onRef("active.session_id", "=", "identity.session_id")
+            .onRef("active.event_seq", "=", "identity.seq"),
+        )
+        .select("active.active_position")
+        .where("identity.session_id", "=", projection.resolved.sessionId)
+        .where("identity.event_id", "=", firstKeptEntryId),
+    );
+    if (firstKept && firstKept.active_position < boundary.active_position) {
+      return firstKept.active_position;
+    }
+  }
+  return boundary.active_position + 1;
+}
+
+/** Serialized bytes of the model-visible tail, excluding history behind the latest boundary. */
+function readBoundedContextBytes(
+  projection: CurrentTranscriptProjection,
+  params: { boundarySeq?: number; contextStart?: number; beforeRawSeq?: number },
+): number {
+  const row = executeSqliteQueryTakeFirstSync(
+    projection.database.db,
+    getActiveTranscriptKysely(projection.database)
+      .selectFrom("session_transcript_active_events as active")
+      .innerJoin("transcript_events as event", (join) =>
+        join
+          .onRef("event.session_id", "=", "active.session_id")
+          .onRef("event.seq", "=", "active.event_seq"),
+      )
+      .select(
+        /* kysely-allow-raw: each serialized event carries one terminating newline. */
+        sql<number>`COALESCE(SUM(OCTET_LENGTH(event.event_json)), 0) + COUNT(*)`.as("size_bytes"),
+      )
+      .where("active.session_id", "=", projection.resolved.sessionId)
+      .where("active.context_eligible", "=", 1)
+      .$if(params.beforeRawSeq !== undefined, (query) =>
+        query.where("active.event_seq", "<", params.beforeRawSeq!),
+      )
+      .$if(params.boundarySeq !== undefined, (query) =>
+        query.where("active.event_seq", "!=", params.boundarySeq!),
+      )
+      .$if(params.contextStart !== undefined, (query) =>
+        query.where("active.active_position", ">=", params.contextStart!),
+      ),
+  );
+  return row?.size_bytes ?? 0;
+}
