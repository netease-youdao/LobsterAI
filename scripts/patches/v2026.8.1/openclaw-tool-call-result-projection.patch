+type ToolCallResultBlock = AgentToolResult<unknown>["content"][number];
+type ToolCallImageBlock = Extract<ToolCallResultBlock, { type: "image" }>;
+
+/** Replace image blocks with short placeholders and return the images separately. */
+function splitToolCallResultImages(result: AgentToolResult<unknown>): {
+  result: AgentToolResult<unknown>;
+  images: ToolCallImageBlock[];
+} {
+  if (!Array.isArray(result.content)) {
+    return { result, images: [] };
+  }
+  const images: ToolCallImageBlock[] = [];
+  const content = result.content.map((block): ToolCallResultBlock => {
+    if (block?.type !== "image") {
+      return block;
+    }
+    images.push(block);
+    return {
+      type: "text",
+      text: `[image ${images.length} (${block.mimeType}) is attached after this result]`,
+    };
+  });
+  return images.length > 0 ? { result: { ...result, content }, images } : { result, images };
+}
