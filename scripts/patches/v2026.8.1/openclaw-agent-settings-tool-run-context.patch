@@ -0,0 +1,19 @@
+import { expect, test } from "vitest";
+import { buildPluginToolDescriptorCacheKey } from "./tool-descriptor-cache.js";
+
+const base = { source: "/settings/index.js", contractToolNames: ["lobsterai_agent_settings"],
+  ctx: { agentId: "main", sessionKey: "agent:main:lobsterai:session", runId: "remote-run" } };
+
+test("settings tool descriptor cache cannot cross session or run visibility", () => {
+  const key = buildPluginToolDescriptorCacheKey({ ...base, pluginId: "lobster-agent-settings" });
+  for (const ctx of [{ ...base.ctx, runId: "local-run" }, { ...base.ctx, runId: undefined },
+    { ...base.ctx, sessionKey: "agent:main:lobsterai:another" }]) {
+    expect(buildPluginToolDescriptorCacheKey({ ...base, pluginId: "lobster-agent-settings", ctx })).not.toBe(key);
+  }
+});
+
+test("unrelated plugin descriptor cache retains its existing reuse", () => {
+  const key = buildPluginToolDescriptorCacheKey({ ...base, pluginId: "unrelated-plugin" });
+  expect(buildPluginToolDescriptorCacheKey({ ...base, pluginId: "unrelated-plugin",
+    ctx: { ...base.ctx, sessionKey: "different-session", runId: "different-run" } })).toBe(key);
+});
