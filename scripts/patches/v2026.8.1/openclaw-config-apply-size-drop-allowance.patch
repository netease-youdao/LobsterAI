+
+describe("config.apply size-drop allowance", () => {
+  async function invokeConfigApply(extraParams: Record<string, unknown>) {
+    const harness = createConfigHandlerHarness({
+      method: "config.apply",
+      params: { raw: JSON.stringify({ gateway: { mode: "local" } }), baseHash: "base-hash", ...extraParams },
+    });
+    await expectDefined(
+      configHandlers["config.apply"],
+      'configHandlers["config.apply"] test invariant',
+    )(harness.options);
+    return harness;
+  }
+
+  function committedWriteOptions(): Record<string, unknown> {
+    expect(configWriteMocks.commitGatewayConfigWrite).toHaveBeenCalledOnce();
+    const [{ writeOptions }] = configWriteMocks.commitGatewayConfigWrite.mock.calls[0] as [
+      { writeOptions: Record<string, unknown> },
+    ];
+    return writeOptions;
+  }
+
+  it("waives the size-drop check only for a writer that opts in", async () => {
+    await invokeConfigApply({ allowConfigSizeDrop: true });
+
+    expect(committedWriteOptions()).toMatchObject({ allowConfigSizeDrop: true });
+  });
+
+  it("keeps the size-drop check for writers that do not opt in", async () => {
+    await invokeConfigApply({ allowConfigSizeDrop: false });
+
+    expect(committedWriteOptions().allowConfigSizeDrop).toBeUndefined();
+  });
+
+  it("rejects a non-boolean allowance before writing", async () => {
+    const harness = await invokeConfigApply({ allowConfigSizeDrop: "true" });
+
+    expect(configWriteMocks.commitGatewayConfigWrite).not.toHaveBeenCalled();
+    expect(harness.respond).toHaveBeenCalledWith(
+      false,
+      undefined,
+      expect.objectContaining({ message: expect.stringContaining("invalid config.apply params") }),
+    );
+  });
+});
