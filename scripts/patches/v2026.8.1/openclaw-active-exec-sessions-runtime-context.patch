+import { afterEach, describe, expect, it } from "vitest";
+import { addSession } from "./bash-process-registry.js";
+import { createProcessSessionFixture } from "./bash-process-registry.test-helpers.js";
+import { resetProcessRegistryForTests } from "./bash-process-registry.test-support.js";
+import { buildActiveProcessSessionRuntimeFacts } from "./runtime-facts-prompt.js";
+
+describe("buildActiveProcessSessionRuntimeFacts", () => {
+  afterEach(() => {
+    resetProcessRegistryForTests();
+  });
+
+  it("returns undefined when the scope has no running background sessions", () => {
+    expect(
+      buildActiveProcessSessionRuntimeFacts({ scopeKey: "agent:main:session-1" }),
+    ).toBeUndefined();
+    expect(buildActiveProcessSessionRuntimeFacts({ scopeKey: undefined })).toBeUndefined();
+  });
+
+  it("renders only the sessions registered for the requested scope", () => {
+    const active = createProcessSessionFixture({
+      id: "sess-active",
+      command: "sleep 600",
+      backgrounded: true,
+      pid: 1234,
+      cwd: "/tmp/work",
+      startedAt: 1_000,
+    });
+    active.scopeKey = "agent:main:session-1";
+    addSession(active);
+    const other = createProcessSessionFixture({
+      id: "sess-other",
+      command: "sleep 600",
+      backgrounded: true,
+    });
+    other.scopeKey = "agent:main:session-2";
+    addSession(other);
+
+    const facts = buildActiveProcessSessionRuntimeFacts({
+      scopeKey: "agent:main:session-1",
+      now: 6_000,
+    });
+
+    expect(facts).toBe(
+      ["Active exec sessions:", "- sess-active running pid=1234 cwd=/tmp/work :: sleep 600"].join(
+        "\n",
+      ),
+    );
+  });
+});
diff --git a/src/agents/runtime-facts-prompt.ts b/src/agents/runtime-facts-prompt.ts
new file mode 100644
index 00000000000..02cb14607d7
--- /dev/null
+++ b/src/agents/runtime-facts-prompt.ts
@@ -0,0 +1,48 @@
+/**
+ * Current-turn runtime facts rendered below the system prompt cache boundary.
+ * Guidance for these facts stays in the stable system prompt; only the per-turn
+ * snapshot travels in the hidden runtime-context carrier, so a background process
+ * starting or finishing between turns no longer rewrites the cached system prefix.
+ */
+import { truncateUtf16Safe } from "@openclaw/normalization-core/utf16-slice";
+import {
+  type ActiveProcessSessionReference,
+  listActiveProcessSessionReferences,
+} from "./bash-process-references.js";
+import { sanitizeForPromptLiteral } from "./sanitize-for-prompt.js";
+
+const MAX_ACTIVE_PROCESS_CWD_CHARS = 256;
+
+export const ACTIVE_EXEC_SESSIONS_HEADER = "Active exec sessions:";
+
+/** Renders one reconnectable background process line for the runtime-context carrier. */
+export function formatActiveProcessSessionReferenceLine(
+  session: ActiveProcessSessionReference,
+): string {
+  const pid = typeof session.pid === "number" ? ` pid=${session.pid}` : "";
+  const cwd = session.cwd
+    ? ` cwd=${truncateUtf16Safe(sanitizeForPromptLiteral(session.cwd), MAX_ACTIVE_PROCESS_CWD_CHARS)}`
+    : "";
+  return `- ${session.sessionId} ${session.status}${pid}${cwd} :: ${sanitizeForPromptLiteral(session.name)}`;
+}
+
+/**
+ * Builds the active background process snapshot for the current turn, or `undefined`
+ * when nothing is running so idle turns add no carrier bytes.
+ */
+export function buildActiveProcessSessionRuntimeFacts(params: {
+  scopeKey?: string;
+  now?: number;
+}): string | undefined {
+  const sessions = listActiveProcessSessionReferences({
+    scopeKey: params.scopeKey,
+    ...(params.now !== undefined ? { now: params.now } : {}),
+  });
+  if (sessions.length === 0) {
+    return undefined;
+  }
+  return [
+    ACTIVE_EXEC_SESSIONS_HEADER,
+    ...sessions.map(formatActiveProcessSessionReferenceLine),
+  ].join("\n");
+}
