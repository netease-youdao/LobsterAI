+async function handleSessionGoalCompat(
+  options: GatewayRequestHandlerOptions,
+  request: SessionsGoalCompatParams,
+): Promise<void> {
+  const { client, context, respond } = options;
+  try {
+    const authorization = options.sessionMutationAuthorization
+      ? { authorization: options.sessionMutationAuthorization, error: null }
+      : resolveSessionMutationAuthorization({
+          client,
+          method: "sessions.goal",
+          requestParams: request,
+          context,
+        });
+    if (authorization.error) {
+      respond(false, undefined, authorization.error);
+      return;
+    }
+    const cfg = context.getRuntimeConfig();
+    const requestedAgent = resolveRequestedSessionAgentId(cfg, request.key, request.agentId);
+    if (!requestedAgent.ok) {
+      respond(false, undefined, requestedAgent.error);
+      return;
+    }
+    const target = resolveSessionSharingTarget({
+      cfg,
+      sessionKey: request.key,
+      agentId: requestedAgent.agentId,
+    });
+    if (!target) {
+      respond(
+        false,
+        undefined,
+        errorShape(ErrorCodes.INVALID_REQUEST, "Session changed or was removed; refresh its Goal."),
+      );
+      return;
+    }
+    const assertCurrent = () => {
+      options.sessionMutationCommitGuard?.();
+      authorization.authorization?.assertCurrent();
+    };
+    assertCurrent();
+    const text = request.text?.trim() ?? "";
+    const action = request.action ?? "status";
+    const goalOptions = {
+      sessionKey: target.storeKey,
+      storePath: target.storePath,
+      agentId: target.agentId,
+      actor: gatewayClientSessionCreator(client),
+    };
+    let goal: unknown;
+    let mutated = false;
+    switch (action) {
+      case "status":
+        goal = (await getSessionGoal(goalOptions)).goal;
+        break;
+      case "start":
+      case "create":
+        if (!text) {
+          respond(false, undefined, errorShape(ErrorCodes.INVALID_REQUEST, "objective required"));
+          return;
+        }
+        goal = await createSessionGoal({
+          ...goalOptions,
+          objective: text,
+          tokenBudget: request.tokenBudget,
+        });
+        mutated = true;
+        break;
+      case "set":
+        if (!text) {
+          respond(false, undefined, errorShape(ErrorCodes.INVALID_REQUEST, "objective required"));
+          return;
+        }
+        await clearSessionGoal(goalOptions);
+        goal = await createSessionGoal({
+          ...goalOptions,
+          objective: text,
+          tokenBudget: request.tokenBudget,
+        });
+        mutated = true;
+        break;
+      case "pause":
+        goal = await updateSessionGoalStatus({
+          ...goalOptions,
+          status: "paused",
+          ...(text ? { note: text } : {}),
+        });
+        mutated = true;
+        break;
+      case "resume":
+        goal = await updateSessionGoalStatus({
+          ...goalOptions,
+          status: "active",
+          ...(text ? { note: text } : {}),
+        });
+        mutated = true;
+        break;
+      case "complete":
+      case "done":
+        goal = await updateSessionGoalStatus({
+          ...goalOptions,
+          status: "complete",
+          ...(text ? { note: text } : {}),
+        });
+        mutated = true;
+        break;
+      case "block":
+      case "blocked":
+        goal = await updateSessionGoalStatus({
+          ...goalOptions,
+          status: "blocked",
+          ...(text ? { note: text } : {}),
+        });
+        mutated = true;
+        break;
+      case "clear":
+        await clearSessionGoal(goalOptions);
+        goal = null;
+        mutated = true;
+        break;
+    }
+    if (mutated) {
+      emitSessionsChanged(context, {
+        sessionKey: target.canonicalKey,
+        agentId: target.agentId,
+        reason: "goal",
+      });
+    }
+    respond(true, { ok: true, goal: goal ?? null }, undefined);
+  } catch (error) {
+    context.logGateway.warn(`Goal compatibility update failed: ${String(error)}`);
+    respond(
+      false,
+      undefined,
+      errorShape(
+        ErrorCodes.INVALID_REQUEST,
+        error instanceof Error ? error.message : String(error),
+      ),
+    );
+  }
+}
