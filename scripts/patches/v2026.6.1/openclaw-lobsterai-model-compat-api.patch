@@ -0,0 +1,38 @@
+import { describe, expect, it } from "vitest";
+import { resolveProviderConfigApiOwnerHint } from "./provider-config-owner.js";
+
+describe("resolveProviderConfigApiOwnerHint", () => {
+  it("routes the exact LobsterAI compatibility owner without changing model transports", () => {
+    const config = {
+      models: {
+        providers: {
+          custom_0: {
+            baseUrl: "https://gateway.example.com/v1",
+            api: "lobsterai-model-compat",
+            models: [
+              {
+                id: "kimi-k3",
+                name: "Kimi K3",
+                api: "openai-completions",
+              },
+              {
+                id: "plain-model",
+                name: "Plain Model",
+                api: "anthropic-messages",
+              },
+            ],
+          },
+        },
+      },
+    };
+
+    expect(resolveProviderConfigApiOwnerHint({
+      provider: "custom_0",
+      config: config as never,
+    })).toBe("lobsterai-model-compat");
+    expect(config.models.providers.custom_0.models.map((model) => model.api)).toEqual([
+      "openai-completions",
+      "anthropic-messages",
+    ]);
+  });
+});
